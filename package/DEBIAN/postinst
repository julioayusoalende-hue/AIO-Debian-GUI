#!/bin/sh
set -eu
# 1.0.19: retire only the passwordless rules previously generated by AiO.
# Custom polkit rules that do not match the known template are left untouched.
if [ "${1:-}" = configure ]; then
  for rule in /etc/polkit-1/rules.d/50-aiodebian-gui-[0-9]*.rules; do
    [ -f "$rule" ] || continue
    if grep -Fq 'action.id === "es.aiodebian.gui.mantenimiento"' "$rule" &&
       grep -Fq 'action.lookup("program") === "/usr/lib/aio-debian-gui/aio-debian-gui-helper"' "$rule" &&
       grep -Fq 'return polkit.Result.YES;' "$rule"; then
      rm -f -- "$rule"
    fi
  done
fi
exit 0
