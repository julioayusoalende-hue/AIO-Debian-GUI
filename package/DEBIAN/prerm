#!/bin/sh
set -eu
# No interrumpir un mantenimiento en curso; retirar timers y excepciones al desinstalar.
case "${1:-}" in
    remove|deconfigure)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            for unit in /etc/systemd/system/aio-debian-gui-maintenance-[0-9]*.timer; do
                [ -f "$unit" ] || continue
                systemctl disable --now "${unit##*/}" || true
            done
        fi
        # No dejar excepciones de Polkit ni su estado si se desinstala la app.
        rm -f /etc/polkit-1/rules.d/50-aiodebian-gui-*.rules
        rm -rf /var/lib/aio-debian-gui/passwordless
        ;;
esac
exit 0
