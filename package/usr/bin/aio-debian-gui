def etiqueta(texto, markup=False, dim=False, xalign=0.0):
    lbl = Gtk.Label(xalign=xalign)
    if markup:
        lbl.set_markup(texto)
    else:
        lbl.set_text(texto)
    lbl.set_line_wrap(True)
    if dim:
        lbl.get_style_context().add_class("dim-label")
    return lbl


class VentanaPrincipal(Gtk.Window):
    def __init__(self):
        super().__init__(title="AiO Debian")
        self.set_default_size(920, 780)
        self.set_icon_name("aio-debian-gui")

        self.en_curso = False
        self.proceso = None
        self.flujo = None
        self.necesita_reinicio = False
        self.hubo_errores = False
        self.fin_recibido = False
        self.terminado_gestionado = False
        self.configurando_sin_contrasena = None
        self.actualizando_sin_contrasena = False
        self.esperando_autorizacion = False
        self.cancelacion_autorizacion = None
        self.timeout_autorizacion_id = None
        self.consultando_estados = False
        self.estados_tareas = set()
        self.salida_estados = []
        self.switches = {}
        self.filas = {}
        self.indicadores = {}

        self.flatpak_presente = shutil.which("flatpak") is not None
        self.gnome_presente = paquete_instalado("gnome-shell")

        self._construir_cabecera()
        self._construir_cuerpo()
        self.connect("delete-event", self._al_cerrar)

    # -- Construcción ----------------------------------------------------------
    def _construir_cabecera(self):
        hb = Gtk.HeaderBar()
        hb.set_show_close_button(True)
        hb.set_title("AiO Debian")
        hb.set_subtitle("Mantenimiento y configuración del sistema")

        self.btn_iniciar = Gtk.Button(label="Iniciar tareas")
        self.btn_iniciar.get_style_context().add_class("suggested-action")
        self.btn_iniciar.connect("clicked", self._iniciar)
        hb.pack_start(self.btn_iniciar)

        btn_acerca = Gtk.Button.new_from_icon_name("help-about-symbolic", Gtk.IconSize.BUTTON)
        btn_acerca.set_tooltip_text("Acerca de AiO Debian")
        btn_acerca.connect("clicked", self._acerca_de)
        hb.pack_end(btn_acerca)
        self.set_titlebar(hb)

    def _construir_cuerpo(self):
        panel = Gtk.Paned(orientation=Gtk.Orientation.VERTICAL)
        self.add(panel)

        # --- Parte superior: información + opciones (con scroll)
        sup = Gtk.ScrolledWindow()
        sup.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for m in ("top", "bottom", "start", "end"):
            getattr(caja, "set_margin_" + m)(16)
        sup.add(caja)
        panel.pack1(sup, resize=True, shrink=False)

        caja.pack_start(self._tarjeta_info(), False, False, 0)
        caja.pack_start(self._tarjeta_opciones(), False, False, 0)

        # --- Parte inferior: progreso + registro
        inf = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for m in ("top", "bottom", "start", "end"):
            getattr(inf, "set_margin_" + m)(12)
        panel.pack2(inf, resize=True, shrink=False)

        fila = Gtk.Box(spacing=10)
        self.spinner = Gtk.Spinner()
        self.estado = etiqueta("Listo. Elige las tareas y pulsa «Iniciar tareas».")
        self.btn_cancelar = Gtk.Button(label="Cancelar espera")
        self.btn_cancelar.set_no_show_all(True)
        self.btn_cancelar.connect("clicked", self._cancelar_espera_autorizacion)
        fila.pack_start(self.spinner, False, False, 0)
        fila.pack_start(self.estado, True, True, 0)
        fila.pack_end(self.btn_cancelar, False, False, 0)
        inf.pack_start(fila, False, False, 0)

        self.barra = Gtk.ProgressBar()
        inf.pack_start(self.barra, False, False, 0)

        marco = Gtk.ScrolledWindow()
        marco.set_shadow_type(Gtk.ShadowType.IN)
        marco.set_min_content_height(140)
        self.log = Gtk.TextView(editable=False, cursor_visible=False)
        self.log.set_monospace(True)
        self.log.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.log.set_left_margin(8)
        self.log.set_right_margin(8)
        self.buf = self.log.get_buffer()
        self.buf.create_tag("ok", foreground="#26a269")
        self.buf.create_tag("aviso", foreground="#cd9309")
        self.buf.create_tag("error", foreground="#e01b24")
        self.buf.create_tag("info", foreground="#1c71d8")
        self.buf.create_tag("paso", weight=Pango.Weight.BOLD)
        marco.add(self.log)
        inf.pack_start(marco, True, True, 0)
        panel.set_position(470)

    def _tarjeta_info(self):
        marco = Gtk.Frame()
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        for m in ("top", "bottom", "start", "end"):
            getattr(caja, "set_margin_" + m)(12)
        marco.add(caja)

        caja.pack_start(etiqueta("<b>Información del sistema</b>", markup=True), False, False, 0)
        filas, version = informacion_sistema()
        contenido = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        grid = Gtk.Grid(column_spacing=18, row_spacing=4)
        for i, (clave, valor) in enumerate(filas):
            grid.attach(etiqueta(clave, dim=True), 0, i, 1, 1)
            v = etiqueta(valor)
            v.set_selectable(True)
            grid.attach(v, 1, i, 1, 1)
        contenido.pack_start(grid, True, True, 0)

        logo = Gtk.Image.new_from_file(DEBIAN_LOGO)
        logo.set_tooltip_text("Logotipo de Debian")
        logo.set_valign(Gtk.Align.CENTER)
        logo.get_accessible().set_name("Logotipo de Debian")
        contenido.pack_end(logo, False, False, 0)
        caja.pack_start(contenido, False, False, 0)

        nov = NOVEDADES.get(version)
        if nov:
            caja.pack_start(
                etiqueta("<b>Novedades de esta versión:</b> " + GLib.markup_escape_text(nov), markup=True),
                False, False, 4,
            )
        return marco

    def _tarjeta_opciones(self):
        externa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        cab = Gtk.Box(spacing=8)
        cab.pack_start(etiqueta("<b>Tareas a realizar</b>", markup=True), True, True, 0)
        presets = Gtk.Box()
        presets.get_style_context().add_class("linked")
        b1 = Gtk.Button(label="Completo")
        b1.set_tooltip_text("Mantenimiento completo (valores por defecto)")
        b1.connect("clicked", self._preset_completo)
        b2 = Gtk.Button(label="Solo Flatpak")
        b2.set_tooltip_text("Saltarse el mantenimiento de APT y actualizar solo Flatpak")
        b2.connect("clicked", self._preset_flatpak)
        presets.pack_start(b1, False, False, 0)
        presets.pack_start(b2, False, False, 0)
        self.botones_preset = (b1, b2)
        cab.pack_end(presets, False, False, 0)
        externa.pack_start(cab, False, False, 0)

        self.chk_sin_contrasena = Gtk.CheckButton(
            label="No pedir contraseña para las tareas de AiO (solo este usuario)"
        )
        self.chk_sin_contrasena.set_tooltip_text(
            "La activación requiere autorización de administrador una vez. "
            "Puedes desmarcar esta opción para revocarla."
        )
        self.chk_sin_contrasena.set_active(autorizacion_sin_contrasena_activa())
        self.chk_sin_contrasena.connect("toggled", self._cambiar_sin_contrasena)
        externa.pack_start(self.chk_sin_contrasena, False, False, 0)
        externa.pack_start(
            etiqueta("Permite ejecutar las tareas de AiO sin contraseña en la sesión local activa.", dim=True),
            False, False, 0,
        )

        for gid, gtitulo in GRUPOS:
            visibles = [p for p in PASOS if p[4] == gid and self._visible(p[0])]
            if not visibles:
                continue
            externa.pack_start(etiqueta(gtitulo, dim=True), False, False, 2)
            marco = Gtk.Frame()
            lista = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            marco.add(lista)
            for pid, titulo, desc, defecto, _ in visibles:
                lista.add(self._fila(pid, titulo, desc, defecto))
            externa.pack_start(marco, False, False, 0)
        return externa

    def _consultar_estados_tareas(self, inicial=False):
        if self.consultando_estados:
            return
        self.consultando_estados = True
        self.consulta_inicial = inicial
        self.salida_estados = []
        if inicial:
            self.estado.set_text("Comprobando tareas ya instaladas…")
        self._actualizar_sensibilidad()
        try:
            self.proceso_estados = Gio.Subprocess.new(
                ["bash", HELPER, "--status"],
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
        except GLib.Error as e:
            self._finalizar_consulta_estados(False, str(e.message))
            return
        self.flujo_estados = Gio.DataInputStream.new(self.proceso_estados.get_stdout_pipe())
        self._leer_linea_estado()

    def _leer_linea_estado(self):
        self.flujo_estados.read_line_async(
            GLib.PRIORITY_DEFAULT, None, self._linea_estado_leida
        )

    def _linea_estado_leida(self, flujo, res):
        try:
            r = flujo.read_line_finish_utf8(res)
            datos = r[0] if isinstance(r, tuple) else r
        except GLib.Error:
            datos = None
        if datos is None:
            self.proceso_estados.wait_async(None, self._estados_terminados)
            return
        self.salida_estados.append(datos)
        self._leer_linea_estado()

    def _estados_terminados(self, proceso, res):
        try:
            proceso.wait_finish(res)
            codigo = proceso.get_exit_status()
        except GLib.Error:
            codigo = -1
        estados = {}
        for linea in self.salida_estados:
            campos = linea.split(":")
            if (len(campos) == 3 and campos[0] == "##STATUS"
                    and campos[1] in (
                        "repos", "tools", "backports-kernel-mesa",
                        "gnome-plugin", "ext-manager",
                    )
                    and campos[2] in ("0", "1")):
                estados[campos[1]] = campos[2] == "1"
        requeridos = {
            "repos", "tools", "backports-kernel-mesa", "gnome-plugin", "ext-manager",
        }
        if codigo != 0 or set(estados) != requeridos:
            self._finalizar_consulta_estados(
                False, "El asistente no devolvió un estado completo de las tareas."
            )
            return

        self.estados_tareas = {pid for pid, completada in estados.items() if completada}
        etiquetas = {
            "repos": "✓ Ya configurados",
            "tools": "✓ Ya instaladas",
            "backports-kernel-mesa": "✓ Ya instalados",
            "gnome-plugin": "✓ Ya instalado",
            "ext-manager": "✓ Ya instalado",
        }
        for pid, completada in estados.items():
            indicador = self.indicadores[pid]
            if completada:
                indicador.set_markup(
                    "<span foreground='#26a269'><b>%s</b></span>" % etiquetas[pid]
                )
                indicador.set_tooltip_text(
                    "Esta tarea ya está completada y no se incluirá en futuras operaciones."
                )
                indicador.show()
                self.switches[pid][0].set_active(False)
            else:
                indicador.set_text("")
                indicador.set_tooltip_text(None)
                indicador.hide()
        self._finalizar_consulta_estados(True)

    def _finalizar_consulta_estados(self, correcta, detalle=""):
        inicial = self.consulta_inicial
        if not correcta:
            self.estados_tareas.clear()
            for indicador in self.indicadores.values():
                indicador.set_text("")
                indicador.set_tooltip_text(None)
                indicador.hide()
        self.consultando_estados = False
        self._actualizar_sensibilidad()
        if correcta:
            if inicial:
                self.estado.set_text("Listo. Elige las tareas y pulsa «Iniciar tareas».")
            return
        mensaje = "No se pudo comprobar el estado de las tareas; siguen disponibles."
        if detalle:
            mensaje += " " + detalle
        if inicial:
            self.estado.set_text(mensaje)
        self._escribir("[!] %s\n" % mensaje, "aviso")

    def _actualizar_sensibilidad(self):
        disponible = not self.en_curso and not self.consultando_estados
        self.btn_iniciar.set_sensitive(disponible)
        self.chk_sin_contrasena.set_sensitive(disponible)
        for boton in self.botones_preset:
            boton.set_sensitive(disponible)
        for pid, fila in self.filas.items():
            habilitada = disponible and pid not in self.estados_tareas
            fila.set_sensitive(habilitada)
            self.switches[pid][0].set_sensitive(habilitada)

    def _visible(self, pid):
        if pid == "flatpak-setup":
            return not self.flatpak_presente
        if pid in ("gnome-plugin", "ext-manager"):
            return self.gnome_presente
        return True

    def _fila(self, pid, titulo, desc, defecto):
        fila = Gtk.ListBoxRow(activatable=False)
        caja = Gtk.Box(spacing=12)
        for m in ("top", "bottom"):
            getattr(caja, "set_margin_" + m)(8)
        for m in ("start", "end"):
            getattr(caja, "set_margin_" + m)(12)
        textos = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        textos.pack_start(etiqueta(GLib.markup_escape_text(titulo), markup=True), False, False, 0)
        textos.pack_start(etiqueta(desc, dim=True), False, False, 0)
        indicador = Gtk.Label()
        indicador.set_no_show_all(True)
        sw = Gtk.Switch(active=defecto, valign=Gtk.Align.CENTER)
        caja.pack_start(textos, True, True, 0)
        caja.pack_end(indicador, False, False, 0)
        caja.pack_end(sw, False, False, 0)
        fila.add(caja)
        self.switches[pid] = (sw, defecto)
        self.filas[pid] = fila
        self.indicadores[pid] = indicador
        return fila

    # -- Presets ---------------------------------------------------------------
    def _preset_completo(self, _b):
        for pid, (sw, defecto) in self.switches.items():
            sw.set_active(defecto and pid not in self.estados_tareas)

    def _preset_flatpak(self, _b):
        for pid, (sw, _d) in self.switches.items():
            if pid in ("clock", "repos", "tools", "upgrade", "autoremove", "autoclean", "rebootcheck"):
                sw.set_active(False)
            elif pid == "flatpak-update" and pid not in self.estados_tareas:
                sw.set_active(True)

    # -- Ejecución ---------------------------------------------------------------
    def _pasos_seleccionados(self):
        sel = [
            p[0] for p in PASOS
            if p[0] in self.switches
            and p[0] not in self.estados_tareas
            and self.switches[p[0]][0].get_active()
        ]
        # La instalación/actualización de Flatpak no tiene sentido sin soporte Flatpak
        return sel

    def _iniciar(self, _b):
        pasos = self._pasos_seleccionados()
        if not pasos:
            self._mensaje(Gtk.MessageType.INFO, "Nada que hacer", "Activa al menos una tarea.")
            return
        helper = helper_mantenimiento()
        if not os.path.exists(helper):
            self._mensaje(Gtk.MessageType.ERROR, "Falta el asistente",
                          "No se encuentra %s.\nReinstala el paquete aio-debian-gui." % helper)
            return

        if ("backports-kernel-mesa" in pasos and
                not helper_admite_tarea(helper, "backports-kernel-mesa")):
            self._mensaje(
                Gtk.MessageType.ERROR, "Asistente del sistema desactualizado",
                "El asistente instalado no incluye la tarea de Backports. "
                "Actualiza el paquete .deb a la versión 1.0.7 o posterior.",
            )
            return

        if "backports-kernel-mesa" in pasos:
            d = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.OK_CANCEL,
                text="¿Instalar el kernel y Mesa desde Debian Backports?",
            )
            d.format_secondary_text(
                "Se instalará el kernel de Backports para esta arquitectura y los controladores "
                "Mesa disponibles. Esto puede actualizar componentes gráficos y requerir un "
                "reinicio. Si falta, se añadirá la fuente oficial de Debian Backports."
            )
            confirmar = d.run() == Gtk.ResponseType.OK
            d.destroy()
            if not confirmar:
                self.switches["backports-kernel-mesa"][0].set_active(False)
                self.estado.set_text("Instalación desde Backports cancelada.")
                return

        lang = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "C"
        cmd = ["pkexec", helper, "--lang", lang] + pasos

        self.buf.set_text("")
        self.necesita_reinicio = False
        self.hubo_errores = False
        self.fin_recibido = False
        self.terminado_gestionado = False
        self.cancelacion_autorizacion = None
        self.total_pasos = len(pasos)
        self._poner_ocupado(True)
        self.estado.set_text("Esperando autenticación de administrador…")
        self._escribir("[*] Solicitando autorización de administrador…\n", "info")
        self._escribir(
            "[*] Si no aparece el diálogo, cancela la espera y comprueba el agente de Polkit.\n",
            "info",
        )
        self.barra.set_fraction(0)
        self.barra.set_text("")
        self.barra.set_show_text(False)

        try:
            self.proceso = Gio.Subprocess.new(
                cmd, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE
            )
        except GLib.Error as e:
            self._poner_ocupado(False)
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo iniciar", str(e.message))
            return

        self.flujo = Gio.DataInputStream.new(self.proceso.get_stdout_pipe())
        self._iniciar_espera_autorizacion()
        self._leer_linea()

    def _cambiar_sin_contrasena(self, boton):
        if self.actualizando_sin_contrasena:
            return

        habilitar = boton.get_active()
        helper = helper_mantenimiento()
        if not os.path.exists(helper):
            self._restablecer_opcion_sin_contrasena(autorizacion_sin_contrasena_activa())
            self._mensaje(Gtk.MessageType.ERROR, "Falta el asistente",
                          "No se encuentra %s.\nReinstala el paquete aio-debian-gui." % helper)
            return

        if not helper_admite_autorizacion_sin_contrasena(helper):
            self._restablecer_opcion_sin_contrasena(autorizacion_sin_contrasena_activa())
            self._mensaje(
                Gtk.MessageType.ERROR, "Función no disponible en el asistente instalado",
                "El asistente del sistema no incluye la autorización sin contraseña. "
                "Actualiza el paquete .deb a la versión 1.0.6 o posterior.",
            )
            return

        if habilitar:
            d = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.OK_CANCEL, text="Permitir tareas sin contraseña?",
            )
            d.format_secondary_text(
                "Se instalará una autorización persistente de Polkit para este usuario y "
                "solo para AiO Debian GUI. Todas las tareas de mantenimiento podrán ejecutarse "
                "como administrador sin volver a pedir contraseña. La activación requiere "
                "autorización de administrador una vez; puedes desactivarla desde esta opción."
            )
            confirmar = d.run() == Gtk.ResponseType.OK
            d.destroy()
            if not confirmar:
                self._restablecer_opcion_sin_contrasena(False)
                return

        accion = "--enable-passwordless" if habilitar else "--disable-passwordless"
        lang = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "C"
        self.configurando_sin_contrasena = habilitar
        self.terminado_gestionado = False
        self.cancelacion_autorizacion = None
        self._poner_ocupado(True)
        self.buf.set_text("")
        self.estado.set_text("Esperando autorización de administrador…")
        self._escribir("[*] Solicitando autorización de administrador…\n", "info")
        self.barra.set_fraction(0)
        self.barra.set_show_text(False)

        try:
            self.proceso = Gio.Subprocess.new(
                ["pkexec", helper, "--lang", lang, accion],
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE,
            )
        except GLib.Error as e:
            self.configurando_sin_contrasena = None
            self._poner_ocupado(False)
            self._restablecer_opcion_sin_contrasena(autorizacion_sin_contrasena_activa())
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo iniciar", str(e.message))
            return

        self.flujo = Gio.DataInputStream.new(self.proceso.get_stdout_pipe())
        self._iniciar_espera_autorizacion()
        self._leer_linea()

    def _restablecer_opcion_sin_contrasena(self, activa):
        self.actualizando_sin_contrasena = True
        self.chk_sin_contrasena.set_active(activa)
        self.actualizando_sin_contrasena = False

    def _poner_ocupado(self, ocupado):
        self.en_curso = ocupado
        self.btn_iniciar.set_label("Trabajando…" if ocupado else "Iniciar tareas")
        self._actualizar_sensibilidad()
        if ocupado:
            self.spinner.start()
        else:
            self.spinner.stop()

    def _iniciar_espera_autorizacion(self):
        self.esperando_autorizacion = True
        self.btn_cancelar.show()
        self.timeout_autorizacion_id = GLib.timeout_add_seconds(
            90, self._agotamiento_autorizacion
        )

    def _finalizar_espera_autorizacion(self):
        self.esperando_autorizacion = False
        self.btn_cancelar.hide()
        if self.timeout_autorizacion_id is not None:
            GLib.source_remove(self.timeout_autorizacion_id)
            self.timeout_autorizacion_id = None

    def _cancelar_espera_autorizacion(self, _boton=None, agotada=False):
        if not self.esperando_autorizacion or self.proceso is None:
            return
        self.cancelacion_autorizacion = "agotada" if agotada else "cancelada"
        self._finalizar_espera_autorizacion()
        self.estado.set_text("Cancelando la espera de autorización…")
        self._escribir(
            "[-] Se canceló la espera de autorización de administrador.\n", "error"
        )
        self.proceso.force_exit()

    def _agotamiento_autorizacion(self):
        self.timeout_autorizacion_id = None
        self._cancelar_espera_autorizacion(agotada=True)
        return GLib.SOURCE_REMOVE

    def _leer_linea(self):
        self.flujo.read_line_async(GLib.PRIORITY_DEFAULT, None, self._linea_leida)

    def _linea_leida(self, flujo, res):
        try:
            r = flujo.read_line_finish_utf8(res)
            datos = r[0] if isinstance(r, tuple) else r
        except GLib.Error:
            datos = None
        if datos is None:
            self._finalizar_espera_autorizacion()
            self.proceso.wait_async(None, self._proceso_terminado)
            return
        self._finalizar_espera_autorizacion()
        texto = datos
        # apt/flatpak pueden usar \r para repintar: nos quedamos con el último trozo
        texto = ANSI.sub("", texto.split("\r")[-1]).rstrip()
        self._procesar(texto)
        if self.fin_recibido:
            self.proceso.wait_async(None, self._proceso_terminado)
            return
        self._leer_linea()

    def _procesar(self, linea):
        if linea.startswith("##STEP:"):
            _, n, total, titulo = linea.split(":", 3)
            n, total = int(n), int(total)
            self.barra.set_show_text(True)
            self.barra.set_fraction((n - 1) / total)
            self.barra.set_text("Paso %d de %d" % (n, total))
            self.estado.set_text("%s…" % titulo)
            self._escribir("\n▶ %s\n" % titulo, "paso")
            return
        if linea.startswith("##REBOOT:"):
            self.necesita_reinicio = linea.endswith(":1")
            return
        if linea.startswith("##DONE:"):
            self.hubo_errores = linea.endswith(":1")
            self.fin_recibido = True
            return

        tag = None
        if linea.startswith("[✔]"):
            tag = "ok"
        elif linea.startswith("[!]"):
            tag = "aviso"
        elif linea.startswith("[-]"):
            tag = "error"
        elif linea.startswith("[*]"):
            tag = "info"
        self._escribir(linea + "\n", tag)

    def _escribir(self, texto, tag=None):
        fin = self.buf.get_end_iter()
        if tag:
            self.buf.insert_with_tags_by_name(fin, texto, tag)
        else:
            self.buf.insert(fin, texto)
        marca = self.buf.create_mark(None, self.buf.get_end_iter(), False)
        self.log.scroll_to_mark(marca, 0.0, False, 0, 0)
        self.buf.delete_mark(marca)

    def _proceso_terminado(self, proc, res):
        if self.terminado_gestionado:
            return
        self.terminado_gestionado = True
        self._finalizar_espera_autorizacion()
        cancelacion = self.cancelacion_autorizacion
        self.cancelacion_autorizacion = None
        try:
            proc.wait_finish(res)
            codigo = proc.get_exit_status() if proc.get_if_exited() else -1
        except GLib.Error:
            codigo = -1

        if self.configurando_sin_contrasena is not None:
            deseada = self.configurando_sin_contrasena
            self.configurando_sin_contrasena = None
            self._poner_ocupado(False)
            activa = autorizacion_sin_contrasena_activa()
            self._restablecer_opcion_sin_contrasena(activa)
            if cancelacion:
                self.estado.set_text(
                    "Espera de autorización agotada."
                    if cancelacion == "agotada" else "Espera de autorización cancelada."
                )
                self._escribir(
                    "[-] No se cambió la preferencia de autorización.\n", "error"
                )
            elif codigo == 0 and activa == deseada:
                self.estado.set_text(
                    "Autorización sin contraseña activada."
                    if activa else "Autorización sin contraseña desactivada."
                )
                self._escribir(
                    "[✔] Preferencia de autorización actualizada.\n", "ok"
                )
            elif codigo in (126, 127):
                self.estado.set_text("No se cambió la autorización.")
                self._escribir(
                    "[-] Autorización cancelada o denegada; no se cambió la preferencia.\n",
                    "error",
                )
            else:
                self.estado.set_text("No se pudo cambiar la autorización.")
                self._escribir(
                    "[-] No se pudo actualizar la preferencia de autorización (código %s).\n"
                    % codigo,
                    "error",
                )
            return

        self._poner_ocupado(False)
        self.barra.set_show_text(False)

        if cancelacion:
            self.estado.set_text(
                "Espera de autorización agotada."
                if cancelacion == "agotada" else "Espera de autorización cancelada."
            )
            self._escribir(
                "[-] No se ejecutó ninguna tarea. Comprueba el agente de autenticación de Polkit.\n",
                "error",
            )
            return
        if codigo == 0 and self.fin_recibido and not self.hubo_errores:
            self.barra.set_fraction(1.0)
            self.estado.set_text("✔ ¡Mantenimiento completado con éxito!")
            self._escribir("\n==================================================\n"
                           "  [✔] ¡Mantenimiento completado con éxito!\n"
                           "==================================================\n"
                           "         ❤️ Made by JULIO AYUSO\n", "ok")
        elif codigo in (126, 127) and self.barra.get_fraction() == 0:
            self.estado.set_text("No se obtuvo autorización de administrador.")
            self._escribir("[-] Autenticación cancelada o denegada. No se ha hecho ningún cambio.\n", "error")
            return
        else:
            self.estado.set_text("Terminó con errores. Revisa el registro.")
            self._escribir("\n[-] El proceso terminó con errores (código %s).\n" % codigo, "error")

        if self.necesita_reinicio:
            self._preguntar_reinicio()
        self._consultar_estados_tareas()

    def _preguntar_reinicio(self):
        d = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE,
            text="¿Reiniciar el sistema ahora?",
        )
        d.format_secondary_text("Se recomienda reiniciar para aplicar los cambios críticos (kernel/servicios).")
        d.add_button("Más tarde", Gtk.ResponseType.NO)
        d.add_button("Reiniciar ahora", Gtk.ResponseType.YES)
        d.set_default_response(Gtk.ResponseType.NO)
        r = d.run()
        d.destroy()
        if r == Gtk.ResponseType.YES:
            self._escribir("[*] Reiniciando el sistema...\n", "info")
            try:
                subprocess.Popen(["systemctl", "reboot"])
            except OSError as e:
                self._mensaje(Gtk.MessageType.ERROR, "No se pudo reiniciar", str(e))
        else:
            self._escribir("[*] Reinicio omitido. Recuerda reiniciar más tarde.\n", "info")

    # -- Varios ----------------------------------------------------------------
    def _mensaje(self, tipo, titulo, texto):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=tipo,
                              buttons=Gtk.ButtonsType.OK, text=titulo)
        d.format_secondary_text(texto)
        d.run()
        d.destroy()

    def _acerca_de(self, _b):
        d = Gtk.AboutDialog(transient_for=self, modal=True)
        d.set_program_name("AiO Debian GUI")
        d.set_version(version_app())
        d.set_comments("Mantenimiento y configuración todo en uno para Debian")
        d.set_website(HOMEPAGE)
        d.set_copyright("© 2026 Julio Ayuso")
        d.set_license_type(Gtk.License.GPL_3_0)
        d.set_logo_icon_name("aio-debian-gui")
        d.run()
        d.destroy()

    def _al_cerrar(self, *_a):
        if not self.en_curso:
            return False
        self._mensaje(
            Gtk.MessageType.WARNING, "Mantenimiento en curso",
            "Espera a que termine: interrumpir apt o dpkg a mitad puede dejar el sistema "
            "en un estado inconsistente.",
        )
        return True  # impide cerrar


def main():
    GLib.set_prgname(PRGNAME)
    GLib.set_application_name("AiO Debian")
    if os.geteuid() == 0:
        print("Ejecuta aio-debian-gui como usuario normal (pedirá la contraseña cuando haga falta).",
              file=sys.stderr)
        sys.exit(1)
    win = VentanaPrincipal()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win._consultar_estados_tareas(inicial=True)
    Gtk.main()


if __name__ == "__main__":
    main()
