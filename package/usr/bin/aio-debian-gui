        self.pagina_terminal.pack_start(consola, True, True, 0)
        notebook.append_page(self.pagina_terminal, Gtk.Label(label=traducir("Terminal")))
        notebook.connect("switch-page", self._cambiar_pestana_terminal)
        notebook.append_page(self._pagina_inicio(), Gtk.Label(label=traducir("Inicio")))
        paneles = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
