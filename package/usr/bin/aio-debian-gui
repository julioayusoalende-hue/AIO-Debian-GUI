     "apt-get update y apt-get dist-upgrade.", True, "apt"),
    ("autoremove", "Eliminar dependencias huérfanas",
     "apt-get autoremove.", True, "apt"),
    ("autoclean", "Limpiar la caché de paquetes obsoletos",
     "apt-get autoclean.", True, "apt"),
