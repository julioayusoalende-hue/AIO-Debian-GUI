class MonitorTemaSistema:
    """Observa el portal de apariencia y, como respaldo, GNOME/tema GTK."""

    def __init__(self):
        self.modo = "sistema"
        self.portal = None
        self.gnome = None
        self.gtk = Gtk.Settings.get_default()
        self._creando = True
        try:
            self.portal = Gio.DBusProxy.new_for_bus_sync(
                Gio.BusType.SESSION, Gio.DBusProxyFlags.DO_NOT_AUTO_START,
                None, "org.freedesktop.portal.Desktop",
                "/org/freedesktop/portal/desktop",
                "org.freedesktop.portal.Settings", None,
            )
            if self.portal.get_name_owner():
                self.portal.connect("g-signal", self._cambio_portal)
            else:
                self.portal = None
        except GLib.Error:
            self.portal = None
        schema = Gio.SettingsSchemaSource.get_default()
        if schema and schema.lookup("org.gnome.desktop.interface", True):
            try:
                self.gnome = Gio.Settings.new("org.gnome.desktop.interface")
                self.gnome.connect("changed::color-scheme", self._cambio_sistema)
            except GLib.Error:
                self.gnome = None
        if self.gtk is not None:
            self.gtk.connect("notify::gtk-theme-name", self._cambio_sistema)
        self._creando = False

    @staticmethod
    def _valor_portal(variant):
        # Read devuelve (v) y el propio valor puede llegar envuelto otra vez.
        while isinstance(variant, GLib.Variant):
            variant = variant.unpack()
            if isinstance(variant, tuple) and len(variant) == 1:
                variant = variant[0]
        return core_appearance.preferencia_portal(variant)

    def _tema_detectado(self):
        if self.portal is not None:
            try:
                dato = self.portal.call_sync(
                    "Read", GLib.Variant(
                        "(ss)", ("org.freedesktop.appearance", "color-scheme")
                    ), Gio.DBusCallFlags.NONE, 1500, None,
                )
                tema = self._valor_portal(dato)
                if tema:
                    return tema
            except (GLib.Error, TypeError, ValueError):
                pass
        if self.gnome is not None:
            tema = core_appearance.preferencia_gnome(
                self.gnome.get_string("color-scheme")
            )
            if tema:
                return tema
        if self.gtk is not None:
            return core_appearance.tema_de_nombre(
                self.gtk.get_property("gtk-theme-name")
            )
        return "claro"

    def _aplicar(self):
        if self.gtk is not None:
            tema = self._tema_detectado() if self.modo == "sistema" else self.modo
            self.gtk.set_property(
                "gtk-application-prefer-dark-theme", tema == "oscuro"
            )

    def _cambio_sistema(self, *_args):
        if not self._creando and self.modo == "sistema":
            self._aplicar()

    def _cambio_portal(self, _proxy, _sender, nombre, parametros):
        if nombre == "SettingChanged" and self.modo == "sistema":
            try:
                espacio, clave, _valor = parametros.unpack()
                if espacio == "org.freedesktop.appearance" and clave == "color-scheme":
                    self._aplicar()
            except (TypeError, ValueError):
                pass

    def cambiar_modo(self, modo):
        self.modo = modo
        self._aplicar()


_monitor_tema = None


def aplicar_tema(tema):
    global _monitor_tema
    if _monitor_tema is None:
        _monitor_tema = MonitorTemaSistema()
    _monitor_tema.cambiar_modo(tema)


# ------------------------------------------------------------------------------
# Información del sistema (no necesita privilegios)
# ------------------------------------------------------------------------------
def es_flatpak():
    return bool(os.environ.get("FLATPAK_ID"))


def comando_host(*argumentos):
    if es_flatpak():
        return ["flatpak-spawn", "--host", *argumentos]
    return list(argumentos)


def leer_texto(ruta):
    if es_flatpak():
        try:
            resultado = subprocess.run(
                comando_host("cat", ruta), capture_output=True, text=True, timeout=10
            )
            return resultado.stdout if resultado.returncode == 0 else None
        except (OSError, subprocess.SubprocessError):
            return None
    try:
        with open(ruta, encoding="utf-8") as archivo:
            return archivo.read()
    except OSError:
        return None


def paquete_instalado(nombre):
    try:
        out = subprocess.run(
            comando_host("dpkg-query", "-W", "-f=${Status}", nombre),
            capture_output=True, text=True, timeout=10,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return "install ok installed" in out


def version_app():
    if os.environ.get("SNAP_VERSION"):
        return os.environ["SNAP_VERSION"]
    version = os.environ.get("AIO_DEBIAN_GUI_VERSION")
    if version:
        return version
    try:
        out = subprocess.run(
            comando_host("dpkg-query", "-W", "-f=${Status}|${Version}", "aio-debian-gui"),
            capture_output=True, text=True, timeout=10,
        ).stdout
        estado, _, version = out.partition("|")
        if "install ok installed" in estado and version:
            return version
    except (OSError, subprocess.SubprocessError):
        pass
    return "desarrollo (no instalado desde paquete)"



# Los AppImage se descargan como archivo nuevo, sin sustituir el ejecutable activo.
# El Flatpak siempre se actualiza desde su repositorio firmado en el anfitrión.
APP_ID_FLATPAK = "io.github.julioayusoalende_hue.aio_debian_gui"
RELEASE_API = HOMEPAGE.replace("https://github.com/", "https://api.github.com/repos/") + "/releases/latest"
MAX_APPIMAGE_SIZE = 256 * 1024 * 1024


def formato_actualizacion():
    if os.environ.get("SNAP"):
        return "snap"
    if es_flatpak():
        return "flatpak"
    if os.environ.get("APPDIR"):
        return "appimage"
    # El paquete DEB instala el ejecutable exactamente en /usr/bin.
    # No etiquetar como DEB una ejecución desde el código fuente.
    if os.path.realpath(__file__) == "/usr/bin/aio-debian-gui":
        return "deb"
    return None


def version_numerica(version):
    return core_updates.version_numerica(version)

def obtener_release_actualizacion():
    return core_updates.obtener_release_actualizacion()

def descargar_appimage_verificado(version, nombre, url, url_hash):
    destino = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD)
    return core_updates.descargar_appimage_verificado(
        version, nombre, url, url_hash, directorio_descargas=destino,
    )

def distribucion_anfitrion():
    """Identifica Debian y Ubuntu LTS mediante /etc/os-release del anfitrión."""
    contenido = leer_texto("/etc/os-release")
    valores = {}
    for linea in (contenido or "").splitlines():
        if "=" in linea and not linea.startswith("#"):
            clave, valor = linea.split("=", 1)
            if clave in ("ID", "VERSION_ID"):
                valores[clave] = valor.strip().strip('"').strip("'")
    if valores.get("ID") == "debian":
        return "debian"
    if valores.get("ID") == "ubuntu" and valores.get("VERSION_ID") in ("24.04", "26.04"):
        return "ubuntu"
    return "no-soportada"


def sistema_operativo():
    contenido = leer_texto("/etc/os-release")
    if contenido:
        for linea in contenido.splitlines():
            if linea.startswith("PRETTY_NAME="):
                return linea.split("=", 1)[1].strip().strip('"')
    return "Debian GNU/Linux"


def _ejecutar(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def helper_mantenimiento():
    global _helper_appimage_temporal
    # Snap no instala un asistente de root fuera del propio snap.
    # Reutilizar exclusivamente el asistente del anfitrión autorizado por Polkit.
    if os.environ.get("SNAP"):
        return HELPER_SISTEMA
    # El Flatpak es solo la interfaz: las operaciones administrativas se delegan
    # al asistente instalado en el Debian anfitrión por el paquete .deb.
    if es_flatpak():
        return HELPER_SISTEMA
    if os.environ.get("APPDIR") and os.path.isfile(HELPER_SISTEMA):
        return HELPER_SISTEMA
    if os.environ.get("APPDIR"):
        if _helper_appimage_temporal and os.path.isfile(_helper_appimage_temporal):
            return _helper_appimage_temporal
        directorio = tempfile.TemporaryDirectory(
            prefix="aio-debian-gui-", dir="/tmp"
        )
        _directorios_helper_appimage.append(directorio)
        raiz = directorio.name
        ruta_helper = os.path.join(
            raiz, "usr", "lib", "aio-debian-gui", "aio-debian-gui-helper"
        )
        ruta_politica = os.path.join(
            raiz, "usr", "share", "polkit-1", "actions",
            "es.aiodebian.gui.policy",
        )
        os.makedirs(os.path.dirname(ruta_helper), mode=0o755, exist_ok=True)
        os.makedirs(os.path.dirname(ruta_politica), mode=0o755, exist_ok=True)
        origen_politica = os.path.normpath(
            os.path.join(
                os.path.dirname(HELPER),
                "../../share/polkit-1/actions/es.aiodebian.gui.policy",
            )
        )
        shutil.copyfile(HELPER, ruta_helper)
        os.chmod(ruta_helper, 0o755)
        shutil.copyfile(origen_politica, ruta_politica)
        _helper_appimage_temporal = ruta_helper
        return ruta_helper
    return HELPER


_directorios_helper_appimage = []
_helper_appimage_temporal = None


def helper_disponible(ruta):
    if es_flatpak():
        try:
            return subprocess.run(
                comando_host("test", "-x", ruta),
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10,
            ).returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False
    return os.path.isfile(ruta)


def comando_pkexec(helper, lang, *argumentos):
    if es_flatpak():
        return ["flatpak-spawn", "--host", "pkexec", helper, "--lang", lang, *argumentos]
    if os.environ.get("APPDIR") and helper != HELPER_SISTEMA:
        return ["pkexec", "/bin/bash", helper, "--lang", lang, *argumentos]
    return ["pkexec", helper, "--lang", lang, *argumentos]


def helper_admite_autorizacion_sin_contrasena(ruta):
    contenido = leer_texto(ruta)
    if contenido is None:
        return False
    return (
        "--enable-passwordless" in contenido
        and "--disable-passwordless" in contenido
    )


def helper_admite_tarea(ruta, tarea):
    contenido = leer_texto(ruta)
    return contenido is not None and "[%s]=" % tarea in contenido


def autorizacion_sin_contrasena_activa():
    uid = os.getuid()
    rule_path = "/etc/polkit-1/rules.d/50-aiodebian-gui-%s.rules" % uid
    try:
        username = pwd.getpwuid(uid).pw_name
        contenido = leer_texto(rule_path)
    except (OSError, KeyError):
        return False
    if contenido is None:
        return False
    return (
        ('action.id === "%s"' % POLKIT_ACTION) in contenido
        and ('action.lookup("program") === "%s"' % HELPER_SISTEMA) in contenido
        and ("subject.user === %s" % json.dumps(username)) in contenido
        and "subject.local" in contenido
        and "subject.active" in contenido
    )


def fecha_instalacion():
    """De más a menos fiable. Devuelve datetime.date o None."""
    # El root del sandbox no es el sistema de archivos raíz del anfitrión.
    if es_flatpak():
        return None
    candidatos = []

    # 1) Creación del sistema de archivos raíz (solo si se puede leer sin root)
    dispositivo = _ejecutar(["findmnt", "-no", "SOURCE", "/"])
    if dispositivo and shutil.which("tune2fs"):
        for linea in _ejecutar(["tune2fs", "-l", dispositivo]).splitlines():
            if linea.lower().startswith("filesystem created"):
                candidatos.append(linea.split(":", 1)[1].strip())
    # 2) Fecha de nacimiento de / si el sistema de archivos la soporta
    nacimiento = _ejecutar(["stat", "-c", "%w", "/"])
    if nacimiento and nacimiento != "-":
        candidatos.append(nacimiento.split(" ")[0])
    # 3) El instalador de Debian deja aquí su rastro
    for ruta in ("/var/log/installer", "/lost+found"):
        try:
            candidatos.append(
                datetime.datetime.fromtimestamp(os.stat(ruta).st_mtime).strftime("%Y-%m-%d")
            )
        except OSError:
            pass

    for c in candidatos:
        # Aceptar "2024-03-05" o el formato largo de tune2fs ("Tue Mar  5 10:00:00 2024")
        for fmt in ("%Y-%m-%d", "%a %b %d %H:%M:%S %Y"):
            try:
                return datetime.datetime.strptime(" ".join(c.split()), fmt).date()
            except ValueError:
                continue
    return None


def antiguedad(desde, hoy):
    anios = hoy.year - desde.year
    meses = hoy.month - desde.month
    dias = hoy.day - desde.day
    if dias < 0:
        mes_ant = hoy.month - 1 or 12
        anio_ant = hoy.year if hoy.month > 1 else hoy.year - 1
        dias += calendar.monthrange(anio_ant, mes_ant)[1]
        meses -= 1
    if meses < 0:
        meses += 12
        anios -= 1
    return anios, meses, dias


def informacion_sistema():
    filas = [
        ("Sistema operativo", sistema_operativo()),
        ("Kernel actual", os.uname().release),
    ]
    try:
        du = shutil.disk_usage("/")
        gib = 1024 ** 3
        filas.append((
            "Espacio en disco (/)",
            traducir("Usado: %.1f GiB / Total: %.1f GiB (%d%% ocupado)")
            % (du.used / gib, du.total / gib, round(du.used * 100 / du.total)),
        ))
    except OSError:
        pass

    fecha = fecha_instalacion()
    if fecha:
        hoy = datetime.date.today()
        a, m, d = antiguedad(fecha, hoy)
        total = (hoy - fecha).days
        filas.append(("Fecha de instalación", fecha.isoformat()))
        filas.append((
            "Antigüedad del sistema",
            traducir("%d años, %d meses y %d días (%d días en total)")
            % (a, m, d, total),
        ))

    version = version_app()
    filas.append(("Versión de AiO Debian GUI", version))
    return filas, version


