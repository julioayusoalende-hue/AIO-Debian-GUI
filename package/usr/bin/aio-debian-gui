def cabecera_mantenimiento(texto, icono, clase="aio-heading"):
    cabecera = Gtk.Box(spacing=9)
    imagen = Gtk.Image.new_from_icon_name(icono, Gtk.IconSize.BUTTON)
    imagen.get_style_context().add_class("aio-icon")
    cabecera.pack_start(imagen, False, False, 0)
    titulo = etiqueta(texto)
    titulo.get_style_context().add_class(clase)
    cabecera.pack_start(titulo, True, True, 0)
    return cabecera


def tarjeta_mantenimiento(espacio):
    marco = Gtk.Frame()
    marco.get_style_context().add_class("aio-card")
    contenido = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=espacio)
    contenido.set_border_width(14)
    marco.add(contenido)
    return marco, contenido


class VentanaPrincipal(Gtk.Window):
    def _contexto_programacion(self):
        return {
            "traducir": traducir, "etiqueta": etiqueta, "pasos": PASOS,
            "formato": formato_actualizacion, "comando_host": comando_host,
            "comando_pkexec": comando_pkexec, "helper": HELPER_SISTEMA,
        }

    def __init__(self, preferencias=None):
        super().__init__(title="AiO Debian")
        self.preferencias = (preferencias or PREFERENCIAS_DEFECTO).copy()
        self.handler_cierre = None
        self.destruida = False
        self.connect("destroy", self._ventana_destruida)
        global IDIOMA_ACTUAL
        IDIOMA_ACTUAL = self.preferencias["idioma"]
        self.set_default_size(1160, 780)
        self.set_icon_name("aio-debian-gui")

        self.en_curso = False
        self.proceso = None
        self.flujo = None
        self.necesita_reinicio = False
        self.hubo_errores = False
        self.fin_recibido = False
        self.terminado_gestionado = False
        self.configurando_sin_contrasena = None
        self.actualizando_sin_contrasena = False
        self.esperando_autorizacion = False
        self.cancelacion_autorizacion = None
        self.timeout_autorizacion_id = None
        self.consultando_estados = False
        self.timeout_estados_id = None
        self.estados_tareas = set()
        self.nvidia_presente = False
        self.nvidia_hibrida = False
        self.nvidia_instalada = False
        self.nvidia_candidata = "no-disponible"
        self.nvidia_secureboot = "desconocido"
        self.salida_estados = []
        self.comprobando_actualizacion = False
        self.backup_action_in_progress = False
        self.grub_action_in_progress = False
        self.grub_estado = None
        self.backup_buttons = {}
        self.recommended_scan_generation = 0
        self.terminal_started = False
        self.ventana_terminal = None
        self.ventana_btop = None
        self.programando = False
        self.programacion = ControladorProgramacion(self)
        self.diagnostico_en_curso = False
        self.ventana_diagnostico = None
        self.btn_actualizar_diagnostico = None
        self.tareas_en_ejecucion = []
        self.actualizando_preset = False
        self.switches = {}
        self.filas = {}
        self.indicadores = {}
        self.resultados_tareas = {}
        self.estado_diagnostico = "No comprobado"

        self.distribucion = distribucion_anfitrion()
        self.canales_recomendados = {app["id"]: app["channels"] for app in APPS_RECOMENDADAS}
        self.datos_anfitrion = datos_distribucion_anfitrion()
        self.canales_recomendados["ghostty"] = canales_ghostty(self.datos_anfitrion)
        self.snapd_presente = paquete_instalado("snapd")
        self.flatpak_presente = es_flatpak() or shutil.which("flatpak") is not None
        self.gnome_presente = paquete_instalado("gnome-shell")

        self._construir_cabecera()
        self._construir_cuerpo()
        self._actualizar_sensibilidad()
        self.connect("key-press-event", self._al_pulsar_tecla)
        self.connect("delete-event", self._al_cerrar)
        self.connect("focus-in-event", self._refrescar_recomendadas_al_volver)
    def _preparar_anfitrion_al_iniciar(self):
        formato = formato_actualizacion()
        if formato not in ("flatpak", "appimage") or self.distribucion == "no-soportada":
            self._consultar_estados_tareas(inicial=True)
            return
        self.programando = True
        self.estado.set_text(traducir("Preparando el mantenimiento del sistema…"))
        self._actualizar_sensibilidad()
        version = version_app()

        def preparar():
            try:
                core_host_integration.prepare_host(formato, version)
                error = None
            except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
                error = str(exc)
            GLib.idle_add(self._anfitrion_preparado, error)

        threading.Thread(target=preparar, daemon=True).start()

    def _ventana_destruida(self, _ventana):
        self.destruida = True
        if self.ventana_btop is not None:
            self.ventana_btop.destroy()
        if self.ventana_terminal is not None:
            self.ventana_terminal.destroy()
            self.ventana_terminal = None

    def _anfitrion_preparado(self, error):
        if self.destruida:
            return GLib.SOURCE_REMOVE
        self.programando = False
        self._actualizar_sensibilidad()
        if error:
            self._escribir("[!] %s %s\n" % (
                traducir("No se pudo preparar la integración del anfitrión."), error,
            ), "aviso")
        self._consultar_estados_tareas(inicial=True)
        return GLib.SOURCE_REMOVE

    # -- Construcción ----------------------------------------------------------
    def _construir_cabecera(self):
        hb = Gtk.HeaderBar()
        hb.set_show_close_button(True)
        formato = formato_actualizacion()
        hb.set_custom_title(self._titulo_cabecera())

        self.btn_menu = Gtk.MenuButton()
        self.btn_menu.add(Gtk.Image.new_from_icon_name(
            "open-menu-symbolic", Gtk.IconSize.BUTTON))
        self.btn_menu.set_tooltip_text(traducir("Menú de preferencias"))
        popover = Gtk.Popover.new(self.btn_menu)
        menu = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        menu.set_margin_top(8)
        menu.set_margin_bottom(8)
        menu.set_margin_start(8)
        menu.set_margin_end(8)

        self.btn_preferencias_menu = Gtk.Button(label=traducir("Preferencias"))
        self.btn_preferencias_menu.connect("clicked", self._abrir_preferencias)
        menu.pack_start(self.btn_preferencias_menu, False, False, 0)

        btn_historial = Gtk.Button(label=traducir("Historial de mantenimiento"))
        btn_historial.connect("clicked", self._mostrar_historial)
        menu.pack_start(btn_historial, False, False, 0)

        self.btn_programar = Gtk.Button(label=traducir("Programar mantenimiento"))
        self.btn_programar.connect("clicked", self._abrir_programacion)
        menu.pack_start(self.btn_programar, False, False, 0)

        if formato in ("flatpak", "appimage"):
            btn_integracion = Gtk.Button(label=traducir("Guía de integración del anfitrión"))
            btn_integracion.connect("clicked", self._abrir_guia_integracion)
            menu.pack_start(btn_integracion, False, False, 0)

        self.btn_actualizar = Gtk.Button(label=traducir("Buscar actualizaciones"))
        self.btn_actualizar.set_tooltip_text(traducir("Actualizar esta aplicación"))
        self.btn_actualizar.connect("clicked", self._buscar_actualizacion)
        menu.pack_start(self.btn_actualizar, False, False, 0)

        btn_acerca = Gtk.Button(label=traducir("Acerca de AiO Debian"))
        btn_acerca.connect("clicked", self._acerca_de)
        menu.pack_start(btn_acerca, False, False, 0)

        popover.add(menu)
        menu.show_all()
        self.btn_menu.set_popover(popover)
        self.menu_popover = popover
        hb.pack_start(self.btn_menu)
        self.set_titlebar(hb)

    def _titulo_cabecera(self):
        titulo = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        principal = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        nombre = Gtk.Label(label="AiO Debian")
        nombre.get_style_context().add_class("aio-header-title")
        principal.pack_start(nombre, False, False, 0)
        principal.pack_start(self._boton_novedades(version_app()), False, False, 0)
        titulo.pack_start(principal, False, False, 0)

        sistema = Gtk.Box(spacing=5, halign=Gtk.Align.CENTER)
        distribucion = self.datos_anfitrion.get("ID")
        nombre_sistema = {"debian": "Debian", "ubuntu": "Ubuntu"}.get(
            distribucion, traducir("Sistema no compatible"))
        ruta_logo, _ = logo_distribucion(distribucion)
        if ruta_logo:
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(ruta_logo, 16, 16, True)
                sistema.pack_start(Gtk.Image.new_from_pixbuf(pixbuf), False, False, 0)
            except GLib.Error:
                pass
        version_sistema = self.datos_anfitrion.get("VERSION_ID")
        if distribucion in ("debian", "ubuntu") and version_sistema:
            nombre_sistema = f"{nombre_sistema} {version_sistema}"
        etiqueta_sistema = Gtk.Label(label=nombre_sistema)
        etiqueta_sistema.get_style_context().add_class("aio-header-system")
        sistema.pack_start(etiqueta_sistema, False, False, 0)
        titulo.pack_start(sistema, False, False, 0)
        return titulo

    def _boton_novedades(self, version):
        texto = version if version_numerica(version.split("~", 1)[0]) else traducir("Desarrollo")
        boton = Gtk.Button()
        boton.set_relief(Gtk.ReliefStyle.NONE)
        encabezado = traducir("Novedades de esta versión")
        boton.set_tooltip_text(encabezado)
        boton.get_accessible().set_name(f"{encabezado} · {texto}")
        numero = Gtk.Label(label=texto)
        numero.get_style_context().add_class("aio-header-version")
        boton.get_style_context().add_class("aio-header-version-button")
        boton.add(numero)
        boton.connect("clicked", self._abrir_novedades, version)
        return boton

    def _abrir_novedades(self, _boton, version):
        dialogo = Gtk.Dialog(title=traducir("Novedades de esta versión"),
                             transient_for=self, modal=True)
        dialogo.add_button(traducir("Cerrar"), Gtk.ResponseType.CLOSE)
        dialogo.connect("response", lambda d, _r: d.destroy())
        ventana = self.get_window()
        monitor = self.get_display().get_monitor_at_window(ventana) if ventana else None
        area = monitor.get_workarea() if monitor else None
        ancho = min(820, area.width * 9 // 10) if area else 820
        alto = min(560, area.height * 9 // 10) if area else 560
        dialogo.set_default_size(ancho, alto)

        notas = novedades_version(version) or traducir("No hay notas para esta versión.")
        detalle = Gtk.TextView(editable=False, cursor_visible=False)
        detalle.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        detalle.set_left_margin(16)
        detalle.set_right_margin(16)
        detalle.set_top_margin(12)
        detalle.set_bottom_margin(12)
        detalle.set_pixels_below_lines(5)
        detalle.get_buffer().set_text(notas)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_overlay_scrolling(False)
        scroll.add(detalle)
        contenido = dialogo.get_content_area()
        contenido.set_border_width(12)
        contenido.pack_start(scroll, True, True, 0)
        dialogo.show_all()

    def _abrir_guia_integracion(self, _boton=None, parent=None):
        if self.programando:
            return
        self.menu_popover.popdown()
        dialogo = Gtk.Dialog(title=traducir("Guía de integración del anfitrión"),
                             transient_for=parent or self, modal=True)
        dialogo.set_default_size(440, -1)
        dialogo.add_button(traducir("Cerrar"), Gtk.ResponseType.CLOSE)
        dialogo.connect("response", lambda d, _r: d.destroy())
        contenido = dialogo.get_content_area()
        contenido.set_spacing(12)
        contenido.set_border_width(14)
        contenido.pack_start(etiqueta(traducir(
            "AiO comparte la integración de mantenimiento entre DEB, Flatpak y AppImage. Puedes volver a prepararla desde aquí."
        )), False, False, 0)
        automatico = Gtk.Button(label=traducir("Instalar integración automáticamente"))
        automatico.connect("clicked", self._instalar_integracion, dialogo, parent)
        contenido.pack_start(automatico, False, False, 0)
        dialogo.show_all()

    def _instalar_integracion(self, _boton, guia, parent):
        if (self.programando or self.en_curso or self.comprobando_actualizacion
                or self.diagnostico_en_curso or self.backup_action_in_progress):
            return
        pregunta = Gtk.MessageDialog(
            transient_for=guia, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE, text=traducir("Instalar integración automáticamente"),
        )
        detalle = traducir(
            "Se instalarán en el anfitrión el asistente privilegiado, la política Polkit y el programador de esta versión. Solo continúa si confías en esta aplicación. Se solicitará autorización de administrador."
        )
        detalle += "\n\n" + traducir(
            "Los horarios compatibles y su historial se conservan. Los horarios que estaban activados volverán a ejecutarse automáticamente."
        )
        pregunta.format_secondary_text(detalle)
        pregunta.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
        pregunta.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
        pregunta.set_default_response(Gtk.ResponseType.CANCEL)
        aceptar = pregunta.run() == Gtk.ResponseType.OK
        pregunta.destroy()
        if not aceptar:
            return
        formato, appimage = formato_actualizacion(), os.environ.get("APPIMAGE")
        guia.destroy()
        self.programando = True
        self._actualizar_sensibilidad()
        if parent is not None and parent is self.programacion.ventana_programacion:
            w = self.programacion.programacion_widgets
            for nombre in ('formulario', 'guardar', 'pausar', 'eliminar', 'actualizar', 'integracion'):
                w[nombre].set_sensitive(False)
            parent.set_response_sensitive(Gtk.ResponseType.CLOSE, False)
            w['estado'].set_text(traducir('Esperando autorización de administrador…'))

        def instalar():
            try:
                core_host_integration.install_host(formato, appimage)
                error = None
            except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
                error = str(exc)
            GLib.idle_add(self._integracion_instalada, parent, error)

        threading.Thread(target=instalar, daemon=True).start()

    def _integracion_instalada(self, parent, error):
        self.programando = False
        self._actualizar_sensibilidad()
        vigente = parent is not None and parent is self.programacion.ventana_programacion
        if vigente:
            parent.set_response_sensitive(Gtk.ResponseType.CLOSE, True)
        dialogo = Gtk.MessageDialog(
            transient_for=parent if vigente else self, modal=True,
            message_type=Gtk.MessageType.ERROR if error else Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.CLOSE,
            text=traducir("No se pudo instalar la integración." if error else "Integración instalada"),
        )
        if error:
            self._escribir("[!] %s %s\n" % (
                traducir("No se pudo instalar la integración."), error,
            ), "aviso")
        else:
            self._consultar_estados_tareas(inicial=True)
        dialogo.format_secondary_text(error if error else traducir(
            "La integración se ha instalado. Comprueba el estado de la programación."
        ))
        dialogo.run()
        dialogo.destroy()
        if vigente:
            self.programacion._cargar_programacion(parent)
        return GLib.SOURCE_REMOVE

    def _abrir_programacion(self, _boton=None):
        self.programacion.abrir()

    def _buscar_actualizacion(self, _boton):
        self.menu_popover.popdown()
        if self.comprobando_actualizacion or self.en_curso:
            return
        self.comprobando_actualizacion = True
        self._actualizar_sensibilidad()
        formato = formato_actualizacion()

        def comprobar():
            try:
                if formato == "deb":
                    # Refresca la información APT de forma autorizada, sin instalar nada.
                    resultado = subprocess.run(
                        comando_pkexec(HELPER_SISTEMA, "C.UTF-8", "--check-update-self"),
                        capture_output=True, text=True, timeout=180,
                    )
                    if resultado.returncode:
                        raise RuntimeError((resultado.stderr or resultado.stdout).strip()[-1200:] or
                                           "No se pudo consultar APT.")
                    lineas = [line for line in resultado.stdout.splitlines()
                              if line.startswith(("##UPDATE:", "##NOUPDATE:"))]
                    if len(lineas) != 1:
                        raise RuntimeError("El asistente no devolvió información válida de APT.")
                    campos = lineas[0].split(":")
                    if len(campos) != 3:
                        raise RuntimeError("Formato de versiones APT no válido.")
                    actual, nueva = campos[1:]
                    if lineas[0].startswith("##NOUPDATE:"):
                        GLib.idle_add(self._terminar_actualizacion, Gtk.MessageType.INFO,
                                      "Ya tienes la última versión", f"Versión instalada: {actual}.")
                        return
                    detalle = f"Versión instalada: {actual}.\nVersión disponible: {nueva}.\n\n¿Actualizar mediante APT?"
                    datos = None
                elif formato == "flatpak":
                    # Sin privilegios: actualizar metadatos y consultar revisiones pendientes.
                    metadatos = subprocess.run(
                        ["flatpak-spawn", "--host", "flatpak", "update", "--user",
                         "--appstream", "--noninteractive"],
                        capture_output=True, text=True, timeout=90,
                    )
                    if metadatos.returncode:
                        raise RuntimeError((metadatos.stderr or metadatos.stdout).strip()[-1200:] or
                                           "No se pudo actualizar el catálogo Flatpak.")
                    resultado = subprocess.run(
                        ["flatpak-spawn", "--host", "flatpak", "remote-ls", "--user",
                         "--updates", "--app", "--columns=application"],
                        capture_output=True, text=True, timeout=40,
                    )
                    if resultado.returncode:
                        raise RuntimeError((resultado.stderr or resultado.stdout).strip()[-1200:] or
                                           "No se pudo consultar el repositorio Flatpak.")
                    if APP_ID_FLATPAK not in resultado.stdout.splitlines():
                        GLib.idle_add(self._terminar_actualizacion, Gtk.MessageType.INFO,
                                      "Ya tienes la última versión", f"Versión instalada: {version_app()}.")
                        return
                    detalle = ("Hay una actualización Flatpak disponible en el repositorio firmado.\n"
                               "¿Quieres instalarla ahora?")
                    datos = None
                elif formato == "appimage":
                    version, nombre, url, url_hash = obtener_release_actualizacion()
                    instalada = version_numerica(version_app())
                    if instalada is None:
                        raise RuntimeError("No se pudo identificar la versión instalada.")
                    if version_numerica(version) <= instalada:
                        GLib.idle_add(self._terminar_actualizacion, Gtk.MessageType.INFO,
                                      "Ya tienes la última versión", f"Versión instalada: {version_app()}.")
                        return
                    detalle = (f"Versión instalada: {version_app()}.\nVersión disponible: {version}.\n\n"
                               "Se descargará el nuevo AppImage, verificado mediante SHA-256, "
                               "sin sustituir el archivo actual. ¿Continuar?")
                    datos = (version, nombre, url, url_hash)
                else:
                    raise RuntimeError("No se pudo identificar el formato de instalación.")
                GLib.idle_add(self._confirmar_actualizacion, formato, detalle, datos)
            except (OSError, ValueError, RuntimeError, urllib.error.URLError,
                    subprocess.SubprocessError) as error:
                GLib.idle_add(self._terminar_actualizacion, Gtk.MessageType.ERROR,
                              "No se pudo actualizar", str(error))

        threading.Thread(target=comprobar, daemon=True).start()

    def _confirmar_actualizacion(self, formato, detalle, datos):
        dialogo = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE, text=traducir("Confirmar actualización"),
        )
        dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
        dialogo.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
        dialogo.set_default_response(Gtk.ResponseType.CANCEL)
        dialogo.format_secondary_text(detalle)
        casilla_reinicio = Gtk.CheckButton(
            label=traducir("Reiniciar AiO automáticamente tras actualizar"))
        casilla_reinicio.set_active(False)
        dialogo.get_content_area().pack_start(casilla_reinicio, False, False, 8)
        casilla_reinicio.show()
        aceptar = dialogo.run() == Gtk.ResponseType.OK
        reiniciar_automaticamente = casilla_reinicio.get_active()
        dialogo.destroy()
        if not aceptar:
            self.comprobando_actualizacion = False
            self._actualizar_sensibilidad()
            return False

        def aplicar():
            try:
                if formato == "deb":
                    resultado = subprocess.run(
                        comando_pkexec(HELPER_SISTEMA, "C.UTF-8", "--update-self"),
                        capture_output=True, text=True, timeout=300,
                    )
                    if resultado.returncode:
                        raise RuntimeError((resultado.stderr or resultado.stdout).strip()[-1200:] or
                                           "No se pudo actualizar el paquete DEB.")
                    titulo = "Actualización DEB completada"
                    detalle_final = "APT ha instalado la nueva versión de AiO Debian GUI."
                    reinicio = ("deb", None)
                elif formato == "flatpak":
                    resultado = subprocess.run(
                        ["flatpak-spawn", "--host", "flatpak", "update",
                         "--user", "--noninteractive", "-y", APP_ID_FLATPAK],
                        capture_output=True, text=True, timeout=300,
                    )
                    if resultado.returncode:
                        raise RuntimeError((resultado.stderr or resultado.stdout).strip()[-1200:] or
                                           "No se pudo actualizar el Flatpak.")
                    titulo = "Actualización Flatpak completada"
                    detalle_final = "La nueva versión Flatpak está instalada."
                    reinicio = ("flatpak", None)
                else:
                    version, nombre, url, url_hash = datos
                    destino = descargar_appimage_verificado(version, nombre, url, url_hash)
                    titulo = "Nueva AppImage descargada"
                    detalle_final = (f"Versión {version} verificada mediante SHA-256.\n"
                                     f"Archivo: {destino}\n\n"
                                     "La AppImage anterior se conserva como copia.")
                    reinicio = ("appimage", destino)
                GLib.idle_add(self._terminar_actualizacion, Gtk.MessageType.INFO,
                              titulo, detalle_final, reinicio, reiniciar_automaticamente)
            except (OSError, ValueError, RuntimeError, urllib.error.URLError,
                    subprocess.SubprocessError) as error:
                GLib.idle_add(self._terminar_actualizacion, Gtk.MessageType.ERROR,
                              "No se pudo actualizar", str(error))

        threading.Thread(target=aplicar, daemon=True).start()
        return False

    def _terminar_actualizacion(self, tipo, titulo, detalle,
                               reinicio=None, automatico=False):
        self.comprobando_actualizacion = False
        self._actualizar_sensibilidad()
        if tipo != Gtk.MessageType.INFO or reinicio is None:
            self._mensaje(tipo, titulo, detalle)
            return False
        if automatico:
            self._reiniciar_aplicacion_actualizada(reinicio)
            return False

        pregunta = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE, text=traducir(titulo))
        pregunta.format_secondary_text(
            detalle + "\n\n" + traducir("¿Reiniciar AiO Debian GUI ahora?"))
        pregunta.add_button(traducir("Más tarde"), Gtk.ResponseType.NO)
        pregunta.add_button(traducir("Reiniciar aplicación"), Gtk.ResponseType.YES)
        pregunta.set_default_response(Gtk.ResponseType.NO)
        respuesta = pregunta.run()
        pregunta.destroy()
        if respuesta == Gtk.ResponseType.YES:
            self._reiniciar_aplicacion_actualizada(reinicio)
        return False

    def _reiniciar_aplicacion_actualizada(self, reinicio):
        """Relanzar solo si la instalación anterior terminó correctamente.

        DEB vuelve a ejecutar el archivo actualizado; Flatpak lanza el host,
        y AppImage abre únicamente el archivo nuevo con SHA-256 verificado.
        """
        if self.en_curso or self.diagnostico_en_curso:
            self._mensaje(Gtk.MessageType.WARNING, "No se puede reiniciar",
                          "Hay una operación en curso. Reinicia AiO cuando termine.")
            return
        formato, destino = reinicio
        try:
            if formato == "deb":
                os.execv(sys.executable, [sys.executable, "/usr/bin/aio-debian-gui"])
            elif formato == "flatpak":
                subprocess.Popen(
                    ["flatpak-spawn", "--host", "flatpak", "run", "--user", APP_ID_FLATPAK],
                    start_new_session=True, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL)
            elif formato == "appimage" and destino and os.path.isfile(destino):
                subprocess.Popen(
                    [destino], start_new_session=True, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL)
            else:
                raise RuntimeError("No se encontró un ejecutable actualizado para reiniciar.")
        except (OSError, RuntimeError) as exc:
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo reiniciar AiO",
                          str(exc))
            return
        Gtk.main_quit()


    def _confirmar_tareas(self, pasos):
        nombres = {pid: titulo for pid, titulo, *_ in PASOS}
        dialogo = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE, text=traducir("Vista previa del mantenimiento"),
        )
        dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
        dialogo.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
        dialogo.set_default_response(Gtk.ResponseType.CANCEL)
        detalle = (traducir("Ejecutar 1 tarea") if len(pasos) == 1 else traducir("Ejecutar %d tareas") % len(pasos))
        detalle += "\n\n" + "\n".join("• " + traducir(nombres[p]) for p in pasos)
        detalle += ("\n\n" + traducir(
            "Esta es una vista previa de las tareas seleccionadas, no una simulación de APT. "
            "APT puede instalar, actualizar o eliminar dependencias. "
            "Comprueba especialmente las tareas de Backports y eliminación de paquetes."
        ))
        dialogo.format_secondary_text(detalle)
        aceptado = dialogo.run() == Gtk.ResponseType.OK
        dialogo.destroy()
        return aceptado

    def _mostrar_historial(self, _boton):
        self.menu_popover.popdown()
        registros = leer_historial()
        dialogo = Gtk.Dialog(title=traducir("Historial de mantenimiento"), transient_for=self,
                             modal=True)
        dialogo.set_default_size(700, 430)
        dialogo.add_button(traducir("Cerrar"), Gtk.ResponseType.CLOSE)
        dialogo.add_button(traducir("Exportar historial"), Gtk.ResponseType.APPLY)
        area = dialogo.get_content_area()
        vista = Gtk.TextView(editable=False, cursor_visible=False)
        vista.set_monospace(True)
        vista.set_wrap_mode(Gtk.WrapMode.WORD)
        texto = []
        for registro in reversed(registros):
            texto.append(f"{registro['fecha']} — {registro['resultado']} — "
                         f"{registro.get('formato', '?')} {registro.get('version', '?')}")
            texto.append("  " + ", ".join(registro["tareas"]))
            if registro.get("reinicio_recomendado"):
                texto.append("  " + traducir("Reinicio recomendado"))
            texto.append("")
        vista.get_buffer().set_text("\n".join(texto) if texto else
                                    traducir("Todavía no hay operaciones registradas."))
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_height(320)
        scroll.add(vista)
        area.pack_start(scroll, True, True, 8)
        dialogo.show_all()
        while dialogo.run() == Gtk.ResponseType.APPLY:
            selector = Gtk.FileChooserDialog(
                title=traducir("Exportar historial"), transient_for=dialogo,
                action=Gtk.FileChooserAction.SAVE,
                buttons=(traducir("Cancelar"), Gtk.ResponseType.CANCEL,
                         traducir("Guardar"), Gtk.ResponseType.OK),
            )
            selector.set_do_overwrite_confirmation(True)
            selector.set_current_name("aio-debian-gui-history.json")
            if selector.run() == Gtk.ResponseType.OK:
                destino = selector.get_filename()
                try:
                    with open(destino, "w", encoding="utf-8") as archivo:
                        json.dump(registros, archivo, ensure_ascii=False, indent=2)
                        archivo.write("\n")
                except OSError as error:
                    self._mensaje(Gtk.MessageType.ERROR, "No se pudo exportar el historial",
                                  str(error))
            selector.destroy()
        dialogo.destroy()

    def _abrir_preferencias(self, _boton):
        self.menu_popover.popdown()
        dialogo = Gtk.Dialog(
            title=traducir("Preferencias"), transient_for=self, modal=True
        )
        dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
        dialogo.add_button(traducir("Guardar"), Gtk.ResponseType.OK)

        contenido = dialogo.get_content_area()
        grid = Gtk.Grid(column_spacing=12, row_spacing=10)
        for margen in ("top", "bottom", "start", "end"):
            getattr(grid, "set_margin_" + margen)(16)
        contenido.pack_start(grid, True, True, 0)

        combo_idioma = Gtk.ComboBoxText()
        for codigo, nombre in (
            ("es", "Español"), ("en", "English"), ("fr", "Français"), ("zh", "中文")
        ):
            combo_idioma.append(codigo, nombre)
        combo_idioma.set_active_id(self.preferencias["idioma"])
        grid.attach(etiqueta("Idioma de la interfaz"), 0, 0, 1, 1)
        grid.attach(combo_idioma, 1, 0, 1, 1)

        combo_tema = Gtk.ComboBoxText()
        combo_tema.append("sistema", traducir("Seguir el sistema"))
        combo_tema.append("claro", traducir("Claro"))
        combo_tema.append("oscuro", traducir("Oscuro"))
        combo_tema.set_active_id(self.preferencias["tema"])
        grid.attach(etiqueta("Apariencia"), 0, 1, 1, 1)
        grid.attach(combo_tema, 1, 1, 1, 1)

        simple = Gtk.CheckButton(
            label=traducir("Interfaz simple")
        )
        simple.set_active(self.preferencias["modo_simple"])
        grid.attach(simple, 0, 2, 2, 1)
        grid.attach(
            etiqueta("Muestra solo Configuración y mantenimiento y oculta la columna de información del sistema y la salida de la consola.", dim=True),
            0, 3, 2, 1,
        )
        dialogo.show_all()
        respuesta = dialogo.run()
        if respuesta != Gtk.ResponseType.OK:
            dialogo.destroy()
            return

        nuevas = {
            **self.preferencias,
            "idioma": combo_idioma.get_active_id(),
            "tema": combo_tema.get_active_id(),
            "modo_simple": simple.get_active(),
        }
        try:
            guardar_preferencias(nuevas)
        except OSError as error:
            dialogo.destroy()
            self._mensaje(
                Gtk.MessageType.ERROR,
                "No se pudieron guardar las preferencias",
                str(error),
            )
            return

        idioma_cambiado = nuevas["idioma"] != self.preferencias["idioma"]
        self.preferencias = nuevas
        aplicar_tema(nuevas["tema"])
        dialogo.destroy()
        if idioma_cambiado:
            self._reiniciar_interfaz()
            return
        self._aplicar_modo_simple()

    def _aplicar_modo_simple(self):
        simple = self.preferencias["modo_simple"]
        if simple:
            self.notebook.set_current_page(0)
        for numero in range(1, self.notebook.get_n_pages()):
            pagina = self.notebook.get_nth_page(numero)
            pagina.set_no_show_all(simple)
            if simple:
                pagina.hide()
            else:
                pagina.show_all()
        self.panel_derecho.set_no_show_all(simple)
        if simple:
            self.panel_derecho.hide()
        else:
            self.panel_derecho.show_all()
        self.separador_paneles.set_no_show_all(simple)
        self.separador_paneles.set_visible(not simple)
        self.expansor_consola.set_expanded(False)
        self.expansor_consola.set_no_show_all(simple)
        self.expansor_consola.set_visible(not simple)

    def _reiniciar_interfaz(self):
        ancho, alto = self.get_size()
        if self.handler_cierre is not None:
            self.disconnect(self.handler_cierre)
        nueva = VentanaPrincipal(self.preferencias)
        nueva.handler_cierre = nueva.connect("destroy", Gtk.main_quit)
        nueva.resize(ancho, alto)
        nueva.show_all()
        nueva._consultar_estados_tareas(inicial=True)
        self.destroy()

    def _construir_cuerpo(self):
        principal = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        principal.set_border_width(14)
        estilo = principal.get_style_context()
        estilo.add_class("aio-page")
        estilo.add_class("aio-maintenance")
        # El proveedor se instala una sola vez en la pantalla; las reglas están
        # acotadas a las pestañas de la aplicación y heredan el tema GTK.
        pantalla = self.get_screen()
        if not getattr(pantalla, "_aio_estilo_aplicacion", None):
            proveedor = Gtk.CssProvider()
            proveedor.load_from_data(ESTILO_APLICACION)
            Gtk.StyleContext.add_provider_for_screen(
                pantalla, proveedor, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            pantalla._aio_estilo_aplicacion = proveedor
        notebook = Gtk.Notebook()
        notebook.set_tab_pos(Gtk.PositionType.TOP)
        notebook.set_scrollable(True)
        self.notebook = notebook
        self.add(notebook)
        notebook.append_page(principal, Gtk.Label(label=traducir("Configuración y mantenimiento")))
        notebook.append_page(self._pagina_backup(), Gtk.Label(label=traducir("Backup")))
        notebook.append_page(self._pagina_recomendadas(), Gtk.Label(label=traducir("Apps recomendadas")))
        notebook.connect("switch-page", self._cambiar_pestana_recomendadas)
        self.pagina_terminal = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.boton_mostrar_terminal = Gtk.Button(label=traducir("Mostrar ventana de la terminal"))
        self.boton_mostrar_terminal.set_halign(Gtk.Align.CENTER)
        self.boton_mostrar_terminal.set_valign(Gtk.Align.CENTER)
        self.boton_mostrar_terminal.set_no_show_all(True)
        self.boton_mostrar_terminal.connect("clicked", self._abrir_terminal)
        self.pagina_terminal.pack_start(self.boton_mostrar_terminal, True, True, 0)
        consola = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.contenido_terminal = consola
        consola.set_border_width(12)
        accesos_terminal = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE,
                                       column_spacing=8, row_spacing=6,
                                       min_children_per_line=1, max_children_per_line=4,
                                       halign=Gtk.Align.START)
        self.terminal_buttons = {}
        for clave, texto in (("clear", "Limpiar"), ("fastfetch", "Fastfetch"), ("btop", "btop"),
