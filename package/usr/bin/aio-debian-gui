DEBIAN_LOGO = os.path.normpath(
    os.path.join(os.path.dirname(__file__), "../share/aio-debian-gui/debian-openlogo.png")
)
UBUNTU_LOGO = os.path.normpath(
    os.path.join(os.path.dirname(__file__), "../share/aio-debian-gui/ubuntu-logo.svg")
)

def logo_distribucion(distribucion):
    """Devuelve el recurso y el nombre accesible para cada sistema soportado."""
    if distribucion == "ubuntu":
        return UBUNTU_LOGO, "Logotipo de Ubuntu"
    if distribucion == "debian":
        return DEBIAN_LOGO, "Logotipo de Debian"
    return None, None

