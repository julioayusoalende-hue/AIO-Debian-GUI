PRGNAME = "aio-debian-gui"
HELPER = os.path.normpath(
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "../lib/aio-debian-gui/aio-debian-gui-helper")
)
HELPER_SISTEMA = "/usr/lib/aio-debian-gui/aio-debian-gui-helper"
HOMEPAGE = "https://github.com/julioayusoalende-hue/AIO-Debian-GUI"
DEBIAN_LOGO = os.path.normpath(
    os.path.join(os.path.dirname(__file__), "../share/aio-debian-gui/debian-openlogo.png")
)
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")

# Novedades por versión (añade aquí una entrada al publicar una versión nueva)
NOVEDADES = {
    "1.0.5": "Corrige la autenticación al ejecutar AppImage con el paquete Debian instalado.",
    "1.0.4": "La aplicación también se distribuye como AppImage.",
    "1.0.3": "Las herramientas auxiliares instalan el soporte FUSE necesario para AppImage.",
    "1.0.2": "El logotipo de Debian aparece junto a la información del sistema.",
    "1.0.1": "El botón principal ahora se llama «Iniciar tareas».",
    "1.0.0": "Primera versión independiente de la interfaz gráfica de AiO Debian.",
}


# ------------------------------------------------------------------------------
# Información del sistema (no necesita privilegios)
# ------------------------------------------------------------------------------
def paquete_instalado(nombre):
    try:
        out = subprocess.run(
            ["dpkg-query", "-W", "-f=${Status}", nombre],
            capture_output=True, text=True, timeout=10,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return "install ok installed" in out


def version_app():
    version = os.environ.get("AIO_DEBIAN_GUI_VERSION")
    if version:
        return version
    try:
        out = subprocess.run(
            ["dpkg-query", "-W", "-f=${Status}|${Version}", "aio-debian-gui"],
            capture_output=True, text=True, timeout=10,
        ).stdout
        estado, _, version = out.partition("|")
        if "install ok installed" in estado and version:
            return version
    except (OSError, subprocess.SubprocessError):
        pass
    return "desarrollo (no instalado desde paquete)"


def sistema_operativo():
    try:
        with open("/etc/os-release", encoding="utf-8") as f:
            for linea in f:
                if linea.startswith("PRETTY_NAME="):
                    return linea.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return "Debian GNU/Linux"


def _ejecutar(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def helper_mantenimiento():
    if not os.environ.get("APPDIR"):
        return HELPER
    try:
        with open(HELPER, "rb") as incluido, open(HELPER_SISTEMA, "rb") as instalado:
            if incluido.read() == instalado.read():
                return HELPER_SISTEMA
    except OSError:
        pass
    return HELPER


def fecha_instalacion():
    """De más a menos fiable. Devuelve datetime.date o None."""
    candidatos = []

    # 1) Creación del sistema de archivos raíz (solo si se puede leer sin root)
    dispositivo = _ejecutar(["findmnt", "-no", "SOURCE", "/"])
    if dispositivo and shutil.which("tune2fs"):
        for linea in _ejecutar(["tune2fs", "-l", dispositivo]).splitlines():
            if linea.lower().startswith("filesystem created"):
                candidatos.append(linea.split(":", 1)[1].strip())
    # 2) Fecha de nacimiento de / si el sistema de archivos la soporta
    nacimiento = _ejecutar(["stat", "-c", "%w", "/"])
    if nacimiento and nacimiento != "-":
        candidatos.append(nacimiento.split(" ")[0])
    # 3) El instalador de Debian deja aquí su rastro
    for ruta in ("/var/log/installer", "/lost+found"):
        try:
            candidatos.append(
                datetime.datetime.fromtimestamp(os.stat(ruta).st_mtime).strftime("%Y-%m-%d")
            )
        except OSError:
            pass

    for c in candidatos:
        # Aceptar "2024-03-05" o el formato largo de tune2fs ("Tue Mar  5 10:00:00 2024")
        for fmt in ("%Y-%m-%d", "%a %b %d %H:%M:%S %Y"):
            try:
                return datetime.datetime.strptime(" ".join(c.split()), fmt).date()
            except ValueError:
                continue
    return None


def antiguedad(desde, hoy):
    anios = hoy.year - desde.year
    meses = hoy.month - desde.month
    dias = hoy.day - desde.day
    if dias < 0:
        mes_ant = hoy.month - 1 or 12
        anio_ant = hoy.year if hoy.month > 1 else hoy.year - 1
        dias += calendar.monthrange(anio_ant, mes_ant)[1]
        meses -= 1
    if meses < 0:
        meses += 12
        anios -= 1
    return anios, meses, dias


def informacion_sistema():
    filas = [
        ("Sistema operativo", sistema_operativo()),
        ("Kernel actual", os.uname().release),
    ]
    try:
        du = shutil.disk_usage("/")
        gib = 1024 ** 3
        filas.append((
            "Espacio en disco (/)",
            "Usado: %.1f GiB / Total: %.1f GiB (%d%% ocupado)"
            % (du.used / gib, du.total / gib, round(du.used * 100 / du.total)),
        ))
    except OSError:
        pass

    fecha = fecha_instalacion()
    if fecha:
        hoy = datetime.date.today()
        a, m, d = antiguedad(fecha, hoy)
        total = (hoy - fecha).days
        filas.append(("Fecha de instalación", fecha.isoformat()))
        filas.append((
            "Antigüedad del sistema",
            "%d años, %d meses y %d días (%d días en total)" % (a, m, d, total),
        ))

    version = version_app()
    filas.append(("Versión de AiO Debian GUI", version))
    return filas, version


