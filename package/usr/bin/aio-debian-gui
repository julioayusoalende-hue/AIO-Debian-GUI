# Ruta equivalente en DEB (/usr), AppImage (AppDir/usr) y Flatpak (/app).
CORE_DIR = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                      "../lib/aio-debian-gui"))
if CORE_DIR not in sys.path:
    sys.path.insert(0, CORE_DIR)
