        consola.pack_start(accesos_terminal, False, False, 0)
        opciones_terminal = Gtk.Box(spacing=8)
        self.terminal_status = etiqueta("")
        opciones_terminal.pack_start(self.terminal_status, True, True, 0)
        self.boton_separar_terminal = Gtk.Button(label=traducir("Separar terminal"))
        self.boton_separar_terminal.connect("clicked", self._alternar_ventana_terminal)
        opciones_terminal.pack_end(self.boton_separar_terminal, False, False, 0)
        consola.pack_start(opciones_terminal, False, False, 0)
        self.terminal_restart = Gtk.Button(label=traducir("Abrir nueva sesión"))
        self.terminal_restart.set_halign(Gtk.Align.START)
