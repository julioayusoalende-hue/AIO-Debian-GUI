    ("repos", "Habilitar contrib y non-free",
     "Añade los componentes a los repositorios oficiales de Debian (con copia .bak).", True, "apt"),
    ("tools", "Instalar herramientas auxiliares",
     "needrestart, fastfetch, kitty, synaptic y soporte FUSE para AppImage, si faltan.", True, "apt"),
