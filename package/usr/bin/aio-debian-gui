    @staticmethod
    def _pagina_tarjetas():
        # Contenedor común para pestañas con paneles de ajustes y acciones.
        pagina = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        pagina.set_border_width(14)
        pagina.get_style_context().add_class("aio-page")
        return pagina

    @staticmethod
    def _scroll_tarjetas(contenido):
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_overlay_scrolling(False)
        scroll.add(contenido)
        return scroll

    @staticmethod
    def _rejilla_tarjetas():
        rejilla = Gtk.FlowBox(
            selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
            min_children_per_line=1, max_children_per_line=2,
            column_spacing=10, row_spacing=10, valign=Gtk.Align.START,
        )
        rejilla.get_style_context().add_class("aio-card-grid")
        return rejilla

    @staticmethod
    def _etiqueta_estado():
        estado = etiqueta("")
        estado.set_no_show_all(True)
        estado.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        estado.connect("notify::label", lambda lbl, _: lbl.set_visible(bool(lbl.get_text())))
        return estado

    def _pagina_inicio(self):
        pagina = self._pagina_tarjetas()
        contenido = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        tarjeta, caja = tarjeta_mantenimiento(10)
        caja.pack_start(cabecera_mantenimiento("Configuración de arranque de GRUB",
                                               "system-reboot-symbolic"), False, False, 0)
        contenido.pack_start(tarjeta, False, False, 0)
        pagina.pack_start(self._scroll_tarjetas(contenido), True, True, 0)

        cargar = Gtk.Button(label=traducir("Cargar ajustes de GRUB"))
        cargar.set_halign(Gtk.Align.START)
        cargar.connect("clicked", self._accion_grub, "status")
        caja.pack_start(cargar, False, False, 0)

        self.grub_formulario = Gtk.Grid(column_spacing=14, row_spacing=10)
        self.grub_formulario.set_sensitive(False)
        caja.pack_start(self.grub_formulario, False, False, 0)
        self.grub_entrada = Gtk.ComboBoxText(hexpand=True)
        for renderer in self.grub_entrada.get_cells():
            renderer.set_property("ellipsize", Pango.EllipsizeMode.END)
        self.grub_tiempo = Gtk.Entry(placeholder_text=traducir("Usar los ajustes del sistema"))
        self.grub_tiempo.set_width_chars(12)
        self.grub_estilo = Gtk.ComboBoxText()
        for clave, texto in (("@system", "Usar los ajustes del sistema"), ("menu", "Mostrar menú"),
                             ("countdown", "Mostrar cuenta atrás"), ("hidden", "Ocultar menú")):
            self.grub_estilo.append(clave, traducir(texto))
        self.grub_estilo.set_active_id("@system")
        self.grub_entrada.append("@system", traducir("Usar los ajustes del sistema"))
        self.grub_entrada.set_active_id("@system")
        for fila, (texto, widget) in enumerate((
            ("Entrada predeterminada", self.grub_entrada),
            ("Tiempo de espera (segundos)", self.grub_tiempo),
            ("Visibilidad del menú", self.grub_estilo),
        )):
            label = etiqueta(texto)
            label.set_mnemonic_widget(widget)
            self.grub_formulario.attach(label, 0, fila, 1, 1)
            self.grub_formulario.attach(widget, 1, fila, 1, 1)

        caja.pack_start(etiqueta(
            "Usa 0 para arrancar al instante, -1 para esperar indefinidamente "
            "o deja el campo vacío para usar los ajustes del sistema.", dim=True),
            False, False, 0)
        self.grub_acciones = Gtk.Box(spacing=8)
        self.grub_acciones.set_sensitive(False)
        caja.pack_start(self.grub_acciones, False, False, 0)
        aplicar = Gtk.Button(label=traducir("Aplicar cambios"))
        aplicar.get_style_context().add_class("suggested-action")
        aplicar.connect("clicked", self._accion_grub, "apply")
        self.grub_acciones.pack_start(aplicar, False, False, 0)
        self.grub_restaurar = Gtk.Button(label=traducir("Restaurar ajustes del sistema"))
        self.grub_restaurar.set_sensitive(False)
        self.grub_restaurar.connect("clicked", self._accion_grub, "restore")
        self.grub_acciones.pack_start(self.grub_restaurar, False, False, 0)
        for boton, icono in ((cargar, "view-refresh-symbolic"),
                             (aplicar, "document-save-symbolic"),
                             (self.grub_restaurar, "document-revert-symbolic")):
            boton.set_image(Gtk.Image.new_from_icon_name(icono, Gtk.IconSize.BUTTON))
            boton.set_always_show_image(True)
        self.grub_mensaje = self._etiqueta_estado()
        pagina.pack_start(self.grub_mensaje, False, False, 0)
        self.grub_pagina = pagina
        return pagina

    def _accion_grub(self, _boton, accion):
        if not self.grub_pagina.get_sensitive() or (accion != "status" and self.grub_estado is None):
            return
        argumentos = ["status"]
        if accion != "status":
            ajustes = {}
            if accion == "apply":
                entrada = self.grub_entrada.get_active_id()
                estilo = self.grub_estilo.get_active_id()
                tiempo = self.grub_tiempo.get_text().strip()
                if tiempo and not re.fullmatch(r"-1|0|[1-9][0-9]{0,2}", tiempo):
                    self._mensaje(Gtk.MessageType.ERROR, "Tiempo de espera no válido",
                                  "Escribe un número entre -1 y 999.")
                    return
                ajustes = {clave: valor for clave, valor in (
                    ("GRUB_DEFAULT", entrada), ("GRUB_TIMEOUT", tiempo),
                    ("GRUB_TIMEOUT_STYLE", estilo),
                ) if valor and valor != "@system"}
            if ajustes == self.grub_estado["settings"]:
                return
            dialogo = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                buttons=Gtk.ButtonsType.NONE, text=traducir("¿Actualizar el arranque de GRUB?"))
            dialogo.format_secondary_text(traducir("Los cambios se aplicarán en el próximo arranque."))
            dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
            dialogo.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
            dialogo.set_default_response(Gtk.ResponseType.CANCEL)
            continuar = dialogo.run() == Gtk.ResponseType.OK
            dialogo.destroy()
            if not continuar:
                return
            argumentos = ["apply", json.dumps(
                {"revision": self.grub_estado["revision"], "settings": ajustes})]

        self.grub_action_in_progress = True
        self.grub_mensaje.set_text(traducir("Se solicitará autorización de administrador…"))
        self._actualizar_sensibilidad()
        threading.Thread(target=self._procesar_grub, args=(argumentos,), daemon=True).start()

    def _procesar_grub(self, argumentos):
        estado, error = None, None
        try:
            if not helper_disponible(GRUB_HELPER):
                raise RuntimeError(traducir("Instala o actualiza la integración del anfitrión para gestionar GRUB."))
            resultado = subprocess.run(comando_host("pkexec", GRUB_HELPER, *argumentos),
                                       stdin=subprocess.DEVNULL, capture_output=True,
                                       text=True, errors="replace")
            if resultado.returncode:
                raise RuntimeError(resultado.stderr.strip() or
                                   traducir("No se completó la autorización o la operación."))
            estado = json.loads(resultado.stdout)
        except (OSError, ValueError, RuntimeError) as exc:
            error = str(exc)
        GLib.idle_add(self._grub_finalizado, argumentos[0], estado, error)

    def _grub_finalizado(self, accion, estado, error):
        self.grub_action_in_progress = False
        if self.destruida:
            return GLib.SOURCE_REMOVE
        self._actualizar_sensibilidad()
        if error:
            titulo = "No se pudo gestionar el arranque de GRUB"
            self.grub_mensaje.set_text(traducir(titulo))
            self._mensaje(Gtk.MessageType.ERROR, titulo, error)
            return GLib.SOURCE_REMOVE

        self.grub_estado = estado
        ajustes = estado["settings"]
        self.grub_entrada.remove_all()
        self.grub_entrada.append("@system", traducir("Usar los ajustes del sistema"))
        for entrada in estado["entries"]:
            self.grub_entrada.append(entrada["id"], entrada["title"])
        predeterminada = ajustes.get("GRUB_DEFAULT", "@system")
        if not self.grub_entrada.set_active_id(predeterminada):
            self.grub_entrada.append(predeterminada, traducir("Entrada no disponible") + " · " + predeterminada)
            self.grub_entrada.set_active_id(predeterminada)
        self.grub_tiempo.set_text(ajustes.get("GRUB_TIMEOUT", ""))
        self.grub_estilo.set_active_id(ajustes.get("GRUB_TIMEOUT_STYLE", "@system"))
        self.grub_formulario.set_sensitive(True)
        self.grub_acciones.set_sensitive(True)
        self.grub_restaurar.set_sensitive(bool(ajustes))
        mensaje = ("Los cambios se aplicarán en el próximo arranque." if accion == "apply"
                   else "Ajustes de GRUB cargados.")
        self.grub_mensaje.set_text(traducir(mensaje))
        return GLib.SOURCE_REMOVE

    def _boton_backup(self, accion, texto, icono, callback):
        boton = Gtk.Button(label=traducir(texto))
        boton.set_image(Gtk.Image.new_from_icon_name(icono, Gtk.IconSize.BUTTON))
        boton.set_always_show_image(True)
        boton.set_halign(Gtk.Align.START)
        boton.connect("clicked", callback, accion)
        self.backup_buttons[accion] = boton
        return boton

    def _pagina_backup(self):
        pagina = self._pagina_tarjetas()
        contenido = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        carpeta, caja = tarjeta_mantenimiento(8)
        caja.pack_start(cabecera_mantenimiento("Carpeta de copia", "folder-symbolic"),
                        False, False, 0)
        self.carpeta_repositorios_label = etiqueta("")
        self.carpeta_repositorios_label.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        self.carpeta_repositorios_label.set_selectable(True)
        self._mostrar_carpeta_repositorios()
        fila_carpeta = Gtk.Box(spacing=10)
        fila_carpeta.pack_start(self.carpeta_repositorios_label, True, True, 0)
        boton = self._boton_backup("folder", "Cambiar carpeta de copia",
                                   "folder-open-symbolic", self._accion_repositorios)
        boton.set_valign(Gtk.Align.CENTER)
        fila_carpeta.pack_end(boton, False, False, 0)
        caja.pack_start(fila_carpeta, False, False, 0)
        contenido.pack_start(carpeta, False, False, 0)

        grupos = self._rejilla_tarjetas()
        for titulo, icono, descripcion, acciones, callback in (
            ("Repositorios APT", "system-software-install-symbolic",
             "Fuentes de software y claves de APT.", (
                ("backup", "Copiar repositorios APT", "document-save-symbolic"),
                ("restore", "Restaurar repositorios APT", "document-revert-symbolic"),
            ), self._accion_repositorios),
            ("Ajustes del escritorio", "preferences-desktop-symbolic",
             "Preferencias, extensiones y widgets de GNOME o KDE Plasma.", (
                ("desktop-backup", "Copiar ajustes del escritorio", "document-save-symbolic"),
                ("desktop-restore", "Restaurar ajustes del escritorio", "document-revert-symbolic"),
            ), self._accion_escritorio),
        ):
            tarjeta, caja = tarjeta_mantenimiento(8)
            tarjeta.set_size_request(330, -1)
            caja.pack_start(cabecera_mantenimiento(titulo, icono), False, False, 0)
            caja.pack_start(etiqueta(descripcion), True, True, 0)
            for accion, texto, icono_accion in acciones:
                boton = self._boton_backup(accion, texto, icono_accion, callback)
                caja.pack_start(boton, False, False, 0)
            grupos.add(tarjeta)
        contenido.pack_start(grupos, False, False, 0)

        herramientas, caja = tarjeta_mantenimiento(10)
        caja.pack_start(cabecera_mantenimiento("Copias de seguridad", "drive-harddisk-symbolic"),
                        False, False, 0)
        for indice, (app_id, app) in enumerate(APLICACIONES_BACKUP.items()):
            if indice:
                caja.pack_start(Gtk.Separator(), False, False, 0)
            fila = Gtk.Box(spacing=10)
            fila.pack_start(self._icono_aplicacion_backup(app), False, False, 0)
            texto = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            nombre = etiqueta(app["name"])
            nombre.get_style_context().add_class("aio-group")
            texto.pack_start(nombre, False, False, 0)
            descripcion = etiqueta(app["description"])
            descripcion.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            texto.pack_start(descripcion, False, False, 0)
            fila.pack_start(texto, True, True, 0)
            boton = self._boton_backup(app_id, "Abrir " + app["name"],
                                       "document-open-symbolic", self._accion_backup)
            boton.set_valign(Gtk.Align.CENTER)
            fila.pack_end(boton, False, False, 0)
            caja.pack_start(fila, False, False, 0)
        contenido.pack_start(herramientas, False, False, 0)
        pagina.pack_start(self._scroll_tarjetas(contenido), True, True, 0)
        self.backup_status = self._etiqueta_estado()
        pagina.pack_start(self.backup_status, False, False, 0)
        return pagina

    def _pagina_recomendadas(self):
        pagina = self._pagina_tarjetas()
        introduccion, caja = tarjeta_mantenimiento(7)
        caja.pack_start(cabecera_mantenimiento("Aplicaciones recomendadas", "view-grid-symbolic"),
                        False, False, 0)
        caja.pack_start(etiqueta(
            "APT requiere autorización de administrador. Flatpak instala para tu usuario y añade Flathub si hace falta. Para los DEB de la web oficial, usa el gestor de software."
        ), False, False, 0)
        self.recommended_selection = {}
        self.recommended_multi = Gtk.ToggleButton(label=traducir("Seleccionar varias"))
        self.recommended_multi.connect("toggled", self._alternar_seleccion_recomendada)
        self.recommended_install = Gtk.Button(label=traducir("Instalar selección"))
        self.recommended_install.get_style_context().add_class("suggested-action")
        self.recommended_install.connect("clicked", self._instalar_seleccion_recomendada)
        barra = Gtk.Box(spacing=8)
        barra.pack_start(self.recommended_multi, False, False, 0)
        barra.pack_end(self.recommended_install, False, False, 0)
        caja.pack_start(barra, False, False, 0)
        self.recommended_status = self._etiqueta_estado()
        caja.pack_start(self.recommended_status, False, False, 0)
        pagina.pack_start(introduccion, False, False, 0)

        self.recommended_buttons = {}
        self.recommended_installed = {}
        self.recommended_indicators = {}
        self.recommended_grid = self._rejilla_tarjetas()
        for app in APPS_RECOMENDADAS:
            self.recommended_grid.add(self._tarjeta_recomendada(app))
        pagina.pack_start(self._scroll_tarjetas(self.recommended_grid), True, True, 0)
        return pagina

    def _tarjeta_recomendada(self, app):
        tarjeta, contenido = tarjeta_mantenimiento(8)
        tarjeta.set_size_request(330, -1)
        cabecera = Gtk.Box(spacing=10)
        icono_app = icono_recomendada(app)
        if app.get("light_icon_background"):
            icono_app.get_style_context().add_class("aio-light-icon-background")
        cabecera.pack_start(icono_app, False, False, 0)
        titulo = etiqueta(app["name"])
        titulo.get_style_context().add_class("aio-heading")
        cabecera.pack_start(titulo, True, True, 0)
        contenido.pack_start(cabecera, False, False, 0)
        descripcion = etiqueta(app["description"])
        descripcion.set_max_width_chars(54)
        contenido.pack_start(descripcion, True, True, 0)

        botones = Gtk.Box(spacing=8, homogeneous=True)
        for canal in self.canales_recomendados[app["id"]]:
            tipo = canal["type"]
            texto, icono = {
                "deb": ("DEB (APT)", "system-software-install-symbolic"),
                "deb-download": ("DEB (web oficial)", "web-browser-symbolic"),
                "appimage": ("Descargar AppImage", "folder-download-symbolic"),
                "flatpak": ("Flatpak", "package-x-generic-symbolic"),
            }[tipo]
            boton = Gtk.Button(label=traducir(texto))
            boton.set_image(Gtk.Image.new_from_icon_name(icono, Gtk.IconSize.BUTTON))
            boton.set_always_show_image(True)
            boton.connect("clicked", self._accion_app_recomendada, app["id"], tipo)
            columna = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            columna.pack_start(boton, False, False, 0)
            indicador = Gtk.Label(label="✓ " + traducir("Instalado"))
            indicador.get_style_context().add_class("aio-group")
            indicador.set_no_show_all(True)
            columna.pack_start(indicador, False, False, 0)
            botones.pack_start(columna, True, True, 0)
            clave = (app["id"], tipo)
            self.recommended_buttons[clave] = boton
            self.recommended_indicators[clave] = indicador
        contenido.pack_end(botones, False, False, 0)
        return tarjeta

    @staticmethod
    def _icono_aplicacion_backup(app):
        ruta = os.path.join(BACKUP_ICON_DIR, app["bundled_icon"])
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(ruta, 48, 48, True)
            return Gtk.Image.new_from_pixbuf(pixbuf)
        except GLib.Error as exc:
            print("No se pudo cargar el icono %s: %s" % (ruta, exc.message), file=sys.stderr)
        theme = Gtk.IconTheme.get_default()
        icon = next((name for name in (app["icon"], app["fallback_icon"])
                     if theme.has_icon(name)), "application-x-executable")
        return Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)

    def _mostrar_carpeta_repositorios(self):
        carpeta = self.preferencias.get("carpeta_repositorios")
        texto = carpeta or traducir("Elige una carpeta para guardar y recuperar la copia.")
        self.carpeta_repositorios_label.set_text(texto)

    def _elegir_carpeta_repositorios(self):
        selector = Gtk.FileChooserNative.new(
            traducir("Carpeta de copia"), self,
            Gtk.FileChooserAction.SELECT_FOLDER, traducir("Aceptar"), traducir("Cancelar"))
        carpeta = self.preferencias.get("carpeta_repositorios")
        if carpeta and os.path.isdir(carpeta):
            selector.set_current_folder(carpeta)
        seleccion = selector.get_filename() if selector.run() == Gtk.ResponseType.ACCEPT else None
        selector.destroy()
        if not seleccion:
            return None
        nuevas = dict(self.preferencias, carpeta_repositorios=seleccion)
        try:
            guardar_preferencias(nuevas)
        except OSError as error:
            self._mensaje(Gtk.MessageType.ERROR, "No se pudieron guardar las preferencias", str(error))
            return None
        self.preferencias = nuevas
        self._mostrar_carpeta_repositorios()
        return seleccion

    def _accion_repositorios(self, _boton, accion):
        if (self.backup_action_in_progress or self.en_curso or self.diagnostico_en_curso
                or self.comprobando_actualizacion or self.programando):
            return
        if accion == "folder":
            self._elegir_carpeta_repositorios()
            return
        carpeta = self.preferencias.get("carpeta_repositorios") or self._elegir_carpeta_repositorios()
        if not carpeta:
            return
        ruta = os.path.join(carpeta, APT_BACKUP_FILENAME)
        if accion == "restore" and not os.path.isfile(ruta):
            self._mensaje(Gtk.MessageType.ERROR, "No se encontró la copia de repositorios.", ruta)
            return
        if accion == "restore" or os.path.lexists(ruta):
            pregunta = ("¿Restaurar los repositorios APT?" if accion == "restore"
                        else "¿Reemplazar la copia de repositorios?")
            dialogo = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.NONE, text=traducir(pregunta))
            detalle = ("La copia sustituirá las fuentes APT actuales. Continúa solo si confías en su contenido."
                       if accion == "restore" else
                       "La copia nueva sustituirá el archivo existente.")
            dialogo.format_secondary_text(traducir(detalle) + "\n" + ruta)
            dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
            dialogo.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
            dialogo.set_default_response(Gtk.ResponseType.CANCEL)
            continuar = dialogo.run() == Gtk.ResponseType.OK
            dialogo.destroy()
            if not continuar:
                return
        self.backup_action_in_progress = True
        self.backup_status.set_text(traducir("Se solicitará autorización de administrador…"))
        self._actualizar_sensibilidad()
        threading.Thread(target=self._procesar_repositorios,
                         args=(accion, ruta), daemon=True).start()

    def _procesar_repositorios(self, accion, ruta):
        error = None
        try:
            if not helper_disponible(APT_BACKUP_HELPER):
                raise RuntimeError(traducir("Instala o actualiza la integración del anfitrión para gestionar las copias APT."))
            datos = b""
            if accion == "restore":
                with open(ruta, "rb") as archivo:
                    datos = archivo.read(APT_BACKUP_LIMIT + 1)
                if len(datos) > APT_BACKUP_LIMIT:
                    raise ValueError(traducir("La copia de repositorios supera el tamaño permitido."))
            resultado = subprocess.run(
                comando_host("pkexec", APT_BACKUP_HELPER, accion),
                input=datos, capture_output=True, timeout=180)
            if resultado.returncode:
                raise RuntimeError(resultado.stderr.decode("utf-8", errors="replace").strip()
                                   or traducir("No se completó la autorización o la operación."))
            if accion == "backup":
                if not resultado.stdout:
                    raise RuntimeError(traducir("La copia de repositorios está vacía."))
                descriptor, temporal = tempfile.mkstemp(prefix=".repositorios-", dir=os.path.dirname(ruta))
                try:
                    with os.fdopen(descriptor, "wb") as archivo:
                        archivo.write(resultado.stdout)
                        archivo.flush()
                        os.fsync(archivo.fileno())
                    os.replace(temporal, ruta)
                finally:
                    if os.path.exists(temporal):
                        os.unlink(temporal)
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
            error = str(exc)
        GLib.idle_add(self._repositorios_finalizados, accion, ruta, error)

    def _repositorios_finalizados(self, accion, ruta, error):
        self.backup_action_in_progress = False
        self._actualizar_sensibilidad()
        if error:
            titulo = "No se pudo completar la operación de repositorios."
            self.backup_status.set_text(traducir(titulo))
            self._mensaje(Gtk.MessageType.ERROR, titulo, error)
        elif accion == "restore":
            self.backup_status.set_text(traducir("Repositorios restaurados. Actualiza los índices APT desde Mantenimiento."))
        else:
            self.backup_status.set_text(traducir("Copia de repositorios guardada en %s") % ruta)
        return GLib.SOURCE_REMOVE

    def _accion_escritorio(self, _boton, accion):
        if (self.backup_action_in_progress or self.en_curso or self.diagnostico_en_curso
                or self.comprobando_actualizacion or self.programando):
            return
        escritorio = core_desktop_backup.detect()
        if not escritorio:
            self._mensaje(Gtk.MessageType.INFO, "Ajustes del escritorio",
                          "Abre AiO desde una sesión de GNOME o KDE Plasma.")
            return
        carpeta = self.preferencias.get("carpeta_repositorios") or self._elegir_carpeta_repositorios()
        if not carpeta:
            return
        ruta = os.path.join(carpeta, f"escritorio-{escritorio}.zip")
        if accion == "desktop-backup" and os.path.lexists(ruta):
            if not self._confirmar_escritorio("¿Reemplazar la copia del escritorio?", ruta):
                return
        self.backup_action_in_progress = True
        self.backup_status.set_text(traducir("Preparando la copia del escritorio…"))
        self._actualizar_sensibilidad()
        threading.Thread(target=self._procesar_escritorio,
                         args=(accion, escritorio, ruta), daemon=True).start()

    def _confirmar_escritorio(self, titulo, detalle):
        dialogo = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.NONE, text=traducir(titulo))
        dialogo.format_secondary_text(detalle)
        dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
        dialogo.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
        dialogo.set_default_response(Gtk.ResponseType.CANCEL)
        continuar = dialogo.run() == Gtk.ResponseType.OK
        dialogo.destroy()
        return continuar

    def _procesar_escritorio(self, accion, escritorio, ruta, preparados=None):
        try:
            if preparados is not None:
                version_actual, archivos, directorios = preparados
                recuperacion = core_desktop_backup.restore(
                    escritorio, version_actual, archivos, directorios)
                mensaje = traducir("Ajustes restaurados. Cierra sesión y vuelve a entrar. Copia anterior: %s") % recuperacion
            else:
                version_actual = core_desktop_backup.version(escritorio)
                directorios = core_desktop_backup.user_dirs()
                if accion == "desktop-restore":
                    origen, archivos = core_desktop_backup.read(Path(ruta), escritorio)
                    GLib.idle_add(self._confirmar_restauracion_escritorio, escritorio, ruta,
                                  origen, (version_actual, archivos, directorios))
                    return
                archivos = core_desktop_backup.snapshot(escritorio, directorios)
                core_desktop_backup.save(Path(ruta), escritorio, version_actual, archivos)
                mensaje = traducir("Copia del escritorio guardada en %s") % ruta
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError, KeyError,
                NotImplementedError, zipfile.BadZipFile, RecursionError) as error:
            GLib.idle_add(self._escritorio_finalizado, None, str(error))
        else:
            GLib.idle_add(self._escritorio_finalizado, mensaje, None)

    def _confirmar_restauracion_escritorio(self, escritorio, ruta, origen, preparados):
        version_actual = preparados[0]
        detalle = traducir("Copia de %s · %s\nSesión actual: %s") % (
            core_desktop_backup.LABELS[escritorio], origen, version_actual)
        if origen != version_actual:
            detalle += "\n\n" + traducir("Las versiones son distintas. Algunas extensiones o widgets podrían ser incompatibles.")
        detalle += "\n\n" + traducir(
            "Se guardará una copia de los ajustes actuales. Continúa solo si confías en las extensiones y widgets de esta copia.")
        if self._confirmar_escritorio("¿Restaurar los ajustes del escritorio?", detalle):
            self.backup_status.set_text(traducir("Restaurando los ajustes del escritorio…"))
            threading.Thread(target=self._procesar_escritorio,
                             args=("desktop-restore", escritorio, ruta, preparados), daemon=True).start()
        else:
            self._escritorio_finalizado("", None)
        return GLib.SOURCE_REMOVE

    def _escritorio_finalizado(self, mensaje, error):
        self.backup_action_in_progress = False
        self._actualizar_sensibilidad()
        if error:
            titulo = "No se pudo completar la copia o restauración del escritorio."
            self.backup_status.set_text(traducir(titulo))
            self._mensaje(Gtk.MessageType.ERROR, titulo, error)
        else:
            self.backup_status.set_text(mensaje)
        return GLib.SOURCE_REMOVE

    def _accion_backup(self, _boton, app_id):
        if (app_id not in APLICACIONES_BACKUP or self.backup_action_in_progress
                or self.en_curso or self.diagnostico_en_curso or self.comprobando_actualizacion
                or self.programando):
            return
        self.backup_action_in_progress = True
        app = APLICACIONES_BACKUP[app_id]
        self.backup_status.set_text(traducir("Comprobando si %s está instalado…") % app["name"])
        self._actualizar_sensibilidad()

        def comprobar():
            try:
                proc = subprocess.run(
                    comando_host("dpkg-query", "-W", "-f=${db:Status-Status}", app["package"]),
                    capture_output=True, text=True, timeout=15,
                    env={**os.environ, "LC_ALL": "C"},
                )
                if proc.returncode == 0:
                    accion = "open" if proc.stdout.strip() == "installed" else "install"
                    error = None
                elif "no packages found matching" in (proc.stderr + proc.stdout).lower():
                    accion, error = "install", None
                else:
                    accion, error = None, (proc.stderr or proc.stdout or "dpkg-query falló.").strip()[-1000:]
            except (OSError, subprocess.SubprocessError) as exc:
                accion, error = None, str(exc)
            GLib.idle_add(self._backup_comprobado, app_id, accion, error)
        threading.Thread(target=comprobar, daemon=True).start()

    def _backup_comprobado(self, app_id, accion, error):
        self.backup_action_in_progress = False
        self._actualizar_sensibilidad()
        app = APLICACIONES_BACKUP[app_id]
        if error:
            self.backup_status.set_text(traducir("No se pudo abrir %s: %s") % (app["name"], error))
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo comprobar %s" % app["name"], error)
        elif accion == "open":
            self._abrir_aplicacion_backup(app_id)
        elif accion == "install":
            dialogo = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                buttons=Gtk.ButtonsType.NONE, text=traducir(app["prompt"]),
            )
            dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
            dialogo.add_button(traducir("Instalar"), Gtk.ResponseType.OK)
            dialogo.set_default_response(Gtk.ResponseType.CANCEL)
            instalar = dialogo.run() == Gtk.ResponseType.OK
            dialogo.destroy()
            if instalar:
                self._instalar_aplicacion_backup(app_id)
            else:
                self.backup_status.set_text(traducir("La aplicación todavía no está instalada."))
        else:
            self.backup_status.set_text(traducir("No se pudo abrir %s: %s") % (app["name"], "resultado inesperado"))
        return GLib.SOURCE_REMOVE

    def _instalar_aplicacion_backup(self, app_id):
        if self.backup_action_in_progress:
            return
        app = APLICACIONES_BACKUP[app_id]
        self.backup_action_in_progress = True
        self.backup_status.set_text(traducir("Instalando %s; se solicitará autorización de administrador…") % app["name"])
        self._actualizar_sensibilidad()

        def instalar():
            error = None
            requiere_integracion = False
            try:
                helper = helper_mantenimiento()
                if not helper_disponible(helper):
                    requiere_integracion = usa_integracion_portable()
                    if not requiere_integracion:
                        raise RuntimeError("No se encuentra el asistente de mantenimiento.")
                elif usa_integracion_portable():
                    requiere_integracion = not core_host_integration.compatible_helper(
                        formato_actualizacion(), helper)
                if not requiere_integracion:
                    proc = subprocess.run(
                        comando_pkexec(helper, "C.UTF-8", "--backup-install", app_id),
                        capture_output=True, text=True, timeout=600,
                    )
                    marcador = f"##BACKUP:installed:{app_id}"
                    if proc.returncode or marcador not in proc.stdout.splitlines():
                        error = (proc.stderr or proc.stdout or "El asistente no confirmó la instalación.").strip()[-1600:]
            except (OSError, subprocess.SubprocessError, RuntimeError) as exc:
                error = str(exc)
            GLib.idle_add(self._backup_instalado, app_id, error, requiere_integracion)
        threading.Thread(target=instalar, daemon=True).start()

    def _backup_instalado(self, app_id, error, requiere_integracion):
        self.backup_action_in_progress = False
        self._actualizar_sensibilidad()
        app = APLICACIONES_BACKUP[app_id]
        if requiere_integracion:
            self.backup_status.set_text(traducir(
                "No se encuentra el asistente actualizado en el anfitrión. Instala la integración desde su guía y vuelve a intentarlo."
            ))
            self._abrir_guia_integracion()
        elif error:
            self.backup_status.set_text(traducir("No se pudo instalar %s: %s") % (app["name"], error))
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo instalar %s" % app["name"], error)
        else:
            self._abrir_aplicacion_backup(app_id)
        return GLib.SOURCE_REMOVE

    def _abrir_aplicacion_backup(self, app_id):
        app = APLICACIONES_BACKUP[app_id]
        self.backup_status.set_text(traducir("Abriendo %s…") % app["name"])
        try:
            Gio.Subprocess.new(comando_host(app["command"]), Gio.SubprocessFlags.NONE)
        except GLib.Error as exc:
            self.backup_status.set_text(traducir("No se pudo abrir %s: %s") % (app["name"], exc.message))
            return
        self.backup_status.set_text(traducir("%s se ha abierto.") % app["name"])

    @staticmethod
    def _comprobar_deb_recomendada(paquete):
        proc = subprocess.run(
            comando_host("dpkg-query", "-W", "-f=${db:Status-Status}", paquete),
            capture_output=True, text=True, timeout=15,
            env={**os.environ, "LC_ALL": "C"},
        )
        if proc.returncode == 0:
            return proc.stdout.strip() == "installed"
        if "no packages found matching" in (proc.stderr + proc.stdout).lower():
            return False
        raise RuntimeError((proc.stderr or proc.stdout or "dpkg-query falló.").strip()[-1000:])

    @staticmethod
    def _flatpaks_recomendadas_instaladas():
        proc = subprocess.run(
            comando_host("flatpak", "list", "--app", "--columns=application"),
            capture_output=True, text=True, timeout=15,
        )
        if proc.returncode:
            raise RuntimeError((proc.stderr or "No se pudo consultar Flatpak.").strip()[-1000:])
        return set(proc.stdout.splitlines())

    def _construir_edicion_terminal(self, barra):
        acciones = (
            (Gdk.KEY_c, "Copiar", lambda: self.terminal.copy_clipboard_format(Vte.Format.TEXT)),
            (Gdk.KEY_v, "Pegar", self.terminal.paste_clipboard),
            (Gdk.KEY_a, "Seleccionar todo", self.terminal.select_all),
            (None, "Quitar selección", self.terminal.unselect_all),
        )
        menu = Gtk.Menu()
        atajos = {}
        modificadores = Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK
        for tecla, nombre, accion in acciones:
            item = Gtk.MenuItem()
            texto = Gtk.AccelLabel(label=traducir(nombre), xalign=0)
            if tecla is not None:
                texto.set_accel(tecla, modificadores)
                atajos[tecla] = accion
            item.add(texto)
            item.connect("activate", lambda _item, ejecutar=accion: ejecutar())
            menu.append(item)
        menu.show_all()

        editar = Gtk.MenuButton(label=traducir("Editar"))
        editar.set_popup(menu)
        barra.pack_end(editar, False, False, 0)

        def pulsar_tecla(_terminal, evento):
            estado = evento.state & Gtk.accelerator_get_default_mod_mask()
            accion = atajos.get(Gdk.keyval_to_lower(evento.keyval))
            if estado != modificadores or accion is None:
                return False
            accion()
            return True

        def mostrar_menu(_terminal, evento=None):
            if evento is not None:
                if evento.button != 3:
                    return False
                menu.popup_at_pointer(evento)
            else:
                menu.popup_at_widget(self.terminal, Gdk.Gravity.CENTER, Gdk.Gravity.CENTER, None)
            return True

        self.terminal.connect("key-press-event", pulsar_tecla)
        self.terminal.connect("button-press-event", mostrar_menu)
        self.terminal.connect("popup-menu", mostrar_menu)

    def _cambiar_pestana_terminal(self, _notebook, pagina, _numero):
        if pagina != self.pagina_terminal or self.ventana_terminal is not None:
            return
        if not self.terminal_started:
            self._iniciar_terminal()
        self.terminal.grab_focus()

    def _alternar_ventana_terminal(self, _boton):
        if self.ventana_terminal is not None:
            self._acoplar_terminal()
            return
        ventana = Gtk.Window(title=f"AiO Debian · {traducir('Terminal')}")
        ventana.set_screen(self.get_screen())
        ventana.set_icon_name(self.get_icon_name())
        ventana.set_default_size(940, 580)
        ventana.connect("delete-event", self._acoplar_terminal)
        self.ventana_terminal = ventana
        self.boton_mostrar_terminal.show()
        self.boton_separar_terminal.set_label(traducir("Volver a acoplar"))
        ventana.realize()
        # Se mueve la terminal existente para conservar la sesión y su salida.
        self.contenido_terminal.reparent(ventana)
        ventana.present()
        self.terminal.grab_focus()

    def _acoplar_terminal(self, *_args):
        ventana = self.ventana_terminal
        self.contenido_terminal.reparent(self.pagina_terminal)
        self.pagina_terminal.set_child_packing(
            self.contenido_terminal, True, True, 0, Gtk.PackType.START)
        self.boton_mostrar_terminal.hide()
        self.boton_separar_terminal.set_label(traducir("Separar terminal"))
        self.ventana_terminal = None
        ventana.destroy()
        if not self.preferencias["modo_simple"]:
            self.notebook.set_current_page(self.notebook.page_num(self.pagina_terminal))
            self.present()
            self.terminal.grab_focus()
        return True

    def _comprobar_btop(self, boton):
        if self.ventana_btop is not None:
            self.ventana_btop.present()
            return
        boton.set_sensitive(False)
        self.terminal_status.set_text(traducir("Comprobando %s…") % "btop")

        def comprobar():
            try:
                resultado = subprocess.run(
                    comando_host("sh", "-c", "command -v btop >/dev/null || exit 1"),
                    capture_output=True, text=True, timeout=10,
                )
                ausente = resultado.returncode == 1 and not resultado.stderr.strip()
                error = None if resultado.returncode == 0 or ausente else (
                    resultado.stderr.strip() or str(resultado.returncode))
            except (OSError, subprocess.SubprocessError) as exc:
                ausente, error = False, str(exc)
            GLib.idle_add(self._btop_comprobado, ausente, error)

        threading.Thread(target=comprobar, daemon=True).start()

    def _btop_comprobado(self, ausente, error):
        if self.destruida:
            return GLib.SOURCE_REMOVE
        self.terminal_buttons["btop"].set_sensitive(True)
        self.terminal_status.set_text("")
        if error:
            self.terminal_status.set_text(traducir("No se pudo ejecutar %s.") % "btop" + " " + error)
        elif not ausente:
            self._abrir_btop()
        elif (self.backup_action_in_progress or self.en_curso or self.diagnostico_en_curso
              or self.comprobando_actualizacion or self.programando or self.grub_action_in_progress):
            self.terminal_status.set_text(traducir("Hay otra operación en curso."))
        else:
            dialogo = Gtk.MessageDialog(
                transient_for=self.terminal.get_toplevel(), modal=True,
                message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                text=traducir("¿Quieres instalar %s en formato %s?") % ("btop", traducir("DEB (APT)")),
            )
            dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
            dialogo.add_button(traducir("Instalar"), Gtk.ResponseType.OK)
            dialogo.set_default_response(Gtk.ResponseType.CANCEL)
            instalar = dialogo.run() == Gtk.ResponseType.OK
            dialogo.destroy()
            if instalar:
                app = next(item for item in APPS_RECOMENDADAS if item["id"] == "btop")
                self.terminal_buttons["btop"].set_sensitive(False)
                self.terminal_status.set_text(traducir("Instalando %s…") % "btop")
                self._instalar_app_recomendada(app, self.canales_recomendados["btop"][0],
                                               self._btop_instalado)
        return GLib.SOURCE_REMOVE

    def _btop_instalado(self, app, canal, error):
        self.backup_action_in_progress = False
        if self.destruida:
            return GLib.SOURCE_REMOVE
        self.recommended_status.set_text("")
        self._actualizar_sensibilidad()
        self.terminal_buttons["btop"].set_sensitive(True)
        if error:
            self.terminal_status.set_text(
                traducir("No se pudo instalar %s.") % "btop" + " " + error)
        else:
            self._marcar_recomendada_instalada(app["id"], canal["type"])
            self.terminal_status.set_text("")
            self._abrir_btop()
        return GLib.SOURCE_REMOVE

    def _abrir_btop(self):
        ventana = Gtk.Window(title="btop")
        ventana.set_icon_name("aio-debian-gui")
        ventana.set_default_size(940, 580)
        visor = Vte.Terminal()
        ventana.add(visor)
        self.ventana_btop = ventana
        ventana.connect("destroy", lambda _ventana: setattr(self, "ventana_btop", None))
        visor.connect("child-exited", lambda *_args: ventana.destroy())
        ventana.show_all()
        visor.grab_focus()
        argv = comando_host("btop")
        if es_flatpak():
            argv = comando_host("script", "-qefc", "exec btop", "/dev/null")

        def iniciado(_terminal, _pid, error, _data):
            if error is not None and self.ventana_btop is ventana:
                ventana.destroy()
                self.terminal_status.set_text(
                    traducir("No se pudo ejecutar %s.") % "btop" + " " + error.message)

        visor.spawn_async(Vte.PtyFlags.DEFAULT, None, argv, None, GLib.SpawnFlags.SEARCH_PATH,
                          None, None, -1, None, iniciado, None)

    def _ejecutar_acceso_terminal(self, boton, clave):
        comandos = {
            "clear": ("clear",),
            "fastfetch": ("fastfetch",),
            "nautilus": ("nautilus", "admin:/"),
        }
        comando = comandos[clave]
        boton.set_sensitive(False)
        self.terminal_status.set_text("")

        def ejecutar():
            try:
                # clear necesita TERM también cuando se ejecuta en el anfitrión.
                argv = comando_host("env", "TERM=xterm-256color", *comando)
                if clave == "nautilus":
                    proceso = subprocess.Popen(
                        argv, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE
                    )
                    GLib.idle_add(boton.set_sensitive, True)
                    _, stderr = proceso.communicate()
                    salida, codigo = b"", proceso.returncode
                else:
                    resultado = subprocess.run(argv, capture_output=True, timeout=30)
                    salida, stderr, codigo = resultado.stdout, resultado.stderr, resultado.returncode
                error = stderr.decode("utf-8", errors="replace").strip()
                if codigo:
                    error = error or f"Exit status {codigo}"
                    salida = b""
                else:
                    error = ""
            except (OSError, subprocess.SubprocessError) as exc:
                salida, error = b"", str(exc)
            GLib.idle_add(terminar, salida, error)

        def terminar(salida, error):
            boton.set_sensitive(True)
            if error:
                self.terminal_status.set_text(
                    (traducir("No se pudo ejecutar %s.") % " ".join(comando)) + " " + error
                )
            elif salida:
                if clave == "fastfetch":
                    salida = b"\r\n" + salida.replace(b"\n", b"\r\n")
                self.terminal.feed(salida)
            return False

        threading.Thread(target=ejecutar, daemon=True).start()

    def _iniciar_terminal(self, _boton=None):
        if self.terminal_started:
            return
        self.terminal_started = True
        self.terminal_restart.hide()
        self.terminal_status.set_text("")
        argv = comando_host("/bin/bash", "-i")
        if es_flatpak():
            # flatpak-spawn no da terminal de control; script crea uno en el anfitrión.
            argv = comando_host("script", "-qefc", "/bin/bash -i", "/dev/null")
        self.terminal.spawn_async(
            Vte.PtyFlags.DEFAULT, None, argv, None, GLib.SpawnFlags.DEFAULT,
            None, None, -1, None, self._terminal_iniciada, None,
        )

    def _terminal_iniciada(self, _terminal, _pid, error, _data):
        if error is not None:
            self.terminal_started = False
            self.terminal_status.set_text(traducir("No se pudo iniciar la terminal.") + " " + error.message)
            self.terminal_restart.show()

    def _terminal_finalizada(self, _terminal, _status):
        self.terminal_started = False
        self.terminal_status.set_text(traducir("La sesión de terminal ha terminado."))
        self.terminal_restart.show()

    def _refrescar_recomendadas_al_volver(self, _ventana, _evento):
        if self.notebook.get_current_page() == 2:
            self._cambiar_pestana_recomendadas(self.notebook, None, 2)
        return False

    def _cambiar_pestana_recomendadas(self, _notebook, _pagina, numero):
        if numero != 2 or self.backup_action_in_progress:
            return
        self.recommended_scan_generation += 1
        generation = self.recommended_scan_generation
        self.recommended_installed.clear()
        for indicador in self.recommended_indicators.values():
            indicador.hide()
        self._actualizar_sensibilidad()

        def comprobar():
            estados, errores = {}, []
            try:
                flatpaks = self._flatpaks_recomendadas_instaladas()
            except (OSError, subprocess.SubprocessError, RuntimeError) as exc:
                flatpaks = None
                errores.append(str(exc))
            for app in APPS_RECOMENDADAS:
                for canal in self.canales_recomendados[app["id"]]:
                    if canal["type"] == "appimage":
                        continue
                    clave = (app["id"], canal["type"])
                    try:
                        if canal["type"] == "flatpak":
                            if flatpaks is not None:
                                estados[clave] = canal["app_id"] in flatpaks
                        else:
                            estados[clave] = self._comprobar_deb_recomendada(canal["package"])
                    except (OSError, subprocess.SubprocessError, RuntimeError) as exc:
                        errores.append(str(exc))
            GLib.idle_add(self._recomendadas_comprobadas, generation, estados, errores)

        threading.Thread(target=comprobar, daemon=True).start()

    def _recomendadas_comprobadas(self, generation, estados, errores):
        if generation != self.recommended_scan_generation:
            return GLib.SOURCE_REMOVE
        self.recommended_installed = estados
        for clave, indicador in self.recommended_indicators.items():
            indicador.set_visible(estados.get(clave) is True)
        if errores:
            self.recommended_status.set_text(traducir("No se pudo comprobar el estado de algunas aplicaciones."))
            self.recommended_status.set_tooltip_text("\n".join(errores))
        else:
            self.recommended_status.set_text("")
            self.recommended_status.set_tooltip_text(None)
        self._actualizar_sensibilidad()
        return GLib.SOURCE_REMOVE

    def _marcar_recomendada_instalada(self, app_id, tipo_canal):
        clave = (app_id, tipo_canal)
        self.recommended_installed[clave] = True
        self.recommended_indicators[clave].show()
        self._actualizar_sensibilidad()

    def _alternar_seleccion_recomendada(self, boton):
        if boton.get_active():
            self.recommended_status.set_text(traducir(
                "Elige DEB (APT) o Flatpak para cada aplicación que quieras instalar."))
        else:
            self.recommended_selection.clear()
            self.recommended_status.set_text("")
        self._actualizar_sensibilidad()

    def _instalar_seleccion_recomendada(self, boton):
        if not boton.get_sensitive():
            return
        seleccion = [
            (app, canal)
            for app in APPS_RECOMENDADAS if app["id"] in self.recommended_selection
            for canal in self.canales_recomendados[app["id"]]
            if canal["type"] == self.recommended_selection[app["id"]]
            and not self.recommended_installed.get((app["id"], canal["type"]))
        ]
        if not seleccion:
            return
        self.recommended_scan_generation += 1
        self.backup_action_in_progress = True
        self.recommended_status.set_text(traducir("Instalando aplicaciones…"))
        self._actualizar_sensibilidad()

        def instalar():
            resultados = [
                (app, canal, self._ejecutar_instalacion_recomendada(app, canal))
                for app, canal in seleccion
            ]
            GLib.idle_add(self._seleccion_recomendada_instalada, resultados)

        threading.Thread(target=instalar, daemon=True).start()

    def _seleccion_recomendada_instalada(self, resultados):
        if self.destruida:
            return GLib.SOURCE_REMOVE
        errores = []
        for app, canal, error in resultados:
            if error is None:
                self.recommended_selection.pop(app["id"], None)
                self._marcar_recomendada_instalada(app["id"], canal["type"])
            else:
                errores.append(f'{app["name"]}: {error}')
        self.backup_action_in_progress = False
        if errores:
            mensaje = "Algunas aplicaciones no se pudieron instalar."
            self.recommended_status.set_text(traducir(mensaje))
            self._actualizar_sensibilidad()
            self._mensaje(Gtk.MessageType.ERROR, mensaje, "\n\n".join(errores))
            return GLib.SOURCE_REMOVE
        else:
            self.recommended_status.set_text(traducir("Se instalaron las aplicaciones seleccionadas."))
        self._actualizar_sensibilidad()
        return GLib.SOURCE_REMOVE

    def _accion_app_recomendada(self, _boton, app_id, tipo_canal):
        app = next((item for item in APPS_RECOMENDADAS if item["id"] == app_id), None)
        if app is None:
            return
        canal = next((item for item in self.canales_recomendados[app_id] if item["type"] == tipo_canal), None)
        if canal is None:
            return
        if (self.backup_action_in_progress or self.en_curso or self.diagnostico_en_curso
                or self.comprobando_actualizacion or self.programando
                or self.recommended_installed.get((app_id, tipo_canal)) is True):
            return
        if tipo_canal == "appimage":
            self._descargar_appimage_ghostty()
            return
        if self.recommended_multi.get_active():
            if tipo_canal in ("deb", "flatpak"):
                if self.recommended_selection.get(app_id) == tipo_canal:
                    del self.recommended_selection[app_id]
                else:
                    self.recommended_selection[app_id] = tipo_canal
                self._actualizar_sensibilidad()
            return
        self.recommended_scan_generation += 1
        self.backup_action_in_progress = True
        self.recommended_status.set_text(traducir("Comprobando %s…") % app["name"])
        self._actualizar_sensibilidad()

        def comprobar():
            try:
                if tipo_canal in ("deb", "deb-download"):
                    instalado = self._comprobar_deb_recomendada(canal["package"])
                else:
                    instalado = canal["app_id"] in self._flatpaks_recomendadas_instaladas()
                accion, error = ("installed" if instalado else "install"), None
            except (OSError, subprocess.SubprocessError, RuntimeError) as exc:
                accion, error = None, str(exc)
            GLib.idle_add(self._app_recomendada_comprobada, app_id, tipo_canal, accion, error)

        threading.Thread(target=comprobar, daemon=True).start()

    def _descargar_appimage_ghostty(self):
        self.backup_action_in_progress = True
        self.recommended_status.set_text(traducir("Comprobando %s…") % "Ghostty")
        self._actualizar_sensibilidad()

        def buscar():
            try:
                uri = url_appimage_ghostty(os.uname().machine)
            except (OSError, ValueError, RuntimeError) as exc:
                GLib.idle_add(self._abrir_appimage_ghostty, None, str(exc))
            else:
                GLib.idle_add(self._abrir_appimage_ghostty, uri, None)

        threading.Thread(target=buscar, daemon=True).start()

    def _abrir_appimage_ghostty(self, uri, error):
        if self.destruida:
            return GLib.SOURCE_REMOVE
        self.backup_action_in_progress = False
        self.recommended_status.set_text("")
        self._actualizar_sensibilidad()
        if not error:
            try:
                Gio.AppInfo.launch_default_for_uri(uri, None)
            except GLib.Error as exc:
                error = exc.message
        if error:
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo descargar la AppImage de Ghostty", error)
        return GLib.SOURCE_REMOVE

    def _app_recomendada_comprobada(self, app_id, tipo_canal, accion, error):
        self.backup_action_in_progress = False
        self.recommended_status.set_text("")
        self._actualizar_sensibilidad()
        app = next(item for item in APPS_RECOMENDADAS if item["id"] == app_id)
        canal = next(item for item in self.canales_recomendados[app_id] if item["type"] == tipo_canal)
        if error:
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo comprobar %s" % app["name"], error)
            return GLib.SOURCE_REMOVE
        if accion == "installed":
            self._marcar_recomendada_instalada(app_id, tipo_canal)
            return GLib.SOURCE_REMOVE
        if tipo_canal == "deb-download":
            try:
                Gio.AppInfo.launch_default_for_uri(canal["uri"], None)
                self.recommended_status.set_text(traducir(
                    "Se abrió la página oficial para descargar el paquete .deb."
                ))
            except GLib.Error as exc:
                self._mensaje(Gtk.MessageType.ERROR, "No se pudo abrir la página oficial.", exc.message)
            return GLib.SOURCE_REMOVE
        fuente = traducir("DEB (APT)") if tipo_canal == "deb" else traducir("Flatpak")
        dialogo = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE,
            text=traducir("¿Quieres instalar %s en formato %s?") % (app["name"], fuente),
        )
        dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
        dialogo.add_button(traducir("Instalar"), Gtk.ResponseType.OK)
        dialogo.set_default_response(Gtk.ResponseType.CANCEL)
        instalar = dialogo.run() == Gtk.ResponseType.OK
        dialogo.destroy()
        if instalar:
            self._instalar_app_recomendada(app, canal)
        return GLib.SOURCE_REMOVE

    def _instalar_app_recomendada(self, app, canal, al_terminar=None):
        if self.backup_action_in_progress:
            return
        self.backup_action_in_progress = True
        self.recommended_status.set_text(traducir("Instalando %s…") % app["name"])
        self._actualizar_sensibilidad()

        def instalar():
            error = self._ejecutar_instalacion_recomendada(app, canal)
            GLib.idle_add(al_terminar or self._app_recomendada_instalada, app, canal, error)

        threading.Thread(target=instalar, daemon=True).start()

    def _ejecutar_instalacion_recomendada(self, app, canal):
        tipo_canal = canal["type"]
        error = None
        try:
            if tipo_canal == "deb":
                helper = helper_mantenimiento()
                if not helper_disponible(helper):
                    raise RuntimeError("No se encuentra el asistente de mantenimiento.")
                if usa_integracion_portable() and not core_host_integration.compatible_helper(
                        formato_actualizacion(), helper):
                    raise RuntimeError(traducir(
                        "No se encuentra el asistente actualizado en el anfitrión. Instala la integración desde su guía y vuelve a intentarlo."
                    ))
                proc = subprocess.run(
                    comando_pkexec(helper, "C.UTF-8", "--recommended-install", app["id"]),
                    capture_output=True, text=True, timeout=600,
                )
                marcador = "##RECOMMENDED:installed:%s" % app["id"]
                if proc.returncode or marcador not in proc.stdout.splitlines():
                    error = (proc.stderr or proc.stdout or
                             "El asistente no confirmó la instalación.").strip()[-1600:]
            else:
                remote = subprocess.run(
                    comando_host("flatpak", "remote-add", "--user", "--if-not-exists",
                                 "flathub", "https://dl.flathub.org/repo/flathub.flatpakrepo"),
                    capture_output=True, text=True, timeout=60,
                )
                if remote.returncode:
                    raise RuntimeError(traducir(
                        "No se pudo configurar Flathub para tu usuario. Comprueba que Flatpak y la conexión estén disponibles e inténtalo de nuevo."
                    ))
                proc = subprocess.run(
                    comando_host("flatpak", "install", "--user", "--noninteractive",
                                 "--assumeyes", "flathub", canal["app_id"]),
                    capture_output=True, text=True, timeout=600,
                )
                if proc.returncode:
                    error = (proc.stderr or proc.stdout or
                             "Flatpak no confirmó la instalación.").strip()[-1600:]
        except (OSError, subprocess.SubprocessError, RuntimeError) as exc:
            error = str(exc)
        return error

    def _app_recomendada_instalada(self, app, canal, error):
        self.backup_action_in_progress = False
        self.recommended_status.set_text("")
        self._actualizar_sensibilidad()
        if error:
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo instalar %s" % app["name"], error)
            return GLib.SOURCE_REMOVE
        self._marcar_recomendada_instalada(app["id"], canal["type"])
        return GLib.SOURCE_REMOVE

    def _adaptar_paneles(self, _ventana, allocation):
        estrecha = allocation.width < 900
        apilados = self.paneles_principales.get_orientation() == Gtk.Orientation.VERTICAL
        ajustar_consola = (self.expansor_consola.get_expanded() and
                           self.marco_consola.get_min_content_height() !=
                           self._altura_consola(allocation.width, allocation.height))
        if self.adaptacion_paneles is None and (estrecha != apilados or ajustar_consola):
            self.adaptacion_paneles = GLib.idle_add(self._aplicar_disposicion)

    def _aplicar_disposicion(self):
        self.adaptacion_paneles = None
        if self.destruida:
            return GLib.SOURCE_REMOVE
        estrecha = self.get_allocated_width() < 900
        orientacion = Gtk.Orientation.VERTICAL if estrecha else Gtk.Orientation.HORIZONTAL
        if self.paneles_principales.get_orientation() != orientacion:
            self.paneles_principales.set_orientation(orientacion)
            self.separador_paneles.set_orientation(
                Gtk.Orientation.HORIZONTAL if estrecha else Gtk.Orientation.VERTICAL)
            self.seleccion_detalle.set_expanded(not estrecha)
        self._ajustar_consola()
        return GLib.SOURCE_REMOVE

    @staticmethod
    def _altura_consola(ancho, alto):
        reserva = 550 if ancho < 900 else 330
        return max(132, min(360, alto * 2 // 5, alto - reserva))

    def _ajustar_consola(self, *_args):
        if self.expansor_consola.get_expanded():
            alto = self._altura_consola(self.get_allocated_width(), self.get_allocated_height())
            self.marco_consola.set_min_content_height(alto)

    def _actualizar_seleccion(self):
        pasos = self._pasos_seleccionados()
        cantidad = len(pasos)
        self.btn_iniciar.set_label(traducir("Trabajando…") if self.en_curso else
            (traducir("Ejecutar 1 tarea") if cantidad == 1 else traducir("Ejecutar %d tareas") % cantidad))
        nombres = {p[0]: traducir(p[1]) for p in PASOS}
        detalle = "\n".join("• " + nombres[p] for p in pasos)
        self.resumen_seleccion.set_text(detalle or traducir("No hay tareas seleccionadas."))

    def _resumir_diagnostico(self, resultados, error=None):
        estado = "No comprobado"
        if not error and resultados:
            estados = {r["status"] for r in resultados}
            if estados & {"critical", "warning"}:
                estado = "Requiere atención"
            elif estados == {"ok"}:
                estado = "Sin incidencias"
        self.estado_diagnostico = estado
        self.salud_sistema.set_text(traducir(estado))
        incidencias = [r for r in resultados if r["status"] in ("critical", "warning", "unknown")]
        incidencias.sort(key=lambda r: {"critical": 0, "warning": 1, "unknown": 2}[r["status"]])
        if error:
            consejo = traducir("No se pudo completar el diagnóstico: ") + error
        elif incidencias:
            primera = incidencias[0]
            consejo = traducir(primera["name"]) + ": " + traducir(primera["advice"] or primera["detail"])
        elif resultados:
            consejo = traducir("No se detectaron incidencias en las comprobaciones realizadas.")
        else:
            consejo = traducir("Ejecuta el diagnóstico para revisar el estado del sistema.")
        self.consejo_sistema.set_text(consejo)

    def _preparar_resultados(self, pasos):
        for widget in self.resumen_ejecucion.get_children():
            widget.destroy()
        self.resultados_tareas = {}
        nombres = {p[0]: traducir(p[1]) for p in PASOS}
        for tarea in pasos:
            linea = etiqueta("")
            linea.set_max_width_chars(80)
            linea.set_tooltip_text(nombres[tarea])
            self.resumen_ejecucion.pack_start(linea, False, False, 0)
            self.resultados_tareas[tarea] = (linea, "Pendiente")
            self._resultado_tarea(tarea, "Pendiente")
        self.scroll_resultados.show()
        self.resumen_ejecucion.show_all()

    def _resultado_tarea(self, tarea, estado):
        if tarea not in self.resultados_tareas:
            return
        nombres = {p[0]: traducir(p[1]) for p in PASOS}
        linea, _anterior = self.resultados_tareas[tarea]
        simbolos = {"Pendiente": "○", "En curso": "▶", "Completada": "✓", "Error": "!", "No ejecutada": "–"}
        linea.set_text(simbolos[estado] + " " + nombres[tarea] + " · " + traducir(estado))
        self.resultados_tareas[tarea] = (linea, estado)
        if estado == "Error" and not self.preferencias["modo_simple"]:
            self.expansor_consola.show()
            self.expansor_consola.set_expanded(True)

    def _abrir_terminal(self, _boton=None):
        if self.ventana_terminal is not None:
            self.ventana_terminal.present()
            self.terminal.grab_focus()
        elif not self.preferencias["modo_simple"]:
            self.notebook.set_current_page(self.notebook.page_num(self.pagina_terminal))

    def _desplazar_consola(self, vista):
        marca = self.buf.create_mark(None, self.buf.get_end_iter(), False)
        vista.scroll_to_mark(marca, 0.0, False, 0, 0)
        self.buf.delete_mark(marca)

    def _borrar_consola(self, _boton):
        if not self.en_curso:
            self.buf.set_text("")

    def _tarjeta_info(self):
        marco, caja = tarjeta_mantenimiento(9)
        titulo = cabecera_mantenimiento("Información del sistema", "computer-symbolic")
        caja.pack_start(titulo, False, False, 0)
        self.btn_diagnostico = Gtk.Button(label=traducir("Diagnosticar"))
        self.btn_diagnostico.set_tooltip_text(traducir(
            "Comprobar el sistema sin realizar modificaciones"))
        self.btn_diagnostico.connect("clicked", self._abrir_diagnostico)
        self.btn_diagnostico.set_image(Gtk.Image.new_from_icon_name(
            "edit-find-symbolic", Gtk.IconSize.BUTTON))
        self.btn_diagnostico.set_always_show_image(True)
        self.btn_diagnostico.set_halign(Gtk.Align.START)

        self.ventana_detalles_sistema = None
        self.btn_detalles_sistema = Gtk.Button(label=traducir("Detalles técnicos"))
        self.btn_detalles_sistema.set_halign(Gtk.Align.START)
        self.btn_detalles_sistema.connect("clicked", self._abrir_detalles_sistema)
        self.salud_sistema = etiqueta("No comprobado")
        self.salud_sistema.get_style_context().add_class("dim-label")
        caja.pack_start(etiqueta(sistema_operativo()), False, False, 0)
        caja.pack_start(self.salud_sistema, False, False, 0)
        self.consejo_sistema = etiqueta("Ejecuta el diagnóstico para revisar el estado del sistema.", dim=True)
        caja.pack_start(self.consejo_sistema, False, False, 0)
        caja.pack_start(self.btn_diagnostico, False, False, 0)
        caja.pack_start(self.btn_detalles_sistema, False, False, 0)
        fastfetch = Gtk.Button(label=traducir("Aplicar diseño de Fastfetch"))
        fastfetch.set_tooltip_text(traducir("Guarda una copia de la configuración anterior de Fastfetch."))
        fastfetch.set_halign(Gtk.Align.START)
        fastfetch.connect("clicked", self._aplicar_diseno_fastfetch)
        caja.pack_start(fastfetch, False, False, 0)
        restaurar = Gtk.Button(label=traducir("Restaurar diseño anterior de Fastfetch"))
        restaurar.set_halign(Gtk.Align.START)
        restaurar.get_child().set_line_wrap(True)
        restaurar.get_child().set_max_width_chars(26)
        restaurar.connect("clicked", self._restaurar_diseno_fastfetch)
        caja.pack_start(restaurar, False, False, 0)

        if self.distribucion == "debian":
            self.nvidia_info_label = etiqueta("Buscando GPU NVIDIA…", dim=True)
        return marco

    def _abrir_detalles_sistema(self, _boton):
        ancho, alto = self.get_size()
        dialogo = self.ventana_detalles_sistema
        if dialogo is None:
            dialogo = self._crear_detalles_sistema()
            self.ventana_detalles_sistema = dialogo
            dialogo.set_default_size(ancho, min(alto, 640))
        else:
            dialogo.resize(ancho, dialogo.get_size()[1])
        self._actualizar_detalles_sistema()
        dialogo.show_all()
        dialogo.present()

    def _crear_detalles_sistema(self):
        dialogo = Gtk.Dialog(title=traducir("Detalles técnicos"), transient_for=self,
                              destroy_with_parent=True)
        dialogo.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
        dialogo.add_button(traducir("Cerrar"), Gtk.ResponseType.CLOSE)
        dialogo.connect("response", lambda ventana, _respuesta: ventana.hide())
        dialogo.connect("delete-event", lambda ventana, _evento: ventana.hide_on_delete())

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        dialogo.get_content_area().pack_start(scroll, True, True, 0)
        detalles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        detalles.set_border_width(20)
        scroll.add(detalles)

        ruta_logo, nombre_logo = logo_distribucion(self.distribucion)
        if ruta_logo and os.path.isfile(ruta_logo):
            try:
                imagen_logo = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    ruta_logo, 100, 100, True)
                logo = Gtk.Image.new_from_pixbuf(imagen_logo)
                logo.set_tooltip_text(traducir(nombre_logo))
                logo.set_halign(Gtk.Align.CENTER)
                logo.get_accessible().set_name(traducir(nombre_logo))
                detalles.pack_start(logo, False, False, 6)
            except GLib.Error:
                pass

        self.grid_detalles_sistema = Gtk.Grid(column_spacing=16, row_spacing=10)
        detalles.pack_start(self.grid_detalles_sistema, False, False, 0)
        if self.distribucion == "debian":
            self.nvidia_info_label.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            detalles.pack_start(self.nvidia_info_label, False, False, 0)
        return dialogo

    def _actualizar_detalles_sistema(self):
        filas, _ = informacion_sistema()
        grid = self.grid_detalles_sistema
        for widget in grid.get_children():
            widget.destroy()
        for i, (clave, valor) in enumerate(filas):
            nombre = etiqueta(clave, dim=True)
            nombre.set_max_width_chars(20)
            grid.attach(nombre, 0, i, 1, 1)
            dato = etiqueta(valor)
            dato.set_hexpand(True)
            dato.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            dato.set_selectable(True)
            grid.attach(dato, 1, i, 1, 1)

    def _aplicar_diseno_fastfetch(self, _boton):
        titulo = traducir("Diseño de Fastfetch")
        try:
            copia = instalar_layout(FASTFETCH_LAYOUT, GLib.get_user_config_dir())
        except (OSError, RuntimeError) as error:
            self._mensaje(Gtk.MessageType.ERROR, titulo,
                          traducir("No se pudo aplicar el diseño de Fastfetch.") + "\n" + str(error))
            return
        mensaje = traducir("El diseño de Fastfetch está activo.")
        if copia:
            mensaje += "\n" + traducir("Copia de la configuración anterior: %s") % copia
        self._mensaje(Gtk.MessageType.INFO, titulo, mensaje)

    def _restaurar_diseno_fastfetch(self, _boton):
        titulo = traducir("Diseño de Fastfetch")
        try:
            restaurado = restaurar_layout(FASTFETCH_LAYOUT, GLib.get_user_config_dir())
        except (OSError, RuntimeError, ValueError) as error:
            self._mensaje(Gtk.MessageType.ERROR, titulo,
                          traducir("No se pudo restaurar el diseño de Fastfetch.") + "\n" + str(error))
            return
        mensaje = ("Se restauró el diseño anterior de Fastfetch." if restaurado
                   else "El diseño de AiO no está activo o se ha modificado.")
        self._mensaje(Gtk.MessageType.INFO, titulo, traducir(mensaje))

    def _tarjeta_seleccion(self):
        marco, caja = tarjeta_mantenimiento(8)
        self.seleccion_detalle = Gtk.Expander(label=traducir("<b>Tu selección</b>"))
        self.seleccion_detalle.set_use_markup(True)
        self.seleccion_detalle.set_expanded(True)
        self.resumen_seleccion = etiqueta("")
        self.resumen_seleccion.set_max_width_chars(38)
        self.resumen_seleccion.set_margin_top(8)
        self.seleccion_detalle.add(self.resumen_seleccion)
        caja.pack_start(self.seleccion_detalle, False, False, 0)
        return marco

    def _abrir_diagnostico(self, _boton=None):
        if self.en_curso or self.programando or self.comprobando_actualizacion:
            return
        if self.diagnostico_en_curso:
            if self.ventana_diagnostico is not None:
                self.ventana_diagnostico.present()
            return
        if self.ventana_diagnostico is not None:
            self.ventana_diagnostico.present()
            return

        dialogo = Gtk.Dialog(
            title=traducir("Diagnóstico preventivo del sistema"),
            transient_for=self, modal=False,
        )
        dialogo.set_default_size(730, 540)
        dialogo.add_button(traducir("Cerrar"), Gtk.ResponseType.CLOSE)
        dialogo.connect("response", lambda d, _response: d.destroy())
        dialogo.connect("destroy", self._diagnostico_cerrado)
        self.ventana_diagnostico = dialogo
        contenedor = dialogo.get_content_area()
        contenedor.set_spacing(10)
        contenedor.set_border_width(12)
        aviso = etiqueta(traducir(
            "Antes del diagnóstico se actualizarán los índices APT con autorización de administrador. "
            "No se instalarán ni eliminarán paquetes."), dim=True)
        contenedor.pack_start(aviso, False, False, 0)
        self.etiqueta_diagnostico = etiqueta(traducir("Actualizando índices APT y analizando el sistema…"))
        contenedor.pack_start(self.etiqueta_diagnostico, False, False, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        contenedor.pack_start(scroll, True, True, 0)
        self.lista_diagnostico = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scroll.add(self.lista_diagnostico)
        dialogo.show_all()
        self.diagnostico_en_curso = True
        self._actualizar_sensibilidad()
        self.btn_actualizar_diagnostico = None
        formato = formato_actualizacion()
        version_instalada = version_app(para_apt=True) if formato == "deb" else version_app()

        def analizar():
            try:
                helper = helper_mantenimiento()
                error_apt = core_diagnostics.refresh_apt_indices(
                    comando_pkexec(helper, "C.UTF-8", "--refresh-diagnostic-apt"))
                resultados = (core_diagnostics.run_host_diagnostics() if es_flatpak()
                              else core_diagnostics.run_diagnostics())
                if error_apt:
                    resultados.insert(0, {
                        "name": "Índices de APT", "status": "unknown",
                        "detail": "No se pudieron actualizar los índices APT; los resultados pueden estar desactualizados.",
                        "advice": error_apt,
                        "action": ("integration" if formato in ("flatpak", "appimage") else None),
                    })
                    for resultado in resultados[1:]:
                        if resultado["name"] in ("Actualizaciones pendientes", "Índices de APT"):
                            resultado.update(status="unknown",
                                detail="No se pudieron verificar las actualizaciones con índices APT actualizados.",
                                advice="")
                estado_app = core_updates.estado_actualizacion_app(
                    formato, version_instalada, APP_ID_FLATPAK)
                if error_apt and formato == "deb":
                    estado_app = {"status": "unknown",
                                  "detail": "No se pudieron verificar las actualizaciones con índices APT actualizados."}
                estado = {
                    "available": "warning", "current": "ok",
                    "unknown": "unknown", "unsupported": "unknown",
                }.get(estado_app["status"], "unknown")
                resultados.append({
                    "name": "Versión de AiO Debian GUI",
                    "status": estado,
                    "detail": estado_app["detail"],
                    "advice": ("Hay una actualización disponible. Puedes instalarla desde aquí."
                               if estado_app["status"] == "available" else ""),
                    "action": ("update" if estado_app["status"] == "available" else None),
                })
                error = None
            except Exception as exc:
                resultados = []
                error = str(exc)
            GLib.idle_add(self._diagnostico_terminado, dialogo, resultados, error)
        threading.Thread(target=analizar, daemon=True).start()

    def _actualizar_desde_diagnostico(self, _boton):
        if self.en_curso or self.comprobando_actualizacion:
            return
        if self.ventana_diagnostico is not None:
            self.ventana_diagnostico.destroy()
        self._buscar_actualizacion(None)

    def _diagnostico_cerrado(self, dialogo):
        if self.ventana_diagnostico is dialogo:
            self.ventana_diagnostico = None
            self.btn_actualizar_diagnostico = None

    def _diagnostico_terminado(self, dialogo, resultados, error):
        self.diagnostico_en_curso = False
        self._actualizar_sensibilidad()
        self._resumir_diagnostico(resultados, error)
        if self.ventana_diagnostico is not dialogo:
            return GLib.SOURCE_REMOVE
        if error is not None:
            self.etiqueta_diagnostico.set_text(
                traducir("No se pudo completar el diagnóstico: ") + error)
            return GLib.SOURCE_REMOVE
        recuento = {
            estado: sum(f["status"] == estado for f in resultados)
            for estado in ("critical", "warning", "unknown", "ok")
        }
        self.etiqueta_diagnostico.set_text(
            traducir(self.estado_diagnostico) + " · " +
            "%s: %s · %s: %s · %s: %s · %s: %s"
            % (traducir("Críticos"), recuento["critical"],
               traducir("Avisos"), recuento["warning"],
               traducir("No comprobados"), recuento["unknown"],
               traducir("Correctos"), recuento["ok"]))
        estados = {
            "critical": ("dialog-error-symbolic", "Requiere atención"),
            "warning": ("dialog-warning-symbolic", "Revisar"),
            "unknown": ("dialog-question-symbolic", "Sin comprobar"),
            "ok": ("emblem-ok-symbolic", "Correcto"),
        }
        for resultado in resultados:
            icono, estado = estados.get(resultado["status"], estados["unknown"])
            fila = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            fila.set_margin_top(6)
            fila.set_margin_bottom(6)
            fila.pack_start(
                Gtk.Image.new_from_icon_name(icono, Gtk.IconSize.BUTTON),
                False, False, 0)
            bloque = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            titulo = etiqueta("<b>%s</b> · %s" % (
                GLib.markup_escape_text(traducir(resultado["name"])),
                GLib.markup_escape_text(traducir(estado))), markup=True)
            bloque.pack_start(titulo, False, False, 0)
            detalle = etiqueta(traducir_detalle_diagnostico(resultado["detail"]), dim=True)
            detalle.set_selectable(True)
            bloque.pack_start(detalle, False, False, 0)
            if resultado["advice"]:
                bloque.pack_start(etiqueta(traducir(resultado["advice"])), False, False, 0)
            fila.pack_start(bloque, True, True, 0)
            if resultado.get("action") == "update":
                boton = Gtk.Button(label=traducir("Actualizar AiO"))
                boton.set_tooltip_text(traducir(
                    "Instalar la versión disponible con el actualizador de AiO"))
                boton.set_sensitive(not self.en_curso and
                                    not self.comprobando_actualizacion)
                boton.connect("clicked", self._actualizar_desde_diagnostico)
                fila.pack_end(boton, False, False, 0)
                self.btn_actualizar_diagnostico = boton
            elif resultado.get("action") == "integration":
                boton = Gtk.Button(label=traducir("Guía de integración del anfitrión"))
                boton.connect("clicked", lambda _b: self._abrir_guia_integracion(parent=dialogo))
                fila.pack_end(boton, False, False, 0)
            self.lista_diagnostico.pack_start(fila, False, False, 0)
            self.lista_diagnostico.pack_start(Gtk.Separator(), False, False, 0)
        self.lista_diagnostico.show_all()
        return GLib.SOURCE_REMOVE

    def _tarjeta_opciones(self):
        externa, tarjeta = tarjeta_mantenimiento(10)
        tarjeta.pack_start(cabecera_mantenimiento(
            "Tareas a realizar", "view-list-symbolic"), False, False, 0)

        presets = Gtk.Box()
        presets.get_style_context().add_class("linked")
        b1 = Gtk.Button(label=traducir("Completo"))
        b1.set_tooltip_text(traducir("Mantenimiento completo (valores por defecto)"))
        b1.connect("clicked", self._preset_completo)
        b2 = Gtk.Button(label=traducir("Solo Flatpak"))
        b2.set_tooltip_text(
            traducir("Saltarse el mantenimiento de APT y actualizar solo Flatpak")
        )
        b2.connect("clicked", self._preset_flatpak)
        b2.set_no_show_all(not self.flatpak_presente)
        presets.pack_start(b1, False, False, 0)
        presets.pack_start(b2, False, False, 0)
        self.botones_preset = (b1, b2)
        presets.set_halign(Gtk.Align.START)
        tarjeta.pack_start(presets, False, False, 0)

        autorizacion = Gtk.Expander(label=traducir("Autorización de administrador"))
        opciones_autorizacion = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        autorizacion.add(opciones_autorizacion)
        fila_autorizacion = Gtk.Box(spacing=12)
        fila_autorizacion.pack_start(etiqueta("No solicitar contraseña de administrador en AiO (opcional)"), True, True, 0)
        self.chk_sin_contrasena = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.chk_sin_contrasena.get_accessible().set_name(traducir("No solicitar contraseña de administrador en AiO (opcional)"))
        fila_autorizacion.pack_end(self.chk_sin_contrasena, False, False, 0)
        self.chk_sin_contrasena.set_tooltip_text(
            "Excepción persistente de Polkit solo para el asistente de AiO y este usuario local activo. "
            "Permite ejecutar todas las tareas de AiO como administrador sin contraseña; "
            "otros procesos del mismo usuario también podrían invocar el asistente. "
            "Desmarca para revocarla."
        )
        self.chk_sin_contrasena.set_active(autorizacion_sin_contrasena_activa())
        self.chk_sin_contrasena.connect("notify::active", self._cambiar_sin_contrasena)
        opciones_autorizacion.pack_start(fila_autorizacion, False, False, 0)
        opciones_autorizacion.pack_start(
            etiqueta("Por defecto Polkit solicita contraseña. Esta excepción es voluntaria y aumenta los riesgos de seguridad.", dim=True),
            False, False, 0,
        )

        grupos = (
            ("Mantenimiento habitual", "view-refresh-symbolic", {"clock", "upgrade", "autoremove", "autoclean", "flatpak-update", "snap-update", "rebootcheck"}, True),
            ("Aplicaciones y repositorios", "system-software-install-symbolic", {"repos", "tools", "flatpak-setup", "gnome-plugin", "ext-manager"}, True),
            ("Kernel y controladores · Avanzado", "preferences-system-symbolic", {"backports-kernel-mesa", "revertir-backports", "nvidia-driver", "ubuntu-hwe"}, False),
        )
        self.grupos_tareas = []
        for titulo, icono, ids, abierto in grupos:
            visibles = [p for p in PASOS if p[0] in ids and self._visible(p[0])]
            if not visibles:
                continue
            grupo = Gtk.Expander()
            grupo.set_label_widget(cabecera_mantenimiento(titulo, icono, "aio-group"))
            grupo.get_accessible().set_name(traducir(titulo))
            grupo.set_expanded(abierto)
            lista = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            lista.get_style_context().add_class("aio-tasks")
            lista.set_margin_top(4)
            grupo.add(lista)
            for pid, titulo_tarea, desc, defecto, _ in visibles:
                lista.add(self._fila(pid, titulo_tarea, desc, defecto))
            tarjeta.pack_start(grupo, False, False, 2)
            self.grupos_tareas.append(grupo)
        tarjeta.pack_start(Gtk.Separator(), False, False, 0)
        tarjeta.pack_start(autorizacion, False, False, 0)
        return externa

    def _consultar_estados_tareas(self, inicial=False):
        if self.consultando_estados:
            return
        self.consultando_estados = True
        self.consulta_inicial = inicial
        self.salida_estados = []
        if inicial:
            self.estado.set_text(traducir("Comprobando tareas ya instaladas…"))
        self._actualizar_sensibilidad()
        portable = usa_integracion_portable()
        sin_integracion = 42
        comando_estado = (
            comando_host("/bin/sh", "-c", f'[ -e "$1" ] || exit {sin_integracion}; exec "$1" --status',
                         "aio-status", HELPER_SISTEMA)
            if portable else ["bash", HELPER, "--status"]
        )

        # Do not rely on GIO stdout async EOF delivery on all desktops.
        # Only the main GTK thread updates widgets; worker collects subprocess output.
        def comprobar():
            try:
                resultado = subprocess.run(
                    comando_estado, capture_output=True, text=True,
                    timeout=15, check=False,
                )
                codigo, salida, error = (
                    resultado.returncode, resultado.stdout, resultado.stderr,
                )
            except subprocess.TimeoutExpired:
                codigo, salida, error = -1, "", (
                    "El asistente no respondió en 15 segundos."
                )
            except (OSError, subprocess.SubprocessError) as exc:
                codigo, salida, error = -1, "", str(exc)
            if portable and codigo == sin_integracion:
                GLib.idle_add(self._estados_sin_integracion)
            else:
                GLib.idle_add(self._estados_terminados, codigo, salida, error)

        threading.Thread(target=comprobar, daemon=True).start()

    def _estados_sin_integracion(self):
        if self.destruida:
            return GLib.SOURCE_REMOVE
        self._finalizar_consulta_estados(False, mensaje=traducir(
            "Para habilitar las tareas administrativas, abre la guía de integración del anfitrión."
        ))
        return GLib.SOURCE_REMOVE

    def _estados_terminados(self, codigo, salida, error=""):
        if self.destruida or not self.consultando_estados:
            return GLib.SOURCE_REMOVE
        self.salida_estados = (salida or "").splitlines()
        if codigo != 0:
            self._finalizar_consulta_estados(
                False, "El asistente terminó con código %s: %s" % (
                    codigo, (error or "sin detalles").strip()[:350],
                )
            )
            return GLib.SOURCE_REMOVE
        estados = {}
        nvidia = {}
        for linea in self.salida_estados:
            campos_nvidia = linea.split(":", 2)
            if (len(campos_nvidia) == 3 and campos_nvidia[0] == "##NVIDIA"
                    and campos_nvidia[1] in ("present", "hybrid", "installed", "candidate", "secureboot", "kernel")):
                nvidia[campos_nvidia[1]] = campos_nvidia[2]
            campos = linea.split(":")
            if (len(campos) == 3 and campos[0] == "##STATUS"
                    and campos[1] in (
                        "repos", "tools", "backports-kernel-mesa", "ubuntu-hwe",
                        "gnome-plugin", "ext-manager",
                    )
                    and campos[2] in ("0", "1")):
                estados[campos[1]] = campos[2] == "1"
        requeridos = {
            "repos", "tools", "backports-kernel-mesa", "ubuntu-hwe", "gnome-plugin", "ext-manager",
        }
        if codigo != 0 or set(estados) != requeridos:
            self._finalizar_consulta_estados(
                False, "El asistente no devolvió un estado completo de las tareas."
            )
            return

        self.nvidia_presente = nvidia.get("present") == "1"
        self.nvidia_hibrida = nvidia.get("hybrid") == "1"
        self.nvidia_instalada = nvidia.get("installed") == "1"
        self.nvidia_candidata = nvidia.get("candidate", "no-disponible")
        self.nvidia_secureboot = nvidia.get("secureboot", "desconocido")
        if self.distribucion == "debian":
            fila_nvidia = self.filas.get("nvidia-driver")
            if fila_nvidia is not None:
                fila_nvidia.set_visible(self.nvidia_presente)
            if self.nvidia_presente:
                modo = traducir("GPU Intel/AMD + NVIDIA") if self.nvidia_hibrida else traducir("NVIDIA dedicada")
                estado = traducir("instalado") if self.nvidia_instalada else traducir("no instalado")
                self.nvidia_info_label.set_text(
                    traducir("GPU: %s · driver %s · candidato APT: %s · Secure Boot: %s")
                    % (modo, estado, self.nvidia_candidata, self.nvidia_secureboot)
                )
            else:
                self.nvidia_info_label.set_text(traducir("No se detectó una GPU NVIDIA PCI."))
        if self.nvidia_presente:
            estados["nvidia-driver"] = self.nvidia_instalada
        self.estados_tareas = {pid for pid, completada in estados.items() if completada}
        etiquetas = {
            "repos": "✓ Ya configurados",
            "tools": "✓ Ya instaladas",
            "backports-kernel-mesa": "✓ Ya instalados",
            "ubuntu-hwe": "✓ Ya instalado",
            "nvidia-driver": "✓ Driver NVIDIA instalado",
            "gnome-plugin": "✓ Ya instalado",
            "ext-manager": "✓ Ya instalado",
        }
        for pid, completada in estados.items():
            indicador = self.indicadores.get(pid)
            if indicador is None:
                continue
            if completada:
                indicador.set_markup(
                    "<span foreground='#26a269'><b>%s</b></span>"
                    % traducir(etiquetas[pid])
                )
                indicador.set_tooltip_text(
                    traducir(
                        "Esta tarea ya está completada y no se incluirá en futuras operaciones."
                    )
                )
                indicador.show()
                self.switches[pid][0].set_active(False)
            else:
                indicador.set_text("")
                indicador.set_tooltip_text(None)
                indicador.hide()
        self._finalizar_consulta_estados(True)

    def _finalizar_consulta_estados(self, correcta, detalle="", *, mensaje=None):
        inicial = self.consulta_inicial
        if self.timeout_estados_id is not None:
            GLib.source_remove(self.timeout_estados_id)
            self.timeout_estados_id = None
        if not correcta:
            self.estados_tareas.clear()
            for indicador in self.indicadores.values():
                indicador.set_text("")
                indicador.set_tooltip_text(None)
                indicador.hide()
        self.consultando_estados = False
        self._actualizar_sensibilidad()
        if correcta:
            if inicial:
                self.estado.set_text(
                    traducir("Selecciona las tareas que quieres ejecutar.")
                )
            return
        if mensaje is None:
            mensaje = traducir(
                "No se pudo comprobar el estado de las tareas; siguen disponibles."
            )
        if detalle:
            mensaje += " " + detalle
        if inicial:
            self.estado.set_text(mensaje)
        self._escribir("[!] %s\n" % mensaje, "aviso")

    def _actualizar_sensibilidad(self):
        disponible = (not self.en_curso and not self.comprobando_actualizacion and not self.programando
                     and not self.diagnostico_en_curso and not self.backup_action_in_progress
                     and not self.grub_action_in_progress
                     and self.distribucion != "no-soportada")
        self.grub_pagina.set_sensitive(disponible)
        self._actualizar_seleccion()
        self.btn_iniciar.set_sensitive(disponible and not self.consultando_estados and bool(self._pasos_seleccionados()))
        if self.btn_actualizar is not None:
            self.btn_actualizar.set_sensitive(disponible and not self.comprobando_actualizacion
                                             and formato_actualizacion() in ("deb", "flatpak", "appimage"))
        self.chk_sin_contrasena.set_sensitive(disponible and not self.consultando_estados)
        self.btn_menu.set_sensitive(disponible)
        self.btn_preferencias_menu.set_sensitive(disponible)
        self.btn_programar.set_sensitive(disponible)
        self.btn_borrar.set_sensitive(not self.en_curso)
        self.btn_diagnostico.set_sensitive(not self.en_curso and not self.diagnostico_en_curso
                                           and not self.comprobando_actualizacion and not self.programando
                                           and not self.backup_action_in_progress
                                           and not self.grub_action_in_progress)
        if self.btn_actualizar_diagnostico is not None:
            self.btn_actualizar_diagnostico.set_sensitive(
                not self.en_curso and not self.comprobando_actualizacion)
        for boton in self.botones_preset:
            boton.set_sensitive(disponible)
        for pid, fila in self.filas.items():
            reversión = self.switches.get("revertir-backports")
            reversion_activa = bool(reversión and reversión[0].get_active())
            habilitada = (disponible and pid not in self.estados_tareas
                         and (pid != "nvidia-driver" or self.nvidia_presente)
                         and (not reversion_activa or pid == "revertir-backports"))
            fila.set_sensitive(habilitada)
            self.switches[pid][0].set_sensitive(habilitada)
        for boton in self.backup_buttons.values():
            boton.set_sensitive(not self.en_curso and not self.programando
                                and not self.comprobando_actualizacion
                                and not self.diagnostico_en_curso
                                and not self.backup_action_in_progress
                                and not self.grub_action_in_progress)
        recomendaciones_disponibles = (not self.en_curso and not self.programando
                                       and not self.comprobando_actualizacion
                                       and not self.diagnostico_en_curso
                                       and not self.backup_action_in_progress
                                       and not self.grub_action_in_progress)
        modo_multiple = self.recommended_multi.get_active()
        self.recommended_multi.set_sensitive(recomendaciones_disponibles)
        seleccionables = 0
        for clave, boton in self.recommended_buttons.items():
            app_id, tipo = clave
            instalado = self.recommended_installed.get(clave, False)
            seleccionado = modo_multiple and not instalado and self.recommended_selection.get(app_id) == tipo
            estilo = boton.get_style_context()
            if seleccionado:
                estilo.add_class("suggested-action")
                seleccionables += 1
            else:
                estilo.remove_class("suggested-action")
            etiqueta_canal = boton.get_label().removeprefix("✓ ")
            etiqueta_boton = f"✓ {etiqueta_canal}" if seleccionado else etiqueta_canal
            if etiqueta_boton != boton.get_label():
                boton.set_label(etiqueta_boton)
            boton.set_sensitive(recomendaciones_disponibles and not instalado
                                and (not modo_multiple or tipo in ("deb", "flatpak")))
        texto = (traducir("Instalar selección (%d)") % seleccionables if seleccionables
                 else traducir("Instalar selección"))
        self.recommended_install.set_label(texto)
        self.recommended_install.set_sensitive(recomendaciones_disponibles and seleccionables > 0)

    def _visible(self, pid):
        if pid == "snap-update":
            return self.snapd_presente
        if pid in ("backports-kernel-mesa", "revertir-backports"):
            return self.distribucion == "debian"
        if pid == "nvidia-driver":
            return self.distribucion == "debian"
        if pid == "ubuntu-hwe":
            return self.distribucion == "ubuntu"
        if pid == "flatpak-update":
            return self.flatpak_presente
        if pid == "flatpak-setup":
            return not self.flatpak_presente
        if pid in ("gnome-plugin", "ext-manager"):
            return self.gnome_presente
        return True

    def _fila(self, pid, titulo, desc, defecto):
        fila = Gtk.ListBoxRow(activatable=False)
        if pid == "nvidia-driver":
            fila.set_no_show_all(True)
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        textos = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        nombre = etiqueta(titulo)
        nombre.get_style_context().add_class("aio-task-name")
        detalle = etiqueta(desc, dim=True)
        detalle.get_style_context().add_class("aio-task-detail")
        detalle.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        textos.pack_start(nombre, False, False, 0)
        textos.pack_start(detalle, False, False, 0)

        indicador = etiqueta("")
        indicador.set_no_show_all(True)
        indicador.set_margin_start(9)
        sw = Gtk.CheckButton(active=defecto, valign=Gtk.Align.CENTER)
        sw.get_style_context().add_class("aio-task")
        sw.get_accessible().set_name(traducir(titulo))
        sw.get_accessible().set_description(traducir(desc))
        sw.add(textos)
        caja.pack_start(sw, False, False, 0)
        caja.pack_start(indicador, False, False, 0)
        sw.connect("notify::active", self._cambio_switch_preset)
        self._estilo_tarea(sw)
        if pid == "revertir-backports":
            sw.connect("notify::active", self._alternar_reversion_stable)
        if pid == "nvidia-driver":
            # La fila sigue oculta hasta detectar la GPU, pero sus hijos
            # deben quedar visibles cuando set_visible() muestre la fila.
            caja.show_all()
        fila.add(caja)
        self.switches[pid] = (sw, defecto)
        self.filas[pid] = fila
        self.indicadores[pid] = indicador
        return fila

    @staticmethod
    def _estilo_tarea(switch):
        estilo = switch.get_style_context()
        if switch.get_active():
            estilo.add_class("aio-selected")
        else:
            estilo.remove_class("aio-selected")

    # -- Presets ---------------------------------------------------------------
    def _preset_completo(self, _b):
        self.actualizando_preset = True
        try:
            for pid, (sw, defecto) in self.switches.items():
                sw.set_active(defecto and pid not in self.estados_tareas)
        finally:
            self.actualizando_preset = False
        self._marcar_preset_seleccionado(self.botones_preset[0])
        self._actualizar_sensibilidad()

    def _preset_flatpak(self, _b):
        self.actualizando_preset = True
        try:
            for pid, (sw, _d) in self.switches.items():
                sw.set_active(pid == "flatpak-update" and pid not in self.estados_tareas)
        finally:
            self.actualizando_preset = False
        self._marcar_preset_seleccionado(self.botones_preset[1])
        self._actualizar_sensibilidad()

    def _alternar_reversion_stable(self, switch, _propiedad):
        # La reversión de kernel/Mesa nunca se mezcla con tareas ordinarias.
        if self.actualizando_preset:
            return
        if switch.get_active():
            self.actualizando_preset = True
            try:
                for pid, (otro, _defecto) in self.switches.items():
                    if pid != "revertir-backports":
                        otro.set_active(False)
            finally:
                self.actualizando_preset = False
        self._actualizar_sensibilidad()

    def _cambio_switch_preset(self, switch, _propiedad):
        self._estilo_tarea(switch)
        if not self.actualizando_preset:
            self._marcar_preset_seleccionado(None)
            self._actualizar_sensibilidad()

    def _marcar_preset_seleccionado(self, seleccionado):
        for boton in self.botones_preset:
            estilo = boton.get_style_context()
            if boton is seleccionado:
                estilo.add_class("suggested-action")
            else:
                estilo.remove_class("suggested-action")

    def _al_pulsar_tecla(self, _ventana, evento):
        """Enter inicia tareas solo en la pestaña de mantenimiento, fuera de controles interactivos."""
        if evento.keyval not in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            return False
        if self.notebook.get_current_page() != 0:
            return False
        if evento.state & (Gdk.ModifierType.CONTROL_MASK |
                           Gdk.ModifierType.MOD1_MASK |
                           Gdk.ModifierType.SUPER_MASK):
            return False
        if not self.is_active() or self.en_curso or not self.btn_iniciar.get_sensitive():
            return False
        foco = self.get_focus()
        # Respetar el comportamiento normal de botones, campos y controles editables.
        if isinstance(foco, (Gtk.Button, Gtk.Entry, Gtk.TextView,
                             Gtk.ComboBox, Gtk.SpinButton, Gtk.TreeView)):
            return False
        self._iniciar(self.btn_iniciar)
        return True

    # -- Ejecución ---------------------------------------------------------------
    def _pasos_seleccionados(self):
        sel = [
            p[0] for p in PASOS
            if p[0] in self.switches
            and p[0] not in self.estados_tareas
            and self._visible(p[0])
            and self.switches[p[0]][0].get_active()
        ]
        # La instalación/actualización de Flatpak no tiene sentido sin soporte Flatpak
        return sel

    def _iniciar(self, _b):
        if self.en_curso or self.programando:
            return
        pasos = self._pasos_seleccionados()
        if self.distribucion == "no-soportada":
            self._mensaje(Gtk.MessageType.ERROR, "Sistema no compatible",
                          "Las operaciones administrativas solo están disponibles en Debian y Ubuntu 24.04/26.04 LTS.")
            return
        if not pasos:
            self._mensaje(Gtk.MessageType.INFO, "Nada que hacer", "Activa al menos una tarea.")
            return
        self._poner_ocupado(True)
        self.estado.set_text(traducir("Comprobando seguridad del mantenimiento…"))
        def verificar():
            try:
                informe = core_preflight.check(pasos)
                GLib.idle_add(self._terminar_preflight, pasos, informe, None)
            except Exception as error:
                GLib.idle_add(self._terminar_preflight, pasos, None, str(error))
        threading.Thread(target=verificar, daemon=True).start()
        return

    def _terminar_preflight(self, pasos, informe, error):
        if not self.en_curso:
            return False
        if error:
            self._poner_ocupado(False)
            self._mensaje(Gtk.MessageType.ERROR, "Mantenimiento bloqueado",
                          traducir("No se pudieron completar las comprobaciones de seguridad.") + "\n" + error)
            return False
        if informe.blocked:
            self._poner_ocupado(False)
            self._mensaje(Gtk.MessageType.ERROR, "Mantenimiento bloqueado", "\n".join(informe.messages))
            return False
        if informe.messages:
            dialogo_seguro = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.NONE, text=traducir("Comprobaciones de seguridad"))
            dialogo_seguro.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
            dialogo_seguro.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
            dialogo_seguro.set_default_response(Gtk.ResponseType.CANCEL)
            lineas = list(informe.messages)
            if informe.preview:
                lineas.append(traducir("Detalle de la simulación APT:"))
                lineas.extend(informe.preview)
            detalle = Gtk.TextView(editable=False, cursor_visible=False)
            detalle.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
            detalle.set_left_margin(8)
            detalle.set_right_margin(8)
            detalle.set_top_margin(6)
            detalle.set_bottom_margin(6)
            detalle.get_buffer().set_text("\n".join(lineas))

            scroll = Gtk.ScrolledWindow()
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroll.set_overlay_scrolling(False)
            scroll.set_shadow_type(Gtk.ShadowType.IN)
            ventana = self.get_window()
            monitor = self.get_display().get_monitor_at_window(ventana) if ventana else None
            area = monitor.get_workarea() if monitor else None
            dialogo_seguro.set_resizable(True)
            ancho = min(680, area.width * 4 // 5) if area else 680
            alto = min(526, area.height * 4 // 5) if area else 526
            dialogo_seguro.set_default_size(ancho, alto)
            scroll.add(detalle)
            contenido = dialogo_seguro.get_content_area()
            contenido.pack_start(scroll, True, True, 0)
            scroll.set_margin_start(12)
            scroll.set_margin_end(12)
            scroll.set_margin_bottom(12)
            scroll.show_all()
            aceptado = dialogo_seguro.run() == Gtk.ResponseType.OK
            dialogo_seguro.destroy()
            if not aceptado:
                self._poner_ocupado(False)
                return False
        self._continuar_mantenimiento(pasos, upgrade_plan=informe.upgrade_plan)
        if self.proceso is None:
            self._poner_ocupado(False)
        return False

    def _continuar_mantenimiento(self, pasos, upgrade_plan=None):
        if not self._confirmar_tareas(pasos):
            self.estado.set_text(traducir("Mantenimiento cancelado antes de comenzar."))
            return
        if pasos == ["flatpak-update"]:
            self._iniciar_flatpak_usuario()
            return
        try:
            helper = helper_mantenimiento()
        except OSError as e:
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo preparar el asistente", str(e))
            return
        if not helper_disponible(helper):
            if usa_integracion_portable():
                self._abrir_guia_integracion()
            else:
                self._mensaje(Gtk.MessageType.ERROR, "Falta el asistente",
                              traducir("No se encuentra %s.\nReinstala el paquete aio-debian-gui.") % helper)
            return

        if (usa_integracion_portable() or os.environ.get("SNAP")) and not core_host_integration.compatible_helper(
                formato_actualizacion(), helper):
            if usa_integracion_portable():
                self._abrir_guia_integracion()
            else:
                self._mensaje(Gtk.MessageType.WARNING, "Asistente del sistema desactualizado",
                              "La integración de mantenimiento del anfitrión necesita actualizarse.")
            return

        if ("backports-kernel-mesa" in pasos and
                not helper_admite_tarea(helper, "backports-kernel-mesa")):
            self._mensaje(
                Gtk.MessageType.ERROR, "Asistente del sistema desactualizado",
                "El asistente instalado no incluye la tarea de Backports. "
                "Actualiza el paquete .deb a la versión 1.0.7 o posterior.",
            )
            return

        if "revertir-backports" in pasos:
            if len(pasos) != 1:
                self._mensaje(
                    Gtk.MessageType.WARNING,
                    traducir("Reversión de Backports"),
                    traducir("La vuelta a Stable debe ejecutarse como única tarea. Desactiva las demás opciones."),
                )
                return
            if not helper_admite_tarea(helper, "revertir-backports"):
                self._mensaje(Gtk.MessageType.ERROR, traducir("Asistente desactualizado"),
                              traducir("Actualiza el asistente de AiO para revertir Backports."))
                return
            cmd = (comando_host(HELPER_SISTEMA, "--backports-rollback-plan")
                   if es_flatpak() else ["bash", HELPER, "--backports-rollback-plan"])
            try:
                resultado = subprocess.run(
                    cmd, capture_output=True, text=True, timeout=45, check=False,
                )
            except (OSError, subprocess.SubprocessError) as exc:
                self._mensaje(Gtk.MessageType.ERROR, traducir("Reversión de Backports"), str(exc))
                return
            if resultado.returncode != 0 or "##STABLE:" not in resultado.stdout:
                self._mensaje(
                    Gtk.MessageType.ERROR, traducir("Reversión no segura"),
                    traducir("No se puede preparar el regreso a Stable. Revisa el diagnóstico y los módulos DKMS.")
                    + "\n" + (resultado.stdout + resultado.stderr)[-1600:],
                )
                return
            planes = [
                linea.replace("##STABLE:", "• ", 1)
                for linea in resultado.stdout.splitlines()
                if linea.startswith("##STABLE:")
            ]
            dialogo = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.NONE,
                text=traducir("¿Preparar el retorno a Debian Stable?"),
            )
            dialogo.format_secondary_text(
                traducir("Se instalarán las versiones Stable de los siguientes paquetes:")
                + "\n" + "\n".join(planes) + "\n\n"
                + traducir("El kernel Backports NO se eliminará. GRUB no cambiará. "
                          "Tras reiniciar deberás seleccionar el kernel Stable y comprobar que funciona. "
                          "La reversión completa requiere verificar ese arranque antes de eliminar el kernel antiguo.")
            )
            dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
            dialogo.add_button(traducir("Preparar Stable"), Gtk.ResponseType.OK)
            dialogo.set_default_response(Gtk.ResponseType.CANCEL)
            aprobado = dialogo.run() == Gtk.ResponseType.OK
            dialogo.destroy()
            if not aprobado:
                return

        if "nvidia-driver" in pasos:
            if "backports-kernel-mesa" in pasos:
                self._mensaje(Gtk.MessageType.WARNING, "NVIDIA y Backports",
                              "Instala primero el kernel de Backports, reinicia y vuelve a comprobar el controlador NVIDIA. No se combinan ambas tareas.")
                return
            cmd_report = comando_host(HELPER_SISTEMA, "--nvidia-report") if es_flatpak() else ["bash", HELPER, "--nvidia-report"]
            try:
                report = subprocess.run(cmd_report, capture_output=True, text=True, timeout=12)
            except (OSError, subprocess.SubprocessError) as e:
                self._mensaje(Gtk.MessageType.ERROR, "Detección NVIDIA", str(e))
                return
            if report.returncode or "##NVIDIA:present:1" not in report.stdout:
                self._mensaje(Gtk.MessageType.WARNING, "Detección NVIDIA",
                              "El asistente no ha podido verificar una GPU NVIDIA. No se instalará nada.")
                return
            hibrida = "##NVIDIA:hybrid:1" in report.stdout
            advertencia = (
                "GPU Intel/AMD y NVIDIA presentes. Se conservará la configuración de pantallas; la combinación no confirma por sí sola un equipo híbrido. "
                if hibrida else "GPU NVIDIA dedicada detectada. "
            )
            advertencia += (
                "Se instalarán paquetes Debian con DKMS si la compatibilidad, Secure Boot, headers y la simulación APT lo permiten. "
                "La versión estable puede tener limitaciones de soporte y seguridad. "
                "No se cambiarán Xorg, GRUB ni Wayland; tras instalar habrá que reiniciar. "
                "¿Autorizar la instalación NVIDIA bajo estas condiciones?"
            )
            dialogo = Gtk.MessageDialog(transient_for=self, modal=True,
                message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.NONE,
                text="Instalación de controlador NVIDIA")
            dialogo.format_secondary_text(advertencia)
            dialogo.add_button("Cancelar", Gtk.ResponseType.CANCEL)
            dialogo.add_button("Instalar si es compatible", Gtk.ResponseType.OK)
            dialogo.set_default_response(Gtk.ResponseType.CANCEL)
            aprobado = dialogo.run() == Gtk.ResponseType.OK
            dialogo.destroy()
            if not aprobado:
                return
            if not helper_admite_tarea(helper, "nvidia-driver"):
                self._mensaje(Gtk.MessageType.ERROR, "Asistente desactualizado",
                              "Instala la nueva versión de AiO y su asistente del sistema para gestionar NVIDIA.")
                return

        if "backports-kernel-mesa" in pasos:
            d = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.NONE,
                text=traducir("¿Instalar el kernel y Mesa desde Debian Backports?"),
            )
            d.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
            d.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
            d.set_default_response(Gtk.ResponseType.CANCEL)
            d.format_secondary_text(
                traducir(
                    "Se instalará el kernel de Backports para esta arquitectura y los controladores "
                "Mesa disponibles. Esto puede actualizar componentes gráficos y requerir un "
                    "reinicio. Si falta, se añadirá la fuente oficial de Debian Backports."
                )
            )
            confirmar = d.run() == Gtk.ResponseType.OK
            d.destroy()
            if not confirmar:
                self.switches["backports-kernel-mesa"][0].set_active(False)
                self.estado.set_text(traducir("Instalación desde Backports cancelada."))
                return

        lang = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "C"
        # Si solo se actualiza Flatpak del usuario no se invoca pkexec.
        solo_flatpak_usuario = pasos == ["flatpak-update"]
        if solo_flatpak_usuario:
            cmd = comando_host(helper, "--flatpak-user-update")
        else:
            argumentos = (["--upgrade-plan", upgrade_plan] if upgrade_plan else []) + pasos
            cmd = comando_pkexec(helper, lang, *argumentos)

        self.buf.set_text("")
        self.necesita_reinicio = False
        self.hubo_errores = False
        self.fin_recibido = False
        self.terminado_gestionado = False
        self.cancelacion_autorizacion = None
        self.tareas_en_ejecucion = list(pasos)
        self._preparar_resultados(pasos)
        self.total_pasos = len(pasos)
        self._poner_ocupado(True)
        if solo_flatpak_usuario:
            self.estado.set_text("Actualizando Flatpak de usuario sin privilegios…")
            self._escribir("[*] Flatpak --user, sin contraseña de administrador.\\n", "info")
        else:
            self.estado.set_text(traducir("Esperando autenticación de administrador…"))
            self._escribir("[*] Solicitando autorización de administrador…\n", "info")
            self._escribir(
                "[*] Si no aparece el diálogo, cancela la espera y comprueba el agente de Polkit.\n",
                "info",
            )
        self.barra.set_fraction(0)
        self.barra.set_text("")
        self.barra.set_show_text(False)

        try:
            self.proceso = Gio.Subprocess.new(
                cmd, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE
            )
        except GLib.Error as e:
            self._poner_ocupado(False)
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo iniciar", str(e.message))
            return

        self.flujo = Gio.DataInputStream.new(self.proceso.get_stdout_pipe())
        if not solo_flatpak_usuario:
            self._iniciar_espera_autorizacion()
        self._leer_linea()

    def _iniciar_flatpak_usuario(self):
        """Actualización de Flatpak del usuario sin helper root ni pkexec."""
        script = (
            'printf "##STEP:1:1:Actualizar Flatpak del usuario\\n"; '
            'if ! command -v flatpak >/dev/null 2>&1; then '
            'echo "[-] Flatpak no está instalado."; echo "##DONE:1"; exit 1; fi; '
            'if flatpak --user update -y && flatpak --user uninstall --unused -y; then '
            'echo "##RESULT:flatpak-update:0"; echo "##DONE:0"; '
            'else echo "##RESULT:flatpak-update:1"; echo "##DONE:1"; exit 1; fi'
        )
        self.buf.set_text("")
        self.necesita_reinicio = False
        self.hubo_errores = False
        self.fin_recibido = False
        self.terminado_gestionado = False
        self.cancelacion_autorizacion = None
        self.tareas_en_ejecucion = ["flatpak-update"]
        self._preparar_resultados(self.tareas_en_ejecucion)
        self.total_pasos = 1
        self._poner_ocupado(True)
        self.estado.set_text("Actualizando Flatpak del usuario sin contraseña…")
        self._escribir("[*] Operación Flatpak de usuario; sin pkexec.\\n", "info")
        self.barra.set_fraction(0)
        self.barra.set_text("")
        self.barra.set_show_text(False)
        try:
            self.proceso = Gio.Subprocess.new(
                comando_host("bash", "-c", script),
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE,
            )
        except GLib.Error as error:
            self._poner_ocupado(False)
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo iniciar", str(error.message))
            return
        self.flujo = Gio.DataInputStream.new(self.proceso.get_stdout_pipe())
        self._leer_linea()

    def _cambiar_sin_contrasena(self, boton, _propiedad=None):
        if self.actualizando_sin_contrasena:
            return

        habilitar = boton.get_active()
        try:
            helper = helper_mantenimiento()
        except OSError as e:
            self.configurando_sin_contrasena = None
            self._poner_ocupado(False)
            self._restablecer_opcion_sin_contrasena(
                autorizacion_sin_contrasena_activa()
            )
            self._mensaje(
                Gtk.MessageType.ERROR, "No se pudo preparar el asistente", str(e)
            )
            return
        if not helper_disponible(helper):
            self._restablecer_opcion_sin_contrasena(autorizacion_sin_contrasena_activa())
            if es_flatpak():
                self._abrir_guia_integracion()
                return
            self._mensaje(
                Gtk.MessageType.ERROR,
                "Falta el asistente",
                (
                    "El Flatpak necesita la integración manual del asistente con Polkit "
                    "en el Debian anfitrión. Consulta la sección «Flatpak» del README oficial. "
                    "Flatseal no concede privilegios de administrador."
                    if es_flatpak() else
                    traducir("No se encuentra %s.\nReinstala el paquete aio-debian-gui.") % helper
                ),
            )
            return

        if habilitar and (
                not helper_admite_autorizacion_sin_contrasena(helper)
                or not helper_disponible(helper)):
            self._restablecer_opcion_sin_contrasena(autorizacion_sin_contrasena_activa())
            self._mensaje(Gtk.MessageType.ERROR, "Función no disponible en el asistente instalado",
                          "Actualiza el asistente del sistema a AiO Debian GUI 1.2.3 o posterior.")
            return

        if habilitar:
            d = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.NONE,
                text=traducir("Permitir tareas sin contraseña?"),
            )
            d.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
            d.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
            d.set_default_response(Gtk.ResponseType.CANCEL)
            d.format_secondary_text(
                "AVISO: esta excepción persistente elimina la petición de contraseña para "
                "TODAS las tareas administrativas disponibles en AiO Debian GUI (APT, "
                "repositorios, kernel y Flatpak del sistema). No concede permisos generales "
                "a otras aplicaciones, pero cualquier proceso con acceso a tu cuenta podría "
                "invocar el asistente de AiO sin contraseña. "
                "Activarla requiere autorización de administrador una vez. "
                "Desmarca esta opción para revocarla."
            )
            confirmar = d.run() == Gtk.ResponseType.OK
            d.destroy()
            if not confirmar:
                self._restablecer_opcion_sin_contrasena(False)
                return

        accion = "--enable-passwordless" if habilitar else "--disable-passwordless"
        lang = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "C"
        self.configurando_sin_contrasena = habilitar
        self.terminado_gestionado = False
        self.cancelacion_autorizacion = None
        self._poner_ocupado(True)
        self.buf.set_text("")
        self.estado.set_text(traducir("Esperando autorización de administrador…"))
        self._escribir("[*] Solicitando autorización de administrador…\n", "info")
        self.barra.set_fraction(0)
        self.barra.set_show_text(False)

        try:
            self.proceso = Gio.Subprocess.new(
                comando_pkexec(helper, lang, accion),
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE,
            )
        except GLib.Error as e:
            self.configurando_sin_contrasena = None
            self._poner_ocupado(False)
            self._restablecer_opcion_sin_contrasena(autorizacion_sin_contrasena_activa())
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo iniciar", str(e.message))
            return

        self.flujo = Gio.DataInputStream.new(self.proceso.get_stdout_pipe())
        self._iniciar_espera_autorizacion()
        self._leer_linea()

    def _restablecer_opcion_sin_contrasena(self, activa):
        self.actualizando_sin_contrasena = True
        self.chk_sin_contrasena.set_active(activa)
        self.actualizando_sin_contrasena = False

    def _poner_ocupado(self, ocupado):
        self.en_curso = ocupado
        self._actualizar_sensibilidad()
        if ocupado:
            self.spinner.start()
        else:
            self.spinner.stop()

    def _iniciar_espera_autorizacion(self):
        self.esperando_autorizacion = True
        self.btn_cancelar.show()
        self.timeout_autorizacion_id = GLib.timeout_add_seconds(
            90, self._agotamiento_autorizacion
        )

    def _finalizar_espera_autorizacion(self):
        self.esperando_autorizacion = False
        self.btn_cancelar.hide()
        if self.timeout_autorizacion_id is not None:
            GLib.source_remove(self.timeout_autorizacion_id)
            self.timeout_autorizacion_id = None

    def _cancelar_espera_autorizacion(self, _boton=None, agotada=False):
        if not self.esperando_autorizacion or self.proceso is None:
            return
        self.cancelacion_autorizacion = "agotada" if agotada else "cancelada"
        self._finalizar_espera_autorizacion()
        self.estado.set_text(traducir("Cancelando la espera de autorización…"))
        self._escribir(
            "[-] Se canceló la espera de autorización de administrador.\n", "error"
        )
        self.proceso.force_exit()

    def _agotamiento_autorizacion(self):
        self.timeout_autorizacion_id = None
        self._cancelar_espera_autorizacion(agotada=True)
        return GLib.SOURCE_REMOVE

    def _leer_linea(self):
        self.flujo.read_line_async(GLib.PRIORITY_DEFAULT, None, self._linea_leida)

    def _linea_leida(self, flujo, res):
        try:
            r = flujo.read_line_finish_utf8(res)
            datos = r[0] if isinstance(r, tuple) else r
        except GLib.Error:
            datos = None
        if datos is None:
            self._finalizar_espera_autorizacion()
            self.proceso.wait_async(None, self._proceso_terminado)
            return
        self._finalizar_espera_autorizacion()
        texto = datos
        # apt/flatpak pueden usar \r para repintar: nos quedamos con el último trozo
        texto = ANSI.sub("", texto.split("\r")[-1]).rstrip()
        self._procesar(texto)
        if self.fin_recibido:
            self.proceso.wait_async(None, self._proceso_terminado)
            return
        self._leer_linea()

    def _procesar(self, linea):
        if linea.startswith("##STEP:"):
            _, n, total, titulo = linea.split(":", 3)
            n, total = int(n), int(total)
            self.barra.set_show_text(True)
            self.barra.set_fraction((n - 1) / total)
            self.barra.set_text(traducir("Paso %d de %d") % (n, total))
            self.estado.set_text(traducir(titulo) + "…")
            if 0 < n <= len(self.tareas_en_ejecucion):
                self._resultado_tarea(self.tareas_en_ejecucion[n - 1], "En curso")
            self._escribir("\n▶ %s\n" % titulo, "paso")
            return
        if linea.startswith("##RESULT:"):
            _, tarea, codigo = linea.split(":", 2)
            self._resultado_tarea(tarea, "Completada" if codigo == "0" else "Error")
            return
        if linea.startswith("##REBOOT:"):
            self.necesita_reinicio = linea.endswith(":1")
            return
        if linea.startswith("##DONE:"):
            self.hubo_errores = linea.endswith(":1")
            self.fin_recibido = True
            return

        tag = None
        if linea.startswith("[✔]"):
            tag = "ok"
        elif linea.startswith("[!]"):
            tag = "aviso"
        elif linea.startswith("[-]"):
            tag = "error"
        elif linea.startswith("[*]"):
            tag = "info"
        self._escribir(linea + "\n", tag)

    def _escribir(self, texto, tag=None):
        if tag == "error" and not self.preferencias["modo_simple"]:
            self.expansor_consola.show()
            self.expansor_consola.set_expanded(True)
        fin = self.buf.get_end_iter()
        if tag:
            self.buf.insert_with_tags_by_name(fin, texto, tag)
        else:
            self.buf.insert(fin, texto)
        self._desplazar_consola(self.log)
        # La salida externa no debe poder enviar secuencias de control a VTE.
        salida = "".join(
            c for c in texto if c in "\n\t" or 32 <= ord(c) < 127 or ord(c) >= 160
        )
        self.terminal.feed(salida.replace("\n", "\r\n").encode("utf-8"))

    def _proceso_terminado(self, proc, res):
        if self.terminado_gestionado:
            return
        self.terminado_gestionado = True
        self.proceso = None
        self._finalizar_espera_autorizacion()
        cancelacion = self.cancelacion_autorizacion
        self.cancelacion_autorizacion = None
        try:
            proc.wait_finish(res)
            codigo = proc.get_exit_status() if proc.get_if_exited() else -1
        except GLib.Error:
            codigo = -1

        if self.configurando_sin_contrasena is not None:
            deseada = self.configurando_sin_contrasena
            self.configurando_sin_contrasena = None
            self._poner_ocupado(False)
            activa = autorizacion_sin_contrasena_activa()
            self._restablecer_opcion_sin_contrasena(activa)
            if cancelacion:
                self.estado.set_text(
                    traducir("Espera de autorización agotada.")
                    if cancelacion == "agotada"
                    else traducir("Espera de autorización cancelada.")
                )
                self._escribir(
                    "[-] No se cambió la preferencia de autorización.\n", "error"
                )
            elif codigo == 0 and activa == deseada:
                self.estado.set_text(
                    traducir("Autorización sin contraseña activada.")
                    if activa else traducir("Autorización sin contraseña desactivada.")
                )
                self._escribir(
                    "[✔] Preferencia de autorización actualizada.\n", "ok"
                )
            elif codigo in (126, 127):
                self.estado.set_text(traducir("No se cambió la autorización."))
                self._escribir(
                    "[-] Autorización cancelada o denegada; no se cambió la preferencia.\n",
                    "error",
                )
            else:
                self.estado.set_text(traducir("No se pudo cambiar la autorización."))
                self._escribir(
                    "[-] No se pudo actualizar la preferencia de autorización (código %s).\n"
                    % codigo,
                    "error",
                )
            return

        self._poner_ocupado(False)
        self.barra.set_show_text(False)
        for tarea, (_etiqueta, estado) in list(self.resultados_tareas.items()):
            if estado in ("Pendiente", "En curso"):
                self._resultado_tarea(tarea, "No ejecutada" if estado == "Pendiente" else "Error")

        if cancelacion:
            try:
                guardar_registro_mantenimiento(self.tareas_en_ejecucion, "cancelado")
            except OSError:
                pass
            self.estado.set_text(
                traducir("Espera de autorización agotada.")
                if cancelacion == "agotada"
                else traducir("Espera de autorización cancelada.")
            )
            self._escribir(
                "[-] No se ejecutó ninguna tarea. Comprueba el agente de autenticación de Polkit.\n",
                "error",
            )
            return
        if codigo == 0 and self.fin_recibido and not self.hubo_errores:
            self.barra.set_fraction(1.0)
            self.estado.set_text(traducir("✔ ¡Mantenimiento completado con éxito!"))
            self._escribir("\n==================================================\n"
                           "  [✔] ¡Mantenimiento completado con éxito!\n"
                           "==================================================\n"
                           "         ❤️ Made by JULIO AYUSO\n", "ok")
        elif codigo in (126, 127) and self.barra.get_fraction() == 0:
            try:
                guardar_registro_mantenimiento(self.tareas_en_ejecucion, "autorización denegada")
            except OSError:
                pass
            self.estado.set_text(traducir("No se obtuvo autorización de administrador."))
            self._escribir("[-] Autenticación cancelada o denegada. No se ha hecho ningún cambio.\n", "error")
            return
        else:
            self.estado.set_text(traducir("Terminó con errores. Revisa el registro."))
            self._escribir("\n[-] El proceso terminó con errores (código %s).\n" % codigo, "error")

        # Registrar el resultado incluso si el mantenimiento terminó con errores.
        try:
            guardar_registro_mantenimiento(
                self.tareas_en_ejecucion,
                "correcto" if codigo == 0 and self.fin_recibido and not self.hubo_errores
                else "error", self.necesita_reinicio,
            )
        except OSError as error:
            self._escribir("[!] No se pudo guardar el historial: %s\n" % error, "aviso")

        self._resumir_diagnostico([])
        if self.necesita_reinicio:
            self._preguntar_reinicio()
        self._consultar_estados_tareas()

    def _preguntar_reinicio(self):
        d = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE,
            text=traducir("¿Reiniciar el sistema ahora?"),
        )
        d.format_secondary_text(traducir(
            "Se recomienda reiniciar para aplicar los cambios críticos (kernel/servicios)."
        ))
        d.add_button(traducir("Más tarde"), Gtk.ResponseType.NO)
        d.add_button(traducir("Reiniciar ahora"), Gtk.ResponseType.YES)
        d.set_default_response(Gtk.ResponseType.NO)
        r = d.run()
        d.destroy()
        if r == Gtk.ResponseType.YES:
            self._escribir("[*] Reiniciando el sistema...\n", "info")
            try:
                subprocess.Popen(comando_host("systemctl", "reboot"))
            except OSError as e:
                self._mensaje(Gtk.MessageType.ERROR, "No se pudo reiniciar", str(e))
        else:
            self._escribir("[*] Reinicio omitido. Recuerda reiniciar más tarde.\n", "info")

    # -- Varios ----------------------------------------------------------------
    def _mensaje(self, tipo, titulo, texto):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=tipo,
                              buttons=Gtk.ButtonsType.NONE, text=traducir(titulo))
        d.add_button(traducir("Aceptar"), Gtk.ResponseType.OK)
        d.format_secondary_text(traducir(texto))
        d.run()
        d.destroy()

    def _crear_dialogo_dedicatoria(self, parent):
        dialogo = Gtk.Dialog(
            title=traducir("Agradecimiento"), transient_for=parent, modal=True
        )
        dialogo.set_resizable(False)
        dialogo.add_button(traducir("Cerrar"), Gtk.ResponseType.CLOSE)
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for margen in ("top", "bottom", "start", "end"):
            getattr(caja, "set_margin_" + margen)(16)

        pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
            FOTO_INSPIRACION, 420, 420, True
        )
        imagen = Gtk.Image.new_from_pixbuf(pixbuf)
        imagen.get_accessible().set_name(traducir("Foto de Adri y Lu"))
        caja.pack_start(imagen, False, False, 0)

        mensaje = Gtk.Label(
            label="Gracias a Adri y Lu por ser mi inspiración en TODO lo que hago"
        )
        mensaje.set_line_wrap(True)
        mensaje.set_justify(Gtk.Justification.CENTER)
        mensaje.set_max_width_chars(50)
        caja.pack_start(mensaje, False, False, 0)
        dialogo.get_content_area().pack_start(caja, True, True, 0)
        dialogo.show_all()
        return dialogo

    def _abrir_dedicatoria(self, _label, uri, acerca):
        if uri != "aio-debian-gui://inspiracion":
            return False
        dialogo = self._crear_dialogo_dedicatoria(acerca)
        try:
            dialogo.run()
        finally:
            dialogo.destroy()
        return True

    def _crear_dialogo_acerca_de(self):
        d = Gtk.AboutDialog(transient_for=self, modal=True)
        d.set_program_name("AiO Debian GUI")
        d.set_version(version_app())
        d.set_comments(traducir("Mantenimiento y configuración todo en uno para Debian"))
        d.set_website(HOMEPAGE)
        d.set_copyright("© 2026 Julio Ayuso")
        d.set_license_type(Gtk.License.GPL_3_0)
        # El tema de iconos del host no contiene necesariamente nuestro icono
        # (AppImage, Flatpak y Snap). Mostrar el PNG incluido en el paquete.
        icono = os.path.normpath(os.path.join(
            os.path.dirname(__file__),
            "../share/icons/hicolor/256x256/apps/aio-debian-gui.png",
        ))
        if os.path.isfile(icono):
            try:
                d.set_logo(GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    icono, 128, 128, True
                ))
            except GLib.Error:
                d.set_logo_icon_name("applications-system")
        else:
            d.set_logo_icon_name("applications-system")
        d.show_all()

        def buscar_credito(widget):
            if isinstance(widget, Gtk.Label) and widget.get_text() == "© 2026 Julio Ayuso":
                return widget
            if isinstance(widget, Gtk.Container):
                for hijo in widget.get_children():
                    encontrado = buscar_credito(hijo)
                    if encontrado is not None:
                        return encontrado
            return None

        credito = buscar_credito(d)
        if credito is None:
            d.destroy()
            raise RuntimeError("No se encontró el crédito de autor en el diálogo Acerca de.")
        credito.set_markup(
            '<span size="large">© 2026 '
            '<a href="aio-debian-gui://inspiracion">Julio Ayuso</a></span>'
        )
        credito.connect("activate-link", self._abrir_dedicatoria, d)
        return d

    def _acerca_de(self, _b):
        self.menu_popover.popdown()
        d = self._crear_dialogo_acerca_de()
        try:
            d.run()
        finally:
            d.destroy()

    def _al_cerrar(self, *_a):
        if self.grub_action_in_progress:
            self._mensaje(Gtk.MessageType.INFO, "Operación en curso",
                          "Espera a que termine la operación de la aplicación antes de cerrar la ventana.")
            return True
        if self.programando:
            self._mensaje(Gtk.MessageType.INFO, "Programar mantenimiento", "Espera a que termine de guardar la programación.")
            return True
        if not any((self.en_curso, self.comprobando_actualizacion,
                    self.programando, self.diagnostico_en_curso,
                    self.backup_action_in_progress)):
            return False
        if self.backup_action_in_progress and not any((
            self.en_curso, self.comprobando_actualizacion,
            self.programando, self.diagnostico_en_curso,
        )):
            self._mensaje(
                Gtk.MessageType.INFO, "Operación en curso",
                "Espera a que termine la operación de la aplicación antes de cerrar la ventana.",
            )
        else:
            self._mensaje(
                Gtk.MessageType.WARNING, "Mantenimiento en curso",
                "Espera a que termine: interrumpir apt o dpkg a mitad puede dejar el sistema "
                "en un estado inconsistente.",
            )
        return True  # impide cerrar


def main():
    aviso_reinicio_programado = "--scheduled-reboot-required" in sys.argv[1:]
    GLib.set_prgname(PRGNAME)
    GLib.set_application_name("AiO Debian")
    if os.geteuid() == 0:
        print("Ejecuta aio-debian-gui como usuario normal (pedirá la contraseña cuando haga falta).",
              file=sys.stderr)
        sys.exit(1)
    error_preferencias = None
    try:
        preferencias = cargar_preferencias()
    except (OSError, ValueError) as error:
        preferencias = PREFERENCIAS_DEFECTO.copy()
        error_preferencias = str(error)
    win = VentanaPrincipal(preferencias)
    aplicar_tema(preferencias["tema"])
    win.handler_cierre = win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win._preparar_anfitrion_al_iniciar()
    if aviso_reinicio_programado:
        GLib.idle_add(win._preguntar_reinicio)
    if error_preferencias:
        win.estado.set_text(
            traducir("No se pudieron leer las preferencias") + ": " + error_preferencias
        )
    Gtk.main()


if __name__ == "__main__":
    main()
