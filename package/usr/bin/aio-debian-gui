def nombre_icono_recomendada(app, tema=None):
    tema = tema or Gtk.IconTheme.get_default()
    for nombre in (app["icon"], app["fallback_icon"], "application-x-executable"):
        if tema.has_icon(nombre):
            return nombre
    return "application-x-executable"


def icono_recomendada(app):
    if "bundled_icon" in app:
        ruta = os.path.join(RECOMMENDED_ICON_DIR, app["bundled_icon"])
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(ruta, 48, 48, True)
            return Gtk.Image.new_from_pixbuf(pixbuf)
        except GLib.Error as exc:
            print("No se pudo cargar el icono %s: %s" % (ruta, exc.message), file=sys.stderr)
    icono = Gtk.Image.new_from_icon_name(nombre_icono_recomendada(app), Gtk.IconSize.DIALOG)
    icono.set_pixel_size(48)
    return icono


RELEASE_API = HOMEPAGE.replace("https://github.com/", "https://api.github.com/repos/") + "/releases/latest"
MAX_APPIMAGE_SIZE = 256 * 1024 * 1024


def formato_actualizacion():
    if os.environ.get("SNAP"):
        return "snap"
    if es_flatpak():
        return "flatpak"
    if os.environ.get("APPDIR"):
        return "appimage"
    # El paquete DEB instala el ejecutable exactamente en /usr/bin.
    # No etiquetar como DEB una ejecución desde el código fuente.
    if os.path.realpath(__file__) == "/usr/bin/aio-debian-gui":
        return "deb"
    return None


def version_numerica(version):
    return core_updates.version_numerica(version)

def obtener_release_actualizacion():
    return core_updates.obtener_release_actualizacion()

def descargar_appimage_verificado(version, nombre, url, url_hash):
    destino = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD)
    return core_updates.descargar_appimage_verificado(
        version, nombre, url, url_hash, directorio_descargas=destino,
    )

def datos_distribucion_anfitrion():
    contenido = leer_texto("/etc/os-release")
    valores = {}
    for linea in (contenido or "").splitlines():
        if "=" in linea and not linea.startswith("#"):
            clave, valor = linea.split("=", 1)
            if clave in ("ID", "VERSION_ID"):
                valores[clave] = valor.strip().strip('"').strip("'")
    return valores


def distribucion_anfitrion():
    """Identifica Debian y Ubuntu LTS mediante /etc/os-release del anfitrión."""
    valores = datos_distribucion_anfitrion()
    if valores.get("ID") == "debian":
        return "debian"
    if valores.get("ID") == "ubuntu" and valores.get("VERSION_ID") in ("24.04", "26.04"):
        return "ubuntu"
    return "no-soportada"


GHOSTTY_APPIMAGE_RELEASES = "https://github.com/pkgforge-dev/ghostty-appimage/releases"


def canales_ghostty(distribucion):
    sistema = distribucion.get("ID")
    version = distribucion.get("VERSION_ID", "")
    appimage = {"type": "appimage"}
    if sistema == "debian":
        return [appimage]
    if sistema == "ubuntu":
        if re.fullmatch(r"[0-9]{2,}\.[0-9]{2}", version) and tuple(map(int, version.split("."))) >= (26, 4):
            return [{"type": "deb", "package": "ghostty", "command": "ghostty"}, appimage]
        return [appimage]
    return []


def url_appimage_ghostty(arquitectura):
    if arquitectura not in ("x86_64", "aarch64"):
        raise RuntimeError(traducir("No hay AppImage de Ghostty para esta arquitectura."))
    pagina = f"{GHOSTTY_APPIMAGE_RELEASES}/latest"
    solicitud = urllib.request.Request(pagina, headers={"User-Agent": PRGNAME}, method="HEAD")
    try:
        with urllib.request.urlopen(solicitud, timeout=8) as respuesta:
            destino = unquote(respuesta.geturl())
    except (OSError, ValueError):
        return pagina
    coincidencia = re.fullmatch(
        rf"{re.escape(GHOSTTY_APPIMAGE_RELEASES)}/tag/(v([0-9]+\.[0-9]+\.[0-9]+))",
        destino,
    )
    if not coincidencia:
        return pagina
    etiqueta, version = coincidencia.groups()
    return f"{GHOSTTY_APPIMAGE_RELEASES}/download/{etiqueta}/Ghostty-{version}-{arquitectura}.AppImage"


def sistema_operativo():
    contenido = leer_texto("/etc/os-release")
    if contenido:
        for linea in contenido.splitlines():
            if linea.startswith("PRETTY_NAME="):
                return linea.split("=", 1)[1].strip().strip('"')
    return "Debian GNU/Linux"


def _ejecutar(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def helper_mantenimiento():
    if es_flatpak() or os.environ.get("APPDIR") or os.environ.get("SNAP"):
        return HELPER_SISTEMA
    return HELPER


def usa_integracion_portable():
    return es_flatpak() or bool(os.environ.get("APPDIR"))


def helper_disponible(ruta):
    if es_flatpak():
        try:
            return subprocess.run(
                comando_host("test", "-x", ruta),
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10,
            ).returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False
    return os.path.isfile(ruta)


def comando_pkexec(helper, lang, *argumentos):
    if es_flatpak():
        return ["flatpak-spawn", "--host", "pkexec", helper, "--lang", lang, *argumentos]
    return ["pkexec", helper, "--lang", lang, *argumentos]


def helper_admite_autorizacion_sin_contrasena(ruta):
    contenido = leer_texto(ruta)
    if contenido is None:
        return False
    return (
        "--enable-passwordless" in contenido
        and "--disable-passwordless" in contenido
    )


def helper_admite_tarea(ruta, tarea):
    contenido = leer_texto(ruta)
    return contenido is not None and "[%s]=" % tarea in contenido


def autorizacion_sin_contrasena_activa():
    uid = os.getuid()
    rule_path = "/etc/polkit-1/rules.d/50-aiodebian-gui-%s.rules" % uid
    try:
        username = pwd.getpwuid(uid).pw_name
        contenido = leer_texto(rule_path)
    except (OSError, KeyError):
        return False
    if contenido is None:
        return False
    return (
        ('action.id === "%s"' % POLKIT_ACTION) in contenido
        and ('action.lookup("program") === "%s"' % HELPER_SISTEMA) in contenido
        and ("subject.user === %s" % json.dumps(username)) in contenido
        and "subject.local" in contenido
        and "subject.active" in contenido
    )


def fecha_instalacion():
    """De más a menos fiable. Devuelve datetime.date o None."""
    # El root del sandbox no es el sistema de archivos raíz del anfitrión.
    if es_flatpak():
        return None
    candidatos = []

    # 1) Creación del sistema de archivos raíz (solo si se puede leer sin root)
    dispositivo = _ejecutar(["findmnt", "-no", "SOURCE", "/"])
    if dispositivo and shutil.which("tune2fs"):
        for linea in _ejecutar(["tune2fs", "-l", dispositivo]).splitlines():
            if linea.lower().startswith("filesystem created"):
                candidatos.append(linea.split(":", 1)[1].strip())
    # 2) Fecha de nacimiento de / si el sistema de archivos la soporta
    nacimiento = _ejecutar(["stat", "-c", "%w", "/"])
    if nacimiento and nacimiento != "-":
        candidatos.append(nacimiento.split(" ")[0])
    # 3) El instalador de Debian deja aquí su rastro
    for ruta in ("/var/log/installer", "/lost+found"):
        try:
            candidatos.append(
                datetime.datetime.fromtimestamp(os.stat(ruta).st_mtime).strftime("%Y-%m-%d")
            )
        except OSError:
            pass

    for c in candidatos:
        # Aceptar "2024-03-05" o el formato largo de tune2fs ("Tue Mar  5 10:00:00 2024")
        for fmt in ("%Y-%m-%d", "%a %b %d %H:%M:%S %Y"):
            try:
                return datetime.datetime.strptime(" ".join(c.split()), fmt).date()
            except ValueError:
                continue
    return None


def antiguedad(desde, hoy):
    anios = hoy.year - desde.year
    meses = hoy.month - desde.month
    dias = hoy.day - desde.day
    if dias < 0:
        mes_ant = hoy.month - 1 or 12
        anio_ant = hoy.year if hoy.month > 1 else hoy.year - 1
        dias += calendar.monthrange(anio_ant, mes_ant)[1]
        meses -= 1
    if meses < 0:
        meses += 12
        anios -= 1
    return anios, meses, dias


def informacion_grafica():
    filas = []
    nvidia = False
    salida = _ejecutar(comando_host("lspci", "-D", "-vmm", "-nnk"))
    for bloque in salida.split("\n\n"):
        campos = dict(re.findall(r"^([\w]+):\t(.+)$", bloque, re.MULTILINE))
        if not re.search(r"\[03[0-9a-f]{2}\]$", campos.get("Class", ""), re.IGNORECASE):
            continue
        fabricante = campos.get("Vendor", "")
        dispositivo = campos.get("Device", "")
        modelo = " ".join(filter(None, (fabricante, dispositivo)))
        if not modelo:
            continue
        filas.append(("GPU", modelo))
        if campos.get("Driver"):
            filas.append(("Controlador gráfico activo", campos["Driver"]))
        nvidia |= fabricante.lower().endswith("[10de]")

    if not filas:
        fabricantes = {"0x10de": "NVIDIA", "0x1002": "AMD", "0x8086": "Intel"}
        for ruta in sorted(Path("/sys/bus/pci/devices").glob("*")):
            clase = (leer_texto(str(ruta / "class")) or "").strip()
            if not clase.startswith("0x03"):
                continue
            fabricante = (leer_texto(str(ruta / "vendor")) or "").strip().lower()
            dispositivo = (leer_texto(str(ruta / "device")) or "").strip().lower()
            modelo = fabricantes.get(fabricante, fabricante) or ruta.name
            if dispositivo:
                modelo += " [" + dispositivo.removeprefix("0x") + "]"
            filas.append(("GPU", modelo))
            try:
                controlador = (ruta / "driver").readlink().name
            except OSError:
                pass
            else:
                filas.append(("Controlador gráfico activo", controlador))
            nvidia |= fabricante == "0x10de"

    if nvidia:
        instalada = _ejecutar(comando_host("/usr/sbin/modinfo", "-F", "version", "nvidia"))
        cargada = (leer_texto("/sys/module/nvidia/version") or "").strip()
        if instalada:
            filas.append(("Versión del módulo NVIDIA instalado", instalada))
        else:
            paquetes = _ejecutar(comando_host(
                "dpkg-query", "-W", "-f=${db:Status-Status}\t${Package}\t${Version}\n",
                "nvidia-driver", "nvidia-driver-*", "nvidia-tesla-*-driver", "nvidia-legacy-*-driver",
            ))
            for linea in paquetes.splitlines():
                campos = linea.split("\t")
                if len(campos) == 3 and campos[0] == "installed":
                    filas.append(("Paquete del controlador NVIDIA", f"{campos[1]} {campos[2]}"))
        if cargada and cargada != instalada:
            filas.append(("Versión del módulo NVIDIA cargado", cargada))
    return filas


def informacion_sistema():
    uname = os.uname()
    filas = [
        ("Sistema operativo", sistema_operativo()),
        ("Kernel actual", uname.release),
        ("Arquitectura", uname.machine),
    ]
    cpuinfo = leer_texto("/proc/cpuinfo") or ""
    procesador = re.search(r"^(?:model name|Hardware)\s*:\s*(.+)$", cpuinfo, re.MULTILINE)
    if procesador:
        filas.append(("Procesador", procesador.group(1).strip()))
    hilos = os.cpu_count()
    if hilos is not None:
        filas.append(("Procesadores lógicos", str(hilos)))

    meminfo = leer_texto("/proc/meminfo") or ""
    for campo, nombre in (("MemTotal", "Memoria RAM total"),
                          ("MemAvailable", "Memoria RAM disponible")):
        memoria = re.search(rf"^{campo}:\s*(\d+) kB$", meminfo, re.MULTILINE)
        if memoria:
            filas.append((nombre, "%.1f GiB" % (int(memoria.group(1)) / 1024 ** 2)))

    filas.extend(informacion_grafica())

    escritorio = os.environ.get("XDG_CURRENT_DESKTOP")
    if escritorio:
        filas.append(("Entorno de escritorio", " / ".join(escritorio.split(":"))))
    sesion = os.environ.get("XDG_SESSION_TYPE", "").lower()
    if sesion:
        filas.append(("Tipo de sesión", {"wayland": "Wayland", "x11": "X11"}.get(sesion, sesion)))

    uptime = re.match(r"[0-9]+", leer_texto("/proc/uptime") or "")
    if uptime:
        horas, minutos = divmod(int(uptime.group()) // 60, 60)
        dias, horas = divmod(horas, 24)
        filas.append(("Tiempo encendido", traducir("%d d · %d h · %d min") % (dias, horas, minutos)))

    try:
        du = shutil.disk_usage("/")
        gib = 1024 ** 3
        filas.append((
            "Espacio en disco (/)",
            traducir("Usado: %.1f GiB / Total: %.1f GiB (%d%% ocupado)")
            % (du.used / gib, du.total / gib, round(du.used * 100 / du.total)),
        ))
    except OSError:
        pass

    fecha = fecha_instalacion()
    if fecha:
        hoy = datetime.date.today()
        a, m, d = antiguedad(fecha, hoy)
        total = (hoy - fecha).days
        filas.append(("Fecha de instalación", fecha.isoformat()))
        filas.append((
            "Antigüedad del sistema",
            traducir("%d años, %d meses y %d días (%d días en total)")
            % (a, m, d, total),
        ))

    version = version_app()
    filas.append(("Versión de AiO Debian GUI", version))
    return filas, version


