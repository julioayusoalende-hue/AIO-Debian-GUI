def etiqueta(texto, markup=False, dim=False, xalign=0.0):
    texto = traducir(texto)
    lbl = Gtk.Label(xalign=xalign)
    if markup:
        lbl.set_markup(texto)
    else:
        lbl.set_text(texto)
    lbl.set_line_wrap(True)
    if dim:
        lbl.get_style_context().add_class("dim-label")
    return lbl


class VentanaPrincipal(Gtk.Window):
    def __init__(self, preferencias=None):
        super().__init__(title="AiO Debian")
        self.preferencias = (preferencias or PREFERENCIAS_DEFECTO).copy()
        self.handler_cierre = None
        global IDIOMA_ACTUAL
        IDIOMA_ACTUAL = self.preferencias["idioma"]
        self.set_default_size(1160, 780)
        self.set_icon_name("aio-debian-gui")

        self.en_curso = False
        self.proceso = None
        self.flujo = None
        self.necesita_reinicio = False
        self.hubo_errores = False
        self.fin_recibido = False
        self.terminado_gestionado = False
        self.configurando_sin_contrasena = None
        self.actualizando_sin_contrasena = False
        self.esperando_autorizacion = False
        self.cancelacion_autorizacion = None
        self.timeout_autorizacion_id = None
        self.consultando_estados = False
        self.timeout_estados_id = None
        self.estados_tareas = set()
        self.nvidia_presente = False
        self.nvidia_hibrida = False
        self.nvidia_instalada = False
        self.nvidia_candidata = "no-disponible"
        self.nvidia_secureboot = "desconocido"
        self.salida_estados = []
        self.comprobando_actualizacion = False
        self.diagnostico_en_curso = False
        self.ventana_diagnostico = None
        self.btn_actualizar_diagnostico = None
        self.tareas_en_ejecucion = []
        self.actualizando_preset = False
        self.switches = {}
        self.filas = {}
        self.indicadores = {}
        self.ventana_consola = None
        self.log_separado = None

        self.distribucion = distribucion_anfitrion()
        self.flatpak_presente = es_flatpak() or shutil.which("flatpak") is not None
        self.gnome_presente = paquete_instalado("gnome-shell")

        self._construir_cabecera()
        self._construir_cuerpo()
        self.connect("delete-event", self._al_cerrar)

    # -- Construcción ----------------------------------------------------------
    def _construir_cabecera(self):
        hb = Gtk.HeaderBar()
        hb.set_show_close_button(True)
        formato = formato_actualizacion()
        hb.set_title(f"AiO Debian — {formato.upper()}" if formato else "AiO Debian")
        hb.set_subtitle(traducir("Mantenimiento y configuración del sistema") +
                        (" · Ubuntu LTS" if self.distribucion == "ubuntu" else
                         " · Debian" if self.distribucion == "debian" else " · Sistema no compatible"))

        self.btn_menu = Gtk.MenuButton()
        self.btn_menu.add(Gtk.Image.new_from_icon_name(
            "open-menu-symbolic", Gtk.IconSize.BUTTON))
        self.btn_menu.set_tooltip_text(traducir("Menú de preferencias"))
        popover = Gtk.Popover.new(self.btn_menu)
        menu = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        menu.set_margin_top(8)
        menu.set_margin_bottom(8)
        menu.set_margin_start(8)
        menu.set_margin_end(8)

        self.btn_preferencias_menu = Gtk.Button(label=traducir("Preferencias"))
        self.btn_preferencias_menu.connect("clicked", self._abrir_preferencias)
        menu.pack_start(self.btn_preferencias_menu, False, False, 0)

        btn_historial = Gtk.Button(label=traducir("Historial de mantenimiento"))
        btn_historial.connect("clicked", self._mostrar_historial)
        menu.pack_start(btn_historial, False, False, 0)

        self.btn_actualizar = Gtk.Button(label=traducir("Buscar actualizaciones"))
        self.btn_actualizar.set_tooltip_text(traducir("Actualizar esta aplicación"))
        self.btn_actualizar.connect("clicked", self._buscar_actualizacion)
        menu.pack_start(self.btn_actualizar, False, False, 0)

        btn_acerca = Gtk.Button(label=traducir("Acerca de AiO Debian"))
        btn_acerca.connect("clicked", self._acerca_de)
        menu.pack_start(btn_acerca, False, False, 0)

        popover.add(menu)
        menu.show_all()
        self.btn_menu.set_popover(popover)
        self.menu_popover = popover
        hb.pack_start(self.btn_menu)
        self.set_titlebar(hb)


    def _buscar_actualizacion(self, _boton):
        self.menu_popover.popdown()
        if self.comprobando_actualizacion or self.en_curso:
            return
        self.comprobando_actualizacion = True
        self._actualizar_sensibilidad()
        formato = formato_actualizacion()

        def comprobar():
            try:
                if formato == "deb":
                    # Refresca la información APT de forma autorizada, sin instalar nada.
                    resultado = subprocess.run(
                        comando_pkexec(HELPER_SISTEMA, "C.UTF-8", "--check-update-self"),
                        capture_output=True, text=True, timeout=180,
                    )
                    if resultado.returncode:
                        raise RuntimeError((resultado.stderr or resultado.stdout).strip()[-1200:] or
                                           "No se pudo consultar APT.")
                    lineas = [line for line in resultado.stdout.splitlines()
                              if line.startswith(("##UPDATE:", "##NOUPDATE:"))]
                    if len(lineas) != 1:
                        raise RuntimeError("El asistente no devolvió información válida de APT.")
                    campos = lineas[0].split(":")
                    if len(campos) != 3:
                        raise RuntimeError("Formato de versiones APT no válido.")
                    actual, nueva = campos[1:]
                    if lineas[0].startswith("##NOUPDATE:"):
                        GLib.idle_add(self._terminar_actualizacion, Gtk.MessageType.INFO,
                                      "Ya tienes la última versión", f"Versión instalada: {actual}.")
                        return
                    detalle = f"Versión instalada: {actual}.\nVersión disponible: {nueva}.\n\n¿Actualizar mediante APT?"
                    datos = None
                elif formato == "flatpak":
                    # Sin privilegios: actualizar metadatos y consultar revisiones pendientes.
                    metadatos = subprocess.run(
                        ["flatpak-spawn", "--host", "flatpak", "update", "--user",
                         "--appstream", "--noninteractive"],
                        capture_output=True, text=True, timeout=90,
                    )
                    if metadatos.returncode:
                        raise RuntimeError((metadatos.stderr or metadatos.stdout).strip()[-1200:] or
                                           "No se pudo actualizar el catálogo Flatpak.")
                    resultado = subprocess.run(
                        ["flatpak-spawn", "--host", "flatpak", "remote-ls", "--user",
                         "--updates", "--app", "--columns=application"],
                        capture_output=True, text=True, timeout=40,
                    )
                    if resultado.returncode:
                        raise RuntimeError((resultado.stderr or resultado.stdout).strip()[-1200:] or
                                           "No se pudo consultar el repositorio Flatpak.")
                    if APP_ID_FLATPAK not in resultado.stdout.splitlines():
                        GLib.idle_add(self._terminar_actualizacion, Gtk.MessageType.INFO,
                                      "Ya tienes la última versión", f"Versión instalada: {version_app()}.")
                        return
                    detalle = ("Hay una actualización Flatpak disponible en el repositorio firmado.\n"
                               "¿Quieres instalarla ahora?")
                    datos = None
                elif formato == "appimage":
                    version, nombre, url, url_hash = obtener_release_actualizacion()
                    instalada = version_numerica(version_app())
                    if instalada is None:
                        raise RuntimeError("No se pudo identificar la versión instalada.")
                    if version_numerica(version) <= instalada:
                        GLib.idle_add(self._terminar_actualizacion, Gtk.MessageType.INFO,
                                      "Ya tienes la última versión", f"Versión instalada: {version_app()}.")
                        return
                    detalle = (f"Versión instalada: {version_app()}.\nVersión disponible: {version}.\n\n"
                               "Se descargará el nuevo AppImage, verificado mediante SHA-256, "
                               "sin sustituir el archivo actual. ¿Continuar?")
                    datos = (version, nombre, url, url_hash)
                else:
                    raise RuntimeError("No se pudo identificar el formato de instalación.")
                GLib.idle_add(self._confirmar_actualizacion, formato, detalle, datos)
            except (OSError, ValueError, RuntimeError, urllib.error.URLError,
                    subprocess.SubprocessError) as error:
                GLib.idle_add(self._terminar_actualizacion, Gtk.MessageType.ERROR,
                              "No se pudo actualizar", str(error))

        threading.Thread(target=comprobar, daemon=True).start()

    def _confirmar_actualizacion(self, formato, detalle, datos):
        dialogo = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE, text=traducir("Confirmar actualización"),
        )
        dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
        dialogo.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
        dialogo.set_default_response(Gtk.ResponseType.CANCEL)
        dialogo.format_secondary_text(detalle)
        casilla_reinicio = Gtk.CheckButton(
            label=traducir("Reiniciar AiO automáticamente tras actualizar"))
        casilla_reinicio.set_active(False)
        dialogo.get_content_area().pack_start(casilla_reinicio, False, False, 8)
        casilla_reinicio.show()
        aceptar = dialogo.run() == Gtk.ResponseType.OK
        reiniciar_automaticamente = casilla_reinicio.get_active()
        dialogo.destroy()
        if not aceptar:
            self.comprobando_actualizacion = False
            self._actualizar_sensibilidad()
            return False

        def aplicar():
            try:
                if formato == "deb":
                    resultado = subprocess.run(
                        comando_pkexec(HELPER_SISTEMA, "C.UTF-8", "--update-self"),
                        capture_output=True, text=True, timeout=300,
                    )
                    if resultado.returncode:
                        raise RuntimeError((resultado.stderr or resultado.stdout).strip()[-1200:] or
                                           "No se pudo actualizar el paquete DEB.")
                    titulo = "Actualización DEB completada"
                    detalle_final = "APT ha instalado la nueva versión de AiO Debian GUI."
                    reinicio = ("deb", None)
                elif formato == "flatpak":
                    resultado = subprocess.run(
                        ["flatpak-spawn", "--host", "flatpak", "update",
                         "--user", "--noninteractive", "-y", APP_ID_FLATPAK],
                        capture_output=True, text=True, timeout=300,
                    )
                    if resultado.returncode:
                        raise RuntimeError((resultado.stderr or resultado.stdout).strip()[-1200:] or
                                           "No se pudo actualizar el Flatpak.")
                    titulo = "Actualización Flatpak completada"
                    detalle_final = "La nueva versión Flatpak está instalada."
                    reinicio = ("flatpak", None)
                else:
                    version, nombre, url, url_hash = datos
                    destino = descargar_appimage_verificado(version, nombre, url, url_hash)
                    titulo = "Nueva AppImage descargada"
                    detalle_final = (f"Versión {version} verificada mediante SHA-256.\n"
                                     f"Archivo: {destino}\n\n"
                                     "La AppImage anterior se conserva como copia.")
                    reinicio = ("appimage", destino)
                GLib.idle_add(self._terminar_actualizacion, Gtk.MessageType.INFO,
                              titulo, detalle_final, reinicio, reiniciar_automaticamente)
            except (OSError, ValueError, RuntimeError, urllib.error.URLError,
                    subprocess.SubprocessError) as error:
                GLib.idle_add(self._terminar_actualizacion, Gtk.MessageType.ERROR,
                              "No se pudo actualizar", str(error))

        threading.Thread(target=aplicar, daemon=True).start()
        return False

    def _terminar_actualizacion(self, tipo, titulo, detalle,
                               reinicio=None, automatico=False):
        self.comprobando_actualizacion = False
        self._actualizar_sensibilidad()
        if tipo != Gtk.MessageType.INFO or reinicio is None:
            self._mensaje(tipo, titulo, detalle)
            return False
        if automatico:
            self._reiniciar_aplicacion_actualizada(reinicio)
            return False

        pregunta = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE, text=traducir(titulo))
        pregunta.format_secondary_text(
            detalle + "\n\n" + traducir("¿Reiniciar AiO Debian GUI ahora?"))
        pregunta.add_button(traducir("Más tarde"), Gtk.ResponseType.NO)
        pregunta.add_button(traducir("Reiniciar aplicación"), Gtk.ResponseType.YES)
        pregunta.set_default_response(Gtk.ResponseType.NO)
        respuesta = pregunta.run()
        pregunta.destroy()
        if respuesta == Gtk.ResponseType.YES:
            self._reiniciar_aplicacion_actualizada(reinicio)
        return False

    def _reiniciar_aplicacion_actualizada(self, reinicio):
        """Relanzar solo si la instalación anterior terminó correctamente.

        DEB vuelve a ejecutar el archivo actualizado; Flatpak lanza el host,
        y AppImage abre únicamente el archivo nuevo con SHA-256 verificado.
        """
        if self.en_curso or self.diagnostico_en_curso:
            self._mensaje(Gtk.MessageType.WARNING, "No se puede reiniciar",
                          "Hay una operación en curso. Reinicia AiO cuando termine.")
            return
        formato, destino = reinicio
        try:
            if formato == "deb":
                os.execv(sys.executable, [sys.executable, "/usr/bin/aio-debian-gui"])
            elif formato == "flatpak":
                subprocess.Popen(
                    ["flatpak-spawn", "--host", "flatpak", "run", "--user", APP_ID_FLATPAK],
                    start_new_session=True, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL)
            elif formato == "appimage" and destino and os.path.isfile(destino):
                subprocess.Popen(
                    [destino], start_new_session=True, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL)
            else:
                raise RuntimeError("No se encontró un ejecutable actualizado para reiniciar.")
        except (OSError, RuntimeError) as exc:
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo reiniciar AiO",
                          str(exc))
            return
        Gtk.main_quit()


    def _confirmar_tareas(self, pasos):
        nombres = {pid: titulo for pid, titulo, *_ in PASOS}
        dialogo = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE, text=traducir("Vista previa del mantenimiento"),
        )
        dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
        dialogo.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
        dialogo.set_default_response(Gtk.ResponseType.CANCEL)
        detalle = "\n".join("• " + traducir(nombres[p]) for p in pasos)
        detalle += ("\n\n" + traducir(
            "Esta es una vista previa de las tareas seleccionadas, no una simulación de APT. "
            "APT puede instalar, actualizar o eliminar dependencias. "
            "Comprueba especialmente las tareas de Backports y eliminación de paquetes."
        ))
        dialogo.format_secondary_text(detalle)
        aceptado = dialogo.run() == Gtk.ResponseType.OK
        dialogo.destroy()
        return aceptado

    def _mostrar_historial(self, _boton):
        self.menu_popover.popdown()
        registros = leer_historial()
        dialogo = Gtk.Dialog(title=traducir("Historial de mantenimiento"), transient_for=self,
                             modal=True)
        dialogo.set_default_size(700, 430)
        dialogo.add_button(traducir("Cerrar"), Gtk.ResponseType.CLOSE)
        dialogo.add_button(traducir("Exportar historial"), Gtk.ResponseType.APPLY)
        area = dialogo.get_content_area()
        vista = Gtk.TextView(editable=False, cursor_visible=False)
        vista.set_monospace(True)
        vista.set_wrap_mode(Gtk.WrapMode.WORD)
        texto = []
        for registro in reversed(registros):
            texto.append(f"{registro['fecha']} — {registro['resultado']} — "
                         f"{registro.get('formato', '?')} {registro.get('version', '?')}")
            texto.append("  " + ", ".join(registro["tareas"]))
            if registro.get("reinicio_recomendado"):
                texto.append("  " + traducir("Reinicio recomendado"))
            texto.append("")
        vista.get_buffer().set_text("\n".join(texto) if texto else
                                    traducir("Todavía no hay operaciones registradas."))
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_height(320)
        scroll.add(vista)
        area.pack_start(scroll, True, True, 8)
        dialogo.show_all()
        while dialogo.run() == Gtk.ResponseType.APPLY:
            selector = Gtk.FileChooserDialog(
                title=traducir("Exportar historial"), transient_for=dialogo,
                action=Gtk.FileChooserAction.SAVE,
                buttons=(traducir("Cancelar"), Gtk.ResponseType.CANCEL,
                         traducir("Guardar"), Gtk.ResponseType.OK),
            )
            selector.set_do_overwrite_confirmation(True)
            selector.set_current_name("aio-debian-gui-history.json")
            if selector.run() == Gtk.ResponseType.OK:
                destino = selector.get_filename()
                try:
                    with open(destino, "w", encoding="utf-8") as archivo:
                        json.dump(registros, archivo, ensure_ascii=False, indent=2)
                        archivo.write("\n")
                except OSError as error:
                    self._mensaje(Gtk.MessageType.ERROR, "No se pudo exportar el historial",
                                  str(error))
            selector.destroy()
        dialogo.destroy()

    def _abrir_preferencias(self, _boton):
        self.menu_popover.popdown()
        dialogo = Gtk.Dialog(
            title=traducir("Preferencias"), transient_for=self, modal=True
        )
        dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
        dialogo.add_button(traducir("Guardar"), Gtk.ResponseType.OK)

        contenido = dialogo.get_content_area()
        grid = Gtk.Grid(column_spacing=12, row_spacing=10)
        for margen in ("top", "bottom", "start", "end"):
            getattr(grid, "set_margin_" + margen)(16)
        contenido.pack_start(grid, True, True, 0)

        combo_idioma = Gtk.ComboBoxText()
        for codigo, nombre in (
            ("es", "Español"), ("en", "English"), ("fr", "Français"), ("zh", "中文")
        ):
            combo_idioma.append(codigo, nombre)
        combo_idioma.set_active_id(self.preferencias["idioma"])
        grid.attach(etiqueta("Idioma de la interfaz"), 0, 0, 1, 1)
        grid.attach(combo_idioma, 1, 0, 1, 1)

        combo_tema = Gtk.ComboBoxText()
        combo_tema.append("sistema", traducir("Seguir el sistema"))
        combo_tema.append("claro", traducir("Claro"))
        combo_tema.append("oscuro", traducir("Oscuro"))
        combo_tema.set_active_id(self.preferencias["tema"])
        grid.attach(etiqueta("Apariencia"), 0, 1, 1, 1)
        grid.attach(combo_tema, 1, 1, 1, 1)

        simple = Gtk.CheckButton(
            label=traducir("Interfaz simple (sin salida de consola)")
        )
        simple.set_active(self.preferencias["modo_simple"])
        grid.attach(simple, 0, 2, 2, 1)
        grid.attach(
            etiqueta("El modo simple oculta la salida detallada de las tareas.", dim=True),
            0, 3, 2, 1,
        )
        dialogo.show_all()
        respuesta = dialogo.run()
        if respuesta != Gtk.ResponseType.OK:
            dialogo.destroy()
            return

        nuevas = {
            "idioma": combo_idioma.get_active_id(),
            "tema": combo_tema.get_active_id(),
            "modo_simple": simple.get_active(),
        }
        try:
            guardar_preferencias(nuevas)
        except OSError as error:
            dialogo.destroy()
            self._mensaje(
                Gtk.MessageType.ERROR,
                "No se pudieron guardar las preferencias",
                str(error),
            )
            return

        idioma_cambiado = nuevas["idioma"] != self.preferencias["idioma"]
        modo_simple_activado = (
            nuevas["modo_simple"] and not self.preferencias["modo_simple"]
        )
        self.preferencias = nuevas
        aplicar_tema(nuevas["tema"])
        dialogo.destroy()
        if idioma_cambiado:
            self._reiniciar_interfaz()
            return
        if modo_simple_activado:
            if self.ventana_consola is not None:
                self.ventana_consola.destroy()
            self.buf.set_text("")
        self.marco_consola.set_no_show_all(nuevas["modo_simple"])
        self.cabecera_consola.set_no_show_all(nuevas["modo_simple"])
        if nuevas["modo_simple"]:
            self.marco_consola.set_visible(False)
            self.cabecera_consola.set_visible(False)
        else:
            if self.ventana_consola is None:
                self.marco_consola.show_all()
            self.cabecera_consola.show_all()

    def _reiniciar_interfaz(self):
        ancho, alto = self.get_size()
        if self.handler_cierre is not None:
            self.disconnect(self.handler_cierre)
        nueva = VentanaPrincipal(self.preferencias)
        nueva.handler_cierre = nueva.connect("destroy", Gtk.main_quit)
        nueva.resize(ancho, alto)
        nueva.show_all()
        nueva._consultar_estados_tareas(inicial=True)
        self.destroy()

    def _construir_cuerpo(self):
        # Paneles realmente lado a lado: información izquierda, tareas derecha.
        # Cada columna puede desplazarse independientemente sin tapar los
        # controles de ejecución ni la consola de la parte inferior.
        principal = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(principal)
        paneles = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paneles.set_wide_handle(True)
        paneles.set_hexpand(True)
        paneles.set_vexpand(True)
        self.paneles_principales = paneles
        principal.pack_start(paneles, True, True, 0)

        izquierda = Gtk.ScrolledWindow()
        izquierda.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        izquierda.set_min_content_width(320)
        izquierda.set_min_content_height(220)
        caja_izquierda = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        caja_izquierda.set_border_width(12)
        izquierda.add(caja_izquierda)
        caja_izquierda.pack_start(self._tarjeta_info(), False, False, 0)
        paneles.pack1(izquierda, resize=True, shrink=False)

        derecha = Gtk.ScrolledWindow()
        derecha.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        derecha.set_min_content_width(420)
        caja_derecha = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        caja_derecha.set_border_width(12)
        derecha.add(caja_derecha)
        caja_derecha.pack_start(self._tarjeta_opciones(), False, False, 0)
        paneles.pack2(derecha, resize=True, shrink=False)
        # El panel de tareas recibe más espacio; el usuario puede ajustar
        # la división arrastrando el separador horizontal.
        paneles.set_position(405)

        inf = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for margen in ("bottom", "start", "end"):
            getattr(inf, "set_margin_" + margen)(12)
        principal.pack_end(inf, False, True, 0)

        acciones = Gtk.Frame()
        acciones_caja = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        for margen in ("top", "bottom", "start", "end"):
            getattr(acciones_caja, "set_margin_" + margen)(10)
        acciones.add(acciones_caja)
        texto_progreso = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        fila = Gtk.Box(spacing=8)
        self.spinner = Gtk.Spinner()
        self.estado = etiqueta(traducir("Listo. Elige las tareas y pulsa «Iniciar tareas»."))
        self.estado.set_line_wrap(True)
        self.btn_cancelar = Gtk.Button(label=traducir("Cancelar espera"))
        self.btn_cancelar.set_no_show_all(True)
        self.btn_cancelar.connect("clicked", self._cancelar_espera_autorizacion)
        fila.pack_start(self.spinner, False, False, 0)
        fila.pack_start(self.estado, True, True, 0)
        fila.pack_end(self.btn_cancelar, False, False, 0)
        texto_progreso.pack_start(fila, False, False, 0)
        self.barra = Gtk.ProgressBar()
        texto_progreso.pack_start(self.barra, False, False, 0)
        acciones_caja.pack_start(texto_progreso, True, True, 0)

        self.btn_iniciar = Gtk.Button(label=traducir("Iniciar tareas"))
        self.btn_iniciar.set_image(Gtk.Image.new_from_icon_name(
            "media-playback-start-symbolic", Gtk.IconSize.BUTTON))
        self.btn_iniciar.set_always_show_image(True)
        self.btn_iniciar.get_style_context().add_class("suggested-action")
        self.btn_iniciar.set_size_request(160, 48)
        self.btn_iniciar.connect("clicked", self._iniciar)
        acciones_caja.pack_end(self.btn_iniciar, False, False, 0)
        inf.pack_start(acciones, False, False, 0)

        cabecera_log = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        icono_log = Gtk.Image.new_from_icon_name("utilities-terminal-symbolic", Gtk.IconSize.BUTTON)
        cabecera_log.pack_start(icono_log, False, False, 0)
        cabecera_log.pack_start(
            etiqueta("<b>Salida de la consola</b>", markup=True), True, True, 0)
        self.btn_separar_consola = Gtk.Button(label=traducir("Abrir en otra ventana"))
        self.btn_separar_consola.set_image(Gtk.Image.new_from_icon_name(
            "window-new-symbolic", Gtk.IconSize.BUTTON))
        self.btn_separar_consola.set_always_show_image(True)
        self.btn_separar_consola.connect("clicked", self._alternar_ventana_consola)
        cabecera_log.pack_end(self.btn_separar_consola, False, False, 0)

        btn_borrar = Gtk.Button(label=traducir("Borrar"))
        btn_borrar.set_image(Gtk.Image.new_from_icon_name(
            "edit-clear-symbolic", Gtk.IconSize.BUTTON))
        btn_borrar.set_always_show_image(True)
        btn_borrar.connect("clicked", self._borrar_consola)
        self.btn_borrar = btn_borrar
        cabecera_log.pack_end(btn_borrar, False, False, 0)
        self.cabecera_consola = cabecera_log
        self.cabecera_consola.set_no_show_all(self.preferencias["modo_simple"])
        inf.pack_start(cabecera_log, False, False, 0)

        marco = Gtk.ScrolledWindow()
        marco.set_shadow_type(Gtk.ShadowType.IN)
        marco.set_size_request(-1, 132)
        marco.set_min_content_height(110)
        marco.set_no_show_all(self.preferencias["modo_simple"])
        self.marco_consola = marco
        self.log = Gtk.TextView(editable=False, cursor_visible=False)
        self.log.set_monospace(True)
        self.log.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.log.set_left_margin(8)
        self.log.set_right_margin(8)
        self.buf = self.log.get_buffer()
        self.buf.create_tag("ok", foreground="#26a269")
        self.buf.create_tag("aviso", foreground="#cd9309")
        self.buf.create_tag("error", foreground="#e01b24")
        self.buf.create_tag("info", foreground="#1c71d8")
        self.buf.create_tag("paso", weight=Pango.Weight.BOLD)
        marco.add(self.log)
        inf.pack_start(marco, False, True, 0)
        if self.preferencias["modo_simple"]:
            marco.hide()
            cabecera_log.hide()

    def _alternar_ventana_consola(self, _boton=None):
        # Se reutiliza el mismo Gtk.TextBuffer en las dos vistas: no se
        # duplica la salida ni se pierde el formato o el historial.
        if self.ventana_consola is not None:
            self.ventana_consola.destroy()
            return
        ventana = Gtk.Window(title=traducir("Salida de la consola"))
        ventana.set_transient_for(self)
        ventana.set_destroy_with_parent(True)
        ventana.set_default_size(900, 480)
        ventana.set_icon_name("aio-debian-gui")
        marco = Gtk.ScrolledWindow()
        marco.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        marco.set_shadow_type(Gtk.ShadowType.IN)
        vista = Gtk.TextView.new_with_buffer(self.buf)
        vista.set_editable(False)
        vista.set_cursor_visible(False)
        vista.set_monospace(True)
        vista.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        vista.set_left_margin(10)
        vista.set_right_margin(10)
        marco.add(vista)
        ventana.add(marco)
        self.ventana_consola = ventana
        self.log_separado = vista
        ventana.connect("destroy", self._consola_separada_cerrada)
        self.marco_consola.hide()
        self.btn_separar_consola.set_label(traducir("Volver a integrar"))
        ventana.show_all()
        self._desplazar_consola(vista)
        ventana.present()

    def _consola_separada_cerrada(self, _ventana):
        self.ventana_consola = None
        self.log_separado = None
        self.btn_separar_consola.set_label(traducir("Abrir en otra ventana"))
        if not self.preferencias["modo_simple"]:
            self.marco_consola.show_all()

    def _desplazar_consola(self, vista):
        marca = self.buf.create_mark(None, self.buf.get_end_iter(), False)
        vista.scroll_to_mark(marca, 0.0, False, 0, 0)
        self.buf.delete_mark(marca)

    def _borrar_consola(self, _boton):
        if not self.en_curso:
            self.buf.set_text("")

    def _tarjeta_info(self):
        marco = Gtk.Frame()
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        for m in ("top", "bottom", "start", "end"):
            getattr(caja, "set_margin_" + m)(12)
        marco.add(caja)

        titulo = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        titulo.pack_start(Gtk.Image.new_from_icon_name(
            "computer-symbolic", Gtk.IconSize.BUTTON), False, False, 0)
        titulo.pack_start(etiqueta("<b>Información del sistema</b>", markup=True), False, False, 0)
        self.btn_diagnostico = Gtk.Button(label=traducir("Diagnosticar"))
        self.btn_diagnostico.set_tooltip_text(traducir(
            "Comprobar el sistema sin realizar modificaciones"))
        self.btn_diagnostico.connect("clicked", self._abrir_diagnostico)
        self.btn_salud = Gtk.Button(label=traducir("Estado de mantenimiento"))
        self.btn_salud.connect("clicked", self._abrir_salud)
        titulo.pack_end(self.btn_salud, False, False, 0)
        titulo.pack_end(self.btn_diagnostico, False, False, 0)
        caja.pack_start(titulo, False, False, 0)

        filas, version = informacion_sistema()
        grid = Gtk.Grid(column_spacing=12, row_spacing=6)
        for i, (clave, valor) in enumerate(filas):
            nombre = etiqueta(clave, dim=True)
            nombre.set_line_wrap(True)
            nombre.set_max_width_chars(20)
            grid.attach(nombre, 0, i, 1, 1)
            dato = etiqueta(valor)
            dato.set_line_wrap(True)
            dato.set_max_width_chars(25)
            dato.set_selectable(True)
            grid.attach(dato, 1, i, 1, 1)
        caja.pack_start(grid, False, False, 0)

        ruta_logo, nombre_logo = logo_distribucion(self.distribucion)
        if ruta_logo and os.path.isfile(ruta_logo):
            try:
                imagen_logo = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    ruta_logo, 76, 76, True)
                logo = Gtk.Image.new_from_pixbuf(imagen_logo)
                logo.set_tooltip_text(traducir(nombre_logo))
                logo.set_halign(Gtk.Align.CENTER)
                logo.get_accessible().set_name(traducir(nombre_logo))
                caja.pack_start(logo, False, False, 6)
            except GLib.Error:
                pass

        nov = NOVEDADES.get(version)
        if nov:
            caja.pack_start(etiqueta("<b>Novedades de esta versión:</b>",
                                     markup=True), False, False, 4)
            detalle = etiqueta(nov, dim=True)
            detalle.set_line_wrap(True)
            detalle.set_max_width_chars(44)
            caja.pack_start(detalle, False, False, 0)
        if self.distribucion == "debian":
            self.nvidia_info_label = etiqueta("Buscando GPU NVIDIA…", dim=True)
            caja.pack_start(self.nvidia_info_label, False, False, 3)
        return marco

    def _abrir_salud(self, _boton=None):
        dialogo = Gtk.MessageDialog(transient_for=self, modal=True,
            message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.CLOSE,
            text=traducir("Estado de mantenimiento"))
        try:
            import shutil as _shutil
            libre = _shutil.disk_usage("/").free / (1024 ** 3)
            informe = "Espacio libre: %.1f GiB" % libre
            informe += "\nReinicio solicitado: " + ("Sí" if os.path.exists("/run/reboot-required") else "No")
        except OSError:
            informe = traducir("No se pudo completar el resumen de salud.")
        dialogo.format_secondary_text(informe)
        dialogo.run()
        dialogo.destroy()

    def _abrir_diagnostico(self, _boton=None):
        if self.diagnostico_en_curso:
            if self.ventana_diagnostico is not None:
                self.ventana_diagnostico.present()
            return
        if self.ventana_diagnostico is not None:
            self.ventana_diagnostico.present()
            return

        dialogo = Gtk.Dialog(
            title=traducir("Diagnóstico preventivo del sistema"),
            transient_for=self, modal=False,
        )
        dialogo.set_default_size(730, 540)
        dialogo.add_button(traducir("Cerrar"), Gtk.ResponseType.CLOSE)
        dialogo.connect("response", lambda d, _response: d.destroy())
        dialogo.connect("destroy", self._diagnostico_cerrado)
        self.ventana_diagnostico = dialogo
        contenedor = dialogo.get_content_area()
        contenedor.set_spacing(10)
        contenedor.set_border_width(12)
        aviso = etiqueta(traducir(
            "Análisis de solo lectura. No instala, elimina ni repara paquetes. "
            "Las comprobaciones dependen del estado de los índices APT."), dim=True)
        contenedor.pack_start(aviso, False, False, 0)
        self.etiqueta_diagnostico = etiqueta(traducir("Analizando el sistema…"))
        contenedor.pack_start(self.etiqueta_diagnostico, False, False, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        contenedor.pack_start(scroll, True, True, 0)
        self.lista_diagnostico = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scroll.add(self.lista_diagnostico)
        dialogo.show_all()
        self.diagnostico_en_curso = True
        self.btn_diagnostico.set_sensitive(False)
        self.btn_actualizar_diagnostico = None
        formato = formato_actualizacion()
        version_instalada = version_app()

        def analizar():
            try:
                resultados = core_diagnostics.run_diagnostics()
                estado_app = core_updates.estado_actualizacion_app(
                    formato, version_instalada, APP_ID_FLATPAK)
                estado = {
                    "available": "warning", "current": "ok",
                    "unknown": "unknown", "unsupported": "unknown",
                }.get(estado_app["status"], "unknown")
                resultados.append({
                    "name": "Versión de AiO Debian GUI",
                    "status": estado,
                    "detail": estado_app["detail"],
                    "advice": ("Hay una actualización disponible. Puedes instalarla desde aquí."
                               if estado_app["status"] == "available" else ""),
                    "action": ("update" if estado_app["status"] == "available" else None),
                })
                error = None
            except Exception as exc:
                resultados = []
                error = str(exc)
            GLib.idle_add(self._diagnostico_terminado, dialogo, resultados, error)
        threading.Thread(target=analizar, daemon=True).start()

    def _actualizar_desde_diagnostico(self, _boton):
        if self.en_curso or self.comprobando_actualizacion:
            return
        if self.ventana_diagnostico is not None:
            self.ventana_diagnostico.destroy()
        self._buscar_actualizacion(None)

    def _diagnostico_cerrado(self, dialogo):
        if self.ventana_diagnostico is dialogo:
            self.ventana_diagnostico = None
            self.btn_actualizar_diagnostico = None

    def _diagnostico_terminado(self, dialogo, resultados, error):
        self.diagnostico_en_curso = False
        self.btn_diagnostico.set_sensitive(not self.en_curso)
        if self.ventana_diagnostico is not dialogo:
            return GLib.SOURCE_REMOVE
        if error is not None:
            self.etiqueta_diagnostico.set_text(
                traducir("No se pudo completar el diagnóstico: ") + error)
            return GLib.SOURCE_REMOVE
        recuento = {
            estado: sum(f["status"] == estado for f in resultados)
            for estado in ("critical", "warning", "unknown", "ok")
        }
        self.etiqueta_diagnostico.set_text(
            "%s: %s · %s: %s · %s: %s · %s: %s"
            % (traducir("Críticos"), recuento["critical"],
               traducir("Avisos"), recuento["warning"],
               traducir("No comprobados"), recuento["unknown"],
               traducir("Correctos"), recuento["ok"]))
        estados = {
            "critical": ("dialog-error-symbolic", "Requiere atención"),
            "warning": ("dialog-warning-symbolic", "Revisar"),
            "unknown": ("dialog-question-symbolic", "Sin comprobar"),
            "ok": ("emblem-ok-symbolic", "Correcto"),
        }
        for resultado in resultados:
            icono, estado = estados.get(resultado["status"], estados["unknown"])
            fila = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            fila.set_margin_top(6)
            fila.set_margin_bottom(6)
            fila.pack_start(
                Gtk.Image.new_from_icon_name(icono, Gtk.IconSize.BUTTON),
                False, False, 0)
            bloque = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            titulo = etiqueta("<b>%s</b> · %s" % (
                GLib.markup_escape_text(traducir(resultado["name"])),
                GLib.markup_escape_text(traducir(estado))), markup=True)
            bloque.pack_start(titulo, False, False, 0)
            detalle = etiqueta(traducir_detalle_diagnostico(resultado["detail"]), dim=True)
            detalle.set_selectable(True)
            bloque.pack_start(detalle, False, False, 0)
            if resultado["advice"]:
                bloque.pack_start(etiqueta(traducir(resultado["advice"])), False, False, 0)
            fila.pack_start(bloque, True, True, 0)
            if resultado.get("action") == "update":
                boton = Gtk.Button(label=traducir("Actualizar AiO"))
                boton.set_tooltip_text(traducir(
                    "Instalar la versión disponible con el actualizador de AiO"))
                boton.set_sensitive(not self.en_curso and
                                    not self.comprobando_actualizacion)
                boton.connect("clicked", self._actualizar_desde_diagnostico)
                fila.pack_end(boton, False, False, 0)
                self.btn_actualizar_diagnostico = boton
            self.lista_diagnostico.pack_start(fila, False, False, 0)
            self.lista_diagnostico.pack_start(Gtk.Separator(), False, False, 0)
        self.lista_diagnostico.show_all()
        return GLib.SOURCE_REMOVE

    def _tarjeta_opciones(self):
        externa = Gtk.Frame()
        tarjeta = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for margen in ("top", "bottom", "start", "end"):
            getattr(tarjeta, "set_margin_" + margen)(12)
        externa.add(tarjeta)

        cab = Gtk.Box(spacing=8)
        cab.pack_start(etiqueta("<b>Tareas a realizar</b>", markup=True), True, True, 0)
        presets = Gtk.Box()
        presets.get_style_context().add_class("linked")
        b1 = Gtk.Button(label=traducir("Completo"))
        b1.set_tooltip_text(traducir("Mantenimiento completo (valores por defecto)"))
        b1.connect("clicked", self._preset_completo)
        b2 = Gtk.Button(label=traducir("Solo Flatpak"))
        b2.set_tooltip_text(
            traducir("Saltarse el mantenimiento de APT y actualizar solo Flatpak")
        )
        b2.connect("clicked", self._preset_flatpak)
        presets.pack_start(b1, False, False, 0)
        presets.pack_start(b2, False, False, 0)
        self.botones_preset = (b1, b2)
        cab.pack_end(presets, False, False, 0)
        tarjeta.pack_start(cab, False, False, 0)

        self.chk_sin_contrasena = Gtk.CheckButton(
            label=traducir(
                "No solicitar contraseña de administrador en AiO (opcional)"
            )
        )
        self.chk_sin_contrasena.set_tooltip_text(
            "Excepción persistente de Polkit solo para el asistente de AiO y este usuario local activo. "
            "Permite ejecutar todas las tareas de AiO como administrador sin contraseña; "
            "otros procesos del mismo usuario también podrían invocar el asistente. "
            "Desmarca para revocarla."
        )
        self.chk_sin_contrasena.set_active(autorizacion_sin_contrasena_activa())
        self.chk_sin_contrasena.connect("toggled", self._cambiar_sin_contrasena)
        tarjeta.pack_start(self.chk_sin_contrasena, False, False, 0)
        tarjeta.pack_start(
            etiqueta("Por defecto Polkit solicita contraseña. Esta excepción es voluntaria y aumenta los riesgos de seguridad.", dim=True),
            False, False, 0,
        )

        for gid, gtitulo in GRUPOS:
            visibles = [p for p in PASOS if p[4] == gid and self._visible(p[0])]
            if not visibles:
                continue
            tarjeta.pack_start(etiqueta(gtitulo, dim=True), False, False, 2)
            marco = Gtk.Frame()
            lista = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            marco.add(lista)
            for pid, titulo, desc, defecto, _ in visibles:
                lista.add(self._fila(pid, titulo, desc, defecto))
            tarjeta.pack_start(marco, False, False, 0)
        return externa

    def _consultar_estados_tareas(self, inicial=False):
        if self.consultando_estados:
            return
        self.consultando_estados = True
        self.consulta_inicial = inicial
        self.salida_estados = []
        if inicial:
            self.estado.set_text(traducir("Comprobando tareas ya instaladas…"))
        self._actualizar_sensibilidad()
        comando_estado = (
            ["flatpak-spawn", "--host", HELPER_SISTEMA, "--status"]
            if es_flatpak() else ["bash", HELPER, "--status"]
        )

        # Do not rely on GIO stdout async EOF delivery on all desktops.
        # Only the main GTK thread updates widgets; worker collects subprocess output.
        def comprobar():
            try:
                resultado = subprocess.run(
                    comando_estado, capture_output=True, text=True,
                    timeout=15, check=False,
                )
                codigo, salida, error = (
                    resultado.returncode, resultado.stdout, resultado.stderr,
                )
            except subprocess.TimeoutExpired:
                codigo, salida, error = -1, "", (
                    "El asistente no respondió en 15 segundos."
                )
            except (OSError, subprocess.SubprocessError) as exc:
                codigo, salida, error = -1, "", str(exc)
            GLib.idle_add(self._estados_terminados, codigo, salida, error)

        threading.Thread(target=comprobar, daemon=True).start()

    def _estados_terminados(self, codigo, salida, error=""):
        if not self.consultando_estados:
            return GLib.SOURCE_REMOVE
        self.salida_estados = (salida or "").splitlines()
        if codigo != 0:
            self._finalizar_consulta_estados(
                False, "El asistente terminó con código %s: %s" % (
                    codigo, (error or "sin detalles").strip()[:350],
                )
            )
            return GLib.SOURCE_REMOVE
        estados = {}
        nvidia = {}
        for linea in self.salida_estados:
            campos_nvidia = linea.split(":", 2)
            if (len(campos_nvidia) == 3 and campos_nvidia[0] == "##NVIDIA"
                    and campos_nvidia[1] in ("present", "hybrid", "installed", "candidate", "secureboot", "kernel")):
                nvidia[campos_nvidia[1]] = campos_nvidia[2]
            campos = linea.split(":")
            if (len(campos) == 3 and campos[0] == "##STATUS"
                    and campos[1] in (
                        "repos", "tools", "backports-kernel-mesa", "ubuntu-hwe",
                        "gnome-plugin", "ext-manager",
                    )
                    and campos[2] in ("0", "1")):
                estados[campos[1]] = campos[2] == "1"
        requeridos = {
            "repos", "tools", "backports-kernel-mesa", "ubuntu-hwe", "gnome-plugin", "ext-manager",
        }
        if codigo != 0 or set(estados) != requeridos:
            self._finalizar_consulta_estados(
                False, "El asistente no devolvió un estado completo de las tareas."
            )
            return

        self.nvidia_presente = nvidia.get("present") == "1"
        self.nvidia_hibrida = nvidia.get("hybrid") == "1"
        self.nvidia_instalada = nvidia.get("installed") == "1"
        self.nvidia_candidata = nvidia.get("candidate", "no-disponible")
        self.nvidia_secureboot = nvidia.get("secureboot", "desconocido")
        if self.distribucion == "debian":
            fila_nvidia = self.filas.get("nvidia-driver")
            if fila_nvidia is not None:
                fila_nvidia.set_visible(self.nvidia_presente)
            if self.nvidia_presente:
                modo = traducir("Híbrida (integrada + NVIDIA)") if self.nvidia_hibrida else traducir("NVIDIA dedicada")
                estado = traducir("instalado") if self.nvidia_instalada else traducir("no instalado")
                self.nvidia_info_label.set_text(
                    traducir("GPU: %s · driver %s · candidato APT: %s · Secure Boot: %s")
                    % (modo, estado, self.nvidia_candidata, self.nvidia_secureboot)
                )
            else:
                self.nvidia_info_label.set_text(traducir("No se detectó una GPU NVIDIA PCI."))
        if self.nvidia_presente:
            estados["nvidia-driver"] = self.nvidia_instalada
        self.estados_tareas = {pid for pid, completada in estados.items() if completada}
        etiquetas = {
            "repos": "✓ Ya configurados",
            "tools": "✓ Ya instaladas",
            "backports-kernel-mesa": "✓ Ya instalados",
            "ubuntu-hwe": "✓ Ya instalado",
            "nvidia-driver": "✓ Driver NVIDIA instalado",
            "gnome-plugin": "✓ Ya instalado",
            "ext-manager": "✓ Ya instalado",
        }
        for pid, completada in estados.items():
            indicador = self.indicadores.get(pid)
            if indicador is None:
                continue
            if completada:
                indicador.set_markup(
                    "<span foreground='#26a269'><b>%s</b></span>"
                    % traducir(etiquetas[pid])
                )
                indicador.set_tooltip_text(
                    traducir(
                        "Esta tarea ya está completada y no se incluirá en futuras operaciones."
                    )
                )
                indicador.show()
                self.switches[pid][0].set_active(False)
            else:
                indicador.set_text("")
                indicador.set_tooltip_text(None)
                indicador.hide()
        self._finalizar_consulta_estados(True)

    def _finalizar_consulta_estados(self, correcta, detalle=""):
        inicial = self.consulta_inicial
        if self.timeout_estados_id is not None:
            GLib.source_remove(self.timeout_estados_id)
            self.timeout_estados_id = None
        if not correcta:
            self.estados_tareas.clear()
            for indicador in self.indicadores.values():
                indicador.set_text("")
                indicador.set_tooltip_text(None)
                indicador.hide()
        self.consultando_estados = False
        self._actualizar_sensibilidad()
        if correcta:
            if inicial:
                self.estado.set_text(
                    traducir("Listo. Elige las tareas y pulsa «Iniciar tareas».")
                )
            return
        mensaje = traducir(
            "No se pudo comprobar el estado de las tareas; siguen disponibles."
        )
        if detalle:
            mensaje += " " + detalle
        if inicial:
            self.estado.set_text(mensaje)
        self._escribir("[!] %s\n" % mensaje, "aviso")

    def _actualizar_sensibilidad(self):
        disponible = not self.en_curso and not self.comprobando_actualizacion and self.distribucion != "no-soportada"
        self.btn_iniciar.set_sensitive(disponible)
        if self.btn_actualizar is not None:
            self.btn_actualizar.set_sensitive(disponible and not self.comprobando_actualizacion
                                             and formato_actualizacion() in ("deb", "flatpak", "appimage"))
        self.chk_sin_contrasena.set_sensitive(disponible)
        self.btn_menu.set_sensitive(disponible)
        self.btn_preferencias_menu.set_sensitive(disponible)
        self.btn_borrar.set_sensitive(not self.en_curso)
        self.btn_diagnostico.set_sensitive(not self.en_curso and not self.diagnostico_en_curso)
        if self.btn_actualizar_diagnostico is not None:
            self.btn_actualizar_diagnostico.set_sensitive(
                not self.en_curso and not self.comprobando_actualizacion)
        for boton in self.botones_preset:
            boton.set_sensitive(disponible)
        for pid, fila in self.filas.items():
            reversión = self.switches.get("revertir-backports")
            reversion_activa = bool(reversión and reversión[0].get_active())
            habilitada = (disponible and pid not in self.estados_tareas
                         and (pid != "nvidia-driver" or self.nvidia_presente)
                         and (not reversion_activa or pid == "revertir-backports"))
            fila.set_sensitive(habilitada)
            self.switches[pid][0].set_sensitive(habilitada)

    def _visible(self, pid):
        if pid in ("backports-kernel-mesa", "revertir-backports"):
            return self.distribucion == "debian"
        if pid == "nvidia-driver":
            return self.distribucion == "debian"
        if pid == "ubuntu-hwe":
            return self.distribucion == "ubuntu"
        if pid == "flatpak-setup":
            return not self.flatpak_presente
        if pid in ("gnome-plugin", "ext-manager"):
            return self.gnome_presente
        return True

    def _fila(self, pid, titulo, desc, defecto):
        fila = Gtk.ListBoxRow(activatable=False)
        if pid == "nvidia-driver":
            fila.set_no_show_all(True)
        caja = Gtk.Box(spacing=12)
        for m in ("top", "bottom"):
            getattr(caja, "set_margin_" + m)(6)
        for m in ("start", "end"):
            getattr(caja, "set_margin_" + m)(12)
        # Fila compacta: el detalle sigue accesible en el tooltip.
        textos = etiqueta(titulo)
        textos.set_line_wrap(True)
        fila.set_tooltip_text(traducir(desc))
        indicador = Gtk.Label()
        indicador.set_no_show_all(True)
        sw = Gtk.Switch(active=defecto, valign=Gtk.Align.CENTER)
        caja.pack_start(textos, True, True, 0)
        caja.pack_end(indicador, False, False, 0)
        caja.pack_end(sw, False, False, 0)
        sw.connect("notify::active", self._cambio_switch_preset)
        if pid == "revertir-backports":
            sw.connect("notify::active", self._alternar_reversion_stable)
        fila.add(caja)
        self.switches[pid] = (sw, defecto)
        self.filas[pid] = fila
        self.indicadores[pid] = indicador
        return fila

    # -- Presets ---------------------------------------------------------------
    def _preset_completo(self, _b):
        self.actualizando_preset = True
        try:
            for pid, (sw, defecto) in self.switches.items():
                sw.set_active(defecto and pid not in self.estados_tareas)
        finally:
            self.actualizando_preset = False
        self._marcar_preset_seleccionado(self.botones_preset[0])
        self._actualizar_sensibilidad()

    def _preset_flatpak(self, _b):
        self.actualizando_preset = True
        try:
            for pid, (sw, _d) in self.switches.items():
                if pid in ("clock", "repos", "tools", "upgrade", "autoremove", "autoclean", "rebootcheck", "backports-kernel-mesa", "revertir-backports", "nvidia-driver"):
                    sw.set_active(False)
                elif pid == "flatpak-update" and pid not in self.estados_tareas:
                    sw.set_active(True)
        finally:
            self.actualizando_preset = False
        self._marcar_preset_seleccionado(self.botones_preset[1])
        self._actualizar_sensibilidad()

    def _alternar_reversion_stable(self, switch, _propiedad):
        # La reversión de kernel/Mesa nunca se mezcla con tareas ordinarias.
        if self.actualizando_preset:
            return
        if switch.get_active():
            self.actualizando_preset = True
            try:
                for pid, (otro, _defecto) in self.switches.items():
                    if pid != "revertir-backports":
                        otro.set_active(False)
            finally:
                self.actualizando_preset = False
        self._actualizar_sensibilidad()

    def _cambio_switch_preset(self, _switch, _propiedad):
        if not self.actualizando_preset:
            self._marcar_preset_seleccionado(None)

    def _marcar_preset_seleccionado(self, seleccionado):
        for boton in self.botones_preset:
            estilo = boton.get_style_context()
            if boton is seleccionado:
                estilo.add_class("suggested-action")
            else:
                estilo.remove_class("suggested-action")

    # -- Ejecución ---------------------------------------------------------------
    def _pasos_seleccionados(self):
        sel = [
            p[0] for p in PASOS
            if p[0] in self.switches
            and p[0] not in self.estados_tareas
            and self._visible(p[0])
            and self.switches[p[0]][0].get_active()
        ]
        # La instalación/actualización de Flatpak no tiene sentido sin soporte Flatpak
        return sel

    def _iniciar(self, _b):
        if self.en_curso:
            return
        pasos = self._pasos_seleccionados()
        if self.distribucion == "no-soportada":
            self._mensaje(Gtk.MessageType.ERROR, "Sistema no compatible",
                          "Las operaciones administrativas solo están disponibles en Debian y Ubuntu 24.04/26.04 LTS.")
            return
        if not pasos:
            self._mensaje(Gtk.MessageType.INFO, "Nada que hacer", "Activa al menos una tarea.")
            return
        self._poner_ocupado(True)
        self.estado.set_text(traducir("Comprobando seguridad del mantenimiento…"))
        def verificar():
            try:
                informe = core_preflight.check(pasos)
                GLib.idle_add(self._terminar_preflight, pasos, informe, None)
            except Exception as error:
                GLib.idle_add(self._terminar_preflight, pasos, None, str(error))
        threading.Thread(target=verificar, daemon=True).start()
        return

    def _terminar_preflight(self, pasos, informe, error):
        if not self.en_curso:
            return False
        self._poner_ocupado(False)
        if error:
            self._mensaje(Gtk.MessageType.ERROR, "Mantenimiento bloqueado",
                          traducir("No se pudieron completar las comprobaciones de seguridad.") + "\n" + error)
            return False
        if informe.blocked:
            self._mensaje(Gtk.MessageType.ERROR, "Mantenimiento bloqueado", "\n".join(informe.messages))
            return False
        if informe.messages:
            dialogo_seguro = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.NONE, text=traducir("Comprobaciones de seguridad"))
            dialogo_seguro.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
            dialogo_seguro.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
            dialogo_seguro.set_default_response(Gtk.ResponseType.CANCEL)
            dialogo_seguro.format_secondary_text("\n".join(informe.messages))
            aceptado = dialogo_seguro.run() == Gtk.ResponseType.OK
            dialogo_seguro.destroy()
            if not aceptado:
                return False
        self._continuar_mantenimiento(pasos)
        return False

    def _continuar_mantenimiento(self, pasos):
        if not self._confirmar_tareas(pasos):
            self.estado.set_text(traducir("Mantenimiento cancelado antes de comenzar."))
            return
        if pasos == ["flatpak-update"]:
            self._iniciar_flatpak_usuario()
            return
        try:
            helper = helper_mantenimiento()
        except OSError as e:
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo preparar el asistente", str(e))
            return
        if not helper_disponible(helper):
            self._mensaje(Gtk.MessageType.ERROR, "Falta el asistente",
                          (
                              "El Flatpak incluye el asistente, pero todavía no está instalado "
                              "en el sistema anfitrión. Para habilitar las tareas administrativas, "
                              "consulta la sección «Flatpak» del README oficial y sigue los pasos "
                              "de integración manual con Polkit. Flatseal no puede instalarlo."
                              if es_flatpak() else
                              traducir("No se encuentra %s.\nReinstala el paquete aio-debian-gui.") % helper
                          ))
            return

        if es_flatpak() or os.environ.get("SNAP"):
            try:
                comprobacion = subprocess.run(
                    comando_host(HELPER_SISTEMA, "--version"),
                    capture_output=True, text=True, timeout=10,
                )
                version_helper = comprobacion.stdout.strip() if comprobacion.returncode == 0 else ""
            except (OSError, subprocess.SubprocessError):
                version_helper = ""
            if version_helper != version_app():
                self._mensaje(
                    Gtk.MessageType.WARNING, "Asistente del sistema desactualizado",
                    "El asistente privilegiado del anfitrión no corresponde a esta versión "
                    "de AiO Debian GUI. Actualiza su integración manual con Polkit según "
                    "el README antes de ejecutar operaciones administrativas."
                )
                return

        if ("backports-kernel-mesa" in pasos and
                not helper_admite_tarea(helper, "backports-kernel-mesa")):
            self._mensaje(
                Gtk.MessageType.ERROR, "Asistente del sistema desactualizado",
                "El asistente instalado no incluye la tarea de Backports. "
                "Actualiza el paquete .deb a la versión 1.0.7 o posterior.",
            )
            return

        if "revertir-backports" in pasos:
            if len(pasos) != 1:
                self._mensaje(
                    Gtk.MessageType.WARNING,
                    traducir("Reversión de Backports"),
                    traducir("La vuelta a Stable debe ejecutarse como única tarea. Desactiva las demás opciones."),
                )
                return
            if not helper_admite_tarea(helper, "revertir-backports"):
                self._mensaje(Gtk.MessageType.ERROR, traducir("Asistente desactualizado"),
                              traducir("Actualiza el asistente de AiO para revertir Backports."))
                return
            cmd = (comando_host(HELPER_SISTEMA, "--backports-rollback-plan")
                   if es_flatpak() else ["bash", HELPER, "--backports-rollback-plan"])
            try:
                resultado = subprocess.run(
                    cmd, capture_output=True, text=True, timeout=45, check=False,
                )
            except (OSError, subprocess.SubprocessError) as exc:
                self._mensaje(Gtk.MessageType.ERROR, traducir("Reversión de Backports"), str(exc))
                return
            if resultado.returncode != 0 or "##STABLE:" not in resultado.stdout:
                self._mensaje(
                    Gtk.MessageType.ERROR, traducir("Reversión no segura"),
                    traducir("No se puede preparar el regreso a Stable. Revisa el diagnóstico y los módulos DKMS.")
                    + "\n" + (resultado.stdout + resultado.stderr)[-1600:],
                )
                return
            planes = [
                linea.replace("##STABLE:", "• ", 1)
                for linea in resultado.stdout.splitlines()
                if linea.startswith("##STABLE:")
            ]
            dialogo = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.NONE,
                text=traducir("¿Preparar el retorno a Debian Stable?"),
            )
            dialogo.format_secondary_text(
                traducir("Se instalarán las versiones Stable de los siguientes paquetes:")
                + "\n" + "\n".join(planes) + "\n\n"
                + traducir("El kernel Backports NO se eliminará. GRUB no cambiará. "
                          "Tras reiniciar deberás seleccionar el kernel Stable y comprobar que funciona. "
                          "La reversión completa requiere verificar ese arranque antes de eliminar el kernel antiguo.")
            )
            dialogo.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
            dialogo.add_button(traducir("Preparar Stable"), Gtk.ResponseType.OK)
            dialogo.set_default_response(Gtk.ResponseType.CANCEL)
            aprobado = dialogo.run() == Gtk.ResponseType.OK
            dialogo.destroy()
            if not aprobado:
                return

        if "nvidia-driver" in pasos:
            if "backports-kernel-mesa" in pasos:
                self._mensaje(Gtk.MessageType.WARNING, "NVIDIA y Backports",
                              "Instala primero el kernel de Backports, reinicia y vuelve a comprobar el controlador NVIDIA. No se combinan ambas tareas.")
                return
            cmd_report = comando_host(HELPER_SISTEMA, "--nvidia-report") if es_flatpak() else ["bash", HELPER, "--nvidia-report"]
            try:
                report = subprocess.run(cmd_report, capture_output=True, text=True, timeout=12)
            except (OSError, subprocess.SubprocessError) as e:
                self._mensaje(Gtk.MessageType.ERROR, "Detección NVIDIA", str(e))
                return
            if report.returncode or "##NVIDIA:present:1" not in report.stdout:
                self._mensaje(Gtk.MessageType.WARNING, "Detección NVIDIA",
                              "El asistente no ha podido verificar una GPU NVIDIA. No se instalará nada.")
                return
            hibrida = "##NVIDIA:hybrid:1" in report.stdout
            advertencia = (
                "GPU híbrida: se mantendrá Intel/AMD para el escritorio y NVIDIA se usará mediante PRIME Render Offload. "
                if hibrida else "GPU NVIDIA dedicada detectada. "
            )
            advertencia += (
                "Se instalarán paquetes Debian con DKMS si la compatibilidad, Secure Boot, headers y la simulación APT lo permiten. "
                "La versión estable puede tener limitaciones de soporte y seguridad. "
                "No se cambiarán Xorg, GRUB ni Wayland; tras instalar habrá que reiniciar. "
                "¿Autorizar la instalación NVIDIA bajo estas condiciones?"
            )
            dialogo = Gtk.MessageDialog(transient_for=self, modal=True,
                message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.NONE,
                text="Instalación de controlador NVIDIA")
            dialogo.format_secondary_text(advertencia)
            dialogo.add_button("Cancelar", Gtk.ResponseType.CANCEL)
            dialogo.add_button("Instalar si es compatible", Gtk.ResponseType.OK)
            dialogo.set_default_response(Gtk.ResponseType.CANCEL)
            aprobado = dialogo.run() == Gtk.ResponseType.OK
            dialogo.destroy()
            if not aprobado:
                return
            if not helper_admite_tarea(helper, "nvidia-driver"):
                self._mensaje(Gtk.MessageType.ERROR, "Asistente desactualizado",
                              "Instala la nueva versión de AiO y su asistente del sistema para gestionar NVIDIA.")
                return

        if "backports-kernel-mesa" in pasos:
            d = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.NONE,
                text=traducir("¿Instalar el kernel y Mesa desde Debian Backports?"),
            )
            d.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
            d.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
            d.set_default_response(Gtk.ResponseType.CANCEL)
            d.format_secondary_text(
                traducir(
                    "Se instalará el kernel de Backports para esta arquitectura y los controladores "
                "Mesa disponibles. Esto puede actualizar componentes gráficos y requerir un "
                    "reinicio. Si falta, se añadirá la fuente oficial de Debian Backports."
                )
            )
            confirmar = d.run() == Gtk.ResponseType.OK
            d.destroy()
            if not confirmar:
                self.switches["backports-kernel-mesa"][0].set_active(False)
                self.estado.set_text(traducir("Instalación desde Backports cancelada."))
                return

        snapshot_before = False
        if pasos != ["flatpak-update"]:
            dialogo_snap = Gtk.MessageDialog(transient_for=self, modal=True,
                message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                text=traducir("¿Crear instantánea Snapper antes del mantenimiento?"))
            dialogo_snap.format_secondary_text("Solo Btrfs con Snapper root configurado. Si falla, no se ejecuta mantenimiento. La restauración no es automática.")
            dialogo_snap.add_button(traducir("Sin instantánea"), Gtk.ResponseType.NO)
            dialogo_snap.add_button(traducir("Crear instantánea"), Gtk.ResponseType.YES)
            dialogo_snap.set_default_response(Gtk.ResponseType.NO)
            snapshot_before = dialogo_snap.run() == Gtk.ResponseType.YES
            dialogo_snap.destroy()

        lang = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "C"
        # Si solo se actualiza Flatpak del usuario no se invoca pkexec.
        solo_flatpak_usuario = pasos == ["flatpak-update"]
        if solo_flatpak_usuario:
            cmd = comando_host(helper, "--flatpak-user-update")
        else:
            cmd = comando_pkexec(helper, lang, *(["--snapshot-before"] if snapshot_before else []), *pasos)

        self.buf.set_text("")
        self.necesita_reinicio = False
        self.hubo_errores = False
        self.fin_recibido = False
        self.terminado_gestionado = False
        self.cancelacion_autorizacion = None
        self.tareas_en_ejecucion = list(pasos)
        self.total_pasos = len(pasos)
        self._poner_ocupado(True)
        if solo_flatpak_usuario:
            self.estado.set_text("Actualizando Flatpak de usuario sin privilegios…")
            self._escribir("[*] Flatpak --user, sin contraseña de administrador.\\n", "info")
        else:
            self.estado.set_text(traducir("Esperando autenticación de administrador…"))
            self._escribir("[*] Solicitando autorización de administrador…\\n", "info")
            self._escribir(
                "[*] Si no aparece el diálogo, cancela la espera y comprueba el agente de Polkit.\\n",
                "info",
            )
        self.barra.set_fraction(0)
        self.barra.set_text("")
        self.barra.set_show_text(False)

        try:
            self.proceso = Gio.Subprocess.new(
                cmd, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE
            )
        except GLib.Error as e:
            self._poner_ocupado(False)
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo iniciar", str(e.message))
            return

        self.flujo = Gio.DataInputStream.new(self.proceso.get_stdout_pipe())
        if not solo_flatpak_usuario:
            self._iniciar_espera_autorizacion()
        self._leer_linea()

    def _iniciar_flatpak_usuario(self):
        """Actualización de Flatpak del usuario sin helper root ni pkexec."""
        script = (
            'printf "##STEP:1:1:Actualizar Flatpak del usuario\\n"; '
            'if ! command -v flatpak >/dev/null 2>&1; then '
            'echo "[-] Flatpak no está instalado."; echo "##DONE:1"; exit 1; fi; '
            'if flatpak --user update -y && flatpak --user uninstall --unused -y; then '
            'echo "##DONE:0"; else echo "##DONE:1"; exit 1; fi'
        )
        self.buf.set_text("")
        self.necesita_reinicio = False
        self.hubo_errores = False
        self.fin_recibido = False
        self.terminado_gestionado = False
        self.cancelacion_autorizacion = None
        self.tareas_en_ejecucion = ["flatpak-update"]
        self.total_pasos = 1
        self._poner_ocupado(True)
        self.estado.set_text("Actualizando Flatpak del usuario sin contraseña…")
        self._escribir("[*] Operación Flatpak de usuario; sin pkexec.\\n", "info")
        self.barra.set_fraction(0)
        self.barra.set_text("")
        self.barra.set_show_text(False)
        try:
            self.proceso = Gio.Subprocess.new(
                comando_host("bash", "-c", script),
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE,
            )
        except GLib.Error as error:
            self._poner_ocupado(False)
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo iniciar", str(error.message))
            return
        self.flujo = Gio.DataInputStream.new(self.proceso.get_stdout_pipe())
        self._leer_linea()

    def _cambiar_sin_contrasena(self, boton):
        if self.actualizando_sin_contrasena:
            return

        habilitar = boton.get_active()
        try:
            helper = helper_mantenimiento()
        except OSError as e:
            self.configurando_sin_contrasena = None
            self._poner_ocupado(False)
            self._restablecer_opcion_sin_contrasena(
                autorizacion_sin_contrasena_activa()
            )
            self._mensaje(
                Gtk.MessageType.ERROR, "No se pudo preparar el asistente", str(e)
            )
            return
        if not helper_disponible(helper):
            self._restablecer_opcion_sin_contrasena(autorizacion_sin_contrasena_activa())
            self._mensaje(
                Gtk.MessageType.ERROR,
                "Falta el asistente",
                (
                    "El Flatpak necesita la integración manual del asistente con Polkit "
                    "en el Debian anfitrión. Consulta la sección «Flatpak» del README oficial. "
                    "Flatseal no concede privilegios de administrador."
                    if es_flatpak() else
                    traducir("No se encuentra %s.\nReinstala el paquete aio-debian-gui.") % helper
                ),
            )
            return

        if habilitar and (
                not helper_admite_autorizacion_sin_contrasena(helper)
                or not helper_disponible(helper)):
            self._restablecer_opcion_sin_contrasena(autorizacion_sin_contrasena_activa())
            self._mensaje(Gtk.MessageType.ERROR, "Función no disponible en el asistente instalado",
                          "Actualiza el asistente del sistema a AiO Debian GUI 1.2.3 o posterior.")
            return

        if habilitar:
            d = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.NONE,
                text=traducir("Permitir tareas sin contraseña?"),
            )
            d.add_button(traducir("Cancelar"), Gtk.ResponseType.CANCEL)
            d.add_button(traducir("Continuar"), Gtk.ResponseType.OK)
            d.set_default_response(Gtk.ResponseType.CANCEL)
            d.format_secondary_text(
                "AVISO: esta excepción persistente elimina la petición de contraseña para "
                "TODAS las tareas administrativas disponibles en AiO Debian GUI (APT, "
                "repositorios, kernel y Flatpak del sistema). No concede permisos generales "
                "a otras aplicaciones, pero cualquier proceso con acceso a tu cuenta podría "
                "invocar el asistente de AiO sin contraseña. "
                "Activarla requiere autorización de administrador una vez. "
                "Desmarca esta opción para revocarla."
            )
            confirmar = d.run() == Gtk.ResponseType.OK
            d.destroy()
            if not confirmar:
                self._restablecer_opcion_sin_contrasena(False)
                return

        accion = "--enable-passwordless" if habilitar else "--disable-passwordless"
        lang = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "C"
        self.configurando_sin_contrasena = habilitar
        self.terminado_gestionado = False
        self.cancelacion_autorizacion = None
        self._poner_ocupado(True)
        self.buf.set_text("")
        self.estado.set_text(traducir("Esperando autorización de administrador…"))
        self._escribir("[*] Solicitando autorización de administrador…\n", "info")
        self.barra.set_fraction(0)
        self.barra.set_show_text(False)

        try:
            self.proceso = Gio.Subprocess.new(
                comando_pkexec(helper, lang, accion),
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE,
            )
        except GLib.Error as e:
            self.configurando_sin_contrasena = None
            self._poner_ocupado(False)
            self._restablecer_opcion_sin_contrasena(autorizacion_sin_contrasena_activa())
            self._mensaje(Gtk.MessageType.ERROR, "No se pudo iniciar", str(e.message))
            return

        self.flujo = Gio.DataInputStream.new(self.proceso.get_stdout_pipe())
        self._iniciar_espera_autorizacion()
        self._leer_linea()

    def _restablecer_opcion_sin_contrasena(self, activa):
        self.actualizando_sin_contrasena = True
        self.chk_sin_contrasena.set_active(activa)
        self.actualizando_sin_contrasena = False

    def _poner_ocupado(self, ocupado):
        self.en_curso = ocupado
        self.btn_iniciar.set_label(
            traducir("Trabajando…" if ocupado else "Iniciar tareas")
        )
        self._actualizar_sensibilidad()
        if ocupado:
            self.spinner.start()
        else:
            self.spinner.stop()

    def _iniciar_espera_autorizacion(self):
        self.esperando_autorizacion = True
        self.btn_cancelar.show()
        self.timeout_autorizacion_id = GLib.timeout_add_seconds(
            90, self._agotamiento_autorizacion
        )

    def _finalizar_espera_autorizacion(self):
        self.esperando_autorizacion = False
        self.btn_cancelar.hide()
        if self.timeout_autorizacion_id is not None:
            GLib.source_remove(self.timeout_autorizacion_id)
            self.timeout_autorizacion_id = None

    def _cancelar_espera_autorizacion(self, _boton=None, agotada=False):
        if not self.esperando_autorizacion or self.proceso is None:
            return
        self.cancelacion_autorizacion = "agotada" if agotada else "cancelada"
        self._finalizar_espera_autorizacion()
        self.estado.set_text(traducir("Cancelando la espera de autorización…"))
        self._escribir(
            "[-] Se canceló la espera de autorización de administrador.\n", "error"
        )
        self.proceso.force_exit()

    def _agotamiento_autorizacion(self):
        self.timeout_autorizacion_id = None
        self._cancelar_espera_autorizacion(agotada=True)
        return GLib.SOURCE_REMOVE

    def _leer_linea(self):
        self.flujo.read_line_async(GLib.PRIORITY_DEFAULT, None, self._linea_leida)

    def _linea_leida(self, flujo, res):
        try:
            r = flujo.read_line_finish_utf8(res)
            datos = r[0] if isinstance(r, tuple) else r
        except GLib.Error:
            datos = None
        if datos is None:
            self._finalizar_espera_autorizacion()
            self.proceso.wait_async(None, self._proceso_terminado)
            return
        self._finalizar_espera_autorizacion()
        texto = datos
        # apt/flatpak pueden usar \r para repintar: nos quedamos con el último trozo
        texto = ANSI.sub("", texto.split("\r")[-1]).rstrip()
        self._procesar(texto)
        if self.fin_recibido:
            self.proceso.wait_async(None, self._proceso_terminado)
            return
        self._leer_linea()

    def _procesar(self, linea):
        if linea.startswith("##STEP:"):
            _, n, total, titulo = linea.split(":", 3)
            n, total = int(n), int(total)
            self.barra.set_show_text(True)
            self.barra.set_fraction((n - 1) / total)
            self.barra.set_text(traducir("Paso %d de %d") % (n, total))
            self.estado.set_text(traducir(titulo) + "…")
            self._escribir("\n▶ %s\n" % titulo, "paso")
            return
        if linea.startswith("##REBOOT:"):
            self.necesita_reinicio = linea.endswith(":1")
            return
        if linea.startswith("##DONE:"):
            self.hubo_errores = linea.endswith(":1")
            self.fin_recibido = True
            return

        tag = None
        if linea.startswith("[✔]"):
            tag = "ok"
        elif linea.startswith("[!]"):
            tag = "aviso"
        elif linea.startswith("[-]"):
            tag = "error"
        elif linea.startswith("[*]"):
            tag = "info"
        self._escribir(linea + "\n", tag)

    def _escribir(self, texto, tag=None):
        if self.preferencias["modo_simple"]:
            return
        fin = self.buf.get_end_iter()
        if tag:
            self.buf.insert_with_tags_by_name(fin, texto, tag)
        else:
            self.buf.insert(fin, texto)
        self._desplazar_consola(self.log)
        if self.log_separado is not None:
            self._desplazar_consola(self.log_separado)

    def _proceso_terminado(self, proc, res):
        if self.terminado_gestionado:
            return
        self.terminado_gestionado = True
        self._finalizar_espera_autorizacion()
        cancelacion = self.cancelacion_autorizacion
        self.cancelacion_autorizacion = None
        try:
            proc.wait_finish(res)
            codigo = proc.get_exit_status() if proc.get_if_exited() else -1
        except GLib.Error:
            codigo = -1

        if self.configurando_sin_contrasena is not None:
            deseada = self.configurando_sin_contrasena
            self.configurando_sin_contrasena = None
            self._poner_ocupado(False)
            activa = autorizacion_sin_contrasena_activa()
            self._restablecer_opcion_sin_contrasena(activa)
            if cancelacion:
                self.estado.set_text(
                    traducir("Espera de autorización agotada.")
                    if cancelacion == "agotada"
                    else traducir("Espera de autorización cancelada.")
                )
                self._escribir(
                    "[-] No se cambió la preferencia de autorización.\n", "error"
                )
            elif codigo == 0 and activa == deseada:
                self.estado.set_text(
                    traducir("Autorización sin contraseña activada.")
                    if activa else traducir("Autorización sin contraseña desactivada.")
                )
                self._escribir(
                    "[✔] Preferencia de autorización actualizada.\n", "ok"
                )
            elif codigo in (126, 127):
                self.estado.set_text(traducir("No se cambió la autorización."))
                self._escribir(
                    "[-] Autorización cancelada o denegada; no se cambió la preferencia.\n",
                    "error",
                )
            else:
                self.estado.set_text(traducir("No se pudo cambiar la autorización."))
                self._escribir(
                    "[-] No se pudo actualizar la preferencia de autorización (código %s).\n"
                    % codigo,
                    "error",
                )
            return

        self._poner_ocupado(False)
        self.barra.set_show_text(False)

        if cancelacion:
            try:
                guardar_registro_mantenimiento(self.tareas_en_ejecucion, "cancelado")
            except OSError:
                pass
            self.estado.set_text(
                traducir("Espera de autorización agotada.")
                if cancelacion == "agotada"
                else traducir("Espera de autorización cancelada.")
            )
            self._escribir(
                "[-] No se ejecutó ninguna tarea. Comprueba el agente de autenticación de Polkit.\n",
                "error",
            )
            return
        if codigo == 0 and self.fin_recibido and not self.hubo_errores:
            self.barra.set_fraction(1.0)
            self.estado.set_text(traducir("✔ ¡Mantenimiento completado con éxito!"))
            self._escribir("\n==================================================\n"
                           "  [✔] ¡Mantenimiento completado con éxito!\n"
                           "==================================================\n"
                           "         ❤️ Made by JULIO AYUSO\n", "ok")
        elif codigo in (126, 127) and self.barra.get_fraction() == 0:
            try:
                guardar_registro_mantenimiento(self.tareas_en_ejecucion, "autorización denegada")
            except OSError:
                pass
            self.estado.set_text(traducir("No se obtuvo autorización de administrador."))
            self._escribir("[-] Autenticación cancelada o denegada. No se ha hecho ningún cambio.\n", "error")
            return
        else:
            self.estado.set_text(traducir("Terminó con errores. Revisa el registro."))
            self._escribir("\n[-] El proceso terminó con errores (código %s).\n" % codigo, "error")

        # Registrar el resultado incluso si el mantenimiento terminó con errores.
        try:
            guardar_registro_mantenimiento(
                self.tareas_en_ejecucion,
                "correcto" if codigo == 0 and self.fin_recibido and not self.hubo_errores
                else "error", self.necesita_reinicio,
            )
        except OSError as error:
            self._escribir("[!] No se pudo guardar el historial: %s\n" % error, "aviso")

        if self.necesita_reinicio:
            self._preguntar_reinicio()
        self._consultar_estados_tareas()

    def _preguntar_reinicio(self):
        d = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE,
            text=traducir("¿Reiniciar el sistema ahora?"),
        )
        d.format_secondary_text(traducir(
            "Se recomienda reiniciar para aplicar los cambios críticos (kernel/servicios)."
        ))
        d.add_button(traducir("Más tarde"), Gtk.ResponseType.NO)
        d.add_button(traducir("Reiniciar ahora"), Gtk.ResponseType.YES)
        d.set_default_response(Gtk.ResponseType.NO)
        r = d.run()
        d.destroy()
        if r == Gtk.ResponseType.YES:
            self._escribir("[*] Reiniciando el sistema...\n", "info")
            try:
                subprocess.Popen(comando_host("systemctl", "reboot"))
            except OSError as e:
                self._mensaje(Gtk.MessageType.ERROR, "No se pudo reiniciar", str(e))
        else:
            self._escribir("[*] Reinicio omitido. Recuerda reiniciar más tarde.\n", "info")

    # -- Varios ----------------------------------------------------------------
    def _mensaje(self, tipo, titulo, texto):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=tipo,
                              buttons=Gtk.ButtonsType.NONE, text=traducir(titulo))
        d.add_button(traducir("Aceptar"), Gtk.ResponseType.OK)
        d.format_secondary_text(traducir(texto))
        d.run()
        d.destroy()

    def _crear_dialogo_dedicatoria(self, parent):
        dialogo = Gtk.Dialog(
            title=traducir("Agradecimiento"), transient_for=parent, modal=True
        )
        dialogo.set_resizable(False)
        dialogo.add_button(traducir("Cerrar"), Gtk.ResponseType.CLOSE)
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for margen in ("top", "bottom", "start", "end"):
            getattr(caja, "set_margin_" + margen)(16)

        pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
            FOTO_INSPIRACION, 420, 420, True
        )
        imagen = Gtk.Image.new_from_pixbuf(pixbuf)
        imagen.get_accessible().set_name(traducir("Foto de Adri y Lu"))
        caja.pack_start(imagen, False, False, 0)

        mensaje = Gtk.Label(
            label="Gracias a Adri y Lu por ser mi inspiración en TODO lo que hago"
        )
        mensaje.set_line_wrap(True)
        mensaje.set_justify(Gtk.Justification.CENTER)
        mensaje.set_max_width_chars(50)
        caja.pack_start(mensaje, False, False, 0)
        dialogo.get_content_area().pack_start(caja, True, True, 0)
        dialogo.show_all()
        return dialogo

    def _abrir_dedicatoria(self, _label, uri, acerca):
        if uri != "aio-debian-gui://inspiracion":
            return False
        dialogo = self._crear_dialogo_dedicatoria(acerca)
        try:
            dialogo.run()
        finally:
            dialogo.destroy()
        return True

    def _crear_dialogo_acerca_de(self):
        d = Gtk.AboutDialog(transient_for=self, modal=True)
        d.set_program_name("AiO Debian GUI")
        d.set_version(version_app())
        d.set_comments(traducir("Mantenimiento y configuración todo en uno para Debian"))
        d.set_website(HOMEPAGE)
        d.set_copyright("© 2026 Julio Ayuso")
        d.set_license_type(Gtk.License.GPL_3_0)
        # El tema de iconos del host no contiene necesariamente nuestro icono
        # (AppImage, Flatpak y Snap). Mostrar el PNG incluido en el paquete.
        icono = os.path.normpath(os.path.join(
            os.path.dirname(__file__),
            "../share/icons/hicolor/256x256/apps/aio-debian-gui.png",
        ))
        if os.path.isfile(icono):
            try:
                d.set_logo(GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    icono, 128, 128, True
                ))
            except GLib.Error:
                d.set_logo_icon_name("applications-system")
        else:
            d.set_logo_icon_name("applications-system")
        d.show_all()

        def buscar_credito(widget):
            if isinstance(widget, Gtk.Label) and widget.get_text() == "© 2026 Julio Ayuso":
                return widget
            if isinstance(widget, Gtk.Container):
                for hijo in widget.get_children():
                    encontrado = buscar_credito(hijo)
                    if encontrado is not None:
                        return encontrado
            return None

        credito = buscar_credito(d)
        if credito is None:
            d.destroy()
            raise RuntimeError("No se encontró el crédito de autor en el diálogo Acerca de.")
        credito.set_markup(
            '<span size="large">© 2026 '
            '<a href="aio-debian-gui://inspiracion">Julio Ayuso</a></span>'
        )
        credito.connect("activate-link", self._abrir_dedicatoria, d)
        return d

    def _acerca_de(self, _b):
        self.menu_popover.popdown()
        d = self._crear_dialogo_acerca_de()
        try:
            d.run()
        finally:
            d.destroy()

    def _al_cerrar(self, *_a):
        if not self.en_curso and not self.comprobando_actualizacion:
            return False
        self._mensaje(
            Gtk.MessageType.WARNING, "Mantenimiento en curso",
            "Espera a que termine: interrumpir apt o dpkg a mitad puede dejar el sistema "
            "en un estado inconsistente.",
        )
        return True  # impide cerrar


def main():
    GLib.set_prgname(PRGNAME)
    GLib.set_application_name("AiO Debian")
    if os.geteuid() == 0:
        print("Ejecuta aio-debian-gui como usuario normal (pedirá la contraseña cuando haga falta).",
              file=sys.stderr)
        sys.exit(1)
    error_preferencias = None
    try:
        preferencias = cargar_preferencias()
    except (OSError, ValueError) as error:
        preferencias = PREFERENCIAS_DEFECTO.copy()
        error_preferencias = str(error)
    win = VentanaPrincipal(preferencias)
    aplicar_tema(preferencias["tema"])
    win.handler_cierre = win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win._consultar_estados_tareas(inicial=True)
    if error_preferencias:
        win.estado.set_text(
            traducir("No se pudieron leer las preferencias") + ": " + error_preferencias
        )
    Gtk.main()


if __name__ == "__main__":
    main()
