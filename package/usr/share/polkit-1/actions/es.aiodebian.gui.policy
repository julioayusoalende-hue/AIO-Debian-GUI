<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>AiO Debian GUI</vendor>
  <vendor_url>https://julioayusoalende-hue.github.io/AIO-Debian-GUI</vendor_url>
  <icon_name>aio-debian-gui</icon_name>

  <action id="es.aiodebian.gui.mantenimiento">
    <description>Ejecutar el mantenimiento del sistema con AiO Debian GUI</description>
    <message>Se necesita autenticación para ejecutar el mantenimiento del sistema (apt, Flatpak, repositorios)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/aio-debian-gui/aio-debian-gui-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
