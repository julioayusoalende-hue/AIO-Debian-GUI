[Desktop Entry]
Type=Application
Name=AiO Debian GUI
GenericName=Mantenimiento del sistema
Comment=Mantenimiento y configuración todo en uno para Debian
Exec=aio-debian-gui %f
MimeType=application/vnd.debian.binary-package;application/x-deb;application/vnd.flatpak.ref;
Icon=aio-debian-gui
Terminal=false
StartupNotify=true
StartupWMClass=Aio-debian-gui
Categories=System;Settings;PackageManager;
Keywords=apt;flatpak;update;actualizar;mantenimiento;
