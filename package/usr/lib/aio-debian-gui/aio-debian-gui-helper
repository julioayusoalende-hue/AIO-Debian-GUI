# Only snapd owns its revisions. Never remove files directly from /var/lib/snapd.
limpiar_revisiones_snap() {
    if ! paquete_instalado snapd || ! command -v snap >/dev/null 2>&1; then
        info "snapd no está instalado; se omite la limpieza Snap."
        return 0
    fi
    local listado nombre version revision tracking publisher notas resto
    local fallos=0
    local -A conservar=()
    if ! listado=$(LC_ALL=C snap list --all); then
        err "No se pudieron consultar las revisiones Snap; no se realizará la limpieza."
        return 1
    fi
    # Keep the newest disabled revision of each snap as a rollback candidate.
    while read -r nombre version revision tracking publisher notas resto; do
        [[ ",$notas," == *,disabled,* ]] || continue
        [[ "$nombre" =~ ^[a-z0-9][a-z0-9_-]*$ && "$revision" =~ ^[1-9][0-9]{0,9}$ ]] || continue
        if [ "$revision" -gt "${conservar[$nombre]:-0}" ]; then
            conservar[$nombre]=$revision
        fi
    done <<< "$listado"
    while read -r nombre version revision tracking publisher notas resto; do
        [[ ",$notas," == *,disabled,* ]] || continue
        [[ "$nombre" =~ ^[a-z0-9][a-z0-9_-]*$ && "$revision" =~ ^[1-9][0-9]{0,9}$ ]] || continue
        [ "$revision" = "${conservar[$nombre]}" ] && continue
        info "Eliminando revisión Snap deshabilitada: $nombre ($revision)..."
        if ! snap remove "$nombre" --revision="$revision"; then
            err "No se pudo eliminar una revisión Snap deshabilitada."
            fallos=1
        fi
    done <<< "$listado"
    [ "$fallos" -eq 0 ] || return 1
    ok "Snap limpiado; se conserva una revisión anterior por aplicación y sus datos."
}

