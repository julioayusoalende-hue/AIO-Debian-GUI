#
# Lo lanza la interfaz gráfica mediante pkexec (una sola autenticación para
# todos los pasos). No hace preguntas: cada paso se activa desde la interfaz.
# Uso: aio-debian-gui-helper [--lang LOCALE] paso [paso ...]
#
# Protocolo de salida (una línea por mensaje):
#   ##STEP:<n>:<total>:<título>   inicio de un paso
#   ##RESULT:<tarea>:<0|1>       resultado de una tarea (1 = error)
#   ##REBOOT:<0|1>                resultado de la comprobación de reinicio
#   ##DONE:<0|1>                  fin (1 = hubo algún paso con errores)

set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022

# ------------------------------------------------------------------------------
# Supervisor único: run_privileged()
# Envuelve todas las operaciones root con timeout, lock global, entorno no-interactivo
# y logs estructurados.
# Uso: run_privileged <operación> <timeout_segundos> <comando> [args...]
#   operación: etiqueta para logs y lock (ej. "apt-upgrade", "dpkg-audit")
#   timeout_segundos: timeout por operación (default 300s, 0 = sin timeout)
#   comando + args: comando a ejecutar (sin sudo/pkexec; ya somos root)
# ------------------------------------------------------------------------------
run_privileged() {
    local operacion="${1:-}" timeout_segundos="${2:-300}"
    shift 2 || { err "run_privileged: uso: run_privileged <operación> <timeout> <comando> [args...]"; return 2; }
    local -a cmd=("$@")
    [ "${#cmd[@]}" -gt 0 ] || { err "run_privileged: comando vacío"; return 2; }

    # Entorno no-interactivo obligatorio
    export DEBIAN_FRONTEND=noninteractive
    export APT_LISTCHANGES_FRONTEND=none
    export NEEDRESTART_MODE=l
    export LANG=C
    export LC_ALL=C

    # Los trazas estructuradas solo se emiten si se piden expresamente y por
    # stderr, para no contaminar la salida que capturan las funciones internas.
    local inicio_epoch resultado=0
    inicio_epoch=$(date +%s)
    if [ "${AIO_PRIV_LOG:-0}" = 1 ]; then
        printf '##PRIV-START:%s:%s:%s\n' "$operacion" "$inicio_epoch" "${cmd[*]}" >&2
    fi

    if [ "${EUID:-$(id -u)}" -ne 0 ]; then
        # Sin privilegios (pruebas/desarrollo): ejecutar directamente para que
        # los dobles de shell de la batería de pruebas sigan siendo válidos.
        "${cmd[@]}"
        resultado=$?
    else
        # Lock global AiO + APT/dpkg combinado. flock() considera independiente
        # cada descriptor abierto: si main() ya tomó el lock (o lo heredó del
        # programador), abrir el archivo de nuevo aquí provocaría un falso
        # "ya hay otra operación AiO/APT en curso" dentro del propio helper.
        local lock_fd=""
        if [ -z "${AIO_PRIV_LOCK_FD:-}" ]; then
            local lock_file="${MAINTENANCE_LOCK:-/run/aio-debian-gui/maintenance.lock}"
            mkdir -p -- "${lock_file%/*}" 2>/dev/null || true
            exec {lock_fd}>"$lock_file" || {
                err "run_privileged: no se pudo abrir lock $lock_file"
                return 1
            }
            if ! flock -n "$lock_fd"; then
                eval "exec ${lock_fd}>&-"
                err "run_privileged [$operacion]: ya hay otra operación AiO/APT en curso"
                return 1
            fi
        fi

        if [ "$timeout_segundos" -gt 0 ]; then
            # Timeout que mata el grupo de procesos completo.
            timeout --kill-after=5s --signal=SIGTERM "${timeout_segundos}s" \
                setsid --wait "${cmd[@]}"
            resultado=$?
            case $resultado in
                0) ;;
                124) err "run_privileged [$operacion]: timeout (${timeout_segundos}s), proceso terminado con SIGTERM+SIGKILL" ;;
                137) err "run_privileged [$operacion]: timeout (${timeout_segundos}s), proceso forzado con SIGKILL" ;;
                *)   err "run_privileged [$operacion]: falló con código $resultado" ;;
            esac
        else
            setsid --wait "${cmd[@]}"
            resultado=$?
            [ "$resultado" -eq 0 ] || err "run_privileged [$operacion]: falló con código $resultado"
        fi

        # El descriptor compartido pertenece a main(): solo cerramos el nuestro.
        if [ -n "$lock_fd" ]; then
            eval "exec ${lock_fd}>&-"
        fi
    fi

    if [ "${AIO_PRIV_LOG:-0}" = 1 ]; then
        local fin_epoch duracion
        fin_epoch=$(date +%s)
        duracion=$((fin_epoch - inicio_epoch))
        printf '##PRIV-END:%s:%s:%s:%s\n' "$operacion" "$fin_epoch" "$duracion" "$resultado" >&2
    fi
    return $resultado
}

# Estas operaciones comparten la autorización de AiO. Los asistentes instalados
# validan sus propios argumentos y dos de ellos reciben datos por stdin.
if [[ "${BASH_SOURCE[0]}" == "$0" && "$EUID" == 0 ]]; then
    case "${1:-}" in
        --software)
            shift
            case "${1:-}" in
                install-trusted-local|install-flatpakref|install|remove|upgrade|refresh|flatpak-system|add-source|enable|disable|delete)
                    _aio_extension_root=${AIO_EXTENSIONS_DIR:-/usr/lib/aio-debian-gui/extensions}
                    for _aio_software_admin in "$_aio_extension_root"/*/software_manager/admin.py; do
                        [ -f "$_aio_software_admin" ] || continue
                        exec /usr/bin/python3 -I "$_aio_software_admin" "$@"
                    done
                    exit 2 ;;
                *) exit 2 ;;
            esac ;;
        --grub) shift; exec /usr/lib/aio-debian-gui/aio-grub-settings "$@" ;;
        --apt-backup) shift; exec /usr/lib/aio-debian-gui/aio-apt-sources-backup "$@" ;;
    esac
fi
# La revisión interactiva de autoremove usa un canal propio: stdin debe seguir
# cerrado para APT y sus hooks, pero la GUI necesita poder aprobar el nuevo plan.
_aio_review_cleanup=0
for _aio_arg in "$@"; do
    [ "$_aio_arg" = "--review-cleanup" ] && _aio_review_cleanup=1
done
if [ "$_aio_review_cleanup" -eq 1 ]; then
    exec {_aio_review_fd}<&0 || { echo "[-] No se pudo preparar el canal de revisión de limpieza." >&2; exit 1; }
fi
exec </dev/null   # nunca esperar entrada: no hay terminal

info() { echo "[*] $*"; }
ok()   { echo "[✔] $*"; }
warn() { echo "[!] $*"; }
err()  { echo "[-] $*"; }

# Sin terminal: nada de preguntas de apt/dpkg/needrestart
export DEBIAN_FRONTEND=noninteractive
export APT_LISTCHANGES_FRONTEND=none
export NEEDRESTART_MODE=l
APT_OPTS=(-y -o DPkg::options::=--force-confdef -o DPkg::options::=--force-confold -o Dpkg::Use-Pty=0)

LISTAS_ACTUALIZADAS=0
UPGRADE_PLAN=""
AUTOREMOVE_PLAN=""
REVISAR_LIMPIEZA=0
REINICIO_REQUERIDO=0
HELPER_VERSION=1.5.3
SYSTEM_HELPER=/usr/lib/aio-debian-gui/aio-debian-gui-helper
SYSTEM_POLICY=/usr/share/polkit-1/actions/es.aiodebian.gui.policy
SCHEDULER_MODULE=/usr/lib/aio-debian-gui/aio_core/scheduler.py
MAINTENANCE_LOCK=/run/aio-debian-gui/maintenance.lock
# Descriptor ya bloqueado por main() o heredado del programador; run_privileged
# lo reutiliza en lugar de intentar bloquear dos veces el mismo archivo.
AIO_PRIV_LOCK_FD=""
POLKIT_RULES_DIR=/etc/polkit-1/rules.d
PASSWORDLESS_STATE_DIR=/var/lib/aio-debian-gui/passwordless
GNOME_EXTENSIONS_MODULE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/aio_core/gnome_extensions.py"
declare -A EXTENSIONES_GNOME=(
    [gnome-ext-appindicator]="appindicatorsupport@rgcjonas.gmail.com"
    [gnome-ext-blur-shell]="blur-my-shell@aunetx"
    [gnome-ext-caffeine]="caffeine@patapon.info"
    [gnome-ext-clipboard-indicator]="clipboard-indicator@tudmotu.com"
    [gnome-ext-dash-to-dock]="dash-to-dock@micxgx.gmail.com"
    [gnome-ext-places-status]="places-menu@gnome-shell-extensions.gcampax.github.com"
    [gnome-ext-tiling-shell]="tilingshell@ferrarodomenico.com"
)

# ------------------------------------------------------------------------------
# Utilidades
# ------------------------------------------------------------------------------
# La decisión sobre la distribución la toma siempre el anfitrión, nunca el sandbox.
# OS_RELEASE_FILE solo se permite en pruebas sin privilegios; se ignora al ejecutar como root.
leer_distribucion() {
    local archivo=/etc/os-release
    if [ "$EUID" -ne 0 ] && [ -n "${AIO_TEST_OS_RELEASE:-}" ]; then
        archivo="$AIO_TEST_OS_RELEASE"
    fi
    [ -r "$archivo" ] || return 1
    (
      ID= VERSION_ID=
      . "$archivo"
      case "${ID:-}" in
        debian|ayusos) printf '%s\n' debian ;;
        ubuntu)
          case "${VERSION_ID:-}" in
            24.04|26.04) printf '%s\n' ubuntu ;;
            *) return 1 ;;
          esac
          ;;
        *) return 1 ;;
      esac
    )
}

distribucion_soportada() {
    local id
    id=$(leer_distribucion) || {
        err "Este sistema no es Debian, AyusOS Linux ni Ubuntu 24.04/26.04 LTS. Se han bloqueado las operaciones administrativas."
        return 1
    }
    printf '%s\n' "$id"
}

ubuntu_hwe_paquete() {
    local version
    [ "$(leer_distribucion)" = ubuntu ] || return 1
    local archivo=/etc/os-release
    if [ "$EUID" -ne 0 ] && [ -n "${AIO_TEST_OS_RELEASE:-}" ]; then
        archivo="$AIO_TEST_OS_RELEASE"
    fi
    . "$archivo"
    version=${VERSION_ID:-}
    [ "$version" = 24.04 ] || [ "$version" = 26.04 ] || return 1
    printf 'linux-generic-hwe-%s\n' "$version"
}

estado_ubuntu_hwe() {
    local paquete
    paquete=$(ubuntu_hwe_paquete) || return 1
    paquete_instalado "$paquete"
}

paso_ubuntu_hwe() {
    local paquete simulation
    paquete=$(ubuntu_hwe_paquete) || return 1
    asegurar_listas || return 1
    if ! apt-cache show "$paquete" >/dev/null 2>&1; then
        err "No hay paquete HWE disponible para esta versión de Ubuntu. No se realizarán cambios."
        return 1
    fi
    info "Simulando instalación del metapaquete HWE $paquete..."
    if ! simulation=$(LC_ALL=C run_privileged "apt-simulate-install-$paquete" 60 apt-get -s --no-remove install "$paquete" 2>&1); then
        err "No se pudo simular la instalación de $paquete."
        printf '%s\n' "$simulation" >&2
        return 1
    fi
    if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
        err "La instalación de $paquete propone eliminar paquetes. Se cancela por seguridad."
        return 1
    fi
    info "Instalando el metapaquete oficial $paquete desde los repositorios configurados..."
    if ! run_privileged "apt-install-$paquete" 300 apt-get "${APT_OPTS[@]}" --no-remove install "$paquete"; then
        err "No se pudo instalar el kernel HWE."
        return 1
    fi
    REINICIO_REQUERIDO=1
    echo "##REBOOT:1"
    ok "Kernel HWE solicitado. Reinicia para activarlo."
}

estado_ubuntu_repos() {
    # Deb822 y formato clásico. Detectar componentes sin modificar archivos.
    local carpeta="${1:-/etc/apt}" f linea
    local encontrado_universe=0 encontrado_multiverse=0 encontrado_restricted=0
    shopt -s nullglob
    for f in "$carpeta/sources.list" "$carpeta"/sources.list.d/*.list "$carpeta"/sources.list.d/*.sources; do
        [ -f "$f" ] || continue
        while IFS= read -r linea; do
            case "$linea" in
                \#*) continue ;;
            esac
            if [[ "$linea" =~ ^Components: ]] || [[ "$linea" =~ ^deb[[:space:]] ]]; then
                [[ " $linea " == *" universe "* ]] && encontrado_universe=1
                [[ " $linea " == *" multiverse "* ]] && encontrado_multiverse=1
                [[ " $linea " == *" restricted "* ]] && encontrado_restricted=1
            fi
        done < "$f"
    done
    shopt -u nullglob
    [ "$encontrado_universe" = 1 ] && [ "$encontrado_multiverse" = 1 ] && [ "$encontrado_restricted" = 1 ]
}

paso_ubuntu_repos() {
    local componente simulation
    asegurar_listas || return 1
    if ! command -v add-apt-repository >/dev/null 2>&1; then
        info "Simulando instalación de software-properties-common..."
        if ! simulation=$(LC_ALL=C run_privileged "apt-simulate-install-software-properties-common" 60 apt-get -s --no-remove install software-properties-common 2>&1); then
            err "No se pudo simular la instalación de software-properties-common."
            printf '%s\n' "$simulation" >&2
            return 1
        fi
        if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
            err "La instalación de software-properties-common propone eliminar paquetes. Se cancela por seguridad."
            return 1
        fi
        info "Instalando software-properties-common para gestionar repositorios oficiales Ubuntu..."
        if ! run_privileged "apt-install-software-properties-common" 300 apt-get "${APT_OPTS[@]}" --no-remove install software-properties-common; then
            return 1
        fi
    fi
    for componente in universe restricted multiverse; do
        info "Habilitando el componente oficial $componente..."
        add-apt-repository -y "$componente" || return 1
    done
    LISTAS_ACTUALIZADAS=0
    asegurar_listas || return 1
    ok "Componentes oficiales de Ubuntu configurados."
}

pkexec_uid() {
    local uid="${PKEXEC_UID:-}"
    if [[ ! "$uid" =~ ^[1-9][0-9]*$ ]]; then
        err "No se pudo determinar el usuario que solicitó la autorización."
        return 1
    fi
    printf '%s\n' "$uid"
}

pkexec_username() {
    local uid entry username
    uid=$(pkexec_uid) || return 1
    entry=$(getent passwd "$uid") || {
        err "No se pudo consultar la cuenta del usuario."
        return 1
    }
    username=${entry%%:*}
    if [[ ! "$username" =~ ^[A-Za-z0-9_.-]+[$]?$ ]]; then
        err "El nombre de usuario contiene caracteres no admitidos."
        return 1
    fi
    printf '%s\n' "$username"
}

ejecutar_como_usuario_solicitante() {
    local uid username entry home runtime
    local -a entorno
    uid=$(pkexec_uid) || return 1
    username=$(pkexec_username) || return 1
    entry=$(getent passwd "$uid") || return 1
    IFS=: read -r _ _ _ _ _ home _ <<< "$entry"
    case "$home" in
        /*) ;;
        *) err "El directorio personal del usuario no es válido."; return 1 ;;
    esac
    [ -d "$home" ] || { err "No se encontró el directorio personal del usuario."; return 1; }
    runtime="/run/user/$uid"
    entorno=(HOME="$home")
    if [ -d "$runtime" ]; then
        entorno+=(XDG_RUNTIME_DIR="$runtime" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus")
    fi
    # pkexec puede dejar el CWD en /root; runuser lo hereda y comandos como
    # find fallan al no poder entrar/restaurar ese directorio como el usuario.
    (
        cd "$home" || exit 1
        runuser -u "$username" -- env "${entorno[@]}" "$@"
    )
}

ejecutar_flatpak_usuario() {
    local uid runtime
    uid=$(pkexec_uid) || return 1
    runtime="/run/user/$uid"
    if [ ! -d "$runtime" ]; then
        warn "No se encontró el runtime de sesión del usuario; se omite Flatpak de usuario."
        return 2
    fi
    ejecutar_como_usuario_solicitante flatpak --user "$@"
}

ejecutar_programador() {
    local host_scheduler=/usr/lib/aio-debian-gui/aio-host-scheduler
    if [ -x "$host_scheduler" ]; then
        "$host_scheduler" "$@"
    else
        /usr/bin/python3 -I "$SCHEDULER_MODULE" "$@"
    fi
}

instalar_componentes_polkit() {
    local source_helper="${BASH_SOURCE[0]}" source_dir source_policy
    source_dir=$(cd -- "$(dirname -- "$source_helper")" && pwd) || return 1
    source_policy="$source_dir/../../share/polkit-1/actions/es.aiodebian.gui.policy"
    [ -f "$source_policy" ] || source_policy=$SYSTEM_POLICY
    [ -f "$source_policy" ] || {
        err "No se encontró la política polkit de AiO Debian GUI."
        return 1
    }

    if paquete_instalado aio-debian-gui; then
        if [ -f "$SYSTEM_HELPER" ] && ! cmp -s "$source_helper" "$SYSTEM_HELPER"; then
            err "La versión del AppImage no coincide con el paquete .deb instalado. Actualiza ambos antes de activar esta opción."
            return 1
        fi
        if [ -f "$SYSTEM_POLICY" ] && ! cmp -s "$source_policy" "$SYSTEM_POLICY"; then
            err "La política del paquete .deb no coincide con el AppImage. Actualiza ambos antes de activar esta opción."
            return 1
        fi
    fi

    if ! install -d -o root -g root -m 0755 \
        "$(dirname "$SYSTEM_HELPER")" "$(dirname "$SYSTEM_POLICY")"; then
        err "No se pudieron preparar los directorios de AiO Debian GUI."
        return 1
    fi
    if [ ! -f "$SYSTEM_HELPER" ] || ! cmp -s "$source_helper" "$SYSTEM_HELPER"; then
        if ! install -o root -g root -m 0755 "$source_helper" "$SYSTEM_HELPER"; then
            err "No se pudo instalar el asistente de AiO Debian GUI."
            return 1
        fi
    fi
    if ! cmp -s "$source_policy" "$SYSTEM_POLICY"; then
        if ! install -o root -g root -m 0644 "$source_policy" "$SYSTEM_POLICY"; then
            err "No se pudo instalar la política polkit de AiO Debian GUI."
            return 1
        fi
    fi
}

guardar_marcador_passwordless() {
    local uid=$1 origen=$2 directorio archivo temp
    directorio=$PASSWORDLESS_STATE_DIR
    archivo="$directorio/${uid}.rules"
    install -d -o root -g root -m 0755 "$directorio" || return 1
    temp=$(mktemp "$directorio/.${uid}.XXXXXX") || return 1
    if ! cat -- "$origen" > "$temp" || ! chmod 0644 "$temp" \
            || ! chown root:root "$temp" || ! mv -f -- "$temp" "$archivo"; then
        rm -f -- "$temp"
        return 1
    fi
}

habilitar_sin_contrasena() {
    local uid username rule_file temp marcador
    uid=$(pkexec_uid) || return 1
    username=$(pkexec_username) || return 1
    instalar_componentes_polkit || return 1
    # No cambiar los permisos de un directorio existente: Debian lo deja en
    # 0750 root:polkitd y systemd-tmpfiles los restaura en cada arranque.
    if [ ! -d "$POLKIT_RULES_DIR" ]; then
        install -d -o root -g root -m 0755 "$POLKIT_RULES_DIR" || {
            err "No se pudo preparar el directorio de reglas polkit."
            return 1
        }
    fi
    rule_file="$POLKIT_RULES_DIR/50-aiodebian-gui-${uid}.rules"
    marcador="$PASSWORDLESS_STATE_DIR/${uid}.rules"
    temp=$(mktemp "$POLKIT_RULES_DIR/.aiodebian-gui-${uid}.XXXXXX") || {
        err "No se pudo crear la regla polkit."
        return 1
    }
    if ! generar_regla_polkit "$username" > "$temp"; then
        rm -f -- "$temp"
        err "No se pudo escribir la regla polkit."
        return 1
    fi
    if ! chmod 0644 "$temp" || ! chown root:root "$temp" || ! mv -f -- "$temp" "$rule_file"; then
        rm -f -- "$temp"
        err "No se pudo activar la regla polkit."
        return 1
    fi
    if ! guardar_marcador_passwordless "$uid" "$rule_file"; then
        rm -f -- "$rule_file" "$marcador"
        err "No se pudo guardar el estado de la autorización sin contraseña."
        return 1
    fi
    ok "Excepción de Polkit activada para el usuario y la acción específica de AiO Debian GUI."
}

generar_regla_polkit() {
    local username="$1"
    # Los nombres POSIX normales no contienen comillas ni barras invertidas;
    # validar igualmente antes de interpolarlos en una cadena JavaScript.
    [[ "$username" =~ ^[a-zA-Z_][a-zA-Z0-9_.-]*[$]?$ ]] || {
        err "Nombre de usuario no válido para una regla Polkit."; return 1;
    }
    cat <<EOF
polkit.addRule(function(action, subject) {
    if (action.id === "es.aiodebian.gui.mantenimiento" &&
        action.lookup("program") === "/usr/lib/aio-debian-gui/aio-debian-gui-helper" &&
        subject.user === "$username" &&
        subject.local &&
        subject.active) {
        return polkit.Result.YES;
    }
});
EOF
}

deshabilitar_sin_contrasena() {
    local uid rule_file marcador
    uid=$(pkexec_uid) || return 1
    rule_file="$POLKIT_RULES_DIR/50-aiodebian-gui-${uid}.rules"
    marcador="$PASSWORDLESS_STATE_DIR/${uid}.rules"
    if ! rm -f -- "$rule_file" "$marcador"; then
        err "No se pudo quitar la autorización sin contraseña de AiO Debian GUI."
        return 1
    fi
    ok "Se quitó la autorización sin contraseña de AiO Debian GUI."
}

paquete_instalado() {
    dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"
}

instalar_aplicacion_backup() {
    local identificador paquete simulation
    identificador="$1"
    case "$identificador" in
        timeshift) paquete=timeshift ;;
        deja-dup) paquete=deja-dup ;;
        *) err "Aplicación de copia no permitida."; return 2 ;;
    esac
    if paquete_instalado "$paquete"; then
        echo "##BACKUP:installed:$identificador"
        return 0
    fi
    asegurar_listas || return 1
    info "Simulando instalación de $paquete..."
    if ! simulation=$(LC_ALL=C run_privileged "apt-simulate-install-$paquete" 60 apt-get -s --no-remove install "$paquete" 2>&1); then
        err "No se pudo simular la instalación de $paquete."
        printf '%s\n' "$simulation" >&2
        return 1
    fi
    if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
        err "La instalación de $paquete propone eliminar paquetes. Se cancela por seguridad."
        return 1
    fi
    info "Instalando $paquete desde los repositorios APT configurados..."
    if ! run_privileged "apt-install-$paquete" 300 apt-get "${APT_OPTS[@]}" --no-remove install "$paquete"; then
        err "No se pudo instalar $paquete."
        return 1
    fi
    if ! paquete_instalado "$paquete"; then
        err "APT terminó, pero no se pudo confirmar la instalación de $paquete."
        return 1
    fi
    echo "##BACKUP:installed:$identificador"
}

ubuntu_compatible_con_ghostty() (
    local archivo=/etc/os-release
    if [ "$EUID" -ne 0 ] && [ -n "${AIO_TEST_OS_RELEASE:-}" ]; then
        archivo="$AIO_TEST_OS_RELEASE"
    fi
    [ -r "$archivo" ] || return 1
    local ID= VERSION_ID=
    . "$archivo"
    [ "$ID" = ubuntu ] && [[ "$VERSION_ID" =~ ^[0-9]{2,}\.[0-9]{2}$ ]] &&
        dpkg --compare-versions "$VERSION_ID" ge 26.04
)

instalar_ghostty_ubuntu() (
    local preferencias simulation
    preferencias=$(mktemp) || return 1
    trap 'rm -f -- "$preferencias"' EXIT
    {
        printf '%s\n' 'Package: ghostty' 'Pin: release o=Ubuntu' 'Pin-Priority: 990' ''
        printf '%s\n' 'Package: ghostty' 'Pin: version *' 'Pin-Priority: -1' ''
        if [ -r /etc/apt/preferences ]; then
            cat /etc/apt/preferences
        fi
    } > "$preferencias" || return 1
    info "Simulando instalación de ghostty..."
    if ! simulation=$(LC_ALL=C run_privileged "apt-simulate-install-ghostty" 60 apt-get -s -o "Dir::Etc::Preferences=$preferencias" --no-remove install ghostty 2>&1); then
        err "No se pudo simular la instalación de ghostty."
        printf '%s\n' "$simulation" >&2
        return 1
    fi
    if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
        err "La instalación de ghostty propone eliminar paquetes. Se cancela por seguridad."
        return 1
    fi
    run_privileged "apt-install-ghostty" 300 apt-get "${APT_OPTS[@]}" -o "Dir::Etc::Preferences=$preferencias" --no-remove install ghostty
)

instalar_aplicacion_recomendada() {
    local identificador paquete simulation resultado=0
    identificador="$1"
    case "$identificador" in
        audacity) paquete=audacity ;;
        btop) paquete=btop ;;
        celluloid) paquete=celluloid ;;
        deluge) paquete=deluge ;;
        flameshot) paquete=flameshot ;;
        ghostty)
            ubuntu_compatible_con_ghostty || {
                err "La instalación de Ghostty desde APT requiere Ubuntu 26.04 o posterior."
                return 2
            }
            paquete=ghostty
            ;;
        gimp) paquete=gimp ;;
        gparted) paquete=gparted ;;
        handbrake) paquete=handbrake ;;
        hplip-gui) paquete=hplip-gui ;;
        htop) paquete=htop ;;
        kdenlive) paquete=kdenlive ;;
        kitty) paquete=kitty ;;
        qbittorrent) paquete=qbittorrent ;;
        retroarch) paquete=retroarch ;;
        vlc) paquete=vlc ;;
        *) err "Aplicación recomendada no permitida."; return 2 ;;
    esac
    if paquete_instalado "$paquete"; then
        echo "##RECOMMENDED:installed:$identificador"
        return 0
    fi
    asegurar_listas || return 1
    if [ "$paquete" = ghostty ]; then
        instalar_ghostty_ubuntu || return 1
    else
        info "Simulando instalación de $paquete..."
        if ! simulation=$(LC_ALL=C run_privileged "apt-simulate-install-$paquete" 60 apt-get -s --no-remove install "$paquete" 2>&1); then
            err "No se pudo simular la instalación de $paquete."
            printf '%s\n' "$simulation" >&2
            return 1
        fi
        if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
            err "La instalación de $paquete propone eliminar paquetes. Se cancela por seguridad."
            return 1
        fi
        info "Instalando $paquete desde los repositorios APT configurados..."
        if ! run_privileged "apt-install-$paquete" 300 apt-get "${APT_OPTS[@]}" --no-remove install "$paquete"; then
            err "No se pudo instalar $paquete."
            return 1
        fi
        if ! paquete_instalado "$paquete"; then
            err "APT terminó, pero no se pudo confirmar la instalación de $paquete."
            return 1
        fi
    fi
    echo "##RECOMMENDED:installed:$identificador"
}

# Auditoría dpkg obligatoria antes de cualquier operación APT
_aio_dpkg_audit() {
    local auditoria
    if ! auditoria=$(LC_ALL=C run_privileged "dpkg-audit" 30 dpkg --audit 2>&1) || [ -n "$auditoria" ]; then
        err "Hay una incidencia de dpkg pendiente. Revisa el diagnóstico antes de continuar."
        [ -z "$auditoria" ] || printf '%s\n' "$auditoria" >&2
        return 1
    fi
}

asegurar_listas() {
    [ "$LISTAS_ACTUALIZADAS" -eq 1 ] && return 0
    _aio_dpkg_audit || return 1
    info "Sincronizando listas de paquetes (apt-get update)..."
    if run_privileged "apt-update" 120 apt-get --error-on=any update; then
        LISTAS_ACTUALIZADAS=1
        return 0
    fi
    err "Error al actualizar las listas de paquetes. Comprueba tu conexión."
    return 1
}

refrescar_indices_diagnostico() {
    local auditoria codigo=0
    auditoria=$(LC_ALL=C run_privileged "dpkg-audit" 30 dpkg --audit 2>&1) || codigo=$?
    printf '##DIAGNOSTIC_DPKG:%s:' "$codigo"
    printf '%s' "${auditoria:0:500}" | base64 -w0
    printf '\n'
    if ! run_privileged "apt-update" 180 apt-get -o APT::Update::Error-Mode=any update; then
        err "No se pudieron actualizar todos los índices APT."
        return 1
    fi
    echo "##DIAGNOSTIC_APT:updated"
}

# Instala un paquete (nombre Debian) si falta. $1 = paquete, $2 = aviso si falla
# Simulación obligatoria con --only-upgrade --no-remove antes de instalar
instalar_paquete_si_falta() {
    local pkg="$1" aviso="$2" simulation
    if paquete_instalado "$pkg"; then
        ok "'${pkg}' ya está instalado."
        return 0
    fi
    info "'${pkg}' no detectado. Simulando instalación..."
    if ! simulation=$(LC_ALL=C run_privileged "apt-simulate-install-$pkg" 60 apt-get -s --no-remove install "$pkg" 2>&1); then
        err "No se pudo simular la instalación de $pkg."
        printf '%s\n' "$simulation" >&2
        return 1
    fi
    if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
        err "La instalación de $pkg propone eliminar paquetes. Se cancela por seguridad."
        return 1
    fi
    info "Instalando $pkg..."
    if ! run_privileged "apt-install-$pkg" 300 apt-get "${APT_OPTS[@]}" --no-remove install "$pkg"; then
        warn "$aviso"
        return 1
    fi
    if paquete_instalado "$pkg"; then
        ok "'${pkg}' se instaló correctamente."
    else
        warn "$aviso"
        return 1
    fi
}

paquete_appimage() {
    local paquete
    for paquete in libfuse2t64 libfuse2; do
        if apt-cache show "$paquete" 2>/dev/null | grep -q "^Package: ${paquete}$"; then
            printf '%s\n' "$paquete"
            return 0
        fi
    done
    return 1
}

debian_backports_codename() (
    local archivo=/etc/os-release codename
    if [ "$EUID" -ne 0 ] && [ -n "${AIO_TEST_OS_RELEASE:-}" ]; then
        archivo="$AIO_TEST_OS_RELEASE"
    fi
    [ -r "$archivo" ] || return 1
    local ID= VERSION_CODENAME= DEBIAN_CODENAME=
    . "$archivo"
    case "$ID" in
        debian) codename=$VERSION_CODENAME ;;
        ayusos) codename=${DEBIAN_CODENAME:-$VERSION_CODENAME} ;;
        *) err "La instalación del kernel desde Backports solo está disponible en Debian y AyusOS Linux."; return 1 ;;
    esac
    if [[ ! "$codename" =~ ^[a-z][a-z0-9-]*$ ]]; then
        err "No se pudo determinar de forma segura la versión de Debian."
        return 1
    fi
    printf '%s\n' "$codename"
)

kernel_backports_package() {
    case "$(dpkg --print-architecture)" in
        amd64)   printf '%s\n' linux-image-amd64 ;;
        arm64)   printf '%s\n' linux-image-arm64 ;;
        armhf)   printf '%s\n' linux-image-armmp ;;
        i386)    printf '%s\n' linux-image-686-pae ;;
        ppc64el) printf '%s\n' linux-image-powerpc64le ;;
        riscv64) printf '%s\n' linux-image-riscv64 ;;
        s390x)   printf '%s\n' linux-image-s390x ;;
        *)
            err "La arquitectura $(dpkg --print-architecture) no tiene un kernel Backports compatible configurado."
            return 1
            ;;
    esac
}

paquete_disponible_en_suite() {
    local paquete="$1" suite="$2"
    apt-cache madison "$paquete" 2>/dev/null |
        awk -F'|' -v suite="$suite" 'index($3, suite "/") { disponible=1 } END { exit !disponible }'
}

asegurar_fuente_backports() {
    local suite="$1"
    local dir=/etc/apt/sources.list.d
    local archivo="$dir/aio-debian-gui-backports.sources"
    local temporal

    if [ -e "$archivo" ]; then
        if grep -Fxq "Types: deb" "$archivo" &&
           grep -Fxq "URIs: http://deb.debian.org/debian" "$archivo" &&
           grep -Fxq "Suites: $suite" "$archivo" &&
           grep -Fxq "Components: main" "$archivo" &&
           grep -Fxq "Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg" "$archivo"; then
            return 0
        fi
        err "$archivo existe, pero no coincide con la fuente Backports gestionada por AiO."
        return 1
    fi

    if ! install -d -o root -g root -m 0755 "$dir"; then
        err "No se pudo preparar el directorio de repositorios APT."
        return 1
    fi
    temporal=$(mktemp "$dir/.aio-debian-gui-backports.XXXXXX") || {
        err "No se pudo crear la fuente de Debian Backports."
        return 1
    }
    if ! cat > "$temporal" <<EOF
Types: deb
URIs: http://deb.debian.org/debian
Suites: $suite
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF
    then
        rm -f -- "$temporal"
        err "No se pudo escribir la fuente de Debian Backports."
        return 1
    fi
    if ! chmod 0644 "$temporal" || ! chown root:root "$temporal" || ! mv -f -- "$temporal" "$archivo"; then
        rm -f -- "$temporal"
        err "No se pudo activar la fuente de Debian Backports."
        return 1
    fi
    LISTAS_ACTUALIZADAS=0
    info "Se añadió la fuente oficial $suite."
}

versiones_paquetes() {
    local paquete version
    for paquete in "$@"; do
        version=$(dpkg-query -W -f='${Version}' "$paquete" 2>/dev/null || true)
        printf '%s=%s\n' "$paquete" "$version"
    done
}

# Añade 'contrib' y 'non-free' a los repositorios oficiales de Debian.
# Devuelve 0 si cambió, 1 si no había cambios y 2 si falló.
# Soporta formato clásico (.list) y deb822 (.sources).
anadir_componentes() {
    local f="$1" temporal backup_tmp
    [ -f "$f" ] && [ ! -L "$f" ] || {
        err "Fuente APT no válida o enlace simbólico: $f"
        return 2
    }
    temporal=$(mktemp "${f}.aio.XXXXXX") || {
        err "No se pudo preparar la actualización de $f."
        return 2
    }

    case "$f" in
        *.sources)
            # Procesa cada stanza Deb822 por separado. Solo modifica Components
            # cuando la stanza contiene una URI oficial de Debian.
            if ! awk '
                function emitir( i, uri_activa, debian, linea) {
                    if (n == 0) return
                    uri_activa = 0
                    debian = 0
                    for (i = 1; i <= n; i++) {
                        linea = stanza[i]
                        if (linea ~ /^URIs:[[:space:]]*/) {
                            uri_activa = 1
                            if (linea ~ /(debian\.org|\/debian\/?([[:space:]]|$))/) debian = 1
                        } else if (linea ~ /^[[:space:]]+/) {
                            if (uri_activa && linea ~ /(debian\.org|\/debian\/?([[:space:]]|$))/) debian = 1
                        } else {
                            uri_activa = 0
                        }
                    }
                    if (debian) {
                        for (i = 1; i <= n; i++) {
                            if (stanza[i] ~ /^Components:[[:space:]]*/) {
                                if (stanza[i] !~ /(^|[[:space:]])contrib([[:space:]]|$)/) stanza[i] = stanza[i] " contrib"
                                if (stanza[i] !~ /(^|[[:space:]])non-free([[:space:]]|$)/) stanza[i] = stanza[i] " non-free"
                            }
                        }
                    }
                    for (i = 1; i <= n; i++) print stanza[i]
                    delete stanza
                    n = 0
                }
                /^[[:space:]]*$/ { emitir(); print; next }
                { stanza[++n] = $0 }
                END { emitir() }
            ' "$f" > "$temporal"; then
                rm -f -- "$temporal"
                err "No se pudo generar la nueva fuente APT: $f"
                return 2
            fi
            ;;
        *.list)
            # Solo líneas deb/deb-src de Debian que tengan el componente 'main'.
            if ! sed -E '/^[[:space:]]*deb(-src)?[[:space:]].*(debian\.org|\/debian\/?[[:space:]])/ {
                /[[:space:]]main([[:space:]]|$)/ {
                    /[[:space:]]contrib([[:space:]]|$)/! s/[[:space:]]*$/ contrib/
                    /[[:space:]]non-free([[:space:]]|$)/! s/[[:space:]]*$/ non-free/
                }
            }' "$f" > "$temporal"; then
                rm -f -- "$temporal"
                err "No se pudo generar la nueva fuente APT: $f"
                return 2
            fi
            ;;
        *)
            rm -f -- "$temporal"
            return 1
            ;;
    esac

    if cmp -s "$f" "$temporal"; then
        rm -f -- "$temporal"
        return 1
    fi
    if ! chmod --reference="$f" "$temporal"; then
        rm -f -- "$temporal"
        err "No se pudieron conservar los permisos de $f."
        return 2
    fi
    if [ "$EUID" -eq 0 ] && ! chown --reference="$f" "$temporal"; then
        rm -f -- "$temporal"
        err "No se pudo conservar el propietario de $f."
        return 2
    fi

    backup_tmp=$(mktemp "${f}.bak.XXXXXX") || {
        rm -f -- "$temporal"
        err "No se pudo preparar el respaldo de $f."
        return 2
    }
    if ! cp -a -- "$f" "$backup_tmp"; then
        rm -f -- "$temporal" "$backup_tmp"
        err "No se pudo crear el respaldo de $f."
        return 2
    fi
    if [ -e "${f}.bak" ] && ! mv -f -- "${f}.bak" "${f}.bak.previous"; then
        rm -f -- "$temporal" "$backup_tmp"
        err "No se pudo conservar el respaldo anterior de $f."
        return 2
    fi
    if ! mv -f -- "$backup_tmp" "${f}.bak"; then
        rm -f -- "$temporal" "$backup_tmp"
        err "No se pudo publicar el respaldo de $f."
        return 2
    fi
    if ! mv -f -- "$temporal" "$f"; then
        rm -f -- "$temporal"
        err "No se pudo sustituir la fuente APT: $f"
        return 2
    fi
    return 0
}

