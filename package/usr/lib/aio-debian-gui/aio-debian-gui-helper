declare -A TITULOS=(
    [clock]="Sincronizar el reloj"
    [repos]="Configurar componentes oficiales de repositorios"
    [tools]="Instalar herramientas auxiliares"
    [backports-kernel-mesa]="Instalar kernel y Mesa desde Backports"
    [ubuntu-hwe]="Instalar kernel HWE oficial de Ubuntu"
    [flatpak-setup]="Instalar Flatpak y Flathub"
    [gnome-plugin]="Plugin Flatpak para GNOME Software"
    [ext-manager]="Extension Manager de GNOME"
    [upgrade]="Actualizar paquetes del sistema"
    [autoremove]="Eliminar dependencias huérfanas"
    [autoclean]="Limpiar caché de paquetes"
    [flatpak-update]="Actualizar aplicaciones Flatpak"
    [rebootcheck]="Comprobar si hace falta reiniciar"
)
# Pasos cuyo fallo detiene la ejecución (el resto solo se anota)
CRITICOS=" upgrade backports-kernel-mesa "

mostrar_estados() {
    local tarea funcion
    local distro
    distro=$(leer_distribucion) || distro=desconocida
    for tarea in repos tools backports-kernel-mesa ubuntu-hwe gnome-plugin ext-manager; do
        # Las tareas exclusivas de otra distribución se marcan como no configuradas.
        case "$distro:$tarea" in
            ubuntu:backports-kernel-mesa|debian:ubuntu-hwe|desconocida:backports-kernel-mesa|desconocida:ubuntu-hwe)
                printf '##STATUS:%s:0\n' "$tarea"
                continue ;;
        esac
        case "$tarea" in
            repos) funcion=estado_repos ;;
            tools) funcion=estado_tools ;;
            backports-kernel-mesa) funcion=estado_backports ;;
            ubuntu-hwe) funcion=estado_ubuntu_hwe ;;
            gnome-plugin) funcion=estado_gnome_plugin ;;
            ext-manager) funcion=estado_ext_manager ;;
        esac
        if "$funcion"; then
            printf '##STATUS:%s:1\n' "$tarea"
        else
            printf '##STATUS:%s:0\n' "$tarea"
        fi
    done
}

main() {
    if [ "${1:-}" = "--version" ] && [ "$#" -eq 1 ]; then
        printf '%s\n' "$HELPER_VERSION"
        return 0
    fi
    if [ "${1:-}" = "--status" ] && [ "$#" -eq 1 ]; then
        mostrar_estados
        return 0
    fi

    # Negar las operaciones administrativas en distribuciones no probadas.
    distribucion_soportada >/dev/null || exit 1

    if [ "$EUID" -ne 0 ]; then
        err "Este asistente debe ejecutarse con privilegios de administrador." >&2
        exit 1
    fi

    # Idioma de los mensajes de apt/flatpak (pkexec limpia el entorno)
    if [ "${1:-}" = "--lang" ]; then
        if [[ "${2:-}" =~ ^[A-Za-z0-9_.@-]{1,40}$ ]]; then
            export LANG="$2"
        fi
        shift; [ $# -gt 0 ] && shift
    fi

    case "${1:-}" in
        --check-update-self)
            [ "$#" -eq 1 ] || { err "Uso: $0 [--lang LOCALE] --check-update-self"; exit 2; }
            paquete_instalado aio-debian-gui || { err "AiO Debian GUI no está instalado como DEB."; exit 1; }
            asegurar_listas || exit 1
            instalada=$(dpkg-query -W -f='${Version}' aio-debian-gui) || exit 1
            disponible=$(apt-cache policy aio-debian-gui | awk '/^[[:space:]]*Candidate:/ { print $2; exit }')
            [ -n "$disponible" ] && [ "$disponible" != "(none)" ] || {
                err "No existe versión candidata de AiO Debian GUI en los repositorios APT."
                exit 1
            }
            if dpkg --compare-versions "$disponible" gt "$instalada"; then
                printf '##UPDATE:%s:%s\n' "$instalada" "$disponible"
            else
                printf '##NOUPDATE:%s:%s\n' "$instalada" "$disponible"
            fi
            exit 0
            ;;
        --update-self)
            [ "$#" -eq 1 ] || { err "Uso: $0 [--lang LOCALE] --update-self"; exit 2; }
            # Solo actualiza el paquete oficial ya instalado por APT. No hay rutas,
            # URLs ni argumentos controlados por el usuario.
            if ! dpkg-query -W -f='${db:Status-Status}' aio-debian-gui 2>/dev/null | grep -qx installed; then
                err "AiO Debian GUI no está instalado como paquete DEB."
                exit 1
            fi
            asegurar_listas || exit 1
            if ! apt-get "${APT_OPTS[@]}" --only-upgrade install aio-debian-gui; then
                err "No se pudo actualizar AiO Debian GUI mediante APT."
                exit 1
            fi
            ok "Comprobación y actualización del paquete DEB completadas."
            exit 0
            ;;
        --enable-passwordless)
            err "La autorización permanente sin contraseña se ha retirado por seguridad desde 1.0.19."
            exit 2
            ;;
        --disable-passwordless)
            [ "$#" -eq 1 ] || { err "Uso: $0 [--lang LOCALE] --disable-passwordless"; exit 2; }
            deshabilitar_sin_contrasena
            exit $?
            ;;
    esac

    local pasos=() s
    for s in "$@"; do
        if [ -z "${TITULOS[$s]+x}" ]; then
            err "Paso desconocido: $s" >&2
            exit 2
        fi
        pasos+=("$s")
    done
    [ ${#pasos[@]} -gt 0 ] || { err "No se indicó ningún paso." >&2; exit 2; }
    local distro
    distro=$(leer_distribucion) || exit 1
    for s in "${pasos[@]}"; do
        case "$distro:$s" in
            ubuntu:backports-kernel-mesa|debian:ubuntu-hwe)
                err "La tarea $s no es compatible con la distribución detectada."
                exit 2 ;;
        esac
    done

    local total=${#pasos[@]} i=0 fallos=0
    for s in "${pasos[@]}"; do
        i=$((i + 1))
        echo "##STEP:${i}:${total}:${TITULOS[$s]}"
        if ! "paso_${s//-/_}"; then
            fallos=1
            if [[ "$CRITICOS" == *" $s "* ]]; then
                echo "##DONE:1"
                exit 1
            fi
        fi
    done

    echo "##DONE:${fallos}"
    [ "$fallos" -eq 0 ]
}

# Permite hacer 'source' del archivo para pruebas sin ejecutar nada
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
