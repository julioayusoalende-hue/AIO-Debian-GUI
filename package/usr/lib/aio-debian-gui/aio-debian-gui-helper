paso_rebootcheck() {
    local necesita="$REINICIO_REQUERIDO" salida=""

    [ -f /var/run/reboot-required ] && necesita=1

    if ! command -v needrestart >/dev/null 2>&1; then
        err "No se pudo comprobar si hace falta reiniciar: instala needrestart en el anfitrión."
        [ "$necesita" -eq 1 ] && echo "##REBOOT:1"
        return 1
    fi
    info "Comprobación final de servicios y kernel con needrestart..."
    info "(puede tardar un poco)"
    if ! salida=$(timeout 180 needrestart -b </dev/null); then
        err "No se pudo completar la comprobación de reinicio con needrestart."
        [ "$necesita" -eq 1 ] && echo "##REBOOT:1"
        return 1
    fi
    if [ -z "$salida" ]; then
        err "needrestart no devolvió resultados; no se pudo comprobar si hace falta reiniciar."
        [ "$necesita" -eq 1 ] && echo "##REBOOT:1"
        return 1
    fi
    echo "$salida"
    if echo "$salida" | grep -qE "^NEEDRESTART-KSTA: [23]"; then
        necesita=1
    fi
    local criticos="dbus|dbus-broker|gdm|gdm3|lightdm|sddm|systemd-logind|systemd-udevd"
    if echo "$salida" | grep -qE "^NEEDRESTART-SVC: (${criticos})\.service$"; then
        necesita=1
    fi

    local linea
    if [ "$necesita" -eq 0 ]; then
        while IFS= read -r linea; do
            if [[ "$linea" =~ ^NEEDRESTART-SVC:\ ([a-zA-Z0-9_][a-zA-Z0-9_.@:-]*\.service)$ ]]; then
                printf '##RESTART-SERVICE:%s\n' "${BASH_REMATCH[1]}"
            fi
        done <<< "$salida"
    fi

    if [ "$necesita" -eq 1 ]; then
        warn "Se recomienda reiniciar para aplicar cambios críticos (kernel/servicios)."
    else
        ok "No hace falta reiniciar."
    fi
    echo "##REBOOT:${necesita}"
}

# NVIDIA: detección PCI del anfitrión, sin depender del driver instalado.
nvidia_pci_root() {
    if [ "$EUID" -ne 0 ] && [[ -v AIO_TEST_PCI_ROOT ]]; then
        printf '%s\n' "$AIO_TEST_PCI_ROOT"
    else
        echo /sys/bus/pci/devices
    fi
}
nvidia_gpu_count() {
    local fabricante="$1" dir ruta v c total=0
    dir=$(nvidia_pci_root)
    for ruta in "$dir"/*; do
        [ -r "$ruta/vendor" ] && [ -r "$ruta/class" ] || continue
        v=$(cat "$ruta/vendor"); c=$(cat "$ruta/class")
        case "$c" in 0x0300*|0x0302*|0x0380*) ;; *) continue ;; esac
        if [ "$fabricante" = integrada ]; then
            case "$v" in 0x8086|0x1002) total=$((total + 1));; esac
        elif [ "$v" = "$fabricante" ]; then
            total=$((total + 1))
        fi
    done
    echo "$total"
}
nvidia_presente() { [ "$(nvidia_gpu_count 0x10de)" -gt 0 ]; }
nvidia_hibrida() {
    # La combinación de fabricantes no demuestra una topología Optimus.
    nvidia_presente && [ "$(nvidia_gpu_count integrada)" -gt 0 ]
}
# Sin mokutil no se puede saber si Secure Boot está activo y la instalación se
# rechazaría: en sistemas EFI se instala antes de comprobarlo.
nvidia_asegurar_mokutil() {
    [ -d "${EFI_DIR:-/sys/firmware/efi}" ] || return 0
    command -v mokutil >/dev/null && return 0
    info "Falta mokutil, necesario para comprobar Secure Boot: se instalará."
    asegurar_listas || return 1
    local simulation
    info "Simulando instalación de mokutil..."
    if ! simulation=$(LC_ALL=C run_privileged "apt-simulate-install-mokutil" 60 apt-get -s --no-remove install mokutil 2>&1); then
        err "No se pudo simular la instalación de mokutil."
        printf '%s\n' "$simulation" >&2
        return 1
    fi
    if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
        err "La instalación de mokutil propone eliminar paquetes. Se cancela por seguridad."
        return 1
    fi
    if ! run_privileged "apt-install-mokutil" 300 apt-get "${APT_OPTS[@]}" --no-remove install mokutil; then
        err "No se pudo instalar mokutil, necesario para comprobar Secure Boot."
        return 1
    fi
    command -v mokutil >/dev/null || { err "mokutil no quedó disponible tras instalarlo."; return 1; }
}
nvidia_secure_boot() {
    local r
    [ -d "${EFI_DIR:-/sys/firmware/efi}" ] || { echo desactivado; return; }
    command -v mokutil >/dev/null || { echo desconocido; return; }
    r=$(mokutil --sb-state 2>/dev/null) || { echo desconocido; return; }
    case "$r" in
        *"SecureBoot enabled"*|*"Secure Boot enabled"*) echo activado ;;
        *"SecureBoot disabled"*|*"Secure Boot disabled"*) echo desactivado ;;
        *) echo desconocido ;;
    esac
}
# Un paquete instalado no garantiza que exista un módulo para el kernel activo.
# Debian instala el módulo como nvidia-current.ko (DEST_MODULE_NAME de su
# dkms.conf); el alias "nvidia" solo existe cuando está activa la alternativa.
nvidia_version_modulo() {
    local nombre version
    for nombre in nvidia nvidia-current nvidia-current-open nvidia-open; do
        version=$(modinfo -k "$(uname -r)" -F version "$nombre" 2>/dev/null) || continue
        [ -n "$version" ] || continue
        printf '%s\n' "$version"
        return 0
    done
    return 1
}

nvidia_modulo_listo() {
    paquete_instalado nvidia-driver || return 1
    local version modulo
    version=$(dpkg-query -W -f='${Version}' nvidia-driver 2>/dev/null) || return 1
    version=${version#*:}; version=${version%%-*}
    modulo=$(nvidia_version_modulo) || return 1
    [ "$modulo" = "$version" ] || return 1
    LC_ALL=C dkms status 2>/dev/null | awk -F", " -v v="$version" -v k="$(uname -r)" '
        $1 ~ /^nvidia[^/]*\// && substr($1, index($1, "/") + 1) == v && $2 == k && $3 ~ /: installed($|[[:space:]])/ { found=1 }
        END { exit !found }'
}

nvidia_diagnostico_dkms() {
    local esperado modulo
    esperado=$(dpkg-query -W -f='${Version}' nvidia-driver 2>/dev/null)
    esperado=${esperado#*:}; esperado=${esperado%%-*}
    modulo=$(nvidia_version_modulo) || modulo="no encontrado"
    info "Diagnóstico: kernel $(uname -r), nvidia-driver ${esperado:-no instalado}, módulo cargable: $modulo."
    LC_ALL=C dkms status 2>&1 | grep -i nvidia | while IFS= read -r linea; do info "dkms status: $linea"; done
}

# Se consulta la lista de GPU del paquete candidato autenticado por APT.
# No se usa nvidia-detect, cuya base puede pertenecer a otra rama.
nvidia_elegir_modulo() {
    local version="$1" temporal resultado estado
    temporal=$(mktemp -d) || return 1
    if ! (cd "$temporal" && run_privileged "apt-download-nvidia-driver" 60 apt-get download "nvidia-driver=$version" >&2); then
        rm -rf -- "$temporal"; return 1
    fi
    resultado=$(python3 "$(dirname "${BASH_SOURCE[0]}")/aio_core/nvidia.py"         "$temporal" "$version" "$(nvidia_pci_root)")
    estado=$?
    rm -rf -- "$temporal"
    [ "$estado" -eq 0 ] || return "$estado"
    printf '%s\n' "$resultado"
}

nvidia_report() {
    local p=0 h=0 installed=0 candidate=no-disponible
    if nvidia_presente; then
        p=1
        nvidia_hibrida && h=1
        nvidia_modulo_listo && nvidia_configuracion_ok && installed=1
        candidate=$(LC_ALL=C apt-cache policy nvidia-driver 2>/dev/null | awk '/Candidate:/ {print $2; exit}')
        [ -n "$candidate" ] || candidate=no-disponible
    fi
    printf '##NVIDIA:present:%s\n' "$p"
    printf '##NVIDIA:hybrid:%s\n' "$h"
    printf '##NVIDIA:installed:%s\n' "$installed"
    printf '##NVIDIA:candidate:%s\n' "$candidate"
    printf '##NVIDIA:secureboot:%s\n' "$(nvidia_secure_boot)"
    printf '##NVIDIA:kernel:%s\n' "$(uname -r)"
}
# Configuración posterior según wiki.debian.org/NvidiaGraphicsDrivers (Trixie):
# - Wayland: nvidia-drm modeset=1 y fbdev=1.
# - Suspensión (salvo portátiles híbridos/Optimus): PreserveVideoMemoryAllocations
#   y NVreg_TemporaryFilePath=/var/tmp. Es obligatoria para que GDM use Wayland.
# - dracut: incluir /etc/modprobe.d/nvidia* en el initramfs.
# - Cabeceras: el metapaquete del kernel para que DKMS compile en kernels futuros.
# - X11: si GDM desactiva Wayland (híbridos sin PreserveVideoMemoryAllocations),
#   necesita el servidor X y las sesiones X11 de GNOME. Debian los instala; AyusOS no.
NVIDIA_MODESET_CONF=${NVIDIA_MODESET_CONF:-/etc/modprobe.d/nvidia-modeset.conf}
NVIDIA_MODESET_CONTENIDO=$'# Creado por AiO Debian GUI: modesetting para el controlador NVIDIA.\noptions nvidia-drm modeset=1\noptions nvidia-drm fbdev=1'
NVIDIA_POWER_CONF=${NVIDIA_POWER_CONF:-/etc/modprobe.d/nvidia-aio-power.conf}
NVIDIA_POWER_CONTENIDO=$'# Creado por AiO Debian GUI: suspensión del controlador NVIDIA (wiki de Debian).\noptions nvidia-current NVreg_PreserveVideoMemoryAllocations=1\noptions nvidia-current NVreg_TemporaryFilePath=/var/tmp'
NVIDIA_DRACUT_CONF=${NVIDIA_DRACUT_CONF:-/etc/dracut.conf.d/10-nvidia.conf}
NVIDIA_DRACUT_CONTENIDO='install_items+=" /etc/modprobe.d/nvidia* "'
NVIDIA_DRACUT_STAMP=${NVIDIA_DRACUT_STAMP:-/var/lib/aio-debian-gui/nvidia-dracut.state}

nvidia_fichero_igual() { [ -f "$1" ] && [ "$(cat "$1" 2>/dev/null)" = "$2" ]; }
nvidia_usa_dracut() { paquete_instalado dracut; }

nvidia_dracut_huella() {
    sha256sum "$NVIDIA_DRACUT_CONF" 2>/dev/null | awk '{print $1}'
}

# 0 = falta regenerar; 1 = la última regeneración corresponde a este kernel/config.
nvidia_dracut_pendiente() {
    nvidia_usa_dracut || return 1
    [ -f "$NVIDIA_DRACUT_CONF" ] || return 0
    [ -r "$NVIDIA_DRACUT_STAMP" ] || return 0
    local kernel huella kernel_guardado huella_guardada
    kernel=$(uname -r)
    huella=$(nvidia_dracut_huella) || return 0
    IFS=: read -r kernel_guardado huella_guardada < "$NVIDIA_DRACUT_STAMP" || return 0
    [ "$kernel" = "$kernel_guardado" ] && [ "$huella" = "$huella_guardada" ] || return 0
    return 1
}

nvidia_dracut_marcar() {
    local kernel huella temporal
    kernel=$(uname -r)
    huella=$(nvidia_dracut_huella) || return 1
    install -d -m 0755 "$(dirname "$NVIDIA_DRACUT_STAMP")" || return 1
    temporal=$(mktemp "${NVIDIA_DRACUT_STAMP}.XXXXXX") || return 1
    if ! printf '%s:%s\n' "$kernel" "$huella" > "$temporal" ||
       ! chmod 0644 "$temporal" ||
       ! mv -f -- "$temporal" "$NVIDIA_DRACUT_STAMP"; then
        rm -f -- "$temporal"
        return 1
    fi
}

# Paquetes que faltan para seguir la wiki (uno por línea).
nvidia_paquetes_extra() {
    local flavor meta
    paquete_instalado xserver-xorg || echo xserver-xorg
    # Sin las sesiones X11 de GNOME, GDM aborta con «no session desktop files installed».
    if paquete_instalado gnome-session && ! paquete_instalado gnome-session-xsession; then
        echo gnome-session-xsession
    fi
    # Panel de control de NVIDIA: nvidia-driver solo lo recomienda y puede quedar fuera.
    if ! paquete_instalado nvidia-settings &&
       LC_ALL=C apt-cache policy nvidia-settings 2>/dev/null | grep -Eq 'Candidate:[[:space:]]+[^ (]'; then
        echo nvidia-settings
    fi
    flavor=$(uname -r); flavor=${flavor#*-}
    meta="linux-headers-$flavor"
    if ! paquete_instalado "$meta" &&
       LC_ALL=C apt-cache policy "$meta" 2>/dev/null | grep -Eq 'Candidate:[[:space:]]+[^ (]'; then
        echo "$meta"
    fi
}

nvidia_configuracion_ok() {
    nvidia_fichero_igual "$NVIDIA_MODESET_CONF" "$NVIDIA_MODESET_CONTENIDO" || return 1
    if ! nvidia_hibrida; then
        nvidia_fichero_igual "$NVIDIA_POWER_CONF" "$NVIDIA_POWER_CONTENIDO" || return 1
    fi
    if nvidia_usa_dracut; then
        nvidia_fichero_igual "$NVIDIA_DRACUT_CONF" "$NVIDIA_DRACUT_CONTENIDO" || return 1
        nvidia_dracut_pendiente && return 1
    fi
    [ -z "$(nvidia_paquetes_extra)" ]
}

nvidia_escribir() {
    nvidia_fichero_igual "$1" "$2" && return 1
    mkdir -p "$(dirname "$1")" && printf '%s\n' "$2" > "$1" || { err "No se pudo escribir $1."; return 2; }
    info "Configurado $1."
    return 0
}

# Devuelve 0 si ha cambiado algo, 1 si ya estaba todo y 2 si ha fallado.
nvidia_configurar_wiki() {
    local cambio=1 estado
    if nvidia_escribir "$NVIDIA_MODESET_CONF" "$NVIDIA_MODESET_CONTENIDO"; then estado=0; else estado=$?; fi
    [ "$estado" -eq 2 ] && return 2; [ "$estado" -eq 0 ] && cambio=0
    if nvidia_hibrida; then
        info "Portátil híbrido: no se activa PreserveVideoMemoryAllocations (la wiki lo desaconseja en Optimus). GDM usará X11."
    else
        if nvidia_escribir "$NVIDIA_POWER_CONF" "$NVIDIA_POWER_CONTENIDO"; then estado=0; else estado=$?; fi
        [ "$estado" -eq 2 ] && return 2; [ "$estado" -eq 0 ] && cambio=0
    fi
    if nvidia_usa_dracut; then
        if nvidia_escribir "$NVIDIA_DRACUT_CONF" "$NVIDIA_DRACUT_CONTENIDO"; then estado=0; else estado=$?; fi
        [ "$estado" -eq 2 ] && return 2
        if nvidia_dracut_pendiente; then
            cambio=0
            info "Regenerando el initramfs con dracut para $(uname -r)…"
            dracut --force --kver "$(uname -r)" || {
                err "No se pudo regenerar el initramfs con dracut. Se reintentará en la próxima ejecución."
                return 2
            }
            nvidia_dracut_marcar || {
                err "No se pudo registrar la regeneración correcta del initramfs."
                return 2
            }
        fi
    fi
    return "$cambio"
}

# Instala con APT sin permitir eliminaciones.
nvidia_apt_seguro() {
    local simulation
    simulation=$(LC_ALL=C run_privileged "apt-simulate-nvidia-apt-seguro" 60 apt-get -s --no-remove install "$@" 2>&1) || {
        err "No se pueden resolver las dependencias sin eliminaciones: $simulation"; return 1;
    }
    if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
        err "APT propone eliminar paquetes. Se cancela por seguridad."
        return 1
    fi
    run_privileged "apt-install-nvidia-apt-seguro" 300 apt-get "${APT_OPTS[@]}" --no-remove install "$@"
}

paso_nvidia_driver() {
    local candidate kernel headers modulo simulation metadata limite
    [ "$(leer_distribucion)" = debian ] || { err "NVIDIA automático solo en Debian."; return 1; }
    nvidia_presente || { err "No se detectó una GPU NVIDIA PCI."; return 1; }
    if nvidia_modulo_listo; then
        ok "El controlador NVIDIA tiene un módulo DKMS instalado para el kernel activo."
        local extra=() estado=1
        mapfile -t extra < <(nvidia_paquetes_extra)
        if [ "${#extra[@]}" -gt 0 ]; then
            info "Instalando lo que pide la wiki de Debian: ${extra[*]}"
            asegurar_listas || return 1
            nvidia_apt_seguro "${extra[@]}" || { err "No se pudieron instalar: ${extra[*]}"; return 1; }
            estado=0
        fi
        local estado_conf=0
        nvidia_configurar_wiki || estado_conf=$?
        [ "$estado_conf" -eq 2 ] && return 1
        [ "$estado_conf" -eq 0 ] && estado=0
        if [ "$estado" -eq 0 ]; then
            REINICIO_REQUERIDO=1
            echo "##REBOOT:1"
            ok "Configuración NVIDIA completada según la wiki de Debian. Reinicia para aplicarla."
        fi
        return 0
    fi
    nvidia_asegurar_mokutil || return 1
    if [ "$(nvidia_secure_boot)" != desactivado ]; then
        err "Secure Boot activo o desconocido: configura primero la firma DKMS/MOK."
        return 1
    fi
    if paquete_instalado bumblebee || paquete_instalado primus; then
        err "Bumblebee/Primus detectado: requiere revisión antes de utilizar PRIME."
        return 1
    fi
    asegurar_listas || return 1
    candidate=$(LC_ALL=C apt-cache policy nvidia-driver | awk '/Candidate:/ {print $2; exit}')
    [ -n "$candidate" ] && [ "$candidate" != "(none)" ] || {
        err "Falta nvidia-driver en APT. Habilita contrib, non-free y non-free-firmware."
        return 1
    }
    kernel=$(uname -r)
    modulo=$(nvidia_elegir_modulo "$candidate") || {
        err "No se pudo verificar soporte para todas las GPU en el paquete candidato. Revisión manual necesaria."
        return 1
    }
    case "$modulo" in nvidia-kernel-dkms|nvidia-open-kernel-dkms) ;; *) return 1 ;; esac
    metadata=$(LC_ALL=C apt-cache show "$modulo=$candidate") || return 1
    limite=$(sed -nE 's/.*tested up to Linux ([0-9]+\.[0-9]+).*/\1/p' <<< "$metadata" | head -n 1)
    if [ -z "$limite" ] || ! dpkg --compare-versions "$(cut -d. -f1,2 <<< "${kernel%%-*}")" le "$limite"; then
        err "El paquete $modulo $candidate no acredita compatibilidad con el kernel $kernel. Revisión manual necesaria."
        return 1
    fi
    headers="linux-headers-$kernel"
    if ! paquete_instalado "$headers" &&
       ! LC_ALL=C apt-cache policy "$headers" | grep -Eq 'Candidate:[[:space:]]+[^ (]'; then
        err "No hay cabeceras disponibles para el kernel $kernel."
        return 1
    fi
    local extra=()
    mapfile -t extra < <(nvidia_paquetes_extra)
    simulation=$(LC_ALL=C run_privileged "apt-simulate-nvidia-driver" 60 apt-get -s --no-remove install "$headers" "nvidia-driver=$candidate" "$modulo=$candidate" "${extra[@]}" 2>&1) || {
        err "No se pueden resolver las dependencias sin eliminaciones: $simulation"; return 1;
    }
    if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
        err "APT propone eliminar paquetes. Se cancela por seguridad."
        return 1
    fi
    info "Controlador Debian $candidate para kernel $kernel."
    if nvidia_hibrida; then
        info "GPU Intel/AMD y NVIDIA presentes: no se modifica la configuración de pantallas. PRIME puede estar disponible."
        info "PRIME: __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia programa"
    fi
    if ! run_privileged "apt-install-nvidia-driver" 300 apt-get "${APT_OPTS[@]}" --no-remove install "$headers" "nvidia-driver=$candidate" "$modulo=$candidate" "${extra[@]}"; then
        err "Fallo instalando NVIDIA. Consulta logs de DKMS y APT."
        return 1
    fi
    if ! nvidia_modulo_listo; then
        err "APT terminó, pero no se verificó el módulo DKMS para el kernel activo. Revisa DKMS antes de reiniciar."
        nvidia_diagnostico_dkms
        return 1
    fi
    local estado_modeset=0
    nvidia_configurar_wiki || estado_modeset=$?
    [ "$estado_modeset" -eq 2 ] && return 1
    REINICIO_REQUERIDO=1
    echo "##REBOOT:1"
    ok "Módulo DKMS verificado. Reinicia y comprueba nvidia-smi; la GPU activa solo puede confirmarse después del reinicio."
}

