# Este programa se distribuye SIN NINGUNA GARANTÍA.
#
# Lo lanza la interfaz gráfica mediante pkexec (una sola autenticación para
# todos los pasos). No hace preguntas: cada paso se activa desde la interfaz.
# Uso: aio-debian-gui-helper [--lang LOCALE] paso [paso ...]
#
# Protocolo de salida (una línea por mensaje):
#   ##STEP:<n>:<total>:<título>   inicio de un paso
#   ##REBOOT:<0|1>                resultado de la comprobación de reinicio
#   ##DONE:<0|1>                  fin (1 = hubo algún paso con errores)

set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022
exec </dev/null   # nunca esperar entrada: no hay terminal

info() { echo "[*] $*"; }
ok()   { echo "[✔] $*"; }
warn() { echo "[!] $*"; }
err()  { echo "[-] $*"; }

# Sin terminal: nada de preguntas de apt/dpkg/needrestart
export DEBIAN_FRONTEND=noninteractive
export APT_LISTCHANGES_FRONTEND=none
export NEEDRESTART_MODE=l
APT_OPTS=(-y -o DPkg::options::=--force-confdef -o DPkg::options::=--force-confold -o Dpkg::Use-Pty=0)

LISTAS_ACTUALIZADAS=0
REINICIO_REQUERIDO=0
SYSTEM_HELPER=/usr/lib/aio-debian-gui/aio-debian-gui-helper
SYSTEM_POLICY=/usr/share/polkit-1/actions/es.aiodebian.gui.policy
POLKIT_RULES_DIR=/etc/polkit-1/rules.d

# ------------------------------------------------------------------------------
# Utilidades
# ------------------------------------------------------------------------------
pkexec_uid() {
    local uid="${PKEXEC_UID:-}"
    if [[ ! "$uid" =~ ^[1-9][0-9]*$ ]]; then
        err "No se pudo determinar el usuario que solicitó la autorización."
        return 1
    fi
    printf '%s\n' "$uid"
}

pkexec_username() {
    local uid entry username
    uid=$(pkexec_uid) || return 1
    entry=$(getent passwd "$uid") || {
        err "No se pudo consultar la cuenta del usuario."
        return 1
    }
    username=${entry%%:*}
    if [[ ! "$username" =~ ^[A-Za-z0-9_.-]+[$]?$ ]]; then
        err "El nombre de usuario contiene caracteres no admitidos."
        return 1
    fi
    printf '%s\n' "$username"
}

instalar_componentes_polkit() {
    local source_helper="${BASH_SOURCE[0]}" source_dir source_policy
    source_dir=$(cd -- "$(dirname -- "$source_helper")" && pwd) || return 1
    source_policy="$source_dir/../../share/polkit-1/actions/es.aiodebian.gui.policy"
    [ -f "$source_policy" ] || source_policy=$SYSTEM_POLICY
    [ -f "$source_policy" ] || {
        err "No se encontró la política polkit de AiO Debian GUI."
        return 1
    }

    if paquete_instalado aio-debian-gui; then
        if [ -f "$SYSTEM_HELPER" ] && ! cmp -s "$source_helper" "$SYSTEM_HELPER"; then
            err "La versión del AppImage no coincide con el paquete .deb instalado. Actualiza ambos antes de activar esta opción."
            return 1
        fi
        if [ -f "$SYSTEM_POLICY" ] && ! cmp -s "$source_policy" "$SYSTEM_POLICY"; then
            err "La política del paquete .deb no coincide con el AppImage. Actualiza ambos antes de activar esta opción."
            return 1
        fi
    fi

    if ! install -d -o root -g root -m 0755 \
        "$(dirname "$SYSTEM_HELPER")" "$(dirname "$SYSTEM_POLICY")"; then
        err "No se pudieron preparar los directorios de AiO Debian GUI."
        return 1
    fi
    if [ ! -f "$SYSTEM_HELPER" ] || ! cmp -s "$source_helper" "$SYSTEM_HELPER"; then
        if ! install -o root -g root -m 0755 "$source_helper" "$SYSTEM_HELPER"; then
            err "No se pudo instalar el asistente de AiO Debian GUI."
            return 1
        fi
    fi
    if ! cmp -s "$source_policy" "$SYSTEM_POLICY"; then
        if ! install -o root -g root -m 0644 "$source_policy" "$SYSTEM_POLICY"; then
            err "No se pudo instalar la política polkit de AiO Debian GUI."
            return 1
        fi
    fi
}

habilitar_sin_contrasena() {
    local uid username rule_file temp
    uid=$(pkexec_uid) || return 1
    username=$(pkexec_username) || return 1
    instalar_componentes_polkit || return 1
    if ! install -d -o root -g root -m 0755 "$POLKIT_RULES_DIR"; then
        err "No se pudo preparar el directorio de reglas polkit."
        return 1
    fi
    rule_file="$POLKIT_RULES_DIR/50-aiodebian-gui-${uid}.rules"
    temp=$(mktemp "$POLKIT_RULES_DIR/.aiodebian-gui-${uid}.XXXXXX") || {
        err "No se pudo crear la regla polkit."
        return 1
    }
    if ! generar_regla_polkit "$username" > "$temp"; then
        rm -f -- "$temp"
        err "No se pudo escribir la regla polkit."
        return 1
    fi
    if ! chmod 0644 "$temp" || ! chown root:root "$temp" || ! mv -f -- "$temp" "$rule_file"; then
        rm -f -- "$temp"
        err "No se pudo activar la regla polkit."
        return 1
    fi
    ok "AiO Debian GUI ya no pedirá la contraseña a este usuario en esta sesión."
}

generar_regla_polkit() {
    local username="$1"
    cat <<EOF
polkit.addRule(function(action, subject) {
    if (action.id === "es.aiodebian.gui.mantenimiento" &&
        action.lookup("program") === "/usr/lib/aio-debian-gui/aio-debian-gui-helper" &&
        subject.user === "$username" &&
        subject.local &&
        subject.active) {
        return polkit.Result.YES;
    }
});
EOF
}

deshabilitar_sin_contrasena() {
    local uid rule_file
    uid=$(pkexec_uid) || return 1
    rule_file="$POLKIT_RULES_DIR/50-aiodebian-gui-${uid}.rules"
    if ! rm -f -- "$rule_file"; then
        err "No se pudo quitar la regla polkit."
        return 1
    fi
    ok "Se quitó la autorización sin contraseña de AiO Debian GUI."
}

paquete_instalado() {
    dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"
}

asegurar_listas() {
    [ "$LISTAS_ACTUALIZADAS" -eq 1 ] && return 0
    info "Sincronizando listas de paquetes (apt-get update)..."
    if apt-get update; then
        LISTAS_ACTUALIZADAS=1
        return 0
    fi
    err "Error al actualizar las listas de paquetes. Comprueba tu conexión."
    return 1
}

# Instala un paquete (nombre Debian) si falta. $1 = paquete, $2 = aviso si falla
instalar_paquete_si_falta() {
    local pkg="$1" aviso="$2"
    if paquete_instalado "$pkg"; then
        ok "'${pkg}' ya está instalado."
        return 0
    fi
    info "'${pkg}' no detectado. Instalando..."
    apt-get "${APT_OPTS[@]}" install "$pkg"
    if paquete_instalado "$pkg"; then
        ok "'${pkg}' se instaló correctamente."
    else
        warn "$aviso"
        return 1
    fi
}

paquete_appimage() {
    local paquete
    for paquete in libfuse2t64 libfuse2; do
        if apt-cache show "$paquete" 2>/dev/null | grep -q "^Package: ${paquete}$"; then
            printf '%s\n' "$paquete"
            return 0
        fi
    done
    return 1
}

debian_backports_codename() {
    local distro codename
    . /etc/os-release
    distro=${ID:-}
    codename=${VERSION_CODENAME:-}
    if [ "$distro" != "debian" ]; then
        err "La instalación del kernel desde Backports solo está disponible en Debian."
        return 1
    fi
    if [[ ! "$codename" =~ ^[a-z][a-z0-9-]*$ ]]; then
        err "No se pudo determinar de forma segura la versión de Debian."
        return 1
    fi
    printf '%s\n' "$codename"
}

kernel_backports_package() {
    case "$(dpkg --print-architecture)" in
        amd64)   printf '%s\n' linux-image-amd64 ;;
        arm64)   printf '%s\n' linux-image-arm64 ;;
        armhf)   printf '%s\n' linux-image-armmp ;;
        i386)    printf '%s\n' linux-image-686-pae ;;
        ppc64el) printf '%s\n' linux-image-powerpc64le ;;
        riscv64) printf '%s\n' linux-image-riscv64 ;;
        s390x)   printf '%s\n' linux-image-s390x ;;
        *)
            err "La arquitectura $(dpkg --print-architecture) no tiene un kernel Backports compatible configurado."
            return 1
            ;;
    esac
}

paquete_disponible_en_suite() {
    local paquete="$1" suite="$2"
    apt-cache madison "$paquete" 2>/dev/null |
        awk -F'|' -v suite="$suite" 'index($3, suite "/") { disponible=1 } END { exit !disponible }'
}

asegurar_fuente_backports() {
    local suite="$1"
    local dir=/etc/apt/sources.list.d
    local archivo="$dir/aio-debian-gui-backports.sources"
    local temporal

    if [ -e "$archivo" ]; then
        if grep -Fxq "Types: deb" "$archivo" &&
           grep -Fxq "URIs: http://deb.debian.org/debian" "$archivo" &&
           grep -Fxq "Suites: $suite" "$archivo" &&
           grep -Fxq "Components: main" "$archivo" &&
           grep -Fxq "Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg" "$archivo"; then
            return 0
        fi
        err "$archivo existe, pero no coincide con la fuente Backports gestionada por AiO."
        return 1
    fi

    if ! install -d -o root -g root -m 0755 "$dir"; then
        err "No se pudo preparar el directorio de repositorios APT."
        return 1
    fi
    temporal=$(mktemp "$dir/.aio-debian-gui-backports.XXXXXX") || {
        err "No se pudo crear la fuente de Debian Backports."
        return 1
    }
    if ! cat > "$temporal" <<EOF
Types: deb
URIs: http://deb.debian.org/debian
Suites: $suite
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF
    then
        rm -f -- "$temporal"
        err "No se pudo escribir la fuente de Debian Backports."
        return 1
    fi
    if ! chmod 0644 "$temporal" || ! chown root:root "$temporal" || ! mv -f -- "$temporal" "$archivo"; then
        rm -f -- "$temporal"
        err "No se pudo activar la fuente de Debian Backports."
        return 1
    fi
    LISTAS_ACTUALIZADAS=0
    info "Se añadió la fuente oficial $suite."
}

versiones_paquetes() {
    local paquete version
    for paquete in "$@"; do
        version=$(dpkg-query -W -f='${Version}' "$paquete" 2>/dev/null || true)
        printf '%s=%s\n' "$paquete" "$version"
    done
}

# Añade 'contrib' y 'non-free' a los repositorios oficiales de Debian
# Soporta formato clásico (.list) y deb822 (.sources)
anadir_componentes() {
    local f="$1" copia
    copia=$(mktemp)
    cp -a "$f" "$copia"

    case "$f" in
        *.sources)
            # Solo si apunta a servidores oficiales de Debian (no a repos de terceros
            # cuyo nombre contenga 'debian', como .../aio-debian)
            if ! grep -qiE '^URIs:.*(debian\.org|/debian/?([[:space:]]|$))' "$f"; then rm -f "$copia"; return 1; fi
            sed -i -E '/^Components:/ {
                /(^|[[:space:]])contrib([[:space:]]|$)/! s/[[:space:]]*$/ contrib/
                /(^|[[:space:]])non-free([[:space:]]|$)/! s/[[:space:]]*$/ non-free/
            }' "$f"
            ;;
        *.list)
            # Solo líneas deb/deb-src de Debian que tengan el componente 'main'
            sed -i -E '/^[[:space:]]*deb(-src)?[[:space:]].*(debian\.org|\/debian\/?[[:space:]])/ {
                /[[:space:]]main([[:space:]]|$)/ {
                    /[[:space:]]contrib([[:space:]]|$)/! s/[[:space:]]*$/ contrib/
                    /[[:space:]]non-free([[:space:]]|$)/! s/[[:space:]]*$/ non-free/
                }
            }' "$f"
            ;;
    esac

    if ! cmp -s "$f" "$copia"; then
        cp -a "$copia" "${f}.bak"     # copia de seguridad (apt ignora .bak)
        rm -f "$copia"
        return 0                      # hubo cambios
    fi
    rm -f "$copia"
    return 1                          # sin cambios
}

# ------------------------------------------------------------------------------
# Pasos
# ------------------------------------------------------------------------------
paso_clock() {
    command -v timedatectl &> /dev/null || { info "timedatectl no disponible. Omitiendo."; return 0; }

    local estado
    estado=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)
    if [ "$estado" = "yes" ]; then
        ok "Reloj del sistema sincronizado."
        return 0
    fi

    warn "El reloj del sistema no está sincronizado. Intentando sincronizarlo..."

    # Activar NTP; si no hay servicio de hora instalado, instalar systemd-timesyncd
    if ! timedatectl set-ntp true &> /dev/null; then
        info "Servicio de hora no disponible. Instalando systemd-timesyncd..."
        apt-get update &> /dev/null
        apt-get -y install systemd-timesyncd &> /dev/null
        timedatectl set-ntp true &> /dev/null
    fi

    # Esperar hasta 30 segundos a que se sincronice
    local i
    for i in $(seq 1 30); do
        estado=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)
        [ "$estado" = "yes" ] && break
        sleep 1
    done

    if [ "$estado" = "yes" ]; then
        ok "Reloj sincronizado correctamente: $(date)"
    else
        err "No se pudo sincronizar el reloj (¿sin red o puerto NTP bloqueado?)."
        err "Fecha actual del sistema: $(date)"
        return 1
    fi
}

paso_repos() {
    info "Verificando los repositorios 'contrib' y 'non-free'..."
    local cambios=0 f
    shopt -s nullglob
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
        [ -f "$f" ] || continue
        if anadir_componentes "$f"; then
            ok "Actualizado: $f (copia en ${f}.bak)"
            cambios=1
        fi
    done
    shopt -u nullglob

    if [ "$cambios" -eq 0 ]; then
        ok "'contrib' y 'non-free' ya estaban configurados."
    else
        LISTAS_ACTUALIZADAS=0   # hay que volver a sincronizar las listas
    fi
}

fuente_debian_relevante() {
    local f="$1"
    case "$f" in
        *.sources)
            grep -qiE '^URIs:.*(debian\.org|/debian/?([[:space:]]|$))' "$f" &&
                grep -qE '^Components:.*(^|[[:space:]])main([[:space:]]|$)' "$f"
            ;;
        *.list)
            grep -qE '^[[:space:]]*deb(-src)?[[:space:]].*(debian\.org|/debian/?[[:space:]]).*([[:space:]])main([[:space:]]|$)' "$f"
            ;;
        *)
            return 1
            ;;
    esac
}

estado_repos() {
    local root="${1:-/etc/apt}" f temporal relevantes=0 pendientes=0 indice=0
    local -a fuentes
    shopt -s nullglob
    fuentes=("$root/sources.list" "$root"/sources.list.d/*.list "$root"/sources.list.d/*.sources)
    shopt -u nullglob

    temporal=$(mktemp -d) || return 1
    for f in "${fuentes[@]}"; do
        [ -f "$f" ] || continue
        fuente_debian_relevante "$f" || continue
        relevantes=1
        indice=$((indice + 1))
        local copia="$temporal/$indice-$(basename "$f")"
        if ! cp -- "$f" "$copia"; then
            rm -rf -- "$temporal"
            return 1
        fi
        if anadir_componentes "$copia"; then
            pendientes=1
            break
        fi
    done
    rm -rf -- "$temporal"
    [ "$relevantes" -eq 1 ] && [ "$pendientes" -eq 0 ]
}

paso_tools() {
    asegurar_listas || return 1
    local r=0
    instalar_paquete_si_falta needrestart "No se pudo instalar 'needrestart'. Se usará el método manual." || r=1
    instalar_paquete_si_falta fastfetch   "No se pudo instalar 'fastfetch'. Puede que no esté disponible en tus repositorios." || r=1
    instalar_paquete_si_falta kitty       "No se pudo instalar 'kitty'. Puede que no esté disponible en tus repositorios." || r=1
    instalar_paquete_si_falta synaptic    "No se pudo instalar 'synaptic'. Puede que no esté disponible en tus repositorios." || r=1
    if paquete_instalado libfuse2 || paquete_instalado libfuse2t64; then
        ok "El soporte FUSE 2 para AppImage ya está instalado."
    else
        local paquete
        if paquete=$(paquete_appimage); then
            instalar_paquete_si_falta "$paquete" "No se pudo instalar el soporte FUSE 2 para AppImage." || r=1
        else
            warn "No se encontró libfuse2 ni libfuse2t64 en los repositorios."
            r=1
        fi
    fi
    return $r
}

estado_tools() {
    local paquete
    for paquete in needrestart fastfetch kitty synaptic; do
        paquete_instalado "$paquete" || return 1
    done
    paquete_instalado libfuse2 || paquete_instalado libfuse2t64
}

paso_backports_kernel_mesa() {
    local codename suite kernel paquete apt_status antes despues
    local -a paquetes especificaciones

    codename=$(debian_backports_codename) || return 1
    suite="${codename}-backports"
    kernel=$(kernel_backports_package) || return 1
    asegurar_listas || return 1

    if ! paquete_disponible_en_suite "$kernel" "$suite" ||
       ! paquete_disponible_en_suite libgl1-mesa-dri "$suite"; then
        asegurar_fuente_backports "$suite" || return 1
        asegurar_listas || return 1
    fi
    if ! paquete_disponible_en_suite "$kernel" "$suite"; then
        err "No se encontró $kernel en $suite para esta arquitectura."
        return 1
    fi
    if ! paquete_disponible_en_suite libgl1-mesa-dri "$suite"; then
        err "No se encontró libgl1-mesa-dri en $suite."
        return 1
    fi

    paquetes=("$kernel" libgl1-mesa-dri)
    for paquete in mesa-vulkan-drivers mesa-va-drivers mesa-vdpau-drivers; do
        if paquete_disponible_en_suite "$paquete" "$suite"; then
            paquetes+=("$paquete")
        else
            info "'$paquete' no está disponible en $suite; se omitirá."
        fi
    done

    especificaciones=()
    for paquete in "${paquetes[@]}"; do
        especificaciones+=("$paquete/$suite")
    done
    antes=$(versiones_paquetes "${paquetes[@]}")

    info "Instalando el kernel y los controladores Mesa desde $suite..."
    if apt-get "${APT_OPTS[@]}" -t "$suite" install "${especificaciones[@]}"; then
        apt_status=0
    else
        apt_status=$?
    fi

    despues=$(versiones_paquetes "${paquetes[@]}")
    if [ "$antes" != "$despues" ]; then
        REINICIO_REQUERIDO=1
        echo "##REBOOT:1"
    fi
    if [ "$apt_status" -ne 0 ]; then
        err "No se pudieron instalar el kernel y los controladores Mesa desde $suite."
        return 1
    fi

    if [ "$REINICIO_REQUERIDO" -eq 1 ]; then
        ok "Kernel y controladores Mesa instalados desde $suite. Se recomienda reiniciar."
    else
        ok "El kernel y los controladores Mesa de $suite ya estaban al día."
    fi
}

paquete_instalado_en_suite() {
    local paquete="$1" suite="$2" instalado
    paquete_instalado "$paquete" || return 1
    instalado=$(dpkg-query -W -f='${Version}' "$paquete" 2>/dev/null) || return 1
    [ -n "$instalado" ] || return 1
    apt-cache madison "$paquete" 2>/dev/null |
        awk -F'|' -v version="$instalado" -v suite="$suite" '
            {
                actual=$2
                gsub(/^[ \t]+|[ \t]+$/, "", actual)
                if (actual == version && index($3, suite "/")) encontrado=1
            }
            END { exit !encontrado }
        '
}

estado_backports() {
    local codename suite kernel paquete
    codename=$(debian_backports_codename 2>/dev/null) || return 1
    suite="${codename}-backports"
    kernel=$(kernel_backports_package 2>/dev/null) || return 1

    for paquete in "$kernel" libgl1-mesa-dri; do
        paquete_instalado_en_suite "$paquete" "$suite" || return 1
    done
    for paquete in mesa-vulkan-drivers mesa-va-drivers mesa-vdpau-drivers; do
        if paquete_disponible_en_suite "$paquete" "$suite"; then
            paquete_instalado_en_suite "$paquete" "$suite" || return 1
        fi
    done
}

paso_flatpak_setup() {
    if command -v flatpak &> /dev/null; then
        ok "Flatpak ya está instalado."
        return 0
    fi
    asegurar_listas || return 1

    info "Instalando flatpak..."
    apt-get "${APT_OPTS[@]}" install flatpak ca-certificates

    if ! command -v flatpak &> /dev/null; then
        err "No se pudo instalar Flatpak. Comprueba tus repositorios."
        return 1
    fi
    ok "Flatpak instalado correctamente."
    info "Añadiendo el repositorio de Flathub..."
    update-ca-certificates &> /dev/null
    if flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo; then
        ok "Repositorio Flathub configurado con éxito."
    else
        err "No se pudo añadir Flathub (error de certificado o de red)."
        err "Fecha del sistema: $(date)"
        err "Reloj sincronizado: $(timedatectl show -p NTPSynchronized --value 2>/dev/null || echo desconocido)"
        err "Si la fecha es correcta, puede que tu red intercepte HTTPS (proxy/antivirus)."
        err "Reintenta luego con: sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo"
        return 1
    fi
}

paso_gnome_plugin() {
    command -v flatpak &> /dev/null || { info "Flatpak no está instalado. Omitiendo el plugin de GNOME Software."; return 0; }
    paquete_instalado gnome-shell || { info "GNOME no detectado. Omitiendo."; return 0; }
    if paquete_instalado gnome-software-plugin-flatpak; then
        ok "'gnome-software-plugin-flatpak' ya está instalado."
        return 0
    fi
    asegurar_listas || return 1

    info "Instalando gnome-software-plugin-flatpak..."
    apt-get "${APT_OPTS[@]}" install gnome-software-plugin-flatpak
    if paquete_instalado gnome-software-plugin-flatpak; then
        ok "Plugin instalado correctamente."
        info "Cierra y vuelve a abrir GNOME Software (o reinicia la sesión) para verlo."
    else
        err "No se pudo instalar el plugin. Comprueba tus repositorios."
        return 1
    fi
}

paso_ext_manager() {
    paquete_instalado gnome-shell || { info "GNOME no detectado. Omitiendo."; return 0; }
    if paquete_instalado gnome-shell-extension-manager; then
        ok "'gnome-shell-extension-manager' ya está instalado."
        return 0
    fi
    asegurar_listas || return 1

    # No está disponible en versiones antiguas de Debian
    if ! apt-cache show gnome-shell-extension-manager &> /dev/null; then
        err "'gnome-shell-extension-manager' no está disponible en tus repositorios."
        return 1
    fi

    info "Instalando gnome-shell-extension-manager..."
    apt-get "${APT_OPTS[@]}" install gnome-shell-extension-manager
    if paquete_instalado gnome-shell-extension-manager; then
        ok "Extension Manager instalado correctamente."
    else
        err "No se pudo instalar Extension Manager. Comprueba tus repositorios."
        return 1
    fi
}

estado_gnome_plugin() {
    paquete_instalado gnome-software-plugin-flatpak
}

estado_ext_manager() {
    paquete_instalado gnome-shell-extension-manager
}

paso_upgrade() {
    asegurar_listas || return 1
    info "Actualizando los paquetes del sistema (apt-get dist-upgrade)..."
    if ! apt-get "${APT_OPTS[@]}" dist-upgrade; then
        err "Error durante la actualización de paquetes."
        return 1
    fi
    ok "Paquetes actualizados."
}

paso_autoremove() {
    info "Eliminando dependencias huérfanas (apt-get autoremove)..."
    apt-get "${APT_OPTS[@]}" autoremove
    ok "Dependencias huérfanas eliminadas."
}

paso_autoclean() {
    info "Limpiando paquetes .deb obsoletos del caché (apt-get autoclean)..."
    apt-get autoclean
    ok "Limpieza realizada."
}

paso_flatpak_update() {
    if ! command -v flatpak &> /dev/null; then
        info "Flatpak no está instalado en este sistema. Omitiendo..."
        return 0
    fi
    info "Actualizando aplicaciones Flatpak..."
    if flatpak update -y && flatpak uninstall --unused -y; then
        ok "Flatpak al día."
    else
        err "Hubo problemas al actualizar Flatpak."
        return 1
    fi
}

paso_rebootcheck() {
    local necesita="$REINICIO_REQUERIDO" salida=""

    [ -f /var/run/reboot-required ] && necesita=1

    if command -v needrestart &> /dev/null; then
        info "Comprobación final de servicios y kernel con needrestart..."
        info "(puede tardar un poco)"
        salida=$(timeout 180 needrestart -b </dev/null 2>/dev/null)
        [ -n "$salida" ] && echo "$salida"

        if echo "$salida" | grep -qE "^NEEDRESTART-KSTA: [23]"; then
            necesita=1
        fi

        local criticos="dbus|dbus-broker|gdm|gdm3|lightdm|sddm|systemd-logind|systemd-udevd"
        if echo "$salida" | grep -qE "^NEEDRESTART-SVC: (${criticos})\.service$"; then
            necesita=1
        fi
    fi

    if [ "$necesita" -eq 1 ]; then
        warn "Se recomienda reiniciar para aplicar cambios críticos (kernel/servicios)."
    else
        ok "No hace falta reiniciar."
    fi
    echo "##REBOOT:${necesita}"
}

# ------------------------------------------------------------------------------
# Principal
# ------------------------------------------------------------------------------
declare -A TITULOS=(
    [clock]="Sincronizar el reloj"
    [repos]="Habilitar contrib y non-free"
    [tools]="Instalar herramientas auxiliares"
    [backports-kernel-mesa]="Instalar kernel y Mesa desde Backports"
    [flatpak-setup]="Instalar Flatpak y Flathub"
    [gnome-plugin]="Plugin Flatpak para GNOME Software"
    [ext-manager]="Extension Manager de GNOME"
    [upgrade]="Actualizar paquetes del sistema"
    [autoremove]="Eliminar dependencias huérfanas"
    [autoclean]="Limpiar caché de paquetes"
    [flatpak-update]="Actualizar aplicaciones Flatpak"
    [rebootcheck]="Comprobar si hace falta reiniciar"
)
# Pasos cuyo fallo detiene la ejecución (el resto solo se anota)
CRITICOS=" upgrade backports-kernel-mesa "

mostrar_estados() {
    local tarea funcion
    for tarea in repos tools backports-kernel-mesa gnome-plugin ext-manager; do
        case "$tarea" in
            repos) funcion=estado_repos ;;
            tools) funcion=estado_tools ;;
            backports-kernel-mesa) funcion=estado_backports ;;
            gnome-plugin) funcion=estado_gnome_plugin ;;
            ext-manager) funcion=estado_ext_manager ;;
        esac
        if "$funcion"; then
            printf '##STATUS:%s:1\n' "$tarea"
        else
            printf '##STATUS:%s:0\n' "$tarea"
        fi
    done
}

main() {
    if [ "${1:-}" = "--status" ] && [ "$#" -eq 1 ]; then
        mostrar_estados
        return 0
    fi

    if [ "$EUID" -ne 0 ]; then
        err "Este asistente debe ejecutarse con privilegios de administrador." >&2
        exit 1
    fi

    # Idioma de los mensajes de apt/flatpak (pkexec limpia el entorno)
    if [ "${1:-}" = "--lang" ]; then
        if [[ "${2:-}" =~ ^[A-Za-z0-9_.@-]{1,40}$ ]]; then
            export LANG="$2"
        fi
        shift; [ $# -gt 0 ] && shift
    fi

    case "${1:-}" in
        --enable-passwordless)
            [ "$#" -eq 1 ] || { err "Uso: $0 [--lang LOCALE] --enable-passwordless"; exit 2; }
            habilitar_sin_contrasena
            exit $?
            ;;
        --disable-passwordless)
            [ "$#" -eq 1 ] || { err "Uso: $0 [--lang LOCALE] --disable-passwordless"; exit 2; }
            deshabilitar_sin_contrasena
            exit $?
            ;;
    esac

    local pasos=() s
    for s in "$@"; do
        if [ -z "${TITULOS[$s]+x}" ]; then
            err "Paso desconocido: $s" >&2
            exit 2
        fi
        pasos+=("$s")
    done
    [ ${#pasos[@]} -gt 0 ] || { err "No se indicó ningún paso." >&2; exit 2; }

    local total=${#pasos[@]} i=0 fallos=0
    for s in "${pasos[@]}"; do
        i=$((i + 1))
        echo "##STEP:${i}:${total}:${TITULOS[$s]}"
        if ! "paso_${s//-/_}"; then
            fallos=1
            if [[ "$CRITICOS" == *" $s "* ]]; then
                echo "##DONE:1"
                exit 1
            fi
        fi
    done

    echo "##DONE:${fallos}"
    [ "$fallos" -eq 0 ]
}

# Permite hacer 'source' del archivo para pruebas sin ejecutar nada
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
