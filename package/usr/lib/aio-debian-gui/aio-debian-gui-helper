paso_backports_kernel_mesa() {
    local codename suite kernel paquete apt_status antes despues simulation
    local -a paquetes especificaciones

    codename=$(debian_backports_codename) || return 1
    suite="${codename}-backports"
    kernel=$(kernel_backports_package) || return 1
    asegurar_listas || return 1

    if ! paquete_disponible_en_suite "$kernel" "$suite" ||
       ! paquete_disponible_en_suite libgl1-mesa-dri "$suite"; then
        asegurar_fuente_backports "$suite" || return 1
        asegurar_listas || return 1
    fi
    if ! paquete_disponible_en_suite "$kernel" "$suite"; then
        err "No se encontró $kernel en $suite para esta arquitectura."
        return 1
    fi
    if ! paquete_disponible_en_suite libgl1-mesa-dri "$suite"; then
        err "No se encontró libgl1-mesa-dri en $suite."
        return 1
    fi

    paquetes=("$kernel" libgl1-mesa-dri)
    for paquete in mesa-vulkan-drivers mesa-va-drivers mesa-vdpau-drivers; do
        if paquete_disponible_en_suite "$paquete" "$suite"; then
            paquetes+=("$paquete")
        else
            info "'$paquete' no está disponible en $suite; se omitirá."
        fi
    done

    especificaciones=()
    for paquete in "${paquetes[@]}"; do
        especificaciones+=("$paquete/$suite")
    done
    antes=$(versiones_paquetes "${paquetes[@]}")

    info "Simulando instalación del kernel y controladores Mesa desde $suite..."
    if ! simulation=$(LC_ALL=C run_privileged "apt-simulate-backports-kernel-mesa" 60 apt-get -s -t "$suite" install "${especificaciones[@]}" 2>&1); then
        err "No se pudo simular la instalación desde $suite."
        printf '%s\n' "$simulation" >&2
        return 1
    fi
    if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
        err "La instalación desde $suite propone eliminar paquetes. Se cancela por seguridad."
        return 1
    fi

    info "Instalando el kernel y los controladores Mesa desde $suite..."
    if run_privileged "apt-install-backports-kernel-mesa" 300 apt-get "${APT_OPTS[@]}" -t "$suite" install "${especificaciones[@]}"; then
        apt_status=0
    else
        apt_status=$?
    fi

    despues=$(versiones_paquetes "${paquetes[@]}")
    if [ "$antes" != "$despues" ]; then
        REINICIO_REQUERIDO=1
        echo "##REBOOT:1"
    fi
    if [ "$apt_status" -ne 0 ]; then
        err "No se pudieron instalar el kernel y los controladores Mesa desde $suite."
        return 1
    fi

    if [ "$REINICIO_REQUERIDO" -eq 1 ]; then
        ok "Kernel y controladores Mesa instalados desde $suite. Se recomienda reiniciar."
    else
        ok "El kernel y los controladores Mesa de $suite ya estaban al día."
    fi
}


# Reversión conservadora: no elimina el kernel en ejecución ni cambia GRUB.
version_stable_paquete() {
    local paquete="$1" codename="$2" version origin best=""
    while IFS='|' read -r _ version origin; do
        version=${version//[[:space:]]/}
        if [[ "$origin" =~ (^|[[:space:]])($codename|$codename-security|$codename-updates)/ ]] &&
           [[ "$version" =~ ^[0-9A-Za-z.+:~_-]+$ ]]; then
            if [ -z "$best" ] || dpkg --compare-versions "$version" gt "$best"; then
                best="$version"
            fi
        fi
    done < <(LC_ALL=C apt-cache madison "$paquete" 2>/dev/null)
    [ -n "$best" ] || return 1
    printf '%s\n' "$best"
}

plan_revertir_backports() {
    local codename kernel headers paquete stable installed spec simulation
    local -a paquetes especificaciones
    codename=$(debian_backports_codename) || return 1
    kernel=$(kernel_backports_package) || return 1
    headers=${kernel/linux-image/linux-headers}
    # Evitar la reversión automática de hardware gráfico propietario.
    if paquete_instalado nvidia-driver ||
       paquete_instalado nvidia-kernel-dkms ||
       paquete_instalado nvidia-open-kernel-dkms; then
        err "Hay un controlador NVIDIA: requiere revisión manual de DKMS/PRIME."
        return 1
    fi
    if command -v dkms >/dev/null 2>&1 && [ -n "$(dkms status 2>/dev/null)" ]; then
        err "Hay módulos DKMS externos. Se requiere revisión manual."
        return 1
    fi
    paquetes=("$kernel" "$headers" libgl1-mesa-dri)
    for paquete in mesa-vulkan-drivers mesa-va-drivers mesa-vdpau-drivers \
        libegl-mesa0 libglx-mesa0 libgbm1 libglapi-mesa libosmesa6 libxatracker2 \
        mesa-libgallium mesa-opencl-icd; do
        if paquete_instalado "$paquete"; then paquetes+=("$paquete"); fi
    done
    especificaciones=()
    for paquete in "${paquetes[@]}"; do
        stable=$(version_stable_paquete "$paquete" "$codename") || {
            err "No se encontró versión Stable de $paquete. Ningún cambio aplicado."
            return 1
        }
        especificaciones+=("$paquete=$stable")
        installed=$(dpkg-query -W -f='${Version}' "$paquete" 2>/dev/null || true)
        info "$paquete: ${installed:-no instalado} -> $stable"
    done
    if ! simulation=$(LC_ALL=C run_privileged "apt-simulate-revertir-backports" 60 apt-get -s -o Debug::NoLocking=1 --allow-downgrades install "${especificaciones[@]}" 2>&1); then
        err "Falló la simulación APT; no se realizará ningún cambio."
        printf '%s\n' "$simulation"
        return 1
    fi
    if grep -Eq '^(Remv|Purg) ' <<<"$simulation"; then
        err "APT propone eliminar paquetes. Reversión bloqueada."
        printf '%s\n' "$simulation"
        return 1
    fi
    info "Simulación validada: no se eliminarán paquetes ni kernels instalados."
    for spec in "${especificaciones[@]}"; do
        printf '##STABLE:%s\n' "$spec"
    done
}

paso_revertir_backports() {
    local codename kernel headers paquete stable
    local -a paquetes specs
    asegurar_listas || return 1
    codename=$(debian_backports_codename) || return 1
    kernel=$(kernel_backports_package) || return 1
    headers=${kernel/linux-image/linux-headers}
    plan_revertir_backports || return 1
    paquetes=("$kernel" "$headers" libgl1-mesa-dri)
    for paquete in mesa-vulkan-drivers mesa-va-drivers mesa-vdpau-drivers \
        libegl-mesa0 libglx-mesa0 libgbm1 libglapi-mesa libosmesa6 libxatracker2 \
        mesa-libgallium mesa-opencl-icd; do
        if paquete_instalado "$paquete"; then paquetes+=("$paquete"); fi
    done
    specs=()
    for paquete in "${paquetes[@]}"; do
        stable=$(version_stable_paquete "$paquete" "$codename") || return 1
        specs+=("$paquete=$stable")
    done
    info "Instalando kernel y Mesa de Debian Stable..."
    if ! run_privileged "apt-install-revertir-backports" 300 apt-get "${APT_OPTS[@]}" --allow-downgrades install "${specs[@]}"; then
        err "APT no completó la transición a Stable."
        return 1
    fi
    REINICIO_REQUERIDO=1
    echo "##REBOOT:1"
    warn "Kernel Backports conservado como respaldo. GRUB no se ha modificado."
    warn "Reinicia, selecciona el kernel Stable en GRUB y verifica uname -r."
    warn "No elimines el kernel anterior sin comprobar que el nuevo arranca."
    ok "Kernel y Mesa Stable preparados; arranque del kernel Stable pendiente."
}

paquete_instalado_en_suite() {
    local paquete="$1" suite="$2" instalado
    paquete_instalado "$paquete" || return 1
    instalado=$(dpkg-query -W -f='${Version}' "$paquete" 2>/dev/null) || return 1
    [ -n "$instalado" ] || return 1
    apt-cache madison "$paquete" 2>/dev/null |
        awk -F'|' -v version="$instalado" -v suite="$suite" '
            {
                actual=$2
                gsub(/^[ \t]+|[ \t]+$/, "", actual)
                if (actual == version && index($3, suite "/")) encontrado=1
            }
            END { exit !encontrado }
        '
}

