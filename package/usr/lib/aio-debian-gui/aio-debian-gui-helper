        local simulation
        info "Simulando instalación de flatpak y ca-certificates..."
        if ! simulation=$(LC_ALL=C run_privileged "apt-simulate-install-flatpak" 60 apt-get -s --no-remove install flatpak ca-certificates 2>&1); then
            err "No se pudo simular la instalación de flatpak."
            printf '%s\n' "$simulation" >&2
            return 1
        fi
        if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
            err "La instalación de flatpak propone eliminar paquetes. Se cancela por seguridad."
            return 1
        fi
        info "Instalando flatpak..."
        if ! run_privileged "apt-install-flatpak" 300 apt-get "${APT_OPTS[@]}" --no-remove install flatpak ca-certificates; then
            err "No se pudo instalar Flatpak. Comprueba tus repositorios."
            return 1
        fi
        if ! command -v flatpak &> /dev/null; then
            err "No se pudo instalar Flatpak. Comprueba tus repositorios."
            return 1
        fi
        ok "Flatpak instalado correctamente."
    fi

    # Aunque Flatpak ya exista, el remoto Flathub puede no estar configurado.
    if flatpak remote-list --system 2>/dev/null | grep -qx 'flathub'; then
        ok "Repositorio Flathub ya configurado."
        return 0
    fi
    info "Añadiendo el repositorio de Flathub..."
    update-ca-certificates &> /dev/null
    if flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo; then
        ok "Repositorio Flathub configurado con éxito."
    else
        err "No se pudo añadir Flathub (error de certificado o de red)."
        err "Fecha del sistema: $(date)"
        err "Reloj sincronizado: $(timedatectl show -p NTPSynchronized --value 2>/dev/null || echo desconocido)"
        err "Si la fecha es correcta, puede que tu red intercepte HTTPS (proxy/antivirus)."
        err "Reintenta luego con: sudo flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo"
        return 1
    fi
}

