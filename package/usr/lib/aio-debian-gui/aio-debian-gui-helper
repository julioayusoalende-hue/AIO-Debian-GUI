limpiar_directorio_usuario() {
    local etiqueta=$1 relativa=$2 modo=$3
    local uid entry home base ruta resuelta
    uid=$(pkexec_uid) || return 1
    entry=$(getent passwd "$uid") || return 1
    IFS=: read -r _ _ _ _ _ home _ <<< "$entry"
    case "$home" in
        /*) ;;
        *) err "El directorio personal del usuario no es válido."; return 1 ;;
    esac
    [ -d "$home" ] || { err "No se encontró el directorio personal del usuario."; return 1; }
    base=$(readlink -f -- "$home") || return 1
    ruta="$base/$relativa"

    # Un enlace directo se elimina sin seguirlo. Si un padre es un enlace,
    # readlink -m detecta si el destino final sale del directorio personal.
    if [ -L "$ruta" ]; then
        ejecutar_como_usuario_solicitante rm -f -- "$ruta" || return 1
        ok "$etiqueta: enlace eliminado sin seguir su destino."
        return 0
    fi
    [ -d "$ruta" ] || { info "$etiqueta: no hay contenido que limpiar."; return 0; }
    resuelta=$(readlink -m -- "$ruta") || return 1
    case "$resuelta" in
        "$base"/*) ;;
        *) err "$etiqueta: la ruta resolvió fuera del directorio personal; se cancela."; return 1 ;;
    esac

    if [ "$modo" = trash ]; then
        ejecutar_como_usuario_solicitante find "$ruta" -mindepth 1 -maxdepth 1 \
            -exec rm -rf -- {} + || return 1
    else
        ejecutar_como_usuario_solicitante find "$ruta" -mindepth 1 -type f -mtime +7 -delete || return 1
        ejecutar_como_usuario_solicitante find "$ruta" -mindepth 1 -depth -type d -empty -delete || return 1
    fi
    ok "$etiqueta limpiado."
}

