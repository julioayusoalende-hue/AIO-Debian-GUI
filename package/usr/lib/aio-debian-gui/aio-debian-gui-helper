paso_clock() {
    command -v timedatectl &> /dev/null || { info "timedatectl no disponible. Omitiendo."; return 0; }

    local estado
    estado=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)
    if [ "$estado" = "yes" ]; then
        ok "Reloj del sistema sincronizado."
        return 0
    fi

    warn "El reloj del sistema no está sincronizado. Intentando sincronizarlo..."

    # Activar NTP; si no hay servicio de hora instalado, instalar systemd-timesyncd
    if ! timedatectl set-ntp true &> /dev/null; then
        info "Servicio de hora no disponible. Instalando systemd-timesyncd..."
        asegurar_listas || return 1
        local simulation
        info "Simulando instalación de systemd-timesyncd..."
        if ! simulation=$(LC_ALL=C run_privileged "apt-simulate-install-systemd-timesyncd" 60 apt-get -s --no-remove install systemd-timesyncd 2>&1); then
            err "No se pudo simular la instalación de systemd-timesyncd."
            printf '%s\n' "$simulation" >&2
            return 1
        fi
        if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
            err "La instalación de systemd-timesyncd propone eliminar paquetes. Se cancela por seguridad."
            return 1
        fi
        if ! run_privileged "apt-install-systemd-timesyncd" 300 apt-get "${APT_OPTS[@]}" --no-remove install systemd-timesyncd ||
           ! timedatectl set-ntp true; then
            err "No se pudo activar el servicio de sincronización horaria."
            return 1
        fi
    fi

    # Esperar hasta 30 segundos a que se sincronice
    local i
    for i in $(seq 1 30); do
        estado=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)
        [ "$estado" = "yes" ] && break
        sleep 1
    done

    if [ "$estado" = "yes" ]; then
        ok "Reloj sincronizado correctamente: $(date)"
    else
        err "No se pudo sincronizar el reloj (¿sin red o puerto NTP bloqueado?)."
        err "Fecha actual del sistema: $(date)"
        return 1
    fi
}

paso_repos() {
    if [ "$(leer_distribucion)" = ubuntu ]; then
        paso_ubuntu_repos
        return $?
    fi
    info "Verificando los repositorios 'contrib' y 'non-free'..."
    local cambios=0 fallos=0 f estado
    shopt -s nullglob
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
        [ -f "$f" ] || continue
        anadir_componentes "$f"; estado=$?
        case "$estado" in
            0)
                ok "Actualizado: $f (copia en ${f}.bak)"
                cambios=1
                ;;
            1) ;;
            *) fallos=1 ;;
        esac
    done
    shopt -u nullglob
    [ "$fallos" -eq 0 ] || return 1

    if [ "$cambios" -eq 0 ]; then
        ok "'contrib' y 'non-free' ya estaban configurados."
    else
        LISTAS_ACTUALIZADAS=0   # hay que volver a sincronizar las listas
    fi
}

fuente_debian_relevante() {
    local f="$1"
    case "$f" in
        *.sources)
            grep -qiE '^URIs:.*(debian\.org|/debian/?([[:space:]]|$))' "$f" &&
                grep -qE '^Components:.*(^|[[:space:]])main([[:space:]]|$)' "$f"
            ;;
        *.list)
            grep -qE '^[[:space:]]*deb(-src)?[[:space:]].*(debian\.org|/debian/?[[:space:]]).*([[:space:]])main([[:space:]]|$)' "$f"
            ;;
        *)
            return 1
            ;;
    esac
}

estado_repos() {
    if [ "$(leer_distribucion)" = ubuntu ]; then
        estado_ubuntu_repos "${1:-/etc/apt}"
        return $?
    fi
    local root="${1:-/etc/apt}" f temporal relevantes=0 pendientes=0 indice=0
    local -a fuentes
    shopt -s nullglob
    fuentes=("$root/sources.list" "$root"/sources.list.d/*.list "$root"/sources.list.d/*.sources)
    shopt -u nullglob

    temporal=$(mktemp -d) || return 1
    for f in "${fuentes[@]}"; do
        [ -f "$f" ] || continue
        fuente_debian_relevante "$f" || continue
        relevantes=1
        indice=$((indice + 1))
        local copia="$temporal/$indice-$(basename "$f")" estado
        if ! cp -- "$f" "$copia"; then
            rm -rf -- "$temporal"
            return 1
        fi
        anadir_componentes "$copia"; estado=$?
        case "$estado" in
            0) pendientes=1; break ;;
            1) ;;
            *) rm -rf -- "$temporal"; return 1 ;;
        esac
    done
    rm -rf -- "$temporal"
    [ "$relevantes" -eq 1 ] && [ "$pendientes" -eq 0 ]
}

