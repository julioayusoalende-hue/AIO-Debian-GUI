limpiar_dependencias() {
    local modo="$1"
    info "Limpiando dependencias huérfanas (apt-get autoremove $modo)..."
    local -a conservar=()
    local paquete
    # needrestart y libnotify-bin son necesarios para el programador en AppImage/Flatpak.
    for paquete in libnotify-bin needrestart; do
        paquete_instalado "$paquete" && conservar+=("${paquete}+")
    done
    local simulation plan cambios respuesta aprobado="$AUTOREMOVE_PLAN"
    while :; do
        if ! simulation=$(LC_ALL=C run_privileged "apt-simulate-autoremove-$modo" 60 apt-get -s -o Debug::NoLocking=1 autoremove "$modo" "${conservar[@]}" </dev/null 2>&1); then
            err "No se pudo simular la limpieza de dependencias."
            printf '%s\n' "$simulation"
            return 1
        fi
        plan=$(huella_plan_apt <<< "$simulation") || return 1
        [ "$plan" = "$aprobado" ] && break
        if [ "$REVISAR_LIMPIEZA" -ne 1 ] || [ -z "$aprobado" ]; then
            err "Limpieza detenida: revisa y confirma de nuevo el plan de autoremove antes de eliminar paquetes."
            return 1
        fi
        cambios=$(LC_ALL=C awk '/^(Inst|Remv|Purg) /' <<< "$simulation") || return 1
        if [ -z "$cambios" ]; then
            ok "No quedan dependencias huérfanas que limpiar."
            return 0
        fi
        local detalle
        detalle=$(printf '%s' "$cambios" | base64 -w0) || return 1
        printf '##CLEANUP-REVIEW:%s:%s:%s\n' "$modo" "$plan" "$detalle"
        if ! IFS= read -r -t 300 -u "${_aio_review_fd:-8}" respuesta; then
            err "No se recibió una respuesta para el nuevo plan de limpieza."
            return 1
        fi
        if [ "$respuesta" = "omitir" ]; then
            warn "Se omitió la limpieza de dependencias por decisión del usuario."
            return 3
        fi
        if [ "$respuesta" != "$plan" ]; then
            err "La respuesta no coincide con el plan de limpieza."
            return 1
        fi
        aprobado="$plan"
    done
    if ! run_privileged "apt-autoremove-$modo" 300 apt-get "${APT_OPTS[@]}" autoremove "$modo" "${conservar[@]}" </dev/null; then
        err "No se pudieron eliminar las dependencias huérfanas."
        return 1
    fi
    ok "Dependencias huérfanas eliminadas."
}

