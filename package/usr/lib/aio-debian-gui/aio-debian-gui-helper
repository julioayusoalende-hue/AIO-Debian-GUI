}

paso_autoremove() {
    info "Eliminando dependencias huérfanas (apt-get autoremove)..."
    if ! apt-get "${APT_OPTS[@]}" autoremove; then
        err "No se pudieron eliminar las dependencias huérfanas."
        return 1
    fi
    ok "Dependencias huérfanas eliminadas."
}

paso_autoclean() {
    info "Limpiando paquetes .deb obsoletos del caché (apt-get autoclean)..."
    if ! apt-get autoclean; then
        err "No se pudo limpiar la caché de paquetes."
        return 1
    fi
    ok "Limpieza realizada."
}

paso_flatpak_update() {
    if ! command -v flatpak &> /dev/null; then
        info "Flatpak no está instalado en este sistema. Omitiendo..."
        return 0
    fi

    local uid entry username home runtime fallos=0
    info "Actualizando instalaciones Flatpak del sistema..."
    if flatpak --system update -y && flatpak --system uninstall --unused -y; then
        ok "Instalación Flatpak del sistema actualizada."
    else
        err "Hubo problemas al actualizar la instalación Flatpak del sistema."
        fallos=1
    fi

    # pkexec conserva el UID solicitante en PKEXEC_UID. Nunca se ejecuta Flatpak
    # de usuario como root: runuser usa su HOME y el runtime de su sesión.
    uid=$(pkexec_uid) || return 1
    entry=$(getent passwd "$uid") || {
        err "No se pudo localizar la cuenta que inició el mantenimiento."
        return 1
    }
    IFS=: read -r username _ _ _ _ home _ <<< "$entry"
    runtime="/run/user/$uid"
    if [ -d "$runtime" ] && [ -n "$home" ]; then
        info "Actualizando la instalación Flatpak del usuario $username..."
        if runuser -u "$username" -- env HOME="$home" XDG_RUNTIME_DIR="$runtime" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
            flatpak --user update -y &&
           runuser -u "$username" -- env HOME="$home" XDG_RUNTIME_DIR="$runtime" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
            flatpak --user uninstall --unused -y; then
            ok "Instalación Flatpak del usuario actualizada."
        else
            err "Hubo problemas al actualizar la instalación Flatpak del usuario."
            fallos=1
        fi
    else
        warn "No se encontró el runtime de sesión del usuario; se omite Flatpak de usuario."
    fi

    [ "$fallos" -eq 0 ] || return 1
    ok "Comprobación de instalaciones Flatpak finalizada."
}
paso_rebootcheck() {
    local necesita="$REINICIO_REQUERIDO" salida=""

    [ -f /var/run/reboot-required ] && necesita=1

    if command -v needrestart &> /dev/null; then
        info "Comprobación final de servicios y kernel con needrestart..."
        info "(puede tardar un poco)"
        salida=$(timeout 180 needrestart -b </dev/null 2>/dev/null)
        [ -n "$salida" ] && echo "$salida"

        if echo "$salida" | grep -qE "^NEEDRESTART-KSTA: [23]"; then
            necesita=1
        fi

        local criticos="dbus|dbus-broker|gdm|gdm3|lightdm|sddm|systemd-logind|systemd-udevd"
        if echo "$salida" | grep -qE "^NEEDRESTART-SVC: (${criticos})\.service$"; then
            necesita=1
        fi
    fi

    if [ "$necesita" -eq 1 ]; then
        warn "Se recomienda reiniciar para aplicar cambios críticos (kernel/servicios)."
    else
        ok "No hace falta reiniciar."
    fi
    echo "##REBOOT:${necesita}"
}

