# Hook genérico: cada paquete de distro puede registrar pasos y estados.
EXTENSION_STATUS_HOOKS=()
extension_root=${AIO_EXTENSIONS_DIR:-/usr/lib/aio-debian-gui/extensions}
for extension_helper in "$extension_root"/*/helper.sh; do
    [ -f "$extension_helper" ] || continue
    # shellcheck disable=SC1090
    source "$extension_helper"
done

mostrar_estados() {
    local tarea funcion
    local distro
    distro=$(leer_distribucion) || distro=desconocida
    for tarea in repos tools backports-kernel-mesa ubuntu-hwe gnome-plugin ext-manager; do
        # Las tareas exclusivas de otra distribución se marcan como no configuradas.
        case "$distro:$tarea" in
            ubuntu:backports-kernel-mesa|debian:ubuntu-hwe|desconocida:backports-kernel-mesa|desconocida:ubuntu-hwe)
                printf '##STATUS:%s:0\n' "$tarea"
                continue ;;
        esac
        case "$tarea" in
            repos) funcion=estado_repos ;;
            tools) funcion=estado_tools ;;
            backports-kernel-mesa) funcion=estado_backports ;;
            ubuntu-hwe) funcion=estado_ubuntu_hwe ;;
            gnome-plugin) funcion=estado_gnome_plugin ;;
            ext-manager) funcion=estado_ext_manager ;;
        esac
        if "$funcion"; then
            printf '##STATUS:%s:1\n' "$tarea"
        else
            printf '##STATUS:%s:0\n' "$tarea"
        fi
    done

    local extensiones=""
    if paquete_instalado gnome-shell && command -v gnome-extensions >/dev/null 2>&1; then
        if [ "$EUID" -eq 0 ]; then
            [ -z "${PKEXEC_UID:-}" ] || extensiones=$(
                ejecutar_como_usuario_solicitante python3 -I "$GNOME_EXTENSIONS_MODULE" list 2>/dev/null || true
            )
        else
            extensiones=$(python3 -I "$GNOME_EXTENSIONS_MODULE" list 2>/dev/null || true)
        fi
    fi
    for tarea in gnome-ext-appindicator gnome-ext-blur-shell gnome-ext-caffeine \
                 gnome-ext-clipboard-indicator gnome-ext-dash-to-dock \
                 gnome-ext-places-status gnome-ext-tiling-shell; do
        if grep -Fxq "${EXTENSIONES_GNOME[$tarea]}" <<< "$extensiones"; then
            printf '##STATUS:%s:1\n' "$tarea"
        else
            printf '##STATUS:%s:0\n' "$tarea"
        fi
    done

    for extension_status_hook in "${EXTENSION_STATUS_HOOKS[@]}"; do
        "$extension_status_hook"
    done

}


aiodebian_auditoria_dpkg() {
    local auditoria
    if ! auditoria=$(LC_ALL=C timeout --kill-after=2s 12s dpkg --audit 2>&1) || [ -n "$auditoria" ]; then
        err "Hay una incidencia de dpkg pendiente. Revisa el diagnóstico antes de actualizar AiO."
        [ -z "$auditoria" ] || printf '%s\n' "$auditoria" >&2
        return 1
    fi
}

aiodebian_candidata_estable() {
    local disponible
    disponible=$(LC_ALL=C apt-cache policy aio-debian-gui | awk '/^[[:space:]]*Candidate:/ { print $2; exit }')
    [ -n "$disponible" ] && [ "$disponible" != "(none)" ] || {
        err "No existe versión candidata de AiO Debian GUI en los repositorios APT."
        return 1
    }
    printf '%s\n' "$disponible"
}

# Resuelve la versión mostrada por la GUI (sin época) a la versión completa
# disponible en APT y rechaza ambigüedades o versiones ausentes.
aiodebian_resolver_version() {
    local solicitada="$1" completa="" version
    [[ "$solicitada" =~ ^[0-9][0-9A-Za-z.+~:-]*$ ]] || {
        err "Versión de actualización no válida."
        return 1
    }
    while IFS='|' read -r _ version _; do
        version=${version//[[:space:]]/}
        [ -n "$version" ] || continue
        if [ "$version" = "$solicitada" ] || [ "${version#*:}" = "$solicitada" ]; then
            if [ -n "$completa" ] && [ "$completa" != "$version" ]; then
                err "La versión aprobada es ambigua en los repositorios APT."
                return 1
            fi
            completa="$version"
        fi
    done < <(LC_ALL=C apt-cache madison aio-debian-gui)
    [ -n "$completa" ] || {
        err "La versión aprobada ya no está disponible en APT. Vuelve a buscar actualizaciones."
        return 1
    }
    printf '%s\n' "$completa"
}

actualizar_aiodebian_estable() (
    local accion=$1 aprobada=${2:-} instalada disponible completa simulation
    [ "$accion" = comprobar ] || [ "$accion" = instalar ] || return 2
    paquete_instalado aio-debian-gui || { err "AiO Debian GUI no está instalado como DEB."; return 1; }
    instalada=$(dpkg-query -W -f='${Version}' aio-debian-gui) || return 1
    aiodebian_auditoria_dpkg || return 1
    asegurar_listas || return 1

    if [ "$accion" = comprobar ]; then
        disponible=$(aiodebian_candidata_estable) || return 1
        if dpkg --compare-versions "$disponible" gt "$instalada"; then
            simulation=$(LC_ALL=C run_privileged "apt-simulate-aiodebian-estable" 60 apt-get -s --only-upgrade --no-remove install "aio-debian-gui=$disponible" 2>&1) || {
                err "No se pudo simular la actualización de AiO Debian GUI."
                printf '%s\n' "$simulation" >&2
                return 1
            }
            if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
                err "La actualización de AiO Debian GUI propone eliminar paquetes. Se cancela por seguridad."
                return 1
            fi
            printf '##UPDATE:%s:%s\n' "${instalada#*:}" "${disponible#*:}"
        else
            printf '##NOUPDATE:%s:%s\n' "${instalada#*:}" "${disponible#*:}"
        fi
        return 0
    fi

    if [ -n "$aprobada" ]; then
        completa=$(aiodebian_resolver_version "$aprobada") || return 1
    else
        completa=$(aiodebian_candidata_estable) || return 1
    fi
    if ! dpkg --compare-versions "$completa" gt "$instalada"; then
        err "La actualización estable de AiO Debian GUI ya no es aplicable."
        return 1
    fi
    simulation=$(LC_ALL=C run_privileged "apt-simulate-aiodebian-estable" 60 apt-get -s --only-upgrade --no-remove install "aio-debian-gui=$completa" 2>&1) || {
        err "No se pudo simular la actualización de AiO Debian GUI."
        printf '%s\n' "$simulation" >&2
        return 1
    }
    if grep -Eq '^(Remv|Purg) ' <<< "$simulation"; then
        err "La actualización de AiO Debian GUI propone eliminar paquetes. Se cancela por seguridad."
        return 1
    fi
    run_privileged "apt-install-aiodebian-estable" 300 apt-get "${APT_OPTS[@]}" --only-upgrade --no-remove install "aio-debian-gui=$completa" || {
        err "No se pudo actualizar AiO Debian GUI mediante APT."
        return 1
    }
    ok "Comprobación y actualización del paquete DEB completadas."
)

# Consulta un origen firmado solo para esta operación. El APT del equipo
# conserva sus fuentes y la instalación resuelve allí las dependencias.
actualizar_aiodebian_testing() (
    local accion=$1 aprobada=${2:-} temporal instalada disponible archivo auditoria hash
    local patron='^[0-9]+:[0-9]+\.[0-9]+\.[0-9]+~testing\.[1-9][0-9]*\.[1-9][0-9]*$'
    paquete_instalado aio-debian-gui || { err "AiO Debian GUI no está instalado como DEB."; return 1; }
    instalada=$(dpkg-query -W -f='${Version}' aio-debian-gui) || return 1
    if [ "$accion" = instalar ]; then
        if ! auditoria=$(LC_ALL=C run_privileged "dpkg-audit" 30 dpkg --audit 2>&1) || [ -n "$auditoria" ]; then
            err "Hay una incidencia de dpkg pendiente. Revisa el diagnóstico antes de actualizar AiO."
            [ -z "$auditoria" ] || printf '%s\n' "$auditoria" >&2
            return 1
        fi
    fi
    temporal=$(mktemp -d /var/tmp/aio-testing.XXXXXXXX) || return 1
    trap 'rm -rf -- "$temporal"' EXIT
    chmod 0755 "$temporal" || return 1
    mkdir "$temporal/lists" || return 1
    printf '%s\n' 'deb [signed-by=/usr/share/keyrings/aio-debian-gui.gpg] https://julioayusoalende-hue.github.io/AIO-Debian-GUI/apt-testing/ testing main' > "$temporal/testing.list" || return 1
    local opciones=(-o "Dir::Etc::sourcelist=$temporal/testing.list"
                    -o 'Dir::Etc::sourceparts=-' -o "Dir::State::lists=$temporal/lists"
                    -o 'Dir::Cache::pkgcache=' -o 'Dir::Cache::srcpkgcache=')
    run_privileged "apt-update-testing" 180 apt-get "${opciones[@]}" -o APT::Update::Error-Mode=any update || return 1
    disponible=$(LC_ALL=C apt-cache "${opciones[@]}" madison aio-debian-gui |
        awk -F '|' 'NR == 1 { gsub(/[[:space:]]/, "", $2); print $2 }')
    [[ "$disponible" =~ $patron ]] || { err "No hay una versión válida en el canal Testing."; return 1; }
    if ! dpkg --compare-versions "$disponible" gt "$instalada"; then
        if [ "$accion" = comprobar ]; then
            printf '##NOUPDATE:%s:%s\n' "${instalada#*:}" "${disponible#*:}"
            return 0
        fi
        err "La actualización Testing ya no es aplicable."
        return 1
    fi
    if [ "$accion" = comprobar ]; then
        printf '##UPDATE:%s:%s\n' "${instalada#*:}" "${disponible#*:}"
        return 0
    fi
    if [ "$aprobada" != "${disponible#*:}" ]; then
        err "La versión Testing ha cambiado. Vuelve a buscar actualizaciones."
        return 1
    fi
    hash=$(LC_ALL=C apt-cache "${opciones[@]}" show "aio-debian-gui=$disponible" |
        awk '$1 == "SHA256:" { print $2 }')
    [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || { err "El índice Testing no contiene un SHA-256 válido."; return 1; }
    mkdir -m 0755 "$temporal/download" || return 1
    mkdir -m 0700 "$temporal/verified" || return 1
    if [ "$EUID" -eq 0 ]; then
        chown _apt "$temporal/download" || return 1
    fi
    cd "$temporal/download" || return 1
    run_privileged "apt-download-aiodebian-testing" 60 apt-get "${opciones[@]}" download "aio-debian-gui=$disponible" || return 1
    local paquetes=(./*.deb)
    [ "${#paquetes[@]}" -eq 1 ] || return 1
    [ -f "${paquetes[0]}" ] && [ ! -L "${paquetes[0]}" ] || return 1
    archivo="$temporal/verified/aio-debian-gui_all.deb"
    install -m 0644 -- "${paquetes[0]}" "$archivo" || return 1
    printf '%s  %s\n' "$hash" "$archivo" | sha256sum --check --status ||
        { err "El paquete descargado no coincide con el SHA-256 del canal Testing."; return 1; }
    # APT necesita atravesar el directorio al abrir el paquete ya verificado.
    chmod 0755 "$temporal/verified" || return 1
    [ "$(dpkg-deb -f "$archivo" Package)" = aio-debian-gui ] &&
        [ "$(dpkg-deb -f "$archivo" Version)" = "$disponible" ] || return 1
    run_privileged "apt-install-aiodebian-testing" 300 apt-get "${APT_OPTS[@]}" --only-upgrade --no-remove install "$archivo"
)

main() {
    if [ "${1:-}" = "--version" ] && [ "$#" -eq 1 ]; then
        printf '%s\n' "$HELPER_VERSION"
        return 0
    fi
    if [ "${1:-}" = "--maintenance-api" ] && [ "$#" -eq 1 ]; then
        printf '%s\n' 1
        return 0
    fi
    # Actualizar exclusivamente Flatpak del usuario sin elevar privilegios.
    # Sin --system ni instalaciones de root; no requiere polkit ni pkexec.
    if [ "${1:-}" = "--flatpak-user-update" ] && [ "$#" -eq 1 ]; then
        [ "$EUID" -ne 0 ] || { err "Flatpak de usuario nunca se ejecuta como root."; return 1; }
        command -v flatpak >/dev/null 2>&1 || { err "Flatpak no está instalado."; return 1; }
        echo "##STEP:1:1:Actualizar aplicaciones Flatpak del usuario"
        if flatpak --user update -y && flatpak --user uninstall --unused -y; then
            ok "Flatpak de usuario actualizado y dependencias sin uso eliminadas."
            echo "##RESULT:flatpak-update:0"
            echo "##DONE:0"
            return 0
        fi
        err "No se pudieron actualizar los Flatpak de usuario."
        echo "##RESULT:flatpak-update:1"
        echo "##DONE:1"
        return 1
    fi
    if [ "${1:-}" = "--backports-rollback-plan" ] && [ "$#" -eq 1 ]; then
        plan_revertir_backports
        return $?
    fi
    if [ "${1:-}" = "--nvidia-report" ] && [ "$#" -eq 1 ]; then
        nvidia_report
        return 0
    fi
    if [ "${1:-}" = "--status" ] && [ "$#" -eq 1 ]; then
        nvidia_report
        mostrar_estados
        return 0
    fi

    if [[ "${1:-}" == "--schedule-status" || "${1:-}" == "--schedule-history" ]] && [ "$#" -eq 1 ]; then
        [ -r "$SCHEDULER_MODULE" ] || { err "Instala la integración de programación de AiO en el anfitrión."; return 1; }
        /usr/bin/python3 -I "$SCHEDULER_MODULE" "--${1#--schedule-}" "$(id -u)"
        return $?
    fi

    if [ "$EUID" -ne 0 ]; then
        err "Este asistente debe ejecutarse con privilegios de administrador." >&2
        exit 1
    fi

    # Idioma de los mensajes de apt/flatpak (pkexec limpia el entorno)
    if [ "${1:-}" = "--lang" ]; then
        if [[ "${2:-}" =~ ^[A-Za-z0-9_.@-]{1,40}$ ]]; then
            export LANG="$2"
        fi
        shift; [ $# -gt 0 ] && shift
    fi

    # Ghostty valida su propia versión de Ubuntu sin habilitar el resto del mantenimiento.
    if [ "$#" -ne 2 ] || [ "${1:-}" != "--recommended-install" ] || [ "${2:-}" != ghostty ]; then
        distribucion_soportada >/dev/null || exit 1
    fi

    local inherited_lock=""
    if [ "${1:-}" = "--lock-fd" ]; then
        inherited_lock="${2:-}"
        [[ "$inherited_lock" =~ ^[1-9][0-9]{0,5}$ ]] && [ "$inherited_lock" -ge 3 ] || {
            err "Descriptor de bloqueo no válido."; exit 2;
        }
        [ "$(readlink "/proc/self/fd/$inherited_lock")" = "$MAINTENANCE_LOCK" ] || {
            err "El bloqueo heredado no corresponde a AiO."; exit 2;
        }
        shift 2
    fi

    # Huella del plan mostrado por la GUI antes de solicitar autorización.
    if [ "${1:-}" = "--upgrade-plan" ]; then
        [[ "${2:-}" =~ ^[0-9a-f]{64}$ ]] || { err "Plan APT no válido."; exit 2; }
        UPGRADE_PLAN="$2"
        shift 2
    fi

    if [ "${1:-}" = "--autoremove-plan" ]; then
        [[ "${2:-}" =~ ^[0-9a-f]{64}$ ]] || { err "Plan de autoremove no válido."; exit 2; }
        AUTOREMOVE_PLAN="$2"
        shift 2
    fi
    if [ "${1:-}" = "--review-cleanup" ]; then
        REVISAR_LIMPIEZA=1
        shift
    fi

    case "${1:-}" in
        --refresh-diagnostic-apt)
            [ "$#" -eq 1 ] || { err "Argumentos de diagnóstico no válidos."; exit 2; }
            install -d -o root -g root -m 0755 /run/aio-debian-gui || exit 1
            umask 077
            exec 9>"$MAINTENANCE_LOCK" || exit 1
            umask 022
            chmod 0600 "$MAINTENANCE_LOCK" || exit 1
            flock -n 9 || { err "Ya hay otro mantenimiento de AiO en curso."; exit 1; }
            AIO_PRIV_LOCK_FD=9
            refrescar_indices_diagnostico
            exit $?
            ;;
        --schedule-save)
            [ "$#" -eq 2 ] || { err "Configuración de programación no válida."; exit 2; }
            [ -r "$SCHEDULER_MODULE" ] || { err "Instala la integración de programación de AiO en el anfitrión."; exit 1; }
            local schedule_uid
            schedule_uid=$(pkexec_uid) || exit 1
            echo "##SCHEDULE:authorized"
            ejecutar_programador --configure "$schedule_uid" "$2"
            exit $?
            ;;
        --schedule-remove)
            [ "$#" -eq 1 ] || { err "Argumentos de programación no válidos."; exit 2; }
            [ -r "$SCHEDULER_MODULE" ] || { err "Instala la integración de programación de AiO en el anfitrión."; exit 1; }
            local schedule_uid
            schedule_uid=$(pkexec_uid) || exit 1
            echo "##SCHEDULE:authorized"
            ejecutar_programador --remove "$schedule_uid"
            exit $?
            ;;
        --check-update-self-testing)
            [ "$#" -eq 1 ] || exit 2
            actualizar_aiodebian_testing comprobar
            exit $?
            ;;
        --update-self-testing)
            [ "$#" -eq 2 ] || exit 2
            actualizar_aiodebian_testing instalar "$2"
            exit $?
            ;;
        --check-update-self)
            [ "$#" -eq 1 ] || { err "Uso: $0 [--lang LOCALE] --check-update-self"; exit 2; }
            actualizar_aiodebian_estable comprobar
            exit $?
            ;;
        --update-self)
            [ "$#" -ge 1 ] && [ "$#" -le 2 ] || { err "Uso: $0 [--lang LOCALE] --update-self [VERSION]"; exit 2; }
            actualizar_aiodebian_estable instalar "${2:-}"
            exit $?
            ;;
        --backup-install)
            [ "$#" -eq 2 ] || { err "Uso: $0 [--lang LOCALE] --backup-install timeshift|deja-dup"; exit 2; }
            instalar_aplicacion_backup "$2"
            exit $?
            ;;
        --recommended-install)
            [ "$#" -eq 2 ] || { err "Uso: $0 [--lang LOCALE] --recommended-install audacity|btop|celluloid|deluge|flameshot|ghostty|gimp|gparted|handbrake|hplip-gui|htop|kdenlive|kitty|qbittorrent|retroarch|vlc"; exit 2; }
            instalar_aplicacion_recomendada "$2"
            exit $?
            ;;
        --enable-passwordless)
            [ "$#" -eq 1 ] || { err "Uso: $0 [--lang LOCALE] --enable-passwordless"; exit 2; }
            habilitar_sin_contrasena
            exit $?
            ;;
        --disable-passwordless)
            [ "$#" -eq 1 ] || { err "Uso: $0 [--lang LOCALE] --disable-passwordless"; exit 2; }
            deshabilitar_sin_contrasena
            exit $?
            ;;
    esac

    local pasos=() s
    for s in "$@"; do
        if [ -z "${TITULOS[$s]+x}" ]; then
            err "Paso desconocido: $s" >&2
            exit 2
        fi
        pasos+=("$s")
    done
    [ ${#pasos[@]} -gt 0 ] || { err "No se indicó ningún paso." >&2; exit 2; }
    if [[ " ${pasos[*]} " == *" autoremove "* && " ${pasos[*]} " == *" autopurge "* ]]; then
        err "Selecciona una sola tarea de limpieza de dependencias."
        exit 2
    fi
    local distro
    distro=$(leer_distribucion) || exit 1
    for s in "${pasos[@]}"; do
        case "$distro:$s" in
            ubuntu:backports-kernel-mesa|ubuntu:revertir-backports|ubuntu:nvidia-driver|debian:ubuntu-hwe)
                err "La tarea $s no es compatible con la distribución detectada."
                exit 2 ;;
        esac
    done

    # Un bloqueo común impide solapar tareas manuales y programadas de AiO.
    if [ -z "$inherited_lock" ]; then
        install -d -o root -g root -m 0755 /run/aio-debian-gui || exit 1
        umask 077
        exec 9>"$MAINTENANCE_LOCK" || exit 1
        umask 022
        chmod 0600 "$MAINTENANCE_LOCK" || exit 1
        inherited_lock=9
    fi
    if ! flock -n "$inherited_lock"; then
        err "Ya hay otro mantenimiento de AiO en curso."
        exit 1
    fi
    AIO_PRIV_LOCK_FD="$inherited_lock"

    local total=${#pasos[@]} i=0 fallos=0 resultado
    for s in "${pasos[@]}"; do
        i=$((i + 1))
        echo "##STEP:${i}:${total}:${TITULOS[$s]}"
        resultado=0
        if [[ "$s" == gnome-ext-* ]]; then
            instalar_extension_gnome "$s" || resultado=$?
        else
            "paso_${s//-/_}" || resultado=$?
        fi
        if [ "$resultado" -eq 3 ] && [[ "$s" == autoremove || "$s" == autopurge ]]; then
            echo "##RESULT:${s}:2"
        elif [ "$resultado" -ne 0 ]; then
            echo "##RESULT:${s}:1"
            fallos=1
            if [[ "$CRITICOS" == *" $s "* ]]; then
                echo "##DONE:1"
                exit 1
            fi
        else
            echo "##RESULT:${s}:0"
        fi
    done

    echo "##DONE:${fallos}"
    [ "$fallos" -eq 0 ]
}

# Permite hacer 'source' del archivo para pruebas sin ejecutar nada
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
