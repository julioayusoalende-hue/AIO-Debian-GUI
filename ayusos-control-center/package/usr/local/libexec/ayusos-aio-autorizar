#!/bin/bash
# Autorización inicial de AiO Debian GUI para AyusOS.
# Crea reglas Polkit para todos los usuarios administradores locales.
# Se ejecuta al primer arranque (servicio systemd) y en Live.
set -euo pipefail
umask 022

state=/var/lib/ayusos
helper=/usr/lib/aio-debian-gui/aio-debian-gui-helper
install -d -m 0755 "$state"

live=false
if [[ -d /run/live/medium ]] || grep -qw 'boot=live' /proc/cmdline; then
    live=true
fi

# Obtener todos los usuarios administradores (UID >= 1000, grupo sudo)
admins=()
if "$live"; then
    # En Live: usuario 'user' con UID 999 (o el que sea)
    if id -u user >/dev/null 2>&1; then
        admins+=("user")
    fi
else
    while IFS=: read -r username _ uid _ _ _ _; do
        if (( uid >= 1000 && uid < 60000 )) && id -nG "$username" 2>/dev/null | grep -qw sudo; then
            admins+=("$username")
        fi
    done < /etc/passwd
fi

if [[ ${#admins[@]} -eq 0 ]]; then
    echo 'Aún no hay cuentas administradoras locales.' >&2
    exit 1
fi

directory=/etc/polkit-1/rules.d
test -d "$directory"

# En Live el overlay no admite ACL POSIX; en instalado sí.
if "$live"; then
    chmod o+x "$directory" 2>/dev/null || true
else
    # Dar acceso al directorio a cada admin (para que pueda leer su regla)
    for u in "${admins[@]}"; do
        setfacl -m "u:$u:--x" "$directory" 2>/dev/null || true
    done
fi

generar_regla_polkit() {
    local username="$1"
    [[ "$username" =~ ^[a-zA-Z_][a-zA-Z0-9_.-]*[$]?$ ]] || {
        echo "Nombre de usuario no válido para una regla Polkit: $username" >&2
        return 1
    }
    cat <<EOF
polkit.addRule(function(action, subject) {
    if (action.id === "es.aiodebian.gui.mantenimiento" &&
        action.lookup("program") === "/usr/lib/aio-debian-gui/aio-debian-gui-helper" &&
        subject.user === "$username" &&
        subject.local &&
        subject.active) {
        return polkit.Result.YES;
    }
});
EOF
}

passwordless_dir=/var/lib/aio-debian-gui/passwordless
install -d -m 0755 "$passwordless_dir" 2>/dev/null || true

# Generar una regla por cada administrador
for username in "${admins[@]}"; do
    uid=$(id -u "$username" 2>/dev/null) || continue
    rule=$(mktemp "$directory/.ayusos-aio.XXXXXX")
    if ! generar_regla_polkit "$username" > "$rule"; then
        rm -f -- "$rule"
        continue
    fi
    chmod 0644 "$rule"
    cp -- "$rule" "$passwordless_dir/${uid}.rules" 2>/dev/null || true
    mv -f -- "$rule" "$directory/50-aiodebian-gui-$uid.rules"
done

# Guardar lista de UIDs autorizados (uno por línea)
printf '%s\n' "${admins[@]}" | while read -r u; do id -u "$u"; done > "$state/aio-usuarios"

echo "Autorización AiO activada para ${#admins[@]} usuario(s): ${admins[*]}"