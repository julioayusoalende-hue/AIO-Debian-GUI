#!/bin/bash
set -euo pipefail
umask 022
state=/var/lib/ayusos
install -d -m 0755 "$state"

live=false
if [[ -d /run/live/medium ]] || grep -qw 'boot=live' /proc/cmdline; then
    live=true
fi

if "$live"; then
    exit 0
fi

# El servicio de autorización escribe la lista de UIDs en aio-usuarios.
[[ -s "$state/aio-usuarios" ]] || {
    echo 'No hay usuarios autorizados registrados; ejecuta ayusos-aio-autorizar.' >&2
    exit 1
}
# Aplicar las elecciones del wizard una sola vez, antes del mantenimiento.
# Código 10 = aplicado pero requiere reinicio; no abortar.
if [[ ! -e "$state/onboarding-done" ]]; then
    echo 'El asistente de primer inicio todavía está pendiente.' >&2
    exit 1
fi
if [[ -s "$state/onboarding-uid" ]]; then
    read -r uid < "$state/onboarding-uid"
else
    # Compatibilidad con asistentes que todavía no guardaban el UID.
    read -r uid < "$state/aio-usuarios"
fi
if ! [[ "$uid" =~ ^[1-9][0-9]*$ ]] || ! grep -Fxq -- "$uid" "$state/aio-usuarios"; then
    echo 'El usuario del asistente no figura como administrador autorizado.' >&2
    exit 1
fi
config="/etc/aio-debian-gui/schedules/$uid.json"
if [[ ! -e "$state/onboarding-applied" || ! -f "$config" ]]; then
    if /usr/local/libexec/ayusos-aplicar-onboarding "$uid"; then
        :
    else
        rc=$?
        if [[ $rc -ne 10 ]]; then
            exit $rc
        fi
    fi
fi

enabled=$(/usr/bin/python3 -I -c \
    'import json,sys; print(json.load(open(sys.argv[1]))["enabled"])' "$config")
case "$enabled" in
    True|False) ;;
    *) echo 'La configuración de mantenimiento no es válida.' >&2; exit 1 ;;
esac
touch "$state/onboarding-applied"

if [[ "$enabled" == True ]]; then
    systemctl start "aio-debian-gui-maintenance@$uid.service"
    /usr/bin/python3 -I -c \
        'import json,sys; sys.exit(json.load(open(sys.argv[1]))["status"] != "success")' \
        "/var/lib/aio-debian-gui/schedules/$uid.json"
fi
touch "$state/aio-inicial"
