#!/usr/bin/python3 -I
"""Consume signed bundled scheduler updates; never execute user-owned code."""
import base64
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import tempfile

ROOT = Path('/usr/lib/aio-debian-gui')
STATE = Path('/var/lib/aio-debian-gui/portable-version')
KEY = Path('/usr/share/keyrings/aio-debian-gui-portable.gpg')
FILES = {
    '__init__.py': str(ROOT / 'aio_core/__init__.py'),
    'scheduler.py': str(ROOT / 'aio_core/scheduler.py'),
    'preflight.py': str(ROOT / 'aio_core/preflight.py'),
    'aio-debian-gui-helper': str(ROOT / 'aio-debian-gui-helper'),
    'es.aiodebian.gui.policy': '/usr/share/polkit-1/actions/es.aiodebian.gui.policy',
    'aio-debian-gui-maintenance@.service': '/usr/lib/systemd/system/aio-debian-gui-maintenance@.service',
}
LIMIT = 4 * 1024 * 1024


def version(value):
    if not isinstance(value, str) or not re.fullmatch(r'[0-9]{1,6}\.[0-9]{1,6}\.[0-9]{1,6}', value):
        raise ValueError('Invalid version')
    return tuple(map(int, value.split('.')))


def verify(envelope, key=KEY):
    if len(envelope) > LIMIT * 2:
        raise ValueError('Oversized update')
    obj = json.loads(envelope)
    data = base64.b64decode(obj['data'], validate=True)
    signature = base64.b64decode(obj['signature'], validate=True)
    if len(data) > LIMIT or len(signature) > 65536:
        raise ValueError('Oversized signature or payload')
    with tempfile.TemporaryDirectory(prefix='aio-verify-') as tmp:
        payload = Path(tmp) / 'payload'
        sig = Path(tmp) / 'signature'
        payload.write_bytes(data)
        sig.write_bytes(signature)
        subprocess.run(['/usr/bin/gpgv', '--homedir', tmp, '--keyring', str(key), str(sig), str(payload)],
                       check=True, capture_output=True, timeout=30)
    manifest = json.loads(data)
    version(manifest['version'])
    if set(manifest) != {'version', 'files'} or set(manifest['files']) != set(FILES):
        raise ValueError('Unexpected resources')
    decoded = {name: base64.b64decode(value, validate=True) for name, value in manifest['files'].items()}
    if any(not value or len(value) > LIMIT for value in decoded.values()):
        raise ValueError('Invalid resource size')
    return manifest['version'], decoded


def atomic(path, data, mode):
    path = Path(path)
    fd, temporary = tempfile.mkstemp(prefix='.aio-update-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
            os.fchmod(stream.fileno(), mode)
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def apply(envelope):
    release, resources = verify(envelope)
    if version(release) <= version(STATE.read_text().strip()):
        return
    # Refuse package-managed installations; migration must explicitly remove their owner.
    for target in FILES.values():
        result = subprocess.run(['/usr/bin/dpkg-query', '-S', '--', target],
                                capture_output=True, text=True, env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'})
        if result.returncode != 1 or result.stdout or result.stderr.strip() != 'dpkg-query: no path found matching pattern ' + target:
            raise RuntimeError('Destination may be owned by dpkg: ' + target)
    previous = {}
    for name, target in FILES.items():
        info = os.lstat(target)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError('Unsafe destination: ' + target)
        previous[name] = (Path(target).read_bytes(), stat.S_IMODE(info.st_mode))
    try:
        for name, target in FILES.items():
            atomic(target, resources[name], 0o755 if name == 'aio-debian-gui-helper' else 0o644)
        subprocess.run(['/usr/bin/systemctl', 'daemon-reload'], check=True, timeout=30)
        atomic(STATE, (release + '\n').encode(), 0o644)
    except BaseException:
        for name, target in FILES.items():
            atomic(target, *previous[name])
        subprocess.run(['/usr/bin/systemctl', 'daemon-reload'], check=True, timeout=30)
        raise


def main():
    if os.geteuid() != 0:
        raise PermissionError('Root required')
    handles = []
    try:
        directory = Path('/run/aio-debian-gui')
        directory.mkdir(mode=0o755, exist_ok=True)
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError('Unsafe lock directory')
        for name in ('host-update.lock', 'maintenance.lock'):
            fd = os.open(directory / name, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
            handles.append(fd)
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077 or info.st_nlink != 1:
                raise RuntimeError('Unsafe lock')
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return  # Retry on next timer tick.
        for name in ('/var/lib/dpkg/lock-frontend', '/var/lib/dpkg/lock'):
            fd = os.open(name, os.O_RDWR | os.O_NOFOLLOW)
            handles.append(fd)
            try:
                fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return
        for runtime in Path('/run/user').iterdir():
            if not runtime.name.isdecimal():
                continue
            try:
                fd = os.open(runtime / 'aio-portable-update', os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
                with os.fdopen(fd, 'rb') as stream:
                    info = os.fstat(stream.fileno())
                    if not stat.S_ISREG(info.st_mode) or info.st_uid != int(runtime.name):
                        continue
                    envelope = stream.read(LIMIT * 2 + 1)
                apply(envelope)
            except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
                print(str(runtime) + ': ' + str(error), flush=True)
    finally:
        for fd in handles:
            os.close(fd)


if __name__ == '__main__':
    main()
