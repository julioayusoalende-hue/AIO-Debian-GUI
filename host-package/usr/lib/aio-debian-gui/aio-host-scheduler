#!/usr/bin/python3
"""Inicia el programador portátil bajo la puerta compartida de actualización."""
import fcntl
import os
import stat
import sys

DIRECTORY = "/run/aio-debian-gui"
LOCK_NAME = "host-update.lock"
SCHEDULER = "/usr/lib/aio-debian-gui/aio_core/scheduler.py"


def main():
    if os.geteuid() != 0:
        raise PermissionError("La programación requiere privilegios de administrador.")
    try:
        os.mkdir(DIRECTORY, 0o755)
    except FileExistsError:
        pass
    directory = os.open(DIRECTORY, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        info = os.fstat(directory)
        if info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError("Directorio de programación inseguro.")
        lock = os.open(LOCK_NAME, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW,
                       0o600, dir_fd=directory)
    finally:
        os.close(directory)
    info = os.fstat(lock)
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0
            or info.st_mode & 0o077 or info.st_nlink != 1):
        os.close(lock)
        raise RuntimeError("Bloqueo de actualización inseguro.")
    fcntl.flock(lock, fcntl.LOCK_SH)
    os.set_inheritable(lock, True)
    os.execv("/usr/bin/python3", ["/usr/bin/python3", "-I", SCHEDULER, *sys.argv[1:]])


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
